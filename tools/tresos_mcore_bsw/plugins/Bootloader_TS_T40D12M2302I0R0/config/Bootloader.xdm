<?xml version='1.0'?>
<datamodel version="3.0"
           xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
           xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
    <d:ctr type="AUTOSAR" factory="autosar"
    xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
    xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
    xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="TS_T40D12M2302I0R0" type="AR-PACKAGE">
                <d:lst type="ELEMENTS">
                    <d:chc name="Bootloader" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html>
                                        Configuration of the Generic integration application components.
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LOWER-MULTIPLICITY" value="1"/>
                            <a:a name="RELEASE" value="asc:4.4.0"/>
                            <a:a name="UPPER-MULTIPLICITY" value="1"/>
                            <a:a name="UUID" value="ECUC:aa293537-43fd-3434-b6a4-f8c4da265866"/>
                            <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                <a:a name="LABEL" value="Config Variant"/>
                                <a:a name="UUID" value="ECUC:ef6bd642-a609-46f7-b5ec-2f16166ba3be"/>
                                <a:da name="DEFAULT" value="VariantPostBuild"/>
                                <a:da name="RANGE">
                                    <a:v>VariantPostBuild</a:v>
                                    <a:v>VariantPostBuildSelectable</a:v>
                                </a:da>
                            </v:var>
                            <v:ctr name="BootloaderGeneral" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Bootloader global configuration"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                    <html>
                                    This container holds global configuration flags
                                       - SBC Watchdog handle
                                       - unchecked: SBC Watchdog enabled.
                                       </html> ]]>
                                    </a:v>
                                </a:a>
                                <v:var name="InTarget_debug_flag" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                   <html>
                                   This flag indicates whether the bootloader shall execute a wait-for-T32 loop or not.
                                   This needs to be configured when the bootloader is running from flash.
                                   <br>    - checked:   wait for debugger;
                                   <br>    - unchecked: do not wait for debugger.
                                   </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Software breakpoint enable"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:2810d48b-c07e-46f0-b111-100148be101d"/>
                                </v:var>
                                <v:var name="A53LockstepEnable" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                   <html>
                                   This flag indicates whether the A53 cluster 1 operates in lockstep mode or not.
                                   As a consequence, it will make cores CA53_2 and CA53_3, CA53_6, CA53_7 unavailable for user code execution, as they are used as supervisors.
                                   </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="A53 Enable Lockstep"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="VISIBLE" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:281ad480-ce7e-46f0-b111-10034bb5191d"/>
                                </v:var>
                                <v:var name="Safety_flag" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                   <html>
                                   This flag indicates whether the bootloader shall be executed in a safety context
                                   using Safety SDK
                                   </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Safety Bootloader Enable"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:2810d48b-c07e-4cf0-b131-140148de101d"/>
                                </v:var>
                                <v:var name="Bl_SynchronizedBoot" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                   <html>
                                   This flag indicates whether the bootloader shall start execution after all applications have been loaded.
                                   <br>    - checked:   execute all applications at the same time;
                                   <br>    - unchecked: execute each application after it has loaded.
								   <br> Warning:
								   <br>   In case of disabling "Start Applications Synchronously" in Tresos
  								   <br>   and if the user runs both the bootloader and another application
  								   <br>   (E.g.: Uboot / ATF) which configures the platform cores clocks,
  								   <br>   a race condition might occur, which subsequently can interfered
  								   <br>   with the boot flow and prevents the platform to boot properly.
  								   <br>   This concept can be extended to other resources or peripherals as well.
  								   <br>   It is up to each application to consider these aspects.
                                   </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Start Applications Synchronously"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:d4eb51d2-c84c-435f-86ed-74fcfd826e74"/>
									<a:da name="WARNING" type="XPath">
                                        <a:tst expr="node:value(../Bl_SynchronizedBoot)"
                                                     false="If the user runs both the bootloader and another application (E.g.: Uboot / ATF) which configures the platform cores clocks, a race condition might occur, which subsequently  can interfered with the boot flow and prevents the platform to boot properly."/>
                                    </a:da>
                                </v:var>
                                <v:var name="Bl_ConfigureDDR" type="BOOLEAN">
                                    <a:a name="VISIBLE" value="false"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                   <html>
                                   This flag indicates whether the bootloader shall initialize the DDR memory
                                   <br>    - checked:   Enable DDR memory
                                   <br>    - unchecked: Disable DDR memory initialization
                                   </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Configure DDR memory"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:2810d48b-c07e-46f0-b111-100148bc101d"/>
                                </v:var>
                                <v:var name="Bl_EnableSecBoot" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            This flag indicates whether the secure boot sequence shall be activated or not
                                            </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Enable Secure Boot"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:f4084f6e-cb5d-4dc0-b18c-e8fbe39a5570"/>
                                </v:var>
                                <v:var  name="Bl_EnableFlexNoc" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            This flag indicates whether the FlexNoC Registers will be initialized or not
                                            </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Enable FlexNoC Registers"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:b73fe480-09ba-11ed-861d-0242ac120002"/>
                                </v:var>
                                <v:ref name="Bl_SecBootKeyRef" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                   <html>
                                   This flag indicates whether the secure boot sequence shall be activated or not
                                   </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Secure Boot Key Descriptor"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:56651463-43db-4ba0-95a3-a184480cdc28"/>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/CryptoDal/CryptoDalBswConfig/CryptoDescriptors"/>
                                    <a:da name="ENABLE" type="XPath">
                                        <a:tst expr="(node:value(../Bl_EnableSecBoot) = 'true')"/>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(node:ref(.)/Algorithm) != 'AES_256_CMAC')"
                                        true="Referenced crypto key must have AES_256_CMAC type."/>
                                    </a:da>
                                </v:ref>
                                <v:var name="SysImageStorageAddr" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                                System Image Storage Address. At this flash address Bootloader will save the HSE system image
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="LABEL" value="HSE System Image Address"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:43dbb255-2f4b-1291-391a-927c9fdddc23"/>
                                    <a:da name="DEFAULT" value="0xB0000"/>
                                    <a:da name="ENABLE" type="XPath">
                                        <a:tst expr="(node:value(../Bl_EnableSecBoot) = 'true')"/>
                                    </a:da>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=0x400000"
                                            true="Address of system image must be less than 0x400000"/>
                                        <a:tst expr="&gt;=0x400"
                                            true="Address of system image must be greater than 0x400"/>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr=". mod 1024 = 0"
                                            false="Value must a multiple of 0x1000"/>
                                    </a:da>
                                </v:var>
                            </v:ctr>
                            <v:ctr name="BootloaderAcceptedResetReasons" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Accepted reset reasons"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                            This container holds the accepted reset reasons, for which the boot flow
                                            shall be allowed to execute.
                                       </html> ]]>
                                    </a:v>
                                </a:a>
                                <v:var name="Bl_POR" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                                This flag indicates that POR (power-on reset) is an accepted reset reason.
                                            </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Power-on reset"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:7f16036b-0908-4460-ada2-2e2e2b19a1dd"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(.) = 'false') and (node:value(../Bl_DestructiveReset) = 'false')
                                                     and (node:value(../Bl_FunctionalReset) = 'false') and (node:value(../Bl_StandbyReset) = 'false')
                                                     and (node:value(../Bl_UnknownReset) = 'false')"
                                                true="At least one accepted reset reason is mandatory."/>
                                    </a:da>
                                </v:var>
                                <v:var name="Bl_DestructiveReset" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                                This flag indicates that destructive reset is an accepted reset reason.
                                            </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Destructive reset"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:34ee62df-7df8-45f5-b2bd-b432124a17e5"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(.) = 'false') and (node:value(../Bl_POR) = 'false')
                                                     and (node:value(../Bl_FunctionalReset) = 'false') and (node:value(../Bl_StandbyReset) = 'false')
                                                     and (node:value(../Bl_UnknownReset) = 'false')"
                                                true="At least one accepted reset reason is mandatory."/>
                                    </a:da>
                                </v:var>
                                <v:var name="Bl_FunctionalReset" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                                This flag indicates that functional reset is an accepted reset reason.
                                            </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Functional reset"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:dedcb6ab-b3da-44ae-aad3-83d0d3073369"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(.) = 'false') and (node:value(../Bl_POR) = 'false')
                                                     and (node:value(../Bl_DestructiveReset) = 'false') and (node:value(../Bl_StandbyReset) = 'false')
                                                     and (node:value(../Bl_UnknownReset) = 'false')"
                                                true="At least one accepted reset reason is mandatory."/>
                                    </a:da>
                                </v:var>
                                <v:var name="Bl_StandbyReset" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                                This flag indicates that functional reset is an accepted reset reason.
                                            </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Standby reset"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:1d6179e9-02bb-4fe0-8b84-820376c9cee4"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(.) = 'false') and (node:value(../Bl_POR) = 'false')
                                                     and (node:value(../Bl_FunctionalReset) = 'false') and (node:value(../Bl_DestructiveReset) = 'false')
                                                     and (node:value(../Bl_UnknownReset) = 'false')"
                                                true="At least one accepted reset reason is mandatory."/>
                                    </a:da>
                                </v:var>
                                <v:var name="Bl_UnknownReset" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                                This flag indicates that unknown reset is an accepted reset reason.<br>
                                                An unkown reset is considered when no other reset reason could be identified.
                                            </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Unknown reset"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:96add524-39fa-42b8-8c5c-77dd69673705"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(.) = 'false') and (node:value(../Bl_POR) = 'false')
                                                     and (node:value(../Bl_FunctionalReset) = 'false') and (node:value(../Bl_DestructiveReset) = 'false')
                                                     and (node:value(../Bl_StandbyReset) = 'false')"
                                                true="At least one accepted reset reason is mandatory."/>
                                    </a:da>
                                </v:var>
                            </v:ctr>
                            <v:ctr name="BootloaderConsoleLog" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Bootloader Console Log"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                    <html>
                                    This container holds the configuration for console log.
                                       </html> ]]>
                                    </a:v>
                                </a:a>
                                <v:var name="Bl_ConsoleLog" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                   <html>
                                   This flag indicates whether the bootloader should have console log active.
                                   </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Enable Console Log"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:35454a39-add3-497f-be56-535eec2ba15a"/>
                                </v:var>

                                <v:ref name="Bl_ConsoleComChannelRef" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Com Descriptor"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:a5ccfcab-e56f-443a-993f-8886dae271a3"/>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/ComDal/ComDalBswConfig/ComDescriptors"/>
                                    <a:da name="ENABLE" type="XPath">
                                        <a:tst expr="(node:value(../Bl_ConsoleLog) = 'true')"/>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(node:ref(.)/ComChannelDirection) != 'TX_CHANNEL')"
                                        true="Referenced com channel must be TX."/>
                                    </a:da>
                                </v:ref>
                            </v:ctr>
                            <v:lst name="CoreConfiguration" type="MAP">
                                <a:da name="MIN" value="1"/>
                                <a:da name="MAX" value="7"/>
                                <a:da name="LABEL" value="Core Configuration"/>
                                <v:ctr name="CoreConfiguration" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                        <html>
                                             This container links the application details for a specific core.
                                        </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:5ce51b69-fffb-4b87-863d-7463e09aaab1"/>

                                    <v:var name="CoreID" type="ENUMERATION">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                         <html>
                                            Core identification based on the platform capabilities
                                         </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="LABEL" value="Core ID"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="ECUC:42ecb255-1f4b-9d91-391a-977c9fcdcb23"/>
                                        <a:da name="DEFAULT" value="M7_1"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:uniq(/AUTOSAR/TOP-LEVEL-PACKAGES/Bootloader/ELEMENTS/Bootloader/BootSources/*/CoreID, .)"
                                                false="Only one configuration per core is valid"/>
                                            <a:tst expr="node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Bootloader/ELEMENTS/Bootloader/BootloaderGeneral/A53LockstepEnable) = 'true'
                                                        and (node:value(.) = 'A53_2' or node:value(.) = 'A53_3' or node:value(.) = 'A53_6' or node:value(.) = 'A53_7')"
                                                true="Cluster 1 (A53_2, A53_3, A53_6 and A53_7) usage is disabled in lockstep mode!"/>
                                        </a:da>
                                        <a:da name="RANGE">
                                            <a:v>M7_0</a:v>
                                            <a:v>M7_1</a:v>
                                            <a:v>M7_2</a:v>
                                            <a:v>M7_3</a:v>
                                            <a:v>A53_0</a:v>
                                            <a:v>A53_1</a:v>
                                            <a:v>A53_2</a:v>
                                            <a:v>A53_3</a:v>
                                            <a:v>A53_4</a:v>
                                            <a:v>A53_5</a:v>
                                            <a:v>A53_6</a:v>
                                            <a:v>A53_7</a:v>
                                        </a:da>
                                    </v:var>

                                    <v:ref name="BootSourcesCfg" type="REFERENCE">
                                        <a:a name="LABEL" value="Boot source configuration"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                               <html>
                                               Reference to a Boot Source configuration which defines the list of images to be loaded.
                                               </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa00c"/>
                                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/Bootloader/BootSources"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:empty(.)"
                                                true="Please select the boot source for this core!"/>
                                            <a:tst expr="not(node:refexists(.))"
                                                true="Please provide a valid boot source configuration"/>
                                        </a:da>
                                    </v:ref>

                                    <v:var name="IsCriticalApplication" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                               <html>
                                               Flag that marks if this is a critical application and the system can not function without this.
                                               <br><strong>Checked</strong> = is a critical application
                                               <br><strong>Unchecked</strong> = is not a critical application
                                               </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"  type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Is a critical application"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:da name="DEFAULT" value="true"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:5ce51b69-fffb-4b87-863d-7463e09aa5cd"/>
                                    </v:var>

                                    <v:var name="StartCore" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                               <html>
                                               Bootloader has the option to start the core after the application image was loaded.<br>
                                               If you want to skip this and leave the responsibility to a system manager application, then uncheck this option.
                                               <br><strong>Checked</strong> = bootloader will start this core
                                               <br><strong>Unchecked</strong> = bootloader will not start this core
                                               </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"  type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Start the core"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:da name="DEFAULT" value="true"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:5ce51b69-fffb-4b87-863d-7463ced7a5cd"/>
                                    </v:var>

                                </v:ctr>
                            </v:lst>
                            <v:lst name="BootSources" type="MAP">
                                <a:da name="MIN" value="1"/>
                                <a:da name="MAX" value="32"/>
                                <a:da name="LABEL" value="Boot Sources"/>
                                <v:ctr name="BootSources" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                        <html>
                                             List of application images for different cores.
                                        </html> ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa001"/>

                                    <v:var name="BootSource" type="ENUMERATION">
                                        <a:a name="LABEL" value="Boot source"/>
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:
                                                <html>
                                                    Image storage source.
                                                </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa004"/>
                                        <a:da name="DEFAULT" value="QSPI"/>
                                        <a:da name="RANGE">
                                            <a:v>QSPI</a:v>
                                            <a:v>SDMMC</a:v>
                                        </a:da>
                                    </v:var>

                                    <v:var name="AuthenticationAlgorithm" type="ENUMERATION">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:
                                                <html>
                                                    Authentication method to be used while bootloader loads application:
                                                    <br>    NONE - load without validation;
                                                    <br>    SHA1 - SHA1 validation;
                                                    <br>    SHA256 - SHA256 validation;
                                                    <br>    CRC32 - CRC validation;
                                                </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="LABEL" value="Boot image authentication method"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa005"/>
                                        <a:da name="DEFAULT" value="NONE"/>
                                        <a:da name="RANGE">
                                            <a:v>NONE</a:v>
                                            <a:v>SHA1</a:v>
                                            <a:v>SHA256</a:v>
                                            <a:v>CRC32</a:v>
                                        </a:da>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="((node:value(../BootSource) = 'SDMMC') and (node:value(.) = 'CRC32'))"
                                            true="The image storage is invalid for the chosen authentication method.
                                            You can not use CRC authentication method if you choose SD/eMMC image storage"/>
                                            <a:tst expr="(node:value(.) = 'CRC32') and (node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Mcl/ELEMENTS/Mcl/MclGeneral/MclDma/MclEnableCrc) = 'false')"
                                            true="DMA CRC operations have not been enabled in MCL plugin. Please update your configuration"/>
                                            <a:tst expr="(node:value(../BootSource) != 'QSPI') and (node:value(.) = 'CRC32')"
                                            true="The CRC32 authentication method only works for QSPI"/>
                                        </a:da>
                                    </v:var>

                                    <v:ref name="EncryptionRef" type="REFERENCE">
                                        <a:a name="LABEL" value="Decryption key descriptor"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                               <html>
                                               Decryption key descriptor, this field references the assigned cryptodal descriptor for current image,
                                               containing information about algorithm and key value
                                               </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa006"/>
                                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/CryptoDal/CryptoDalBswConfig/CryptoDescriptors"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:empty(.)"
                                                true="Please reference the CryptoDal key to be used!"/>
                                        </a:da>
                                    </v:ref>

                                    <v:var name="ApplicationResetHandler" type="INTEGER">
                                        <a:a name="LABEL" value="Reset handler address"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                <html> The address of the application Reset Handler.
                                                This address must be contained in one of the listed fragmented images, and must not exceed image boundaries: RAM address + image size.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa00b"/>
                                        <a:a name="DEFAULT_RADIX" value="HEX" />
                                        <a:da name="DEFAULT" value="0"/>
                                    </v:var>

                                    <v:lst name="ImageFragments" type="MAP">
                                        <a:da name="MIN" value="1"/>
                                        <a:da name="MAX" value="4"/>
                                        <a:da name="LABEL" value="Boot image fragments"/>
                                        <v:ctr name="ImageFragments" type="IDENTIFIABLE">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:
                                                <html>
                                                    This container implements all the fragments of an appication image.
                                                </html> ]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa002"/>

                                            <v:var name="SourceAddressQspi" type="INTEGER">
                                                <a:a name="LABEL" value="Source address (in QSPI)"/>
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html>Source address in the QSPI memory of the fragmented image.
                                                        </html>]]>
                                                    </a:v>
                                                </a:a>
                                                <a:da name="INVALID" type="XPath">
                                                    <a:tst expr="(((node:value(../../../AuthenticationAlgorithm) = 'CRC32') and (num:mod(node:value(.),8) = 0)) or
                                                                 ((node:value(../../../AuthenticationAlgorithm) = 'SHA1') and (num:mod(node:value(.),64) = 0)) or
                                                                 ((node:value(../../../AuthenticationAlgorithm) = 'SHA256') and (num:mod(node:value(.),64) = 0)) or
                                                                 ((node:value(../../../AuthenticationAlgorithm) = 'NONE') and (num:mod(node:value(.),64) = 0)))"
                                                    false="The flash storage address is invalid.
                                                    If you use CRC over DMA transfer, the flash storage address must be multiple of 8
                                                    If you don't use CRC over DMA transfer, the flash storage address must be multiple of 64"/>
                                                </a:da>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa003"/>
                                                <a:a name="DEFAULT_RADIX" value="HEX" />
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:da name="EDITABLE" type="XPath">
                                                    <a:tst expr="node:value(../../../BootSource) = 'QSPI'"/>
                                                </a:da>
                                            </v:var>

                                            <v:ref name="MemoryBlockId" type="REFERENCE">
                                                <a:a name="LABEL" value="MemDal block reference"/>
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html>
                                                        Reference to the MemDal block containing application image
                                                        </html> ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:da name="EDITABLE" type="XPath">
                                                    <a:tst expr="(node:value(../../../BootSource) = 'SDMMC')"/>
                                                </a:da>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa008"/>
                                                <a:da name="INVALID" type="XPath">
                                                    <a:tst expr="node:empty(.) and node:value(../../../BootSource) = 'SDMMC'"
                                                        true="Please reference the MemDal block to be used!"/>
                                                    <a:tst expr="(not(node:refexists(.))) and (node:value(../../../BootSource) = 'SDMMC')"
                                                        true="Please provide a valid MemDal block reference."/>
                                                </a:da>
                                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/MemDal/MemDalSdhcBlocks"/>
                                            </v:ref>

                                            <v:ref name="ComManagerSessionReference" type="REFERENCE">
                                                <a:a name="LABEL" value="ComManager session reference"/>
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html> Reference to the ComManager session which will handle the external image transfer.
                                                        </html>]]>
                                                    </a:v>
                                                </a:a>
                                                <a:da name="INVALID" type="XPath">
                                                    <a:tst expr="(not(node:refexists(.))) and (node:value(../../../BootSource) = 'COM')"
                                                        true="A valid session reference must be provided."/>
                                                    <a:tst expr="(node:name(node:ref(.)/ComProtocolType) = 'HTTP') and
                                                                (node:name(node:ref(.)/ComProtocolType/HttpSessionType) = 'HTTP_CLIENT') and
                                                                (node:value(node:ref(.)/ComProtocolType/HttpSessionType/HttpRequestMethod) = 'GET') and
                                                                (not(text:uniq(../../*/ComManagerSessionReference, .)))"
                                                        true="The session reference must be unique for HTTP GET sessions."/>
                                                </a:da>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa00d"/>
                                                <a:da name="ENABLE" type="XPath">
                                                    <a:tst expr="node:value(../../../BootSource) = 'COM'"/>
                                                </a:da>
                                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/ComManager/ComManagerSessionsConfig/ComSessions"/>
                                            </v:ref>

                                            <v:var name="LoadAddressRam" type="INTEGER">
                                                <a:a name="LABEL" value="Load image at address (RAM)"/>
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html> The address to load the image into RAM.
                                                        <br><font color="red">NOTE !:</font> The start address must be multiple of 8 if you choose CRC32 authentication method,
                                                                                            otherwise must be multiple of 64.
                                                        </html>]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa007"/>
                                                <a:a name="DEFAULT_RADIX" value="HEX" />
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:da name="INVALID" type="XPath">
                                                    <a:tst expr="(((node:value(../../../AuthenticationAlgorithm) = 'CRC32') and (num:mod(node:value(.),8) = 0)) or
                                                                ((node:value(../../../AuthenticationAlgorithm) = 'SHA1') and (num:mod(node:value(.),64) = 0))or
                                                                ((node:value(../../../AuthenticationAlgorithm) = 'SHA256') and (num:mod(node:value(.),64) = 0))or
                                                                ((node:value(../../../AuthenticationAlgorithm) = 'NONE') and (num:mod(node:value(.),64) = 0)))"
                                                    false="The load RAM address is invalid.
                                                    If you use CRC over DMA transfer, the start address must be multiple of 8
                                                    If you don't use CRC over DMA transfer, the start address must be multiple of 64"/>
                                                </a:da>
                                            </v:var>

                                            <v:var name="ImageSize" type="INTEGER">
                                                <a:a name="LABEL" value="Image size (bytes)"/>
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html>
                                                            The fragment image size in bytes.
                                                            For images loaded from SDMMC the application size is provided by MemDal block descriptor.
                                                        </html>]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa009"/>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:da name="EDITABLE" type="XPath">
                                                    <a:tst expr="(node:value(../../../BootSource) = 'QSPI' and (node:value(../../../AuthenticationAlgorithm) = 'NONE' or node:value(../../../AuthenticationAlgorithm) = 'CRC32'))
                                                                 or (node:value(../../../BootSource) = 'COM')"/>
                                                </a:da>
                                            </v:var>
											<v:var name="SmrIndex" type="INTEGER">
                                                <a:a name="LABEL" value="SMR Index "/>
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html>
                                                            The HSE SMR table index if Secure Boot is enabled.
															If 0 the SMR entry is disabled for current image fragment.
															Only available for QSPI boot source and without image authentication.
                                                        </html>]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="UUID" value="ECUC:ed1cff6a-569b-11ed-9b6a-0242ac120002"/>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:da name="EDITABLE" type="XPath">
                                                    <a:tst expr="((node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Bootloader/ELEMENTS/Bootloader/BootloaderGeneral/Bl_EnableSecBoot) = 'true') )"/>
                                                </a:da>

                                            </v:var>
                                            <v:var name="CrcValue" type="INTEGER">
                                                <a:a name="LABEL" value="Image CRC value"/>
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html> The CRC value of the image.
                                                        <br><font color="red">NOTE !:</font> To compute the CRC it must be used the same CRC algorithm as DMA uses when
                                                                    transfer the application image which is Ethernet (IEEE 802,3) CCITT32 CRC-32.
                                                        </html>]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="UUID" value="ECUC:5ce51b69-fffb-4a07-8b1d-7463e09aa00a"/>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:a name="DEFAULT_RADIX" value="HEX"/>
                                                <a:da name="EDITABLE" type="XPath">
                                                    <a:tst expr="(node:value(../../../BootSource) = 'QSPI') and
                                                                (node:value(../../../AuthenticationAlgorithm) = 'CRC32')"/>
                                                </a:da>
                                                <a:da name="INVALID" type="XPath">
                                                    <a:tst expr="(node:value(../../../BootSource) = 'QSPI') and
                                                                 (node:value(../../../AuthenticationAlgorithm) = 'CRC32') and
                                                                 (node:empty(.) or node:value(.) = 0)"
                                                        true="Please set a correct CRC32 value"/>
                                                </a:da>
                                            </v:var>

                                        </v:ctr>
                                    </v:lst>
                                </v:ctr>
                            </v:lst>
                            <v:lst name="Boot_Triggers" type="MAP">
                                <a:a name="MIN" value="1"/>
                                <a:a name="MAX" value="1"/>
                                <a:da name="LABEL" value="Boot Triggers"/>
                                <v:ctr name="Boot_Triggers" type="IDENTIFIABLE">
                                    <a:da name="LABEL" value="Boot triggers"/>
                                    <a:a name="DESC"
                                        value="EN: This container holds the general, pre-compile configuration parameters for supporting communication."/>
                                    <a:a name="UUID" value="ECUC:98e1662b-c143-4573-9ad8-2ebccc32b277"/>
                                    <v:var name="BootTriggerSupport" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                        <html>
                                        This flag enables upon a specific message received over CAN interface (configured in ComDal). The configured channel
                                        must set the corresponding Notification Function.
                                        </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"  type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Enable CAN boot trigger"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:2812d58a-c07f-41f0-b191-100148be101d"/>
                                    </v:var>
                                    <v:ref name="GptTimeoutChannel" type="REFERENCE">
                                        <a:da name="LABEL" value="Timeout channel"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                             <html>
                                              Reference to the configured General Purpose Timer channel used for measuring the timeout until a can message can be received.
                                             </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="ECUC:a1fa39c7-1ca5-4fb1-8c19-3460c4a323ab"/>
                                        <a:da name="ENABLE" type="XPath">
                                            <a:tst expr="node:value(../BootTriggerSupport) = 'true'"/>
                                        </a:da>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:empty(.)"
                                            true="Please reference the Gpt channel to be used for communication timeout."/>
                                        </a:da>
                                        <a:da name="REF"  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Gpt/GptChannelConfigSet/GptChannelConfiguration"/>
                                    </v:ref>
                                    <v:var name="ComTimeoutTime" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Timeout trigger time. Bootloader waits for this period, in milliseconds until continuing normal execution.
                                                If a CAN message is received in this period of time, bootloader breaks directly into normal execution.
                                                </html> ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"  type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="LABEL" value="Timeout period [ms]"/>
                                        <a:a name="UUID" value="ECUC:b17e2b31-742b-e3fa-9616-7c8a3a6f36ac"/>
                                        <a:da name="DEFAULT" value="10000"/>
                                        <a:da name="ENABLE" type="XPath">
                                            <a:tst expr="node:value(../BootTriggerSupport) = 'true'"/>
                                        </a:da>
                                    </v:var>
                                </v:ctr>
                            </v:lst>
                        </v:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>
