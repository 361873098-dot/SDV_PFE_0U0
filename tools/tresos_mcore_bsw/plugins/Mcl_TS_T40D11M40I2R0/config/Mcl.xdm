                                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                                </a:a>
                                                                <a:a name="ORIGIN" value="NXP"/>
                                                                <a:a name="SCOPE" value="LOCAL"/>
                                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                                <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100361"/>
                                                                <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../../../dmaLogicChannel_EnableScatterGather ='true') and (../../dmaLogicChannelConfig_enScatterGatherConfig = 'true')"/>
                                                                <a:da name="DEFAULT" value="false"/>
                                                            </v:var>
                                                            <v:ref name="dynamic_dmaLogicChannelConfig_MajorLoopLinkChValueType" type="SYMBOLIC-NAME-REFERENCE">
                                                                <a:a name="LABEL" value="Logic Link Channel"/>
                                                                <a:a name="DESC">
                                                                    <a:v>
                                                                        <![CDATA[EN:
                                                                            <html> Vendor specific: Set the Dma Channel major loop logic channel link.
                                                                            </html>]]>
                                                                    </a:v>
                                                                </a:a>
                                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                                </a:a>
                                                                <a:a name="ORIGIN" value="NXP"/>
                                                                <a:a name="SCOPE" value="LOCAL"/>
                                                                <a:a name="UUID" value="ECUC:8f76d08b-417d-421b-8668-c3c09bc5feda"/>
                                                                <a:a name="OPTIONAL" value="true"/>
                                                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcl/MclConfig/dmaLogicChannel_Type"/>
                                                                <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../../../dmaLogicChannel_EnableScatterGather ='true') and (../../dmaLogicChannelConfig_enScatterGatherConfig = 'true') and (../dmaLogicChannelConfig_enMajorLoopLinkCh='true')"/>
                                                                <a:da name="INVALID" type="XPath">
                                                                     <a:tst expr="node:refvalid(.)" false="Invalid XPath or empty reference."/>
                                                                </a:da>
                                                            </v:ref>
                                                            <v:var name="dmaLogicChannelConfig_MajorLoopCountType" type="INTEGER">
                                                                <a:a name="LABEL" value="Count"/>
                                                                <a:a name="DESC">
                                                                    <a:v>
                                                                        <![CDATA[EN:
                                                                            <html> Vendor specific: Set the Dma Channel major loop count.
                                                                                   If minor loop channel linking is enabled, the major loop count limit is between 0 and 511.
                                                                            </html>]]>
                                                                    </a:v>
                                                                </a:a>
                                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                                </a:a>
                                                                <a:a name="ORIGIN" value="NXP"/>
                                                                <a:a name="SCOPE" value="LOCAL"/>
                                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                                <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100363"/>
                                                                <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../../../dmaLogicChannel_EnableScatterGather ='true') and (../../dmaLogicChannelConfig_enScatterGatherConfig = 'true')"/>
                                                                <a:da name="DEFAULT" value="1"/>
                                                                <a:da name="INVALID" type="Range">
                                                                    <a:tst expr="&gt;=0"/>
                                                                    <a:tst expr="&lt;=32767"/>
                                                                </a:da>
                                                                <a:a name="INVALID" type="XPath">
                                                                    <a:tst expr="node:value(../dmaLogicChannelConfig_enMajorLoopLinkCh)='true' and node:value(.)&gt;511" true="When enable logic link channel, the max value of Major Loop Count is 511 (9 Bits)!"/>
                                                                </a:a>
                                                            </v:var>
                                                        </v:ctr>
                                                    </v:ctr>
                                                </v:ctr>
                                            </v:lst>
                                        </v:ctr>


                                                                                                        <v:ctr name="dmaLogicChannel_CrcConfigType" type="IDENTIFIABLE">
                                <a:a name="TAB" value="Crc"/>
                                    <a:a name="DESC">
                                    <a:v><![CDATA[EN:
                                        <html> Vendor specific:
                                        Crc Configuration.
                                        </html>
                                            ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:04ac857b-72f5-480b-b9ec-cc43a5100200"/>
                                <a:a name="EDITABLE" type="XPath" expr="(../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../../MclGeneral/MclDma/MclEnableCrc ='true') and(../../../dmaLogicChannel_EnableCrcConfig ='true')"/>

                                <v:var name="dmaLogicChannel_HwCrcChId" type="ENUMERATION">
                                    <a:a name="LABEL" value="DMA CRC Hardware Channel"/>
                                    <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html> Vendor specific:
                                        Select the physical DMA CRC Channel.
                                        NOTE: This is an Implementation Specific Parameter.
                                        </html>]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:70415366-91a9-4685-974a-fb4c0af4d7cc"/>
                                    <a:da name="RANGE" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaCrcChannel')"/>
                                    <a:da name="DEFAULT" value="DMA_IP_HW_CRC_0_CH_0"/>
                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../MclGeneral/MclDma/MclEnableDma ='true')and (../../../../../../MclGeneral/MclDma/MclEnableCrc ='true') and (../../../dmaLogicChannel_EnableCrcConfig ='true')"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="node:when((node:value(../../../../../../MclGeneral/MclDma/MclEnableCrc)='false'),'true', text:uniq(../../../../*[dmaLogicChannel_EnableCrcConfig='true']/*/*/dmaLogicChannel_HwCrcChId, .))" false="Duplicate DMA CRC Hardware Channel!"/>
                                        <a:tst expr="node:when((node:value(../../../dmaLogicChannel_EnableCrcConfig)='false' or node:value(../../../../../../MclGeneral/MclDma/MclEnableCrc)='false'),'true',node:when((node:value(../../../dmaLogicChannel_HwInstId)='DMA_IP_HW_INST_0'),text:match(.,'DMA_IP_HW_CRC_0'),text:match(.,'DMA_IP_HW_CRC_1')))" false="Incorrect DMA CRC channel value, please choose the DMA CRC channel of another instance!"/>
                                    </a:da>
                                </v:var>

                                <v:var name="dmaLogicChannel_CrcMode" type="ENUMERATION">
                                    <a:a name="LABEL" value="Mode"/>
                                    <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html> Vendor specific:
                                        Select the Mode for CRC logic.
                                        NOTE: This is an Implementation Specific Parameter.
                                        </html>]]>
                                    </a:v>
