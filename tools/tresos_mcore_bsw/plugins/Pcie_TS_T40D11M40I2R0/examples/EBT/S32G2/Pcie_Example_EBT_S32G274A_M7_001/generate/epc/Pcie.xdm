                      <a:a name="ENABLE" value="true"/>
                    </d:var>
                    <d:ref name="PcieChannelEcucPartitionRef" type="REFERENCE" >
                      <a:a name="ENABLE" value="false"/>
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:ref>
                    <d:ctr name="BAR0Configuration" type="IDENTIFIABLE">
                      <d:var name="Bar0Type64Bit" type="BOOLEAN" value="false"/>
                      <d:var name="Bar0TypeIo" type="BOOLEAN" value="false">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="Bar0TypePrefetchable" type="BOOLEAN" 
                             value="false"/>
                      <d:var name="Bar0Size" type="INTEGER" value="65536"/>
                      <d:var name="Bar0StartAddr" type="INTEGER" value="0">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="Bar0StartSymbol" type="FUNCTION-NAME" 
                             value="pcieMem_0"/>
                    </d:ctr>
                    <d:ctr name="BAR1Configuration" type="IDENTIFIABLE">
                      <a:a name="ENABLE" value="true"/>
                      <d:var name="Bar1TypeIo" type="BOOLEAN" value="false"/>
                      <d:var name="Bar1Size" type="INTEGER" value="65536"/>
                      <d:var name="Bar1StartAddr" type="INTEGER" value="0">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="Bar1StartSymbol" type="FUNCTION-NAME" 
