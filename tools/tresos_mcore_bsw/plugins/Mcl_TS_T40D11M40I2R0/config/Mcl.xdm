                                                            <a:da name="DEFAULT" type="XPath" expr="concat(node:fallback(node:current()/../../../../../../dmaLogicChannel_LogicName,'0'), '_SGA_ELEMENT_', node:fallback(node:current()/../../@index,'0') )"/>
                                                        </v:var>
                                                        <v:var name="dmaLogicChannelConfig_LastElementLink_ScatterGatherType" type="BOOLEAN">
