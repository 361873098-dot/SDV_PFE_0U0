                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bac8d865-f024-4b85-91fe-8ac2fc9c013b">
                          <SHORT-NAME>XrdcMasterPID</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">Process Identifier. This field only has meaning if the core is core master type and PID mode enable</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
