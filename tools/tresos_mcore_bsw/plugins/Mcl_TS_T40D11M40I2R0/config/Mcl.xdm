                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:32d07ea6-e364-4128-927e-d361c1b774f7"/>
                                    <a:da name="RANGE" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaCrcMode.List')"/>
                                    <a:da name="DEFAULT" value="NORMAL_CRC_MODE"/>
                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../MclGeneral/MclDma/MclEnableDma ='true')and (../../../../../../MclGeneral/MclDma/MclEnableCrc ='true') and (../../../dmaLogicChannel_EnableCrcConfig ='true')"/>
                                </v:var>

                                <v:var name="dmaLogicChannel_CrcPolynomial" type="ENUMERATION">
                                    <a:a name="LABEL" value="Polynomial"/>
                                    <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html> Vendor specific:
                                        Select the polynomial for CRC logic.
                                        NOTE: This is an Implementation Specific Parameter.
                                        </html>]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
