                                                    <a:da name="DEFAULT" type="XPath" expr="num:i(ecu:list('Rm.Mpu_M7.RegionEndAddress')[num:i( node:fallback( node:current()/../@index, num:i(0))) + 1])"/>
                                                    <a:a name="DEFAULT_RADIX" value="HEX"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=i(0xFFFFFFFF)"/>
                                                        <a:tst expr="&gt;=ecu:get('Rm.Mpu_M7.MinRegionSize')"/>
                                                    </a:da>
                                                </v:var>

                                                <v:var name="RegionSize" type="INTEGER">
