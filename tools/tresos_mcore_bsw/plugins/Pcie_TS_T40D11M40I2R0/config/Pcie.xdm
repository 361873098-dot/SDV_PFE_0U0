                                             false="Mem bar size too low."/>
                                      <a:tst expr="((node:value(.) = '0') or (node:value(../../BAR4Configuration/Bar4TypeIo) = 'false')) or (num:i(.)&gt;=ecu:get('Pcie.PcieGlobalConfig.PcieIoBarSize'))"  
                                             false="IO bar size too low"/>
                                      <a:tst expr="( bit:and((.), (.) - 1) ) = 0" false="BAR size must be power of 2."/>
                                  </a:da>
