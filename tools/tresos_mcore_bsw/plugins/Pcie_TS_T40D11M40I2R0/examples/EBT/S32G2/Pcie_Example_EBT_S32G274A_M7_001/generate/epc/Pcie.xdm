                    </d:ctr>
                    <d:ctr name="BAR4Configuration" type="IDENTIFIABLE">
                      <d:var name="Bar4Type64Bit" type="BOOLEAN" value="true"/>
                      <d:var name="Bar4TypeIo" type="BOOLEAN" value="false">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="Bar4TypePrefetchable" type="BOOLEAN" 
