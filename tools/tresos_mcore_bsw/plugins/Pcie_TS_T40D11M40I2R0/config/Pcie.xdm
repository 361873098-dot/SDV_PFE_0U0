                                  <a:a name="DESC">
                                      <a:v>
                                          <![CDATA[EN:<html><p>
                                              Vendor specific: Size of address space requested through BAR4. Set to 0 to disable BAR.<br />
                                          </p></html>]]>
                                      </a:v>
