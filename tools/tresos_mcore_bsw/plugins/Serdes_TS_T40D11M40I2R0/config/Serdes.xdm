*   used strictly in accordance with the applicable license terms. By expressly
*   accepting such terms or by downloading, installing, activating and/or otherwise
*   using the software, you are agreeing that you have read, and that you agree to
*   comply with and are bound by, such license terms. If you do not agree to be
*   bound by the applicable license terms, then you may not retain, install,
*   activate or otherwise use the software.
====================================================================================================
-->

  <d:ctr type="AUTOSAR" factory="autosar"
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd"
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">

      <d:ctr name="TS_T40D11M40I2R0" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:35cab853-b883-496d-98d6-c2226b4d6856"/>
            <d:lst type="ELEMENTS">
              <d:chc name="Serdes" type="AR-ELEMENT" value="MODULE-DEF">
                <v:ctr type="MODULE-DEF">
                    <a:a name="RELEASE" value="asc:4.4"/>
                    <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                        <ad:ADMIN-DATA>
                            <ad:DOC-REVISIONS>
                            <ad:DOC-REVISION>
                            <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                            </ad:DOC-REVISION>
                        </ad:DOC-REVISIONS>
                    </ad:ADMIN-DATA>
                    </a:a>
                    <a:a name="DESC" value="EN: Configuration of the Serdes (SerdesDriver) module"/>
                    <a:a name="LOWER-MULTIPLICITY" value="0"/>
                    <a:a name="POSTBUILDVARIANTSUPPORT" value="false"/>
                    <a:a name="UPPER-MULTIPLICITY" value="1"/>
                    <a:a name="UUID" value="ECUC:1e8f8a52-ca03-d4f1-21e2-21377143d9d5"/>
                    <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                        <a:a name="DESC" value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="LABEL" value="Post Build Variant Used"/>
                        <a:a name="ORIGIN" value="EB"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="READONLY" value="true"/>
                    </v:var>
                    <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                        <a:a name="LABEL" value="Config Variant"/>
                        <a:a name="UUID" value="ECUC:1a6b36f0-ea4c-46d6-87b5-9369aa3b226c"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:
                                    <html><p>
                                        VariantPreCompile: Only precompile time configuration parameters.<br>
                                        The files Serdes_Cfg.h and Serdes_Cfg.c are used.<br>
                                    </p></html>
                                ]]>
                            </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:da name="DEFAULT" value="VariantPreCompile"/>
                        <a:da name="RANGE">
                            <a:v>VariantPreCompile</a:v>
                        </a:da>
                    </v:var>

                    <!-- @implements SerdesGeneralConfiguration_Object -->
                    <v:ctr name="SerdesGeneral" type="IDENTIFIABLE">
                        <a:a name="DESC" value="EN: Container for common configuration options"/>
                        <a:a name="UUID" value="ECUC:22ae2271-3311-410d-108a-8aeafedf64e6"/>

                        <!-- @implements SerdesDevErrorDetect_Object -->
                        <v:var name="SerdesDevErrorDetect" type="BOOLEAN">
                            <a:a name="DESC" value="EN: Switches the development error detection and notification on or off."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:1a0aef6b-fa21-1fa8-a2db-0ac159b82c59"/>
                            <a:da name="DEFAULT" value="false"/>
                        </v:var>
                        <!-- @implements SerdesSetModeApi_Object -->
                        <v:var name="SerdesSetModeApi" type="BOOLEAN">
                            <a:a name="DESC" value="EN: Pre-processor switch to enable and disable availability of the API Serdes_SetMode()." />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP" />
                            <a:a name="SCOPE" value="LOCAL" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                            <a:a name="UUID" value="ECUC:1c15aa69-2a3a-b5b7-ae2a-b35392ab722b" />
                            <a:da name="DEFAULT" value="false" />
                        </v:var>
                        <!-- @implements SerdesVersionInfoApi_Object -->
                        <v:var name="SerdesVersionInfoApi" type="BOOLEAN">
                            <a:a name="DESC" value="EN: Pre-processor switch to enable and disable availability of the API Serdes_GetVersionInfo()."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:1c15aa69-2a3a-a6b7-ae2a-b35392ab722b"/>
                            <a:da name="DEFAULT" value="false"/>
                        </v:var>


                        <v:var name="SerdesEnableUserModeSupport" type="BOOLEAN">
                          <a:a name="LABEL" value="SerdesEnableUserModeSupport"/>
                          <a:a name="DESC">
                          <a:v>
                              <![CDATA[EN:
                                  <html>
                                      <p>When this parameter is enabled, the Serdes module will adapt to run from User Mode, with the following measures:</p>
                                      <p>(if applicable) a) configuring REG_PROT for the Serdes Controllers so that the registers under protection eth be accessed from user mode by setting UAA bit in REG_PROT_GCR to 1.</p>
                                      <p>(if applicable) b) using 'call trusted function' stubs for all internal function calls that access registers requiring supervisor mode.</p>
                                      <p>(if applicable) c) other module specific measures for more information, please see chapter 5.7 User Mode Support in IM</p>
                                  </html>
                              ]]>
                          </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:fbb4800a-1111-8ef4-9a8b-396befc038de"/>
                          <a:da name="DEFAULT" value="false"/>
                        </v:var>

                        <v:var name="SerdesMulticoreSupport" type="BOOLEAN">
                          <a:a name="DESC">
                          <a:v><![CDATA[EN:<html><p>This parameter globally enables the possibility to support multicore. If this parameter is enabled, at least one EcucPartition needs to be      defined (in all variants).<br>
                          <h1>Note</h1>This is an Implementation Specific Parameter.
                                </p></html>]]></a:v>
                          </a:a>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="LABEL" value="Serdes Multicore Support"/>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="ECUC:8436de9b-c7e1-4220-9e80-145k3690a2ab" />
                          <a:da name="DEFAULT" value="false" />
                          <a:a name="INVALID" type="XPath">
                            <a:tst expr="(. = 'true') and not(num:i(count(../SerdesEcucPartitionRef/*) > 0))"
                            true="Serdes Multicore Support is only enabled when at least one SerdesEcucPartitionRef needs to be defined (in all variants)."/>
                          </a:a>
                        </v:var>

                        <v:var name="SerdesTimeoutMethod" type="ENUMERATION">
                          <a:a name="LABEL" value="SerdesTimeoutMethod"/>
                          <a:a name="DESC">
                              <a:v><![CDATA[EN:<html>
                                  Configures the timeout method.<br />
                                  Based on this selection a certain timeout method from OsIf will be used in the driver.<br />
                                  Note: If SystemTimer or CustomTimer are selected make sure the corresponding timer is enabled in OsIf General configuration. <br />
                                  Note: Implementation Specific Parameter.
                              </html>]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:7228a335-4003-4789-811a-bb3d94567872"/>
                          <a:a name="DEFAULT" value="OSIF_COUNTER_DUMMY"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="(node:refs('ASPathDataOfSchema:/TS_T40D11M40I2R0/BaseNXP/OsIfGeneral/OsIfUseCustomTimer') = 'false') and (node:value(.) = 'OSIF_COUNTER_CUSTOM')" true="Custom Timer is not enabled in OsIf (OsIfGeneral/OsIfUseCustomTimer checkbox)"/>
                              <a:tst expr="(node:refs('ASPathDataOfSchema:/TS_T40D11M40I2R0/BaseNXP/OsIfGeneral/OsIfUseSystemTimer') = 'false') and (node:value(.) = 'OSIF_COUNTER_SYSTEM')" true="System Timer is not enabled in OsIf (OsIfGeneral/OsIfUseSystemTimer checkbox)"/>
                          </a:da>
                          <a:da name="RANGE">
                              <a:v>OSIF_COUNTER_SYSTEM</a:v>
                              <a:v>OSIF_COUNTER_CUSTOM</a:v>
                              <a:v>OSIF_COUNTER_DUMMY</a:v>
                          </a:da>
                        </v:var>

                        <v:var name="SerdesTimeoutDuration" type="INTEGER">
                          <a:a name="DESC" value="EN: The unit of measurement is given in number of microseconds."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:4e67cddf-1339-4ecc-97a7-a8ddcb18e24a"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=4294967295"/>
                            <a:tst expr="&gt;=1"/>
                          </a:da>
                          <a:da name="DEFAULT" value="1000"/>
                        </v:var>

                        <v:var name="SerdesMainFunctionPeriod" type="FLOAT">
                          <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                                The period between successive calls to the Serdes_MainFunction() in seconds.
                            </html>]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:4e67cddf-1339-4ecc-9457-a8ddcb18e24a"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=65.535"/>
                            <a:tst expr="&gt;=0.001"/>
                          </a:da>
                          <a:da name="DEFAULT" value="0.001"/>
                        </v:var>


                        <v:var name="SerdesJobDone" type="FUNCTION-NAME">
                        <a:a name="LABEL" value="Serdes Init Completed Callback"/>
                          <a:a name="DESC">
                              <a:v>
                                   <![CDATA[EN:<html>
                                        <p>Serdes initialization job completed callback. This function will be called when initialzation is completed.</p>
                                      Note: Implementation Specific Parameter.
                                  </html>]]>
                              </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="UUID" value="ECUC:8c7cba30-17c7-48bd-ae5f-9bdf0311b814"/>
                          <a:a name="OPTIONAL" value="true"/>
                          <a:da name="DEFAULT" value="Serdes_JobDoneCallback"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="(text:toupper(normalize-space(node:fallback(., ''))) = '&quot;NULL_PTR&quot;') or
                                           (text:toupper(normalize-space(node:fallback(., ''))) = 'NULL_PTR') or
                                           (text:toupper(normalize-space(node:fallback(., ''))) = '&quot;NULL&quot;') or
                                           (text:toupper(normalize-space(node:fallback(., ''))) = 'NULL') or not
                                           (text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$'))"
                                 true="Invalid identifier. The field must specify a valid C function identifier (i.e. an arbitrarily long sequence of digits, underscores, lowercase and uppercase Latin letters, that must begin with a non-digit character)"/>
                          </a:da>
                        </v:var>

                        <v:var name="SerdesJobFailed" type="FUNCTION-NAME">
                        <a:a name="LABEL" value="Serdes Init Failed Callback"/>
                          <a:a name="DESC">
                              <a:v>
                                   <![CDATA[EN:<html>
                                        <p>Serdes initialization job failed callback. This function will be called when initialzation had failed.</p>
                                      Note: Implementation Specific Parameter.
                                  </html>]]>
                              </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="UUID" value="ECUC:8c7cba30-17c7-48bd-a15f-11de0363b814"/>
                          <a:a name="OPTIONAL" value="true"/>
                          <a:da name="DEFAULT" value="Serdes_JobFailedCallback"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="(text:toupper(normalize-space(node:fallback(., ''))) = '&quot;NULL_PTR&quot;') or
                                           (text:toupper(normalize-space(node:fallback(., ''))) = 'NULL_PTR') or
                                           (text:toupper(normalize-space(node:fallback(., ''))) = '&quot;NULL&quot;') or
                                           (text:toupper(normalize-space(node:fallback(., ''))) = 'NULL') or not
                                           (text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$'))"
                                 true="Invalid identifier. The field must specify a valid C function identifier (i.e. an arbitrarily long sequence of digits, underscores, lowercase and uppercase Latin letters, that must begin with a non-digit character)"/>
                          </a:da>
                        </v:var>
                        <v:lst name="SerdesEcucPartitionRef">
                            <a:a name="INVALID" type="XPath">
                                <a:tst expr="((../../SerdesGeneral/SerdesMulticoreSupport = 'false') and (num:i(count(./*)) > 0)) or ((../../SerdesGeneral/SerdesMulticoreSupport = 'true') and (num:i(count(./*)) = 0))"
                               true="When at least one EcucPartitions is defined, a cross check should be done with SerdesMulticoreSupport to be enabled."/>
                            </a:a>
                            <a:a name="EDITABLE" type="XPath">
                                <a:tst expr="../../SerdesGeneral/SerdesMulticoreSupport ='true'"/>
                            </a:a>
                            <v:ref name="SerdesEcucPartitionRef" type="REFERENCE">
                                <a:a name="DESC">
                                    <a:v>Maps the SERDES driver to zero or multiple ECUC partitions to make the driver API available in the according partition.</a:v>
                                    <a:v>Tags: atp.Status=draft</a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="UUID" value="ECUC:f86d920b-a1e5-4f3f-a656-0f496z1b8513"/>
                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="count(text:grep(../../../SerdesGlobalConfig/SerdesChannel/*/SerdesChannelEcucPartitionRef/*[1], .)) = 0"
                                   true="The Ecuc partition need to be mapped to at least one SERDES channel."/>
                                    <a:tst expr="count(text:grep(node:refs('ASPathDataOfSchema:/TS_T40D11M40I2R0/Os')/OsApplication/*/OsAppEcucPartitionRef, .)) = 0"
                                   true="The ECUC partition must be defined in OS."/>
                                    <a:tst expr="text:uniq(../*, .)" false="Duplicate Partition."/>
                                </a:da>
                            </v:ref>
                        </v:lst>
                    </v:ctr>

                    <v:ctr name="SerdesGlobalConfig" type="IDENTIFIABLE">
                      <a:a name="DESC">
                          <a:v>
                              <![CDATA[EN:
                                  <html>
                                  This container contains the global configuration parameter of the Serdes driver. This container is a MultipleConfigurationContainer, i.e. this container and its sub-containers exit once per configuration set.
                                  </html>
                              ]]>
                          </a:v>
                      </a:a>
                      <a:a name="UUID" value="ECUC:ea3b8cf8-1ae5-9a29-ad07-1717472cf680"/>
                        <!-- @implements SerdesChannel_Object -->
                        <v:lst name="SerdesChannel" type="MAP">
                          <a:da name="MIN" value="1"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="num:i(count(node:current()/*)) &gt; ecu:get(&apos;Serdes.SerdesGlobalConfig.SerdesChannel&apos;)"
                                     true="Maximum available Serdes HW channels was exceeded."/>
                          </a:da>

                        <v:ctr name="SerdesChannel" type="IDENTIFIABLE">
                          <a:a name="DESC">
                              <a:v>
                                  <![CDATA[EN:
                                      <html>
                                      This container contains the configuration (parameters) of the Serdes Controller(s).
                                      <h1>Note:</h1>"User should use unique names for naming the Serdes channels across different SerdesGlobalConfig Sets."
                                      </html>
                                  ]]>
                              </a:v>
                          </a:a>
                          <a:a name="UUID" value="ECUC:9f1209fb-5482-4e6b-bf29-8231b4a8da21"/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>


                          <v:var name="SerdesChannelId" type="INTEGER">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                        Identifies the Serdes channel. <p/>
                                        Note: Implementation Specific Parameter. <p/>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Serdes Channel ID" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                            <a:a name="UUID"
                                 value="ECUC:aac952ef-7cb7-4b11-acc4-b6c4ca835e7a"/>
                            <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                            <a:da name="INVALID" type="Range">
                                <a:tst expr="&gt;=0"/>
                                <a:tst expr="&lt;(ecu:get(&apos;Serdes.SerdesGlobalConfig.SerdesChannel&apos;))"/>
                            </a:da>
                            <a:da name="INVALID" type="XPath">
                                <a:tst expr="(. &gt;= 0) and (.&lt; num:i(count(node:current()/../../*)))"
                                       false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the 'Calculate Value' button to calculate correct default value."/>
                                <a:tst expr="text:uniq(../../*/SerdesChannelId, .)"
                                       false="Duplicated value: SerdesChannelId must be unique across all Serdes channels. Use the 'Calculate Value' button to calculate correct default value."/>
                                <a:tst expr="(node:fallback( ., 0) &gt;= ecu:get(&apos;Serdes.SerdesGlobalConfig.SerdesChannel&apos;))"
                                        true="Exceeded the maximum Serdes channels supported by this particular derivative. Please refer to the reference manual for additional information."/>
                                <a:tst expr="num:i(node:fallback(.,0)) = num:i(../@index)"
                                       false="Invalid value: The ID should correspond to the position of the element within the configuration list."/>
                            </a:da>
                          </v:var>

                          <v:var name="SerdesHwChannel" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                        Selects the physical Serdes Channel. <p/>
                                        Note: Implementation Specific Parameter. <p/>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Serdes Hardware Channel" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID"
                                 value="ECUC:38388b20-3219-731a-ab13-8afb524661cd"/>
                            <a:da name="DEFAULT" type="XPath" expr="(ecu:list(&apos;Serdes.SerdesGlobalConfig.SerdesChannel.SerdesHwChannel&apos;))[position()-1=node:fallback( node:current()/../@index, '0')]">
                            </a:da>
                             <a:da name="INVALID" type="XPath">
                              <a:tst expr="text:uniq(node:fallback(../../*/SerdesHwChannel, 0 ), node:fallback( ., 1 ))"
                                     false="Duplicate physical Serdes channel: SerdesHwChannel must be unique across all Serdes channels. Use the 'Calculate Value' button to calculate correct default value."/>
                            </a:da>
                            <a:da name="RANGE" type="XPath"
                                  expr="ecu:list(&apos;Serdes.SerdesGlobalConfig.SerdesChannel.SerdesHwChannel&apos;)"/>
                          </v:var>

                          <v:var name="SerdesMode" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                        Selects the mode for Serdes. <p/>
                                        Note: Implementation Specific Parameter. <p/>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Serdes mode" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:9134e53b-4d60-9119-bbb4-1b273af192fc"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:da name="DEFAULT" value="SGMII_MODE_3"/>
                            <a:da name="RANGE">
                                <a:v>PCIE_X2</a:v>
                                <a:v>PCIE_SGMII_XPCS_0</a:v>
                                <a:v>PCIE_SGMII_XPCS_1</a:v>
                                <a:v>SGMII_MODE_3</a:v>
                                <a:v>SGMII_MODE_4</a:v>
                            </a:da>
                          </v:var>

                          <v:var name="SerdesPhyClock" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                        Selects the PHY clock, internal or external. <p/>
                                        Note: Implementation Specific Parameter. <p/>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Serdes PHY clock" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
