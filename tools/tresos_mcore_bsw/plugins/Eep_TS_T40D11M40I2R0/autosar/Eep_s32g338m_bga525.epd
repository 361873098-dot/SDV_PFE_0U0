              </PARAMETERS>
              <REFERENCES>
                <ECUC-REFERENCE-DEF UUID="ECUC:627edf12-4c45-4a3c-8960-de18707316ae">
                  <SHORT-NAME>EepMCoreSemaphoreLogicChannel</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          The Semaphore Logic Channel of the multicore semaphore used for requesting an access.
                                          The Semaphore Logic Channel should be passed to the SEMA4 gate APIs.
                                    </L-2>
                  </DESC>
                  <!-- @Calculated /TS_T40D11M40I2R0/Eep/AutosarExt/EepMCoreSemaphoreLogicChannel: ENABLE(XPath: (node:fallback( ../EepMCoreEnable, 0 ) = &apos;true&apos;))-->
