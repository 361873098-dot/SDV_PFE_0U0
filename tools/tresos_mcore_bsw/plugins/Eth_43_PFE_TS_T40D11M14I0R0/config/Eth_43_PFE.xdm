 *  be used strictly in accordance with the applicable license terms. By
 *  expressly accepting such terms or by downloading, installing, activating
 *  and/or otherwise using the software, you are agreeing that you have read,
 *  and that you agree to comply with and are bound by, such license terms. If
 *  you do not agree to be bound by the applicable license terms, then you may
 *  not retain, install, activate or otherwise use the software.
 *  <<< PFE Restricted Software >>>
 *
====================================================================================================
-->
  <d:ctr type="AUTOSAR" factory="autosar"
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Eth_43_PFE_TS_T40D11M14I0R0" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:d4c2f91e-2e50-4806-9c29-be6911515478"/>
        <d:lst type="ELEMENTS">
          <!-- /** @implements Eth_Object */ -->
          <d:chc name="Eth" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                      <ad:DATE>2014-10-31</ad:DATE>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC"
                   value="EN: Configuration of the Eth_43_PFE (Ethernet Driver) module."/>
              <a:a name="LOWER-MULTIPLICITY" value="1"/>
              <a:a name="RELEASE" value="asc:4.4"/>
              <a:a name="UPPER-MULTIPLICITY" value="*"/>
              <a:a name="UUID" value="ECUC:54eb453b-e14c-4f14-b2d4-381bb8ed7593"/>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                <a:a name="DESC">
                    <a:v>
                        <![CDATA[EN:<html>
                            Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points.
                        </html>]]>
                    </a:v>
                </a:a>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                </a:a>
                <a:a name="LABEL" value="Post Build Variant Used"/>
                <a:a name="ORIGIN" value="EB"/>
                <a:a name="UUID" value="ECUC:6d798fd6-a944-4bc5-9869-fb8dff5ed653"/>
                <a:da name="DEFAULT" value="true"/>
              </v:var>
              <!-- /** @implements IMPLEMENTATION_CONFIG_VARIANT_Object */ -->
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantLinkTime</icc:v>
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="ECUC:b490f94e-a63f-4d77-8d83-35640585c068"/>
                <a:da name="DEFAULT" value="VariantLinkTime"/>
                <a:da name="RANGE">
                  <a:v>VariantLinkTime</a:v>
                  <a:v>VariantPostBuild</a:v>
                  <a:v>VariantPreCompile</a:v>
                </a:da>
              </v:var>
              <!-- /** @implements EthConfigSet_Object */ -->
                <v:ctr name="EthConfigSet" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="EthConfigset"/>
                  <a:a name="DESC"
                     value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR Eth module."/>
                  <a:a name="UUID" value="ECUC:c21e2dd1-a743-4a06-9e67-8251d84af43d"/>
                    <v:lst name="EthCtrlConfig" type="MAP">
                        <a:da name="MIN" value="1"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="num:i(count(node:current()/*)) &lt;= num:i(../../EthGeneral/EthMaxCtrlsSupported)" false="Exceeded the maximum ETH Controllers defined in EthGeneral/EthMaxCtrlsSupported."/>
                        </a:da>
                        <!-- /** @implements EthCtrlConfig_Object */ -->
                        <v:ctr name="EthCtrlConfig" type="IDENTIFIABLE">
                          <a:a name="DESC"
                               value="EN: Configuration of the individual controller"/>
                            <a:a name="UUID" value="ECUC:dfc85eeb-1546-4ee7-a4a6-1a9e50057a97"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v mclass="Link">VariantLinkTime</icc:v>
                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <!-- /** @implements EthCtrlEnableMii_Object */ -->
                            <v:var name="EthCtrlEnableMii" type="BOOLEAN">
                                <a:a name="LABEL" value="EthCtrlEnableMii"/>
                                <a:a name="DESC"
                                     value="EN: Enables / Disables Media Independent Interface (MII) for transceiver access. This option is only available on master driver and for EMAC interfaces."/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:140b5eda-7fad-412d-a8c8-70a4c30722ac"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="EDITABLE" type="XPath" expr="(node:empty(../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode)='true' or ../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='false') and ../EthVendorSpecific/EthCtrlHwPort!='AUX' and ../EthVendorSpecific/EthCtrlHwPort!='HIF0' and ../EthVendorSpecific/EthCtrlHwPort!='HIF1' and ../EthVendorSpecific/EthCtrlHwPort!='HIF2' and ../EthVendorSpecific/EthCtrlHwPort!='HIF3' and ../EthVendorSpecific/EthCtrlHwPort!='HIF_NOCPY'"/>
                            </v:var>
                            <!-- /** @implements EthCtrlEnableRxInterrupt_Object */ -->
                            <v:var name="EthCtrlEnableRxInterrupt" type="BOOLEAN">
                                <a:a name="LABEL" value="EthCtrlEnableRxInterrupt"/>
                                <a:a name="DESC"
                                    value="EN: Enables / Disables receive interrupt"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:c46f8fc7-4d64-46c1-8951-67889206fa1f"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>
                            <!-- /** @implements EthCtrlEnableTxInterrupt_Object */ -->
                            <v:var name="EthCtrlEnableTxInterrupt" type="BOOLEAN">
                                <a:a name="LABEL" value="EthCtrlEnableTxInterrupt"/>
                                <a:a name="DESC"
                                    value="EN: Enables / Disables transmit interrupt"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:05d70535-57c3-4383-a77c-20283257fadc"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>
                            <v:ref name="EthCtrlEcucPartitionRef" type="REFERENCE">
                                <a:a name="DESC"
                                  value="EN: Maps the ETH driver to zero or multiple ECUC partitions to make the driver API available in the according partition. The Eth driver will operate as an independent instance in each of the partitions."/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                     type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                  <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                                  <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                  <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="UUID"
                                     value="ECUC:b883dcfa-2f16-443a-9a48-6d23d99c49f9"/>
                                <a:da name="REF"
                                      value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                            </v:ref>
                            <!-- /** @implements EthCtrlIdx_Object */ -->
                            <v:var name="EthCtrlIdx" type="INTEGER">
                                <a:a name="LABEL" value="EthCtrlIdx"/>
                                <a:a name="DESC">
                                    <a:v><![CDATA[EN:<html>
                                    Specifies the instance ID of the configured controller.
                                    </html>]]></a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:6835f380-518a-48b5-9b69-201150d0799f"/>
                                <a:da name="RANGE" type="XPath">
                                    <a:tst expr="text:uniq(node:fallback(../../*/EthCtrlIdx, text:split('1 2 3')), node:fallback(.,1))"
                                           false="Duplicated value. EthCtrlIdx must be unique for a configset"/>
                                    <a:tst expr="num:i(.) &lt; num:i(../../../../EthGeneral/EthMaxCtrlsSupported)"
                                           false="EthCtrlIdx must be less than supported controllers number configured in EthMaxCtrlsSupported." />
                                    <a:tst expr="num:i(.) &lt; num:i(count(../../*))"
                                           false="There must be no gap in EthCtrlIdx values and they must start from 0" />
                                </a:da>
                                <a:a name="WIDTH" value="3"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=255"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                                <a:da name="DEFAULT" value="0"/>
                            </v:var>

                            <!-- /** @implements EthCtrlMacLayerSpeed_Object */ -->
                            <v:var name="EthCtrlMacLayerSpeed" type="ENUMERATION">
                                <a:a name="LABEL" value="EthCtrlMacLayerSpeed"/>
                                <a:a name="DESC">
                                    <a:v><![CDATA[EN:<html>
                                    This bit = 0 & Port Select(Eth line speed) = 1 => Speed = 10Mbps.
                                    This bit = 0 & Port Select = 0 => Speed = 1Gbps.
                                    This bit = 1 & Port Select = 1 => Speed = 100Mbps.
                                    This bit = 1 & Port Select = 0 => Speed = 2.5Gbps.
                                    This option is only available on master driver and for EMAC interfaces.
                                    </html>]]></a:v>
                                </a:a>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                    <icc:v vclass="Link">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v mclass="Link">VariantLinkTime</icc:v>
                                    <icc:v mclass="Link">VariantPostBuild</icc:v>
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="UUID" value="ECUC:7fc4ca6f-a490-4a46-9268-1c7ffdb31d3c"/>
                                <a:da name="RANGE">
                                    <a:v>ETH_MAC_LAYER_SPEED_10M</a:v>
                                    <a:v>ETH_MAC_LAYER_SPEED_100M</a:v>
                                    <a:v>ETH_MAC_LAYER_SPEED_1G</a:v>
                                    <a:v>ETH_MAC_LAYER_SPEED_2500M</a:v>
                                </a:da>
                                <a:da name="DEFAULT" value="ETH_MAC_LAYER_SPEED_1G"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst
                                        expr=".='ETH_MAC_LAYER_SPEED_2500M' and ../EthCtrlMacLayerSubType!='SERIAL'"
                                        true="Link speeds of 2500M is supported only in SGMII mode."
                                    />
                                    <a:tst 
                                        expr="node:exists(.) and ../../../../EthGeneral/EthVendorSpecific/EthPfeMultiInstance='true' and ../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='true'" 
                                        true="Cannot configure MAC speed when the driver is configured in slave mode."
                                    />
                                    <a:tst 
                                        expr="node:exists(.) and ../EthVendorSpecific/EthCtrlHwPort!='EMAC0' and ../EthVendorSpecific/EthCtrlHwPort!='EMAC1' and ../EthVendorSpecific/EthCtrlHwPort!='EMAC2'" 
                                        true="Cannot configure MAC speed, EthCtrlHwPort is not an EMAC"
                                    />
                                </a:da>
                            </v:var>

                            <!-- /** @implements EthCtrlMacLayerSubType_Object */ -->
                            <v:var name="EthCtrlMacLayerSubType" type="ENUMERATION">
                                <a:a name="LABEL" value="EthCtrlMacLayerSubType"/>
                                <a:a name="DESC">
                                    <a:v><![CDATA[EN:<html>
                                    Defines the MAC layer subtype of ethernet controller.
                                    This option is only available on master driver and for EMAC interfaces.
                                    </html>]]></a:v>
                                </a:a>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                    <icc:v vclass="Link">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v mclass="Link">VariantLinkTime</icc:v>
                                    <icc:v mclass="Link">VariantPostBuild</icc:v>
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="UUID" value="ECUC:c8d08729-1f73-44dd-ab88-fbfd5eb92785"/>
                                <a:da name="RANGE">
                                    <a:v>REDUCED</a:v>
                                    <a:v>SERIAL</a:v>
                                    <a:v>STANDARD</a:v>
                                </a:da>
                                <a:da name="DEFAULT" value="REDUCED"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst 
                                        expr="node:exists(.) and ../../../../EthGeneral/EthVendorSpecific/EthPfeMultiInstance='true' and ../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='true'" 
                                        true="Cannot configure MAC subtype when the driver is configured in slave mode."
                                    />
                                    <a:tst 
                                        expr="node:exists(.) and ../EthVendorSpecific/EthCtrlHwPort!='EMAC0' and ../EthVendorSpecific/EthCtrlHwPort!='EMAC1' and ../EthVendorSpecific/EthCtrlHwPort!='EMAC2'" 
                                        true="Cannot configure MAC subtype, EthCtrlHwPort is not an EMAC"
                                    />
                                </a:da>
                            </v:var>
                            <!-- /** @implements EthCtrlMacLayerType_Object */ -->
                            <v:var name="EthCtrlMacLayerType" type="ENUMERATION">
                                <a:a name="LABEL" value="EthCtrlMacLayerType"/>
                                <a:a name="DESC">
                                    <a:v><![CDATA[EN:<html>
                                    Defines the MAC layer type of the ethernet controller.
                                    This option is only relevant on master driver and for EMAC interfaces, otherwise it is ignored.
                                    </html>]]></a:v>
                                </a:a>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="UUID" value="ECUC:235fbd08-c7cb-47b0-8a45-7efe857e1780"/>
                                <a:da name="RANGE">
                                    <a:v>ETH_MAC_LAYER_TYPE_XMII</a:v>
                                    <a:v>ETH_MAC_LAYER_TYPE_XGMII</a:v>
                                </a:da>
                                <a:da name="DEFAULT" value="ETH_MAC_LAYER_TYPE_XGMII"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and (node:empty(../EthCtrlMacLayerSpeed) = false()) and ((node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_2500M') or (node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_1G'))"
                                      true = "Link speeds of 1Gbps and 2500M are not supported in MII and RMII."/>
                                    <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and (node:empty(../EthCtrlMacLayerSubType) = false()) and ((node:value(../EthCtrlMacLayerSubType) = 'SERIAL'))"
                                      true = "SMII is not supported by the SoC."/>
                                    <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XGMII') and (node:empty(../EthCtrlMacLayerSubType) = false()) and ((node:value(../EthCtrlMacLayerSubType) = 'STANDARD'))"
                                      true = "GMII is not supported by the SoC."/>
                                </a:da>
                            </v:var>

                            <!-- /** @implements EthCtrlPhyAddress_Object */ -->
                            <v:var name="EthCtrlPhyAddress" type="STRING">
                              <a:a name="LABEL" value="EthCtrlPhyAddress"/>
                              <a:a name="DESC"
                                  value="EN: Specifies the unique 48-bit physical address (MAC address) of the controller in network byte order. Depending on EthCtrlPort option, the address is set to associated EMAC or to AUX interface."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                  type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="Link">VariantLinkTime</icc:v>
                                  <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="OPTIONAL" value="true"/>
                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                              <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:3144e974-3d55-447e-888b-f474cddb6067"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="text:match(., '^[0-9a-fA-F]{2}([:-][0-9a-fA-F]{2}){5}$')" false="Physical address has an invalid value."/>
                              </a:da>
                              <a:da name="DEFAULT" value="66:55:44:33:22:11"/>
                            </v:var>

                            <v:ctr name="EthCtrlConfigEgress" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="EthCtrlConfigEgress"/>
                                <a:a name="DESC">
                                <a:v><![CDATA[EN:<html>
                                    Controller Configuration Egress : Egress Controller configuration of the individual controller
                                </html>]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:41063528-855e-4a4e-a2a6-854283664388"/>
                                <v:ref name="EthCtrlConfigEgressLastSchedulerRef" type="REFERENCE">
                                  <a:a name="DESC"
                                       value="EN: Reference to the scheduler which is the last in the egress structure."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:fad695a0-fd08-4be4-b1b7-b7f47f5df8e8"/>
                                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigScheduler"/>
                                  <a:da name="INVALID" type="XPath">
                                      <a:tst expr="(node:exists(../EthCtrlConfigScheduler) = true()) and (node:refvalid(.) = false())" true="Invalid or empty reference."/>
                                  </a:da>
                                  <a:da name="EDITABLE" type="XPath" expr="(node:empty(../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode)='true' or ../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='false') and ../../EthVendorSpecific/EthCtrlHwPort!='AUX' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF0' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF1' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF2' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF3' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF_NOCPY'"/>
                                </v:ref>
                                <v:lst name="EthCtrlConfigEgressFifo" type="MAP">
                                    <a:da name="MIN" value="0"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="num:i(count(node:current()/*)) &gt; (num:i(8))" true="Maximum number of egress queues per controler is 8."/>
                                        <a:tst expr="num:i(count(node:current()/*)) &lt; (num:i(1))" true="At least one egress queue per controler needs to be defined."/>
                                    </a:da>

                                    <!-- /** @implements EthCtrlConfigEgressFifo_Object */ -->
                                    <v:ctr name="EthCtrlConfigEgressFifo" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="EthCtrlConfigEgressFifo"/>
                                        <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                            Controller Configuration Egress : Egress Controller configuration of the individual controller
                                        </html>]]></a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:76704b6a-fa43-4bd4-bf87-3e27b65af4ac"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                                  <icc:v mclass="Link">VariantLinkTime</icc:v>
                                                  <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                       <!-- /** @implements EthCtrlConfigEgressFifoBufLenByte_Object */ -->
                                        <v:var name="EthCtrlConfigEgressFifoBufLenByte" type="INTEGER">
                                            <a:a name="LABEL" value="EthCtrlConfigEgressFifoBufLenByte"/>
                                            <a:a name="DESC"
                                                 value="EN: Limits the maximum transmit buffer length (frame length) in bytes. The minimum value is 64 and maximum 1522. Maximal frame payload is equal to the configured value decreased by 14 bytes that are used for L2 header. Size of allocated buffers will be increased by 4 bytes for driver's internal metadata and aligned up to 8 bytes. This option does not apply for HIF_NOCPY interface, which uses BMU buffers."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:35608ff5-127a-4f09-b33c-921eb72c33df"/>
                                            <a:a name="WIDTH" value="4"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=1522"/>
                                                <a:tst expr="&gt;=64"/>
                                            </a:da>
                                            <a:da name="DEFAULT" value="1522"/>
                                            <a:da name="EDITABLE" type="XPath" expr="../../../../../../../EthGeneral/EthVendorSpecific/EthCommonHif != 'HIF_NOCPY'"/>
                                        </v:var>
                                        <!-- /** @implements EthCtrlConfigEgressFifoBufTotal_Object */ -->
                                        <v:var name="EthCtrlConfigEgressFifoBufTotal" type="INTEGER">
                                            <a:a name="LABEL" value="EthCtrlConfigEgressFifoBufTotal"/>
                                            <a:a name="DESC"
                                                value="EN: Number of transmit buffers. The minimum value is 2 and maximum 512"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:5ef4b8a3-f343-4af7-8f06-35bcaf3b01fa"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=512"/>
                                                <a:tst expr="&gt;=2"/>
                                            </a:da>
                                            <a:da name="DEFAULT" value="4"/>
                                        </v:var>
                                        <v:var name="EthCtrlConfigEgressFifoIdx" type="INTEGER">
                                            <a:a name="LABEL" value="EthCtrlConfigEgressFifoIdx"/>
                                            <a:a name="DESC"
                                                value="EN: Configures the number of transmit buffers."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:2c000b7b-e855-4d12-95ad-00d70e403049"/>
                                            <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index,'0')"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;255"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                            <a:a name="EDITABLE" value="false"/>

                                        </v:var>
                                        <v:ctr name="EthVendorSpecific" type="IDENTIFIABLE">
                                            <a:a name="LABEL" value="EthVendorSpecific"/>
                                            <a:a name="DESC">
                                            <a:v><![CDATA[EN:<html>
                                                Vendor specific: Vendor specific configuration of the individual controller
                                            </html>]]></a:v>
                                            </a:a>
                                            <a:a name="UUID" value="ECUC:5617319d-8823-4651-8846-8edfdf34f62d"/>
                                        </v:ctr>
                                        <v:lst name="EthCtrlConfigEgressFifoPriorityAssignment">
                                            <a:da name="MIN" value="0"/>
                                            <a:da name="MAX" value="7"/>
                                            <v:var name="EthCtrlConfigEgressFifoPriorityAssignment" type="INTEGER">
                                                <a:a name="LABEL" value="EthCtrlConfigEgressFifoPriorityAssignment"/>
                                                <a:a name="DESC"
                                                    value="EN: Message egress prority assignment."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                    type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v mclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                                <a:a name="UUID" value="ECUC:3fa2ffac-83dc-4df5-b9b7-7aa92c30929a"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=7"/>
                                                    <a:tst expr="&gt;=0"/>
                                                </a:da>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:a name="EDITABLE" value="true"/>
                                            </v:var>
                                        </v:lst>
                                    </v:ctr>
                                </v:lst>
                                <v:lst name="EthCtrlConfigScheduler" type="MAP">
                                    <a:da name="MIN" value="1"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="num:i(count(./*)) &gt; 2"
                                               true="The number of elements in this list must be less than or equal 2 (the number of Schedulers supported by this controller)."/>
                                    </a:da>
                                    <a:da name="ENABLE" type="XPath" expr="(node:empty(../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode)='true' or ../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='false') and ../../EthVendorSpecific/EthCtrlHwPort!='AUX' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF0' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF1' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF2' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF3' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF_NOCPY'"/>
                                    <v:ctr name="EthCtrlConfigScheduler" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="EthCtrlConfigScheduler"/>
                                        <a:a name="DESC" value="EN: Controller Configuration Scheduler: Represents a Scheduler on the egress side."/>
                                        <a:a name="UUID" value="ECUC:9b964652-518a-4eeb-8e0d-64ef7da6906f"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                        <v:lst name="EthCtrlConfigSchedulerPredecessor" type="MAP">
                                            <a:da name="MIN" value="1"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="num:i(count(./*)) &gt; 8"
                                                       true="Maximum number of inputs assigned to a single scheduler is 8."/>
                                                <a:tst expr="((node:value(../EthCtrlConfigSchedulerVendorSpecific/EthCtrlConfigSchedulerAlgorithm) = 'SCHED_ALGO_WRR') or
                                                              (node:value(../EthCtrlConfigSchedulerVendorSpecific/EthCtrlConfigSchedulerAlgorithm) = 'SCHED_ALGO_DWRR')) and (sum(./*/EthCtrlConfigSchedulerPredecessorVendorSpecific/EthTxSchedulerBandwidth) > 100)"
                                                       true="The sum of all bandwidth percentages of scheduler inputs must not exceed 100%"/>
                                            </a:da>
                                            <v:ctr name="EthCtrlConfigSchedulerPredecessor" type="IDENTIFIABLE">
                                                <a:a name="LABEL" value="EthCtrlConfigSchedulerPredecessor"/>
                                                <a:a name="DESC" value="EN: Controller Configuration Scheduler Predecessors: Defines an ordered list of predecessors for this scheduler."/>
                                                <a:a name="UUID" value="ECUC:5a22ab0c-8a9d-4538-90c7-a9eca05bbc81"/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v mclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                                <v:var name="EthCtrlConfigSchedulerPredecessorOrder" type="INTEGER">
                                                    <a:a name="LABEL" value="EthCtrlConfigSchedulerPredecessorOrder"/>
                                                    <a:a name="DESC"
                                                         value="EN: Defines the order of the scheduler predecessors."/>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:bb31ad22-25e5-4b7f-8d8d-ec2d83b54a4b"/>
                                                    <a:da name="DEFAULT" value="0"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=7"/>
                                                        <a:tst expr="&gt;=0"/>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst expr="text:uniq(../../*/EthCtrlConfigSchedulerPredecessorOrder, num:i(.))"
                                                               false="EthCtrlConfigSchedulerPredecessorOrder (or scheduler input index) must be unique across all EthCtrlConfigSchedulerPredecessor of each scheduler."/>
                                                    </a:da>
                                                </v:var>
                                                <v:ref name="EthCtrlConfigSchedulerPredecessorRef" type="CHOICE-REFERENCE">
                                                    <a:a name="LABEL" value="EthCtrlConfigSchedulerPredecessorRef"/>
                                                    <a:a name="DESC" value="EN: Choice reference to the scheduler predecessor."/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                    <a:a name="REF">
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigEgressFifo</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigScheduler</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigShaper</a:v>
                                                    </a:a>
                                                    <a:a name="UUID" value="ECUC:9eaa0401-cf37-42e7-bc99-30dccafab63c"/>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst expr="node:refvalid(.)"
                                                               false="Invalid or empty reference."/>
                                                        <a:tst expr="text:uniq(../../*/EthCtrlConfigSchedulerPredecessorRef, .)"
                                                               false="A Predecessor must be referenced at most once by a Scheduler in EthCtrlConfigSchedulerPredecessor (i.e. EthCtrlConfigSchedulerPredecessorRef must be unique within a Scheduler in EthCtrlConfigSchedulerPredecessor)."/>
                                                        <a:tst expr="text:uniq(../../../../*/EthCtrlConfigSchedulerPredecessor/*/EthCtrlConfigSchedulerPredecessorRef, .)"
                                                               false="A Predecessor must be referenced at most once by all Schedulers in EthCtrlConfigScheduler (i.e. EthCtrlConfigSchedulerPredecessorRef must be unique across all Schedulers in EthCtrlConfigScheduler)."/>
                                                        <a:tst expr="node:path(node:ref(.)) = node:path(../../..)"
                                                               true="A Scheduler cannot reference itself as a Predecessor."/>
                                                        <a:tst expr="node:path(node:ref(.)/../../..) != node:path(../../../../../..)"
                                                               true="EthCtrlConfigSchedulerPredecessorRef can only reference to (EthCtrlConfigEgressFifo/*) in it's controller range."/>
                                                    </a:da>
                                                </v:ref>
                                                <v:ctr name="EthCtrlConfigSchedulerPredecessorVendorSpecific" type="IDENTIFIABLE">
                                                    <a:a name="LABEL" value="EthCtrlConfigSchedulerPredecessorVendorSpecific"/>
                                                    <a:a name="DESC" value="EN: Scheduler Predecessor vendor specific configuration."/>
                                                    <a:a name="UUID" value="ECUC:a240e482-f8b4-4ccb-b0d1-85334567fe12"/>
                                                    <v:var name="EthCtrlConfigSchedulerBandwidth" type="INTEGER">
                                                        <a:a name="LABEL" value="EthCtrlConfigSchedulerBandwidth"/>
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:<html>
                                                            Represents the bandwidth percentage allocated for current scheduler input.<br />
                                                            In SCHED_ALGO_RR and SCHED_ALGO_PQ, this parameter is irrelevant.<br />
                                                            In SCHED_ALGO_WRR, weight for current scheduler input = (EthTxSchedulerBandwidth / 100) * EthTotalPacketsPerCycle.<br />
                                                            In SCHED_ALGO_DWRR, weight for current scheduler input = (EthTxSchedulerBandwidth / 100) * EthTotalQuantumPerCycle.<br />
                                                            This field is editable only when the scheduling algorithm is set to SCHED_ALGO_WRR or SCHED_ALGO_DWRR.
                                                            </html>]]></a:v>
                                                        </a:a>
                                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                             type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                        </a:a>
                                                        <a:a name="ORIGIN" value="NXP"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:0665580f-4039-4aef-875a-407788776644"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&lt;=100"/>
                                                            <a:tst expr="&gt;=1"/>
                                                        </a:da>
                                                        <a:da name="DEFAULT" value="10"/>
                                                        <a:da name="EDITABLE" type="XPath">
                                                            <a:tst expr="(../../../../EthCtrlConfigSchedulerVendorSpecific/EthCtrlConfigSchedulerAlgorithm = 'SCHED_ALGO_WRR') or
                                                                         (../../../../EthCtrlConfigSchedulerVendorSpecific/EthCtrlConfigSchedulerAlgorithm = 'SCHED_ALGO_DWRR')"/>
                                                        </a:da>
                                                    </v:var>
                                                </v:ctr>
                                            </v:ctr>
                                        </v:lst>
                                        <v:ctr name="EthCtrlConfigSchedulerVendorSpecific" type="IDENTIFIABLE">
                                            <a:a name="LABEL" value="EthCtrlConfigSchedulerVendorSpecific"/>
                                            <a:a name="DESC" value="EN: Scheduler vendor specific configuration."/>
                                            <a:a name="UUID" value="ECUC:a240e482-f8b4-4ccb-b0d1-853701546789"/>
                                            <v:var name="EthCtrlConfigSchedulerAlgorithm" type="ENUMERATION">
                                                <a:a name="LABEL" value="EthCtrlConfigSchedulerAlgorithm"/>
                                                <a:a name="DESC" value="EN: Configures the Tx Scheduler Algorithm."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:0665580f-4039-4aef-875a-407711d34d72"/>
                                                <a:da name="RANGE">
                                                    <a:v>SCHED_ALGO_RR</a:v>
                                                    <a:v>SCHED_ALGO_WRR</a:v>
                                                    <a:v>SCHED_ALGO_DWRR</a:v>
                                                    <a:v>SCHED_ALGO_PQ</a:v>
                                                </a:da>
                                                <a:da name="DEFAULT" value="SCHED_ALGO_RR"/>
                                            </v:var>
                                            <v:var name="EthCtrlConfigSchedulerRateMode" type="ENUMERATION">
                                                <a:a name="LABEL" value="EthCtrlConfigSchedulerRateMode"/>
                                                <a:a name="DESC" value="EN: Configures the Tx Scheduler rate mode."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:0665580f-4039-4aef-875a-407711d34d77"/>
                                                <a:da name="RANGE">
                                                    <a:v>RATE_MODE_DATA_RATE</a:v>
                                                    <a:v>RATE_MODE_PACKET_RATE</a:v>
                                                </a:da>
                                                <a:da name="DEFAULT" value="RATE_MODE_PACKET_RATE"/>
                                            </v:var>
                                            <v:var name="EthCtrlConfigTotalPacketsPerCycle" type="INTEGER">
                                                <a:a name="LABEL" value="EthCtrlConfigTotalPacketsPerCycle"/>
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:<html>
                                                    Configures the total weight value (in packets) per arbitration cycle from which individual scheduler input weights are calculated based on their allocated bandwidths.<br />
                                                    For example, if scheduler inputs (I2, I1, I0) are configured with bandwidths (50%, 25%, 25%) and EthCtrlConfigTotalPacketsPerCycle = 4 packets,
                                                    then the individual scheduler input weights are (4 * 0.5, 4 * 0.25, 4 * 0.25) = (2, 1, 1) packets.<br />
                                                    This field is editable only when the scheduler algorithm is set to SCHED_ALGO_WRR.
                                                    </html>]]></a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:0665580f-4039-4aef-875a-40151e259a75"/>
                                                <a:a name="EDITABLE" type="XPath" expr="../EthCtrlConfigSchedulerAlgorithm = 'SCHED_ALGO_WRR'"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=4294967295"/>
                                                    <a:tst expr="&gt;=1"/>
                                                </a:da>
                                                <a:da name="DEFAULT" value="1"/>
                                            </v:var>
                                            <v:var name="EthCtrlConfigTotalQuantumPerCycle" type="INTEGER">
                                                <a:a name="LABEL" value="EthCtrlConfigTotalQuantumPerCycle"/>
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:<html>
                                                    Configures the total quantum value (in bytes) per arbitration cycle from which individual scheduler input quantums are calculated based on their allocated bandwidths.<br />
                                                    For example, if scheduler input (I2, I1, I0) are configured with bandwidths (50%, 25%, 25%) and EthCtrlConfigTotalQuantumPerCycle = 2000 bytes,
                                                    then the individual scheduler input quantums are (2000 * 0.5, 2000 * 0.25, 2000 * 0.25) = (1000, 500, 500) bytes.<br />
                                                    This field is editable only when the scheduler algorithm is set to SCHED_ALGO_DWRR.
                                                    </html>]]></a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:0665580f-4039-4aef-875a-40151d137e70"/>
                                                <a:a name="EDITABLE" type="XPath" expr="../EthCtrlConfigSchedulerAlgorithm = 'SCHED_ALGO_DWRR'"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=4294967295"/>
                                                    <a:tst expr="&gt;=1"/>
                                                </a:da>
                                                <a:da name="DEFAULT" value="1000"/>
                                            </v:var>
                                        </v:ctr>
                                    </v:ctr>
                                </v:lst>
                                <v:lst name="EthCtrlConfigShaper" type="MAP">
                                    <a:da name="MIN" value="0"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="num:i(count(./*)) &gt; 4"
                                               true="The number of elements in this list must be less than or equal to the number of Shapers supported by this controller."/>
                                    </a:da>
                                    <a:da name="ENABLE" type="XPath" expr="(node:empty(../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode)='true' or ../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='false') and ../../EthVendorSpecific/EthCtrlHwPort!='AUX' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF0' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF1' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF2' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF2' and ../../EthVendorSpecific/EthCtrlHwPort!='HIF_NOCPY'"/>
                                    <v:ctr name="EthCtrlConfigShaper" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="EthCtrlConfigShaper"/>
                                        <a:a name="DESC" value="EN: Controller Configuration Shaper: Represents a Shaper at the egress side."/>
                                        <a:a name="UUID" value="ECUC:b07426cf-1de3-49fc-bd46-494b36b72510"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <v:var name="EthCtrlConfigShaperIdleSlope" type="INTEGER">
                                            <a:a name="LABEL" value="EthCtrlConfigShaperIdleSlope"/>
                                            <a:a name="DESC"
                                                 value="EN: Defines the increase of credit in bits per second for the AVB shaper."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:bfc0c576-ad6f-4caa-9206-3d2e18021787"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=2500000000"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="((num:i(.) > num:i(10000000 * 0.75)) and (../../../../EthCtrlMacLayerSpeed = 'ETH_MAC_LAYER_SPEED_10M')) or
                                                             ((num:i(.) > num:i(100000000 * 0.75)) and (../../../../EthCtrlMacLayerSpeed = 'ETH_MAC_LAYER_SPEED_100M')) or
                                                             ((num:i(.) > num:i(1000000000 * 0.75)) and (../../../../EthCtrlMacLayerSpeed = 'ETH_MAC_LAYER_SPEED_1G')) or
                                                             ((num:i(.) > num:i(2500000000 * 0.75)) and (../../../../EthCtrlMacLayerSpeed = 'ETH_MAC_LAYER_SPEED_2500M'))"
                                                       true="For AVB shaper, the idle slope must not exceed 75% of the current controller's total bandwidth (i.e EthCtrlConfigShaperIdleSlope &lt;= 0.75 * EthCtrlMacLayerSpeed)"/>
                                            </a:da>
                                        </v:var>
                                        <v:ref name="EthCtrlConfigShaperPredecessorFifoRef" type="REFERENCE">
                                            <a:a name="LABEL" value="EthCtrlConfigShaperPredecessorFifoRef"/>
                                            <a:a name="DESC" value="EN: Reference to the fifo which is the predecessor for this shaper."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:da name="REF"
                                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigEgressFifo"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="UUID" value="ECUC:b0f3cbbb-cae9-4f59-a29f-48e7e7acc053"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="node:refvalid(.)"
                                                       false="Invalid or empty reference."/>
                                                <a:tst expr="node:refvalid(.) and not(text:uniq(../../*/EthCtrlConfigShaperPredecessorFifoRef, .))"
                                                       true="A Predecessor (Egress FIFO) must be referenced at most once by all Shapers in EthCtrlConfigShaper (i.e. EthCtrlConfigShaperPredecessorFifoRef must be unique across all Shapers in EthCtrlConfigShaper)."/>
                                                <a:tst expr="node:refvalid(.) and (num:i(node:ref(.)/EthCtrlConfigEgressFifoIdx) = num:i(0))"
                                                       true="Queue 0 does not support shapers, because it is reserved for best-effort traffic. Please select a queue Qn > Q0."/>
                                                <a:tst expr="node:path(node:ref(.)/../../..) != node:path(../../../..)"
                                                       true="EthCtrlConfigSchedulerPredecessorRef can only reference to (EthCtrlConfigEgressFifo/*) in it's controller range."/>
                                            </a:da>
                                        </v:ref>
                                        <v:ctr name="EthCtrlConfigShaperVendorSpecific" type="IDENTIFIABLE">
                                            <a:a name="LABEL" value="EthCtrlConfigShaperVendorSpecific"/>
                                            <a:a name="DESC" value="EN: Shaper vendor specific configuration."/>
                                            <a:a name="UUID" value="ECUC:a240e482-f8b4-4ccb-b0d1-8537012345f6"/>
                                            <v:var name="EthCtrlConfigShaperIdx" type="INTEGER">
                                                <a:a name="LABEL" value="EthCtrlConfigShaperIdx"/>
                                                <a:a name="DESC" value="EN: Specifies the shaper index of the configured controller."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="ECU"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                <a:a name="UUID" value="ECUC:6835f380-518a-48b5-9b69-201150d079af"/>
                                                <a:da name="RANGE" type="XPath">
                                                    <a:tst expr="text:uniq(node:fallback(../../../*/EthCtrlConfigShaperVendorSpecific/EthCtrlShaperIdx, text:split('1 2 3')), node:fallback(.,1))"
                                                           false="EthCtrlConfigShaperIdx must be unique across all Shapers in EthCtrlConfigShaper"/>
                                                </a:da>
                                                <a:a name="WIDTH" value="4"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=3"/>
                                                    <a:tst expr="&gt;=0"/>
                                                </a:da>
                                                <a:da name="DEFAULT" value="0"/>
                                            </v:var>
                                            <v:var name="EthCtrlConfigShaperRateMode" type="ENUMERATION">
                                                <a:a name="LABEL" value="EthCtrlConfigShaperRateMode"/>
                                                <a:a name="DESC" value="EN: Configures the Shaper rate mode."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:0665580f-4039-4aef-875a-407711d34d78"/>
                                                <a:da name="RANGE">
                                                    <a:v>RATE_MODE_DATA_RATE</a:v>
                                                    <a:v>RATE_MODE_PACKET_RATE</a:v>
                                                </a:da>
                                                <a:da name="DEFAULT" value="RATE_MODE_PACKET_RATE"/>
                                            </v:var>
                                            <v:var name="EthCtrlConfigShaperMaxCredit" type="INTEGER">
                                                <a:a name="LABEL" value="EthCtrlConfigShaperMaxCredit"/>
                                                <a:a name="DESC" value="EN: Defines the maximum value (in bits) that can be accumulated in the credit parameter."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:10ef456f-1118-4b32-9424-8d556432723a"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=4194303"/>
                                                    <a:tst expr="&gt;=0"/>
                                                </a:da>
                                                <a:da name="DEFAULT" value="100"/>
                                            </v:var>
                                            <v:var name="EthCtrlConfigShaperMinCredit" type="INTEGER">
                                                <a:a name="LABEL" value="EthCtrlConfigShaperMinCredit"/>
                                                <a:a name="DESC" value="EN: Defines the minimum value (in bits) that can be accumulated in the credit parameter."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:10ef456f-1118-4b32-9424-8d776654440e"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=4194303"/>
                                                    <a:tst expr="&gt;=0"/>
                                                </a:da>
                                                <a:da name="DEFAULT" value="100"/>
                                            </v:var>
                                        </v:ctr>
                                    </v:ctr>
                                </v:lst>
                            </v:ctr>

                            <!-- /** @implements EthCtrlConfigIngress_Object */ -->
                            <v:ctr name="EthCtrlConfigIngress" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="EthCtrlConfigIngress"/>
                                    <a:a name="DESC">
                                    <a:v><![CDATA[EN:<html>
                                        Controller Configuration Ingress : Configuration of one Ethernet controler ingress behavior.
                                    </html>]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:1d0a0320-3b5f-4043-855c-0d04c45c4660"/>
                                <v:lst name="EthCtrlConfigIngressFifo" type="MAP">
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="num:i(count(node:current()/*)) &gt; (num:i(1))" true="Only one ingress queue per controler is currently supported."/>
                                        <a:tst expr="num:i(count(node:current()/*)) &lt; (num:i(1))" true="Only one ingress queue per controler is currently supported."/>
                                    </a:da>

                                    <!-- /** @implements EthCtrlConfigIngressFifo_Object */ -->
                                    <v:ctr name="EthCtrlConfigIngressFifo" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="EthCtrlConfigIngressFifo"/>
                                        <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                            Controller Configuration Ingress : Represents a Fifo at the ingress side.
                                        </html>]]></a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                                  <icc:v mclass="Link">VariantLinkTime</icc:v>
                                                  <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:da name="INVALID" type="XPath">
                                          <a:tst expr="text:uniq(../../../../*/EthCtrlConfigIngress/EthCtrlConfigIngressFifo/*/@name, @name)" false="Duplicate EthCtrlConfigIngressFifo names, Group Symbolic names must be unique across HWUnits."/>
                                        </a:da>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                        <a:a name="UUID" value="ECUC:cf8806a8-8b98-406a-8e07-08d697d4ef28"/>
                                         <!-- /** @implements EthCtrlConfigIngressFifoBufLenByte_Object */ -->
                                        <v:var name="EthCtrlConfigIngressFifoBufLenByte" type="INTEGER">
                                            <a:a name="LABEL" value="EthCtrlConfigIngressFifoBufLenByte"/>
                                            <a:a name="DESC"
                                                 value="EN: Only value 1522 is supported. Limits the maximum receive buffer length (frame length) in bytes. Maximum frame payload is equal to the configured value decreased by 14 bytes that are used for the frame header. Size of allocated buffers will be increased by 16 bytes for internal Rx header and aligned up to 8 bytes. Rx buffer size is configurable per HIF interface, so if this values for all controllers and their FIFOs are not the same, maximum of them will be used. This option does not apply for HIF_NOCPY interface, which uses BMU buffers."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:d74fd68c-2982-48ac-9282-2ddcf9a0354e"/>
                                            <a:a name="WIDTH" value="4"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=1522"/>
                                                <a:tst expr="&gt;=1522"/>
                                            </a:da>
                                            <a:da name="DEFAULT" value="1522"/>
                                            <a:da name="EDITABLE" value="false"/>
                                        </v:var>

                                        <!-- /** @implements EthCtrlConfigIngressFifoBufTotal_Object */ -->
                                        <v:var name="EthCtrlConfigIngressFifoBufTotal" type="INTEGER">
                                            <a:a name="LABEL" value="EthCtrlConfigIngressFifoBufTotal"/>
                                            <a:a name="DESC"
                                                 value="EN: Number of receive buffers. The minimum value is 2 and maximum 512. Rx buffers are used also for delivery of PTP timestamps from PFE, which should be considered when choosing this value. Since single HIF is used, all Rx buffers from all controllers/queues are put together into single buffer pool, which is extended by 4 buffers if 'Multiple PFE drivers support (master-slave)' option is enabled.
                                                 For HIF_NOCPY interface, only buffer descriptors are allocated based on this option, no buffers. Buffers from BMU2 are used instead (see option VarEthBmu2BufCnt).
                                                 For standard HIF, the total number of allocated buffers is automatically extended by 72 additional buffers for Errata ERR051211 workaround, unless disabled."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:a1475ecb-6fe7-4833-b253-d589bbebba00"/>
                                            <a:a name="WIDTH" value="3"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=512"/>
                                                <a:tst expr="&gt;=2"/>
                                            </a:da>
                                            <a:da name="DEFAULT" value="4"/>
                                        </v:var>
                                        <!-- /** @implements EthCtrlConfigIngressFifoIdx_Object */ -->
                                        <v:var name="EthCtrlConfigIngressFifoIdx" type="INTEGER">
                                            <a:a name="LABEL" value="EthCtrlConfigIngressFifoIdx"/>
                                            <a:a name="DESC"
                                                value="EN: Ingress Fifo index."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:ffdc5fce-1118-4b32-9424-8d5fdcaf9e3f"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=0"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="text:uniq(node:fallback(../../*/EthCtrlConfigIngressFifoIdx, text:split('0')), node:fallback(.,1))" false="Index Rx Fifo for the queues must unique in all configurations"/>
                                            </a:da>
                                            <a:da name="DEFAULT" value="0"/>
                                        </v:var>
                                        <v:lst name="EthCtrlConfigIngressFifoPriorityAssignment">
                                            <a:da name="MIN" value="0"/>
                                            <v:var name="EthCtrlConfigIngressFifoPriorityAssignment" type="INTEGER">
                                                <a:a name="LABEL" value="EthCtrlConfigIngressFifoPriorityAssignment"/>
                                                <a:a name="DESC"
                                                    value="EN: Message ingress prority assignment."/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                    type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v mclass="Link">VariantLinkTime</icc:v>
                                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                                <a:a name="UUID" value="ECUC:682c2e5b-b328-4f0c-bf99-874db059dc6d"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=7"/>
                                                    <a:tst expr="&gt;=0"/>
                                                </a:da>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:a name="EDITABLE" value="false"/>
                                             </v:var>

                                        </v:lst>
                                    </v:ctr>
                                </v:lst>
                            </v:ctr>

                            <!-- /** @implements EthDemEventParameterRefs_Object */ -->
                            <v:ctr name="EthDemEventParameterRefs" type="IDENTIFIABLE">
                                <a:a name="DESC"
                                    value="EN: Container for the references to DemEventParameter elements which shall be invoked using the API Dem_ReportErrorStatus in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter&apos;s DemEventId value. The standardized errors are provided in the container and can be extended by vendor specific error references."/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="EDITABLE" type="XPath" expr="../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                <a:a name="UUID" value="ECUC:b208b021-dc00-48aa-98d7-d669c2107244"/>
                                <a:da name="ENABLE" value="false"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <!-- /** @implements ETH_E_ACCESS_Object */ -->
                                <v:ref name="ETH_E_ACCESS" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Controller access failed&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:4e9232b1-a993-4d56-bcb2-33779454bb6c"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_ALIGNMENT_Object */ -->
                                <v:ref name="ETH_E_ALIGNMENT" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Alignment Error&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:8295f932-b1d9-4f68-b7c2-f51babe01cd8"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_CRC_Object */ -->
                                <v:ref name="ETH_E_CRC" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;CRC Failure&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:18549030-ea57-4aa7-a8a6-511a082d9990"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_LATECOLLISION_Object */ -->
                                <v:ref name="ETH_E_LATECOLLISION" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Late Collisions&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
