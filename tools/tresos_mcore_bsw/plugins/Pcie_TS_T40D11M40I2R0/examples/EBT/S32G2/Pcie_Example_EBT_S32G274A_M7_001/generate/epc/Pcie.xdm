                  </d:var>
                  <d:var name="PcieSendMsiXApi" type="BOOLEAN" value="true">
                    <a:a name="IMPORTER_INFO" value="@DEF"/>
                  </d:var>
                  <d:var name="PcieDmaLlReadSetupApi" type="BOOLEAN" 
