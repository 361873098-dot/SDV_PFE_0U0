                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:795357fe-0c55-449a-afd9-d7d0e4e02832">
                          <SHORT-NAME>EthCtrlEnableMii</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables / Disables Media Independent Interface (MII) for transceiver access</L-2>
                          </DESC>
                          <!-- @Calculated /Eth_43_PFE_TS_T40D11M14I0R0/Eth/EthGeneral/EthVendorSpecific/EthEMAC2Config/EthCtrlEnableMii: ENABLE(XPath: ../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!=&apos;EMAC2&apos;)-->
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <!-- @CalculatedEnd -->
