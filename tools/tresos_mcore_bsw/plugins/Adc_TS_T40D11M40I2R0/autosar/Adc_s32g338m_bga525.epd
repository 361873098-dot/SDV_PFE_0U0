                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:fe3316cb-3665-458f-98cd-7b4edfd71ff6">
                      <SHORT-NAME>AdcThresholdControl</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configure threshold detection feature for the selected channel.</L-2>
                      </DESC>
