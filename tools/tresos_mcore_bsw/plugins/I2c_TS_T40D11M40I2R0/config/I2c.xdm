<?xml version='1.0'?>
<datamodel version="3.0"
           xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
           xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
<!--
*   @file    I2c.xdm
*   @version 4.0.2
*
*   @brief   AUTOSAR I2c - Tresos Studio plugin schema file
*   @details This file contains the schema configuration for and I2c Tresos Studio plugin.
-->
<!--
====================================================================================================
*   Project              : RTD AUTOSAR 4.4
*   Platform             : CORTEXM
*   Peripheral           : IIC
*   Dependencies         : MCU,PORT,DET,RTE
*
*   Autosar Version      : 4.4.0
*   Autosar Revision     : ASR_REL_4_4_REV_0000
*   Autosar Conf.Variant :
*   SW Version           : 4.0.2
*   Build Version        : S32_RTD_4_0_2_D2306_ASR_REL_4_4_REV_0000_20230630

*   (c) Copyright 2020-2023 NXP Semiconductors
*   All Rights Reserved.
====================================================================================================
====================================================================================================
====================================================================================================
-->
    <d:ctr type="AUTOSAR" factory="autosar"
        xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
        xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
        xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
        <d:lst type="TOP-LEVEL-PACKAGES">
            <!-- /** @implements  I2c_Object */ -->
            <d:ctr name="TS_T40D11M40I2R0" type="AR-PACKAGE">
                <a:a name="UUID" value="ECUC:5fe16860-10a9-42e8-ba32-129de4bf6ac3"/>
                <d:lst type="ELEMENTS">
                    <d:chc name="I2c" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html>
                                        Configuration of the Inter-integrated circuit (I2c) module.
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LOWER-MULTIPLICITY" value="1" />
                            <a:a name="UPPER-MULTIPLICITY" value="1" />
                            <a:a name="RELEASE" value="asc:4.4"/>
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:LANGUAGE>EN</ad:LANGUAGE>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>4.0.2</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>NXP</ad:ISSUED-BY>
                                            <ad:DATE>2010-12-03</ad:DATE>
                                        </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                            <a:a name="UUID" value="ECUC:b510368b-ff12-4d58-aaad-a5e9c1cb3e3c"/>

                            <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                                <a:a name="DESC"
                                     value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="LABEL" value="Post Build Variant Used"/>
                                <a:a name="ORIGIN" value="EB"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="READONLY" value="false"/>
                                <a:da name="TOOLTIP"
                                    value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                            </v:var>

                            <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                <a:a name="LABEL" value="Config Variant"/>
                                <a:a name="UUID" value="ECUC:e2d81221-d902-4f85-bd93-578fada9dc41"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html>
                                            VariantPreCompile: Only precompile time configuration parameters. Only one set of parameters.<p/>
                                            VariantPostBuild: Mix of precompile and postbuild time configuration parameters. Only one set of parameters.<p/>
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:da name="DEFAULT" value="VariantPostBuild"/>
                                <a:da name="RANGE">
                                    <a:v>VariantPostBuild</a:v>
                                    <a:v>VariantPreCompile</a:v>
                                </a:da>
                            </v:var>

                            <!-- @implements GeneralConfiguration_Object -->
                            <v:ctr name="GeneralConfiguration" type="IDENTIFIABLE">
                              <a:a name="UUID" value="ECUC:f9793957-805b-400b-921f-acc6d3289e14"/>
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:
                                          <html>
                                              <p>GeneralConfiguration</p>
                                              <p>This container contains the global configuration parameters of the Non-Autosar I2c driver.</p>
                                              Note: Implementation Specific Parameter. <p/>
                                          </html>
                                      ]]>
                                  </a:v>
                                  </a:a>

                                  <!-- @implements I2cDevErrorDetect_Object -->
                                  <v:var name="I2cDevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="I2c Development Error Detection"/>
                                    <a:a name="DESC">
                                     <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>I2cDevErrorDetect</p>
                                                    <p>Switches the Development Error Detection and Notification ON or OFF.</p>
                                                    Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                     </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:7228a335-4003-4639-8e1a-bb3d9f762a74"/>
                                    <a:da name="DEFAULT" value="true"/>

                                  </v:var>


                                  <v:var name="I2cTimeoutMethod" type="ENUMERATION">
                                     <a:a name="LABEL" value="I2cTimeoutMethod"/>
                                     <a:a name="DESC">
                                         <a:v>
                                             <![CDATA[EN:
                                                 <html>
                                                     <p>Configures the timeout method.</p>
                                                     <p>Based on this selection a certain timeout method from OsIf will be used in the driver.</p>
                                                     <p>Note: If SystemTimer or CustomTimer are selected make sure the corresponding timer is enabled in OsIf General configuration. </p>
                                                     Note: Implementation Specific Parameter. <p/>
                                                 </html>
                                             ]]>
                                         </a:v>
                                     </a:a>
                                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                         <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                     </a:a>
                                     <a:a name="ORIGIN" value="NXP"/>
                                     <a:a name="SCOPE" value="LOCAL"/>
                                     <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                     <a:a name="UUID" value="ECUC:7228a335-4113-4636-8e1a-bb3d9450787b"/>
                                     <a:a name="DEFAULT" value="OSIF_COUNTER_DUMMY"/>
                                     <a:da name="INVALID" type="XPath">
                                         <a:tst expr="(node:refs('ASPathDataOfSchema:/TS_T40D11M40I2R0/BaseNXP/OsIfGeneral/OsIfUseCustomTimer') = 'false') and (node:value(.) = 'OSIF_COUNTER_CUSTOM')" true="Custom Timer is not enabled in OsIf (OsIfGeneral/OsIfUseCustomTimer checkbox)"/>
                                         <a:tst expr="(node:refs('ASPathDataOfSchema:/TS_T40D11M40I2R0/BaseNXP/OsIfGeneral/OsIfUseSystemTimer') = 'false') and (node:value(.) = 'OSIF_COUNTER_SYSTEM')" true="System Timer is not enabled in OsIf (OsIfGeneral/OsIfUseSystemTimer checkbox)"/>
                                     </a:da>
                                     <a:da name="RANGE">
                                         <a:v>OSIF_COUNTER_DUMMY</a:v>
                                         <a:v>OSIF_COUNTER_SYSTEM</a:v>
                                         <a:v>OSIF_COUNTER_CUSTOM</a:v>
                                     </a:da>
                                   </v:var>

                                  <v:var name="I2cDmaUsed" type="BOOLEAN">
                                      <a:a name="LABEL" value="I2c DMA Used"/>
                                      <a:a name="DESC">
                                      <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                <p>I2cDmaUsed</p>
                                                <p>Check this in order to be able to use DMA in the I2c driver.</p>
                                                <p>Leaving this unchecked will allow the I2c driver to compile with no dependencies from the Mcl driver.</p>
                                                Note: Implementation Specific Parameter. <p/>
                                            </html>
                                        ]]>
                                     </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:72a8a638-4009-4639-124a-bb4daf844a8c"/>
                                    <a:da name="DEFAULT" value="false"/>
                                  </v:var>

                                  <!-- @implements I2cDmaTransferErrorDetect_Object -->
                                  <v:var name="I2cDmaTransferErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="I2c Dma Transfer Error Detection"/>
                                    <a:a name="DESC">
                                     <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>I2cDmaTransferErrorDetect</p>
                                                    <p>Switches the Dma transfer error of the i2c module ON or OFF.</p>
                                                    Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                     </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:3f1df248-aefe-11eb-8529-0242ac130003"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="EDITABLE" type="XPath">
                                      <a:tst expr="(node:fallback(../I2cDmaUsed,'true') = 'true')"/>
                                    </a:a>
                                  </v:var>

                                  <v:var name="I2cDisableDemReportErrorStatus" type="BOOLEAN">
                                      <a:a name="LABEL" value="I2c Disable Production Error Reporting"/>
                                      <a:a name="DESC">
                                      <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                <p>I2cDisableDemReportErrorStatus</p>
                                                <p>Switches the Diagnostic Error Reporting and Notification OFF.</p>
                                                Note: Implementation Specific Parameter. <p/>
                                            </html>
                                        ]]>
                                     </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:72a8a638-4009-4639-124a-bb4daf863a8b"/>
                                    <a:da name="DEFAULT" value="false"/>
                                  </v:var>

                                  <v:var name="I2cMulticoreSupport" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                This parameter globally enables the possibility to support multicore.<p/>
                                                <p>If I2cMulticoreSupport is disabled, then for all the variants no partition shall be defined.</p>
                                                <p>If I2cMulticoreSupport is enabled, at least one EcucPartition needs to be defined (in all variants).</p>
                                                Note: Implementation Specific Parameter.<p/>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="I2c Multicore Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="ECUC:7b661377-99f4-4110-a16d-3141fabeaf3b" />
                                    <a:da name="DEFAULT" value="false" />
                                    <a:a name="EDITABLE" value="true"/>
                                    <a:a name="INVALID" type="XPath">
                                        <a:tst expr="(. = 'true') and not(num:i(count(../../I2cGlobalConfig/I2cEcucPartitionRef/*) > 0))"
                                            true="I2cMulticoreSupport is only enabled when at least one EcucPartition needs to be defined (in all variants)."/>
                                    </a:a>
                                  </v:var>
                                  <!-- @implements I2cEnableUserModeSupport_Object -->
                                  <v:var name="I2cEnableUserModeSupport" type="BOOLEAN">
                                    <a:a name="LABEL" value="I2c Enable User Mode Support"/>
                                    <a:a name="DESC">
                                      <a:v><![CDATA[EN:<html>
                                          When this parameter is enabled, the I2C module will adapt to run from User Mode, with the following measures:<p/>
                                          a) Configuring REG_PROT so that the registers under protection can be accessed from user mode
                                          by setting UAA bit in REG_PROT_GCR to 1 (only if applicable)<p/>
                                          b) Using 'trusted calls' stubs for all internal function calls that access registers requiring
                                          supervisor mode. (only if applicable)<p/>
                                          c) Other module specific measures.<p/>
                                          For additional details, please refer to chapter '5.6 User Mode Support' in the IM.<p/>
                                          Note: Implementation Specific Parameter.
                                          </html> ]]>
                                      </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:0dd697e3-9af6-4625-b4ed-c4215cb6e773"/>
                                    <a:da name="DEFAULT" value="false"/>
                                  </v:var>
                                  <!-- @implements I2cTimeoutDuration_Object -->
                                  <v:var name="I2cTimeoutDuration" type="INTEGER">
                                    <a:a name="LABEL" value="I2c Timeout Duration"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                Specifies the maximum number of loops for blocking function until a timeout is raised in short term wait loops <p/>
                                                Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:ea0e01de-6a8a-4466-841a-76cb28e5c197"/>
                                    <a:da name="DEFAULT" value="1000"/>
                                    <a:da name="INVALID" type="Range">
                                      <a:tst expr="&lt;=65535"/>
                                      <a:tst expr="&gt;=1"/>
                                    </a:da>
                                  </v:var>

                                  <!-- @implements I2cVersionInfoApi_Object -->
                                  <v:var name="I2cVersionInfoApi" type="BOOLEAN">
                                    <a:a name="LABEL" value="Provide I2c VersionInfo Api"/>
                                    <a:a name="DESC">
                                    <a:v>
                                     <![CDATA[EN:
                                        <html>
                                            <p>I2cVersionInfoApi</p>
                                            <p>Switches the I2c_GetVersionInfo function ON or OFF.</p>
                                            Note: Implementation Specific Parameter. <p/>
                                        </html>
                                     ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:be230747-6176-4d0b-61e3-290362e2d3ef"/>
                                    <a:da name="DEFAULT" value="true"/>
                                  </v:var>
                                  <v:var name="I2c_Callback" type="BOOLEAN">
                                    <a:a name="LABEL" value="I2c Callback Used"/>
                                    <a:a name="DESC">
                                      <a:v><![CDATA[EN:<html>
                                          Enable Callback function
                                          </html> ]]>
                                      </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:8e7c04de-ddf4-48dd-a4b4-5b87f0f40ac0"/>
                                    <a:da name="DEFAULT" value="false"/>
                                  </v:var>
                                  <!-- @implements I2cCallback_Object -->
                                  <v:var name="I2cCallback" type="FUNCTION-NAME">
                                  <a:a name="LABEL" value="I2c Callback"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html>
                                                  <p>I2c general callback. This function will be called for both master and slave events.</p>
                                                Note: Implementation Specific Parameter.
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:17291a1c-163b-4343-87d0-f3ed8536af6b"/>
                                    <a:a name="OPTIONAL" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:da name="DEFAULT" value="I2c_Callback"/>
                                    <a:a name="EDITABLE" type="XPath">
                                      <a:tst expr="(node:fallback(../I2c_Callback,'true') = 'true')"/>
                                    </a:a>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="((.='NULL') or (.='Null') or (.='false') or (.='FALSE') or (.='null') or (.='null_ptr') or (.='Null_Ptr'))" 
                                            true="Invalid identifier. Must be valid C function name or NULL_PTR (i.e. an arbitrarily long sequence of digits, underscores, lowercase and uppercase Latin letters, that must begin with a non-digit character)."/>
                                        <a:tst expr="(text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$'))"
                                            false="Invalid identifier. The field must specify a valid C function identifier (i.e. an arbitrarily long sequence of digits, underscores, lowercase and uppercase Latin letters, that must begin with a non-digit character)"/>
                                    </a:da>
                                  </v:var>
                                  <v:var name="I2c_ErrorCallback" type="BOOLEAN">
                                    <a:a name="LABEL" value="I2c Error Callback Used"/>
                                    <a:a name="DESC">
                                      <a:v><![CDATA[EN:<html>
                                          Enable Callback Error function
                                          </html> ]]>
                                      </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a87a0d8d-32e9-414a-bf2d-941c4af94dd7"/>
                                    <a:da name="DEFAULT" value="false"/>
                                  </v:var>
                                  <!-- @implements I2cErrorNotification_Object -->
                                  <v:var name="I2cErrorCallback" type="FUNCTION-NAME">
                                  <a:a name="LABEL" value="I2c Error Callback"/>
                                    <a:a name="DESC">
                                        <a:v>
                                             <![CDATA[EN:<html>
                                                  <p>I2c error callback. This function will be called for i2c error events.</p>
                                                Note: Implementation Specific Parameter.
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:8c7cba30-17c7-48bd-ae5f-9bde0363b814"/>
                                    <a:a name="OPTIONAL" value="false"/>
                                    <a:da name="DEFAULT" value="I2c_ErrorCallback"/>
                                    <a:a name="EDITABLE" type="XPath">
                                      <a:tst expr="(node:fallback(../I2c_ErrorCallback,'true') = 'true')"/>
                                    </a:a>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="((.='NULL') or (.='Null') or (.='false') or (.='FALSE') or (.='null') or (.='null_ptr') or (.='Null_Ptr'))" 
                                            true="Invalid identifier. Must be valid C function name or NULL_PTR (i.e. an arbitrarily long sequence of digits, underscores, lowercase and uppercase Latin letters, that must begin with a non-digit character)."/>
                                        <a:tst expr="(text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$'))"
                                            false="Invalid identifier. The field must specify a valid C function identifier (i.e. an arbitrarily long sequence of digits, underscores, lowercase and uppercase Latin letters, that must begin with a non-digit character)"/>
                                    </a:da>
                                  </v:var>
                            </v:ctr>

                            <!-- @implements I2cGlobalConfig_Object -->
                            <v:ctr name="I2cGlobalConfig" type="IDENTIFIABLE">
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          This container contains the global configuration parameter of the I2c driver. This container is a MultipleConfigurationContainer, i.e. this container and its sub-containers exit once per configuration set.
                                          </html>
                                      ]]>
                                  </a:v>
                              </a:a>
                              <a:a name="UUID" value="ECUC:ea3b8cf8-0ae5-5a24-ad07-1759472cf680"/>

                              <v:lst name="I2cEcucPartitionRef" type="">
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="not(num:i(count(./*) > 0)) and (../../GeneralConfiguration/I2cMulticoreSupport = 'true')
                                                 or (num:i(count(./*) > 0)) and (../../GeneralConfiguration/I2cMulticoreSupport = 'false')"
                                    true="Invalid identifier. This list must contain at least one item for generation the configuration structure if I2cMulticoreSupport is enabled,
                                                              and empty if I2cMulticoreSupport disabled."/>
                                </a:da>
                                <!-- @implements I2cEcucPartitionRef_Object -->
                                <v:ref name="I2cEcucPartitionRef" type="REFERENCE">
                                  <a:a name="DESC">
                                   <a:v>
                                      <![CDATA[EN:
                                          <html>
                                              Maps the I2C driver to zero or multiple ECUC partitions to make the
                                              modules API available in this partition. The I2C driver will operate as
                                              an independent instance in each of the partitions.<p/>
                                              Tags: atp.Status=draft<p/>
                                              Note: Implementation Specific Parameter.<p/>
                                          </html>
                                      ]]>
                                   </a:v>
                                  </a:a>
                                  <a:a name="LABEL" value="I2cEcucPartitionRef" />
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                  </a:a>
                                  <a:a name="ORIGIN" value="NXP"/>
                                  <a:a name="SCOPE" value="ECU"/>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="UUID" value="ECUC:ea6ef896-5acf-47b9-8b3c-b8f2129f6cf2"/>
                                  <a:a name="INVALID" type="XPath">
                                    <a:tst expr="node:empty(.)"
                                           true="Field is empty (Suggestion: Select an EcucPartition reference)."/>
                                    <a:tst expr="not(node:refvalid(.))"
                                           true="Invalid EcucPartition reference (Suggestion: Select an EcucPartition reference)."/>
                                    <a:tst expr="text:uniq(node:fallback(../*,''),node:fallback( ., '' ))"
                                           false ="The partition must be unique in I2cEcucPartitionRef list."/>
                                    <a:tst expr="node:containsValue(as:modconf('I2c')/I2cGlobalConfig/I2cChannel/*/I2cChannelEcucPartitionRef, node:value(.))"
                                           false ="The partition referred in I2cEcucPartitionRef is not used by any I2cChannelEcucPartitionRef."/>
                                    <a:tst expr="node:containsValue(as:modconf('Os')[1]/OsApplication/*/OsAppEcucPartitionRef, node:value(.))"
                                           false="The partition referred isn't used by any Os/OsApplication/*/OsAppEcucPartitionRef"/>
                                  </a:a>
                                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                </v:ref>
                              </v:lst>

                              <!-- @implements I2cChannel_Object -->
                              <v:lst name="I2cChannel" type="MAP">
                                <a:da name="MIN" value="1"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="num:i(count(node:current()/*)) &gt; ecu:get(&apos;I2c.I2cGlobalConfig.I2cChannel&apos;)"
                                           true="Maximum available I2c HW channels was exceeded."/>
                                </a:da>
                                <v:ctr name="I2cChannel" type="IDENTIFIABLE">
                                  <a:a name="DESC">
                                      <a:v>
                                          <![CDATA[EN:
                                              <html>
                                              This container contains the configuration (parameters) of the I2c Controller(s).
                                              <h1>Note:</h1>"User should use unique names for naming the I2c channels across different I2cGlobalConfig Sets."
                                              </html>
                                          ]]>
                                      </a:v>
                                  </a:a>
                                  <a:a name="UUID" value="ECUC:9f1209fb-5482-4e6b-bf29-8231b2a8da2d"/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                  </a:a>

                                  <!-- @implements I2cChannelId_Object -->
                                  <v:var name="I2cChannelId" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                Identifies the I2c channel. <p/>
                                                Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="I2c Channel ID" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                                    <a:a name="UUID"
                                         value="ECUC:aac952ef-7cb7-4b94-acc5-b6c4ca835e7a"/>
                                    <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0"/>
                                        <a:tst expr="&lt;(ecu:get(&apos;I2c.I2cGlobalConfig.I2cChannel&apos;))"/>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(. &gt;= 0) and (.&lt; num:i(count(node:current()/../../*)))"
                                               false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the 'Calculate Value' button to calculate correct default value."/>
                                        <a:tst expr="text:uniq(../../*/I2cChannelId, .)"
                                               false="Duplicated value: I2cChannelId must be unique across all I2c channels. Use the 'Calculate Value' button to calculate correct default value."/>
                                        <a:tst expr="(node:fallback( ., 0) &gt;= ecu:get(&apos;I2c.I2cGlobalConfig.I2cChannel&apos;))"
                                                true="Exceeded the maximum I2c channels supported by this particular derivative. Please refer to the reference manual for additional information."/>
                                        <a:tst expr="num:i(node:fallback(.,0)) = num:i(../@index)"
                                               false="Invalid value: The ID should correspond to the position of the element within the configuration list."/>
                                    </a:da>
                                  </v:var>

                                  <v:var name="I2cHwChannel" type="ENUMERATION">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                Selects the physical I2c Channel. <p/>
                                                Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="I2C Hardware Channel" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID"
                                         value="ECUC:38348b20-3249-431a-ab13-8afb524661cd"/>
                                    <a:da name="DEFAULT" type="XPath" expr="(ecu:list(&apos;I2c.I2cGlobalConfig.I2cChannel.I2cHwChannel&apos;))[position()-1=node:fallback( node:current()/../@index, '0')]">
                                    </a:da>
                                     <a:da name="INVALID" type="XPath">
                                      <a:tst expr="text:uniq(node:fallback(../../*/I2cHwChannel, 0 ), node:fallback( ., 1 ))"
                                             false="Duplicate physical I2c channel: I2cHwChannel must be unique across all I2c channels. Use the 'Calculate Value' button to calculate correct default value."/>
                                      <a:tst expr="(
                                                        (node:fallback(../I2cMasterSlaveConfiguration,'MASTER_MODE') = 'MASTER_MODE') or
                                                        (node:fallback(../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     ) and not(node:exists(../I2cMasterConfiguration/I2cClockRef))"
                                                true="An McuClockReferencePoint reference for IIC must be configured. Refer to I2cChannel_x/I2cMasterConfiguration/I2cClockRef"/>
                                    </a:da>
                                    <a:da name="RANGE" type="XPath"
                                          expr="ecu:list(&apos;I2c.I2cGlobalConfig.I2cChannel.I2cHwChannel&apos;)"/>
                                  </v:var>

                                  <v:var name="I2cMasterSlaveConfiguration" type="ENUMERATION">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                Selects the master slave configuration. <p/>
                                                  Select whether the selected channel will be used as Master, Slave or both. <p/>
                                                Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="I2c Master/Slave configuration" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:2121e93b-3d41-4334-bcb4-6b273af183fc"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:da name="DEFAULT" value="MASTER_MODE"/>
                                    <a:da name="RANGE">
                                        <a:v>MASTER_MODE</a:v>
                                        <a:v>SLAVE_MODE</a:v>
                                    </a:da>
                                  </v:var>

                                  <!-- @implements I2cChannelEcucPartitionRef_Object -->
                                  <v:ref name="I2cChannelEcucPartitionRef" type="REFERENCE">
                                    <a:a name="DESC">
                                     <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                Maps one single I2C channel to zero or one ECUC partitions.
                                                The ECUC partition referenced is a subset of the ECUC partitions
                                                where the I2C driver is mapped to.<p/>
                                                Tags: atp.Status=draft<p/>
                                                Note: Implementation Specific Parameter.<p/>
                                            </html>
                                        ]]>
                                     </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="I2C Channel Partition Reference" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                      <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                    <a:a name="UUID" value="ECUC:f8d45bee-2afd-48db-a0ef-f5bcd347cd8b"/>
                                    <a:a name="INVALID" type="XPath">
                                      <a:tst expr="node:empty(.)"
                                             true="Field is empty (Suggestion: Select an EcucPartition reference)."/>
                                      <a:tst expr="not(node:refvalid(.))"
                                             true="Invalid EcucPartition reference (Suggestion: Select an EcucPartition reference)."/>
                                      <a:tst expr="node:containsValue(../../../I2cEcucPartitionRef/*, node:value(.))"
                                             false="The ECUC partition referenced by I2cChannelEcucPartitionRef shall be a subset of of the ECUC partitions referenced by I2cEcucPartitionRef."/>
                                    </a:a>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                  </v:ref>

                                  <v:ctr name="I2cMasterConfiguration" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                This container contains the configuration (parameters) of the Master Configuration.
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:fdac1ad9-1317-44a8-bc4f-341635a10162"/>
                                    <a:a name="LABEL" value="Master Configuration"/>

                            <!-- @implements I2cClockRef_Object -->
                                    <v:ref name="I2cClockRef" type="REFERENCE">
                                      <a:a name="DESC">
                                          <a:v>
                                              <![CDATA[EN:
                                               <html>
                                                  <p>Reference to the I2c clock source configuration, which is set in the MCU driver configuration.</p>
                                                  Note: Implementation Specific Parameter. <p/>
                                              </html>
                                              ]]>
                                          </a:v>
                                      </a:a>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="OPTIONAL" value="true"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="UUID" value="ECUC:5419eaab-b72b-4ee1-9e89-22e203491b61"/>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:a name="INVALID" type="XPath">
                                        <a:tst expr="(
                                                          (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                          (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     ) and node:empty(.)"
                                                     true="Field is empty (Suggestion: select an McuClockReferencePoint reference)."/>
                                        <a:tst expr="(
                                                          (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                          (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     ) and not(node:refvalid(.))"
                                                     true="Invalid McuClockReferencePoint reference (Suggestion: select an McuClockReferencePoint reference)."/>
                                      </a:a>
                                      <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint"/>
                                    </v:ref>

                                    <!-- @implements I2cAsyncMethod_Object -->
                                    <v:var name="I2cAsyncMethod" type="ENUMERATION">
                                      <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:
                                               <html>
                                                 <p>This configures IIC_IBCR[DMAEN].</p>
                                                 <p>Configures the asynchronous mechanism used by the 'AsyncTransmit' function (interrupts or DMA).</p>
                                                 Note: Implementation Specific Parameter. <p/>
                                               </html>
                                          ]]>
                                       </a:v>
                                      </a:a>
                                      <a:a name="LABEL" value="I2c Asynchronous Method" />
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>

                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="UUID" value="ECUC:240b6eec-0e3a-4030-9533-5cc2db9bec01"/>
                                      <a:da name="DEFAULT" value="I2C_USING_INTERRUPTS"/>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:da name="RANGE">
                                          <a:v>I2C_USING_INTERRUPTS</a:v>
                                          <a:v>I2C_USING_DMA</a:v>
                                      </a:da>
                                      <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(
                                                        (
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                        ) and
                                                        (node:fallback(.,'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA') and
                                                        (node:fallback(../../../../../GeneralConfiguration/I2cDmaUsed,'false') = 'false')
                                                     )"
                                                     true="The I2cDmaUsed checkbox in GeneralConfiguration must be checked in order to use DMA as an asynchronous method."/>
                                        <a:tst expr="(
                                                        (
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                        ) and
                                                        (node:fallback(.,'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA') and
                                                        ((not(node:exists(../I2cTxDmaChannel))) or (not(node:exists(../I2cTxDmaChannel))))
                                                     )"
                                                     true="A DMA transmission channel reference must be configured. Refer to I2cMasterConfiguration/I2cDmaChannel."/>
                                      </a:da>
                                    </v:var>

                                    <v:var name="I2cMasterGlitchFilter" type="BOOLEAN">
                                      <a:a name="LABEL" value="Glitch Filter Enable"/>
                                      <a:a name="DESC">
                                      <a:v>
                                       <![CDATA[EN:
                                          <html>
                                              <p>I2cMasterGlitchFilter</p>
                                              <p>Switches the glitch filter function ON or OFF.</p>
                                              Note: Implementation Specific Parameter. <p/>
                                          </html>
                                       ]]>
                                      </a:v>
                                      </a:a>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="UUID" value="ECUC:be270747-6276-4d0b-62e3-290362a2d3ef"/>
                                      <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    <v:ref name="I2cTxDmaChannel" type="REFERENCE">
                                      <a:a name="DESC">
                                          <a:v>
                                            <![CDATA[EN:
                                             <html>
                                                <p>Reference to the TX DMA channel, which is set in the Mcl driver configuration.</p>
                                                Note: Implementation Specific Parameter. <p/>
                                            </html>
                                            ]]>
                                        </a:v>
                                      </a:a>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="OPTIONAL" value="true"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="LABEL" value="I2c Tx DMA Channel"/>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="UUID" value="ECUC:5419eaab-b73b-4ee2-9e88-22e201491b61"/>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     ) and (node:fallback(../I2cAsyncMethod, 'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA')
                                                     "/>
                                      </a:a>
                                      <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(
                                                        (
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                        ) and
                                                        (node:fallback(../I2cAsyncMethod,'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA') and
                                                        (node:empty(.))
                                                     )"
                                               true="Field is empty (Suggestion: select a DMAChannel reference)."/>
                                        <a:tst expr="(
                                                        (
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                        ) and
                                                        (node:fallback(../I2cAsyncMethod,'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA') and
                                                        (not(node:refvalid(.)))
                                                     )"
                                               true="Invalid Tx DMAChannel reference (Suggestion: select a DMAChannel reference)."/>
                                      </a:da>
                                      <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcl/MclConfig/dmaLogicChannel_Type"/>
                                    </v:ref>
                                    <v:ref name="I2cRxDmaChannel" type="REFERENCE">
                                      <a:a name="DESC">
                                          <a:v>
                                            <![CDATA[EN:
                                             <html>
                                                <p>Reference to the RX DMA channel, which is set in the Mcl driver configuration.</p>
                                                Note: Implementation Specific Parameter. <p/>
                                            </html>
                                            ]]>
                                        </a:v>
                                      </a:a>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="OPTIONAL" value="true"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="LABEL" value="I2c Rx DMA Channel"/>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="UUID" value="ECUC:5411eaab-b79b-4ee2-9e88-27e201491b61"/>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     ) and (node:fallback(../I2cAsyncMethod, 'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA')
                                                     "/>
                                      </a:a>
                                      <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(
                                                        (
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                        ) and
                                                        (node:fallback(../I2cAsyncMethod,'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA') and
                                                        (node:empty(.))
                                                     )"
                                               true="Field is empty (Suggestion: select a DMAChannel reference)."/>
                                        <a:tst expr="(
                                                        (
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                        ) and
                                                        (node:fallback(../I2cAsyncMethod,'I2C_USING_INTERRUPTS') = 'I2C_USING_DMA') and
                                                        (not(node:refvalid(.)))
                                                     )"
                                               true="Invalid Rx DMAChannel reference (Suggestion: select a DMAChannel reference)."/>
                                      </a:da>
                                      <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcl/MclConfig/dmaLogicChannel_Type"/>
                                    </v:ref>

                            <v:var name="I2cIbcValue" type="INTEGER">
                                      <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:
                                               <html>
                                                 <p>Configures IIC_IBFD</p>
                                                 <p>Configures the I-BUS Clock Rate for I2c Driver.</p>
                                                 Note: Implementation Specific Parameter. <p/>
                                               </html>
                                          ]]>
                                       </a:v>
                                      </a:a>
                                      <a:a name="LABEL" value="I2c IBC Register Value" />
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="UUID" value="ECUC:240b5eec-0e3a-4030-9533-5cc2db9beb07"/>
                                      <a:da name="DEFAULT" value="0"/>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0"/>
                                        <a:tst expr="&lt;=num:i(ecu:list('I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cBaudRateParam.max'))"/>
                                      </a:da>
                                    </v:var>

                                    <v:var name="I2cSCLDivider" type="INTEGER">
                                      <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:
                                               <html>
                                                   <p>SCL Divider: Calculated from the IBC value and based on the I2C divider and hold values table in the Reference manual.</p>
                                                   <p>The calculated SCL Divider value should coincide (be equal to) with MCU_Bus_Frequency / SCL_Clock_Frequency</p>
                                                   <p>In other words, 1 SCL Cycle = 'I2cSCLDivider' Bus Clock Cycles</p>
                                                   <p>When multiplied with the bus clock period (i.e. 1 / 'I2cClockRef/McuClockReferencePointFrequency'), it gives the amount of time to transfer a bit.</p>
                                                 Note: Implementation Specific Parameter. <p/>
                                               </html>
                                          ]]>
                                       </a:v>
                                      </a:a>
                                      <a:a name="LABEL" value="I2c SCL Divider (cycles)" />
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>

                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="UUID" value="ECUC:3101c48d-3a53-4fac-ae0f-efe91312255f"/>
                                      <a:da name="DEFAULT" type="XPath">
                                          <a:tst expr="num:i
                                                            (
                                                              text:split
                                                              (
                                                                ecu:list
                                                                (
                                                                   concat
                                                                   (
                                                                     'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.',node:fallback('->node:value(../I2cMasterGlitchFilter)','true')
                                                                   )
                                                                )[num:i(node:fallback('->node:value(node:current()/../I2cIbcValue)',1)) + 1]
                                                              , '_'
                                                              )[2]
                                                            )" />
                                      </a:da>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:da name="INVALID" type="Range">
                                          <a:tst expr="&lt;=4294967295"/>
                                          <a:tst expr="&gt;=0"/>
                                      </a:da>
                                      <a:da name="INVALID" type="XPath">
                                      
                                        <a:tst expr="num:i(node:fallback(.,7)) !=num:i
                                                                                    (
                                                                                      text:split
                                                                                       (
                                                                                         ecu:list
                                                                                           (
                                                                                             concat
                                                                                               (
                                                                                                 'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.', ../I2cMasterGlitchFilter
                                                                                                )
                                                                                            )[num:i(node:current()/../I2cIbcValue) + 1]
                                                                                        , '_'
                                                                                        )[2]
                                                                                   )"
                                        true="Please press the 'Calculate Value' button in order to calculate the value automatically."/>
                                      </a:da>
                                    </v:var>

                                    <v:var name="I2cSDAHoldDelay" type="INTEGER">
                                      <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:
                                               <html>
                                                   <p>SDA Hold: Calculated from the IBC value and based on the I2C divider and hold values table in the Reference manual.</p>
                                                   <p>When multiplied with the bus clock period (i.e. 1 / 'I2cClockRef/McuClockReferencePointFrequency'):</p>
                                                   <ul>
                                                     <li>It corresponds with the t<sub>HD;DAT</sub> symbol (data hold time) from the I2c specification.</li>
                                                     <li>It gives the amount of time after the falling edge of the SCL that the data will remain valid.</li>
                                                   </ul>
                                                 Note: Implementation Specific Parameter. <p/>
                                               </html>
                                          ]]>
                                       </a:v>
                                      </a:a>
                                      <a:a name="LABEL" value="I2c SDA Hold Delay (cycles)" />
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="UUID" value="ECUC:02af9d3b-c106-4715-9062-814c66309262"/>
                                      <a:da name="DEFAULT" type="XPath">
                                            <a:tst expr="num:i(
                                                                text:split
                                                                  (
                                                                    ecu:list
                                                                      (
                                                                        concat
                                                                          (
                                                                            'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.',node:fallback('->node:value(../I2cMasterGlitchFilter)','true')
                                                                          )
                                                                      )[num:i(node:fallback('->node:value(node:current()/../I2cIbcValue)',1)) + 1]
                                                                  , '_'
                                                                  )[3]
                                                            )" />
                                      </a:da>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:da name="INVALID" type="Range">
                                          <a:tst expr="&lt;=4294967295"/>
                                          <a:tst expr="&gt;=0"/>
                                      </a:da>
                                      <a:da name="INVALID" type="XPath">
                                        <a:tst expr="num:i(node:value(.)) != num:i(
                                                                                    text:split
                                                                                      (
                                                                                        ecu:list
                                                                                          (
                                                                                            concat
                                                                                              (
                                                                                                'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.', ../I2cMasterGlitchFilter
                                                                                              )
                                                                                           )[num:i(node:current()/../I2cIbcValue) + 1]
                                                                                       , '_'
                                                                                       )[3]
                                                                                   )"
                                        true="Please press the 'Calculate Value' button in order to calculate the value automatically."/>
                                      </a:da>
                                      <a:da name="WARNING" type="XPath">
                                          <a:tst expr="(
                                                         (num:f(node:fallback(.,2052.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &gt; 0.00000345
                                                       ) and
                                                       (
                                                         num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 100000.0
                                                       )"
                                                 true="The bit (baud) rate corresponds to I2c Standard-Mode and the data hold time (tHD;DAT) is greater than 3.45 &#181;s. Please consult the I2c specification."/>
                                          <a:tst expr="(
                                                         (num:f(node:fallback(.,2052.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &gt; 0.0000009
                                                       ) and
                                                       (
                                                         (num:f(node:fallback(../I2cBaudRate, 0.0)) &gt; 100000.0) and (num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 400000.0)
                                                       )"
                                                 true="The bit (baud) rate corresponds to I2c Fast-Mode and the data hold time (tHD;DAT) is greater than 0.9 &#181;s. Please consult the I2c specification."/>
                                          <a:tst expr="(
                                                         (num:f(node:fallback(.,2052.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &gt; 0.0000009
                                                       ) and
                                                       (
                                                         (num:f(node:fallback(../I2cBaudRate, 0.0)) &gt; 400000.0) and (num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 1000000.0)
                                                       )"
                                                 true="The bit (baud) rate corresponds to I2c Fast-Mode Plus and the data hold time (tHD;DAT) is greater than 0.9 &#181;s. Please consult the I2c specification."/>
                                      </a:da>
                                    </v:var>

                                    <v:var name="I2cSCLHoldStart" type="INTEGER">
                                      <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:
                                               <html>
                                                   <p>SCL Hold (start): Calculated from the IBC value and based on the I2C divider and hold values table in the Reference manual.</p>
                                                   <p>When multiplied with the bus clock period (i.e. 1 / 'I2cClockRef/McuClockReferencePointFrequency'):</p>
                                                   <ul>
                                                     <li>It corresponds with the t<sub>HD;STA</sub> symbol (hold time for [repeated] START condition) from the I2c specification.</li>
                                                     <li>It gives the delay from the falling edge of SDA to the falling edge of SCL during a (repeated) START condition.</li>
                                                   </ul>
                                                 Note: Implementation Specific Parameter. <p/>
                                               </html>
                                          ]]>
                                       </a:v>
                                      </a:a>
                                      <a:a name="LABEL" value="I2c Hold Start Delay (cycles)" />
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="UUID" value="ECUC:0b6dbe56-ece8-4c06-8eef-c17f49a6c79e"/>
                                      <a:da name="DEFAULT" type="XPath">
                                     <a:tst expr="num:i(
                                                                text:split
                                                                  (
                                                                    ecu:list
                                                                      (
                                                                        concat
                                                                          (
                                                                            'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.',node:fallback('->node:value(../I2cMasterGlitchFilter)','true')
                                                                           )
                                                                      )[num:i(node:fallback('->node:value(node:current()/../I2cIbcValue)',1)) + 1]
                                                                  , '_'
                                                                  )[4]
                                                            )" />
                                      </a:da>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:da name="INVALID" type="Range">
                                          <a:tst expr="&lt;=4294967295"/>
                                          <a:tst expr="&gt;=0"/>
                                      </a:da>
                                      <a:da name="INVALID" type="XPath">
                                        <a:tst expr="num:i(node:value(.)) != num:i(
                                                                                    text:split
                                                                                      (
                                                                                        ecu:list
                                                                                          (
                                                                                            concat
                                                                                              (
                                                                                                'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.', ../I2cMasterGlitchFilter
                                                                                               )
                                                                                           )[num:i(node:current()/../I2cIbcValue) + 1]
                                                                                       , '_'
                                                                                       )[4]
                                                                                   )"
                                        true="Please press the 'Calculate Value' button in order to calculate the value automatically."/>
                                      </a:da>
                                      <a:da name="WARNING" type="XPath">
                                        <a:tst expr="(
                                                       (num:f(node:fallback(.,7672.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &lt; 0.000004
                                                     ) and
                                                     (
                                                       num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 100000.0
                                                     )"
                                               true="The bit (baud) rate corresponds to I2c Standard-Mode and the hold time for [repeated] START condition (tHD;STA) is less than 4.0 &#181;s. Please consult the I2c specification."/>
                                        <a:tst expr="(
                                                       (num:f(node:fallback(.,7672.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &lt; 0.0000006
                                                     ) and
                                                     (
                                                       (num:f(node:fallback(../I2cBaudRate, 0.0)) &gt; 100000.0) and (num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 400000.0)
                                                     )"
                                               true="The bit (baud) rate corresponds to I2c Fast-Mode and the hold time for [repeated] START condition (tHD;STA) is less than 0.6 &#181;s. Please consult the I2c specification."/>
                                        <a:tst expr="(
                                                       (num:f(node:fallback(.,7672.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &lt; 0.00000026
                                                     ) and
                                                     (
                                                       (num:f(node:fallback(../I2cBaudRate, 0.0)) &gt; 400000.0) and (num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 1000000.0)
                                                     )"
                                               true="The bit (baud) rate corresponds to I2c Fast-Mode Plus and the hold time for [repeated] START condition (tHD;STA) is less than 0.26 &#181;s. Please consult the I2c specification."/>
                                      </a:da>
                                    </v:var>

                                    <v:var name="I2cSCLHoldStop" type="INTEGER">
                                      <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:
                                               <html>
                                                   <p>SCL Hold (stop):Calculated from the IBC value and based on the I2C divider and hold values table in the Reference manual.</p>
                                                   <p>When multiplied with the bus clock period (i.e. 1 / 'I2cClockRef/McuClockReferencePointFrequency'):</p>
                                                   <ul>
                                                     <li>It corresponds with the t<sub>SU:STO</sub> symbol (set-up time for STOP condition) from the I2c specification.</li>
                                                     <li>It gives the delay from the rising edge of SCL to the rising edge of SDA during a STOP condition.</li>
                                                   </ul>
                                                 Note: Implementation Specific Parameter. <p/>
                                               </html>
                                          ]]>
                                       </a:v>
                                      </a:a>
                                      <a:a name="LABEL" value="I2c Hold Stop Delay (cycles)" />
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>

                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="UUID" value="ECUC:e2d7a1cf-ade1-4aa4-9c4a-422f2b1121ba"/>
                                      <a:da name="DEFAULT" type="XPath">
                                          <a:tst expr="num:i(
                                                                text:split
                                                                  (
                                                                    ecu:list
                                                                      (
                                                                        concat
                                                                          (
                                                                            'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.',node:fallback('->node:value(../I2cMasterGlitchFilter)','true')
                                                                           )
                                                                       )[num:i(node:fallback('->node:value(node:current()/../I2cIbcValue)',1)) + 1]
                                                                  , '_'
                                                                  )[5]
                                                            )" />
                                      </a:da>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:da name="INVALID" type="Range">
                                          <a:tst expr="&lt;=4294967295"/>
                                          <a:tst expr="&gt;=0"/>
                                      </a:da>
                                      <a:da name="INVALID" type="XPath">
                                      <a:tst expr="num:i(node:value(.)) != num:i(
                                                                                    text:split
                                                                                      (
                                                                                        ecu:list
                                                                                          (
                                                                                            concat
                                                                                              (
                                                                                                'I2c.I2cGlobalConfig.I2cChannel.I2cMasterConfiguration.I2cDividerAndHoldValueGlitch.', ../I2cMasterGlitchFilter
                                                                                               )
                                                                                          )[num:i(node:current()/../I2cIbcValue) + 1]
                                                                                       , '_'
                                                                                       )[5]
                                                                                   )"
                                        true="Please press the 'Calculate Value' button in order to calculate the value automatically."/>
                                      </a:da>
                                      <a:da name="WARNING" type="XPath">
                                        <a:tst expr="(
                                                       (num:f(node:fallback(.,7684.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &lt; 0.000004
                                                     ) and
                                                     (
                                                       num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 100000.0
                                                     )"
                                               true="The bit (baud) rate corresponds to I2c Standard-Mode and the set-up time for STOP condition (tSU:STO) is less than 4.0 &#181;s. Please consult the I2c specification."/>
                                        <a:tst expr="(
                                                       (num:f(node:fallback(.,7684.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &lt; 0.0000006
                                                     ) and
                                                     (
                                                       (num:f(node:fallback(../I2cBaudRate, 0.0)) &gt; 100000.0) and (num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 400000.0)
                                                     )"
                                               true="The bit (baud) rate corresponds to I2c Fast-Mode and the set-up time for STOP condition (tSU:STO) is less than 0.6 &#181;s. Please consult the I2c specification."/>
                                        <a:tst expr="(
                                                       (num:f(node:fallback(.,7684.0)) * (1.0 div num:f(noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency'))))) &lt; 0.00000026
                                                     ) and
                                                     (
                                                       (num:f(node:fallback(../I2cBaudRate, 0.0)) &gt; 400000.0) and (num:f(node:fallback(../I2cBaudRate, 0.0)) &lt;= 1000000.0)
                                                     )"
                                               true="The bit (baud) rate corresponds to I2c Fast-Mode Plus and the set-up time for STOP condition (tSU:STO) is less than 0.26 &#181;s. Please consult the I2c specification."/>
                                      </a:da>
                                    </v:var>

                                    <!-- @implements I2cBaudRate_Object -->
                                    <v:var name="I2cBaudRate" type="FLOAT">
                                      <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:
                                               <html>
                                                   <p>Calculated as Bus Frequency / SCL_Divider (i.e. 'I2cClockRef/McuClockReferencePointFrequency' / I2cSCLDivider)</p>
                                                 Note: Implementation Specific Parameter. <p/>
                                               </html>
                                          ]]>
                                       </a:v>
                                      </a:a>
                                      <a:a name="LABEL" value="I2c Baud Rate" />
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="UUID" value="ECUC:0a2f04ba-5b60-46bd-92f1-c75db251a411"/>
                                      <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     )
                                                     "/>
                                      </a:a>
                                      <a:da name="DEFAULT" type="XPath">
                                        <a:tst expr="noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency')) div
                                                     node:fallback(../I2cSCLDivider, 20)" />
                                      </a:da>
                                      <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0.0"       false="This baud rate is too low."/>
                                        <a:tst expr="&lt;=1000000.0" false="This baud rate is too high."/>
                                      </a:da>
                                      <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_MODE') or
                                                       (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                     ) and
                                                     (
                                                       num:f(node:fallback(., 1000000)) !=
                                                       (
                                                         noderef:value(concat(noderef:ref(node:fallback(../I2cClockRef, .)),'/McuClockReferencePointFrequency')) div
                                                         node:fallback(../I2cSCLDivider, 20)
                                                       )
                                                     )"
                                               true="Please press the 'Calculate Value' button in order to calculate the value automatically."/>
                                      </a:da>
                                    </v:var>

                                  </v:ctr>
                                    <v:ctr name="I2cSlaveConfiguration" type="IDENTIFIABLE">
                                      <a:a name="DESC">
                                          <a:v>
                                              <![CDATA[EN:
                                                  <html>
                                                This container contains the Slave configuration (parameters).
                                                  </html>
                                              ]]>
                                          </a:v>
                                      </a:a>
                                      <a:a name="UUID" value="ECUC:b993be3e-e6b3-4a5f-9912-0f010dccfa31"/>
                                      <a:a name="LABEL" value="Slave Configuration"/>

                                      <v:var name="I2cSlaveAddress" type="INTEGER">
                                        <a:a name="DESC">
                                         <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>The address of the slave.</p>
                                                    <p>This configures IIC_IBAD[7:1].</p>
                                                    Note: Implementation Specific Parameter.<p/>
                                                </html>
                                            ]]>
                                         </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="I2c Slave Address" />
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                             type="IMPLEMENTATIONCONFIGCLASS">
                                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID"
                                             value="ECUC:f8d45bee-2afd-48db-a0ef-f1fb7d86cd8b"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:a name="EDITABLE" type="XPath">
                                            <a:tst expr="(
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'SLAVE_MODE') or
                                                            (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                         )"/>
                                        </a:a>
                                        <a:da name="INVALID" type="Range">
                                          <a:tst expr="&lt;=127"/>
                                          <a:tst expr="&gt;=0"/>
                                        </a:da>
                                        <a:da name="INVALID" type="XPath">
                                          <a:tst expr="(
                                                         (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'SLAVE_MODE') or
                                                         (node:fallback(../../I2cMasterSlaveConfiguration, 'MASTER_MODE') = 'MASTER_SLAVE_MODE')
                                                       ) and
                                                       (
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000000')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000001')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000010')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000011')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000100')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000101')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000110')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b0000111')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111100')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111101')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111110')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111111')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111000')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111001')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111010')) or
                                                         (num:i(node:fallback(., 0)) = num:bintoint('b1111011'))
                                                       )"
                                                 true="The slave address can't be a reserved address (as defined by the I2c specification).
                                                       The reserved addresses are: 0000 000 (d0), 0000 001 (d1), 0000 010 (d2), 0000 011 (d3), 0000 1XX (d4-7), 1111 0XX (d120-123), 1111 1XX (d124-127)"/>
                                        </a:da>
                                      </v:var>

                                      <v:var name="I2cSlaveListening" type="BOOLEAN">
                                      <a:a name="LABEL" value="I2c Slave Listening"/>
                                      <a:a name="DESC">
                                      <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                <p>I2cSlaveListening</p>
                                                <p>Check this in order to chose slave mode (always listening or on demand only).</p>
                                                Note: Implementation Specific Parameter. <p/>
                                            </html>
                                        ]]>
                                      </a:v>
                                      </a:a>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="UUID" value="ECUC:72a8a638-4001-4649-121a-bb4daf844a8b"/>
                                      <a:da name="DEFAULT" value="false"/>
                                      </v:var>

                                    <v:var name="I2cSlaveGlitchFilter" type="BOOLEAN">
                                      <a:a name="LABEL" value="Glitch Filter Enable"/>
                                      <a:a name="DESC">
                                      <a:v>
                                       <![CDATA[EN:
                                          <html>
                                              <p>I2cMasterGlitchFilter</p>
                                              <p>Switches the glitch filter function ON or OFF.</p>
                                              Note: Implementation Specific Parameter. <p/>
                                          </html>
                                       ]]>
                                      </a:v>
                                      </a:a>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                           type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="NXP"/>
                                      <a:a name="SCOPE" value="LOCAL"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="UUID" value="ECUC:be270747-6271-4d0b-62ea-290362a2d3ef"/>
                                      <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    </v:ctr>
                                  </v:ctr>
                                </v:lst>

                                <!-- @implements I2cDemEventParameterRefs_Object -->
                                <v:ctr name="I2cDemEventParameterRefs" type="IDENTIFIABLE">
                                  <a:a name="LABEL" value="I2c Dem Event Parameter Refs" />
                                  <a:a name="DESC"
                                       value="EN: Container for the references to DemEventParameter elements which shall be invoked using the API Dem_SetEventStatus API in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter&apos;s DemEventId value. The standardized errors are provided in the container and can be extended by vendor specific error references."/>
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="UUID" value="ECUC:4c0d3fc1-6d2c-4614-8f58-fa7632263cbb"/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>

                                  <!-- @implements I2C_E_TIMEOUT_Object -->
                                  <v:ref name="I2C_E_TIMEOUT_FAILURE" type="SYMBOLIC-NAME-REFERENCE">
                                  <a:a name="LABEL" value="I2c Timeout Dem Error" />
                                    <a:a name="DESC"
                                         value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Timeout caused by hardware error&quot; has occured."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="UUID"
                                         value="ECUC:111e0a82-ab9f-4c95-879f-b686bbba6c65"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="node:empty(.)" true="Field is empty (Suggestion: select a DemEventParameter reference)."/>
                                        <a:tst expr="node:refvalid(.)" false="Invalid DemEventParameter reference (Suggestion: select a DemEventParameter reference)."/>
                                   </a:da>
                                   <a:da name="REF"
                                         value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                 </v:ref>
                               </v:ctr>
                             </v:ctr>

                             <!-- /** @implements CommonPublishedInformation_Object */ -->
                             <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                               <a:a name="DESC">
                                   <a:v>
                                       <![CDATA[EN:<html>
                                           Common container, aggregated by all modules.
                                           It contains published information about vendor and versions.
                                       </html>]]>
                                   </a:v>
                               </a:a>
                               <a:a name="UUID" value="ECUC:acb0123b-4400-4cf6-9048-3b802ed2c765"/>

                               <v:var name="ArReleaseMajorVersion" type="INTEGER_LABEL">
                                   <a:a name="LABEL" value="Ar Release Major Version" />
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Major version number of AUTOSAR specification on which the appropriate implementation is based on. <p/>
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:1a61b436-b723-47b1-8f4d-b568b3c77bca"/>
                                   <a:da name="DEFAULT" value="4"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=4"/>
                                       <a:tst expr="&lt;=4"/>
                                   </a:da>
                               </v:var>

                               <v:var name="ArReleaseMinorVersion" type="INTEGER_LABEL">
                                   <a:a name="LABEL" value="Ar Release Minor Version" />
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Minor version number of AUTOSAR specification on which the appropriate implementation is based on. <p/>
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:6b04c7cc-fcf4-40d5-b589-579f3b691bc0"/>
                                   <a:da name="DEFAULT" value="4"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=4"/>
                                       <a:tst expr="&lt;=4"/>
                                   </a:da>
                               </v:var>

                               <v:var name="ArReleaseRevisionVersion" type="INTEGER_LABEL">
                                   <a:a name="LABEL" value="Ar Release Revision Version" />
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Revision version number of AUTOSAR specification on which the appropriate implementation is based on. <p/>
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:856eb3f2-36bf-4d6f-b404-6a874fbbe0e8"/>
                                   <a:da name="DEFAULT" value="0"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=0"/>
                                       <a:tst expr="&lt;=0"/>
                                   </a:da>
                               </v:var>

                               <v:var name="ModuleId" type="INTEGER_LABEL">
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Module ID of this module from Module List.
                                               Note: Implementation Specific Parameter
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:c8d8c033-3334-459e-b45c-705a3ff4887c"/>
                                   <a:da name="DEFAULT" value="255"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=255"/>
                                       <a:tst expr="&lt;=255"/>
                                   </a:da>
                               </v:var>

                               <v:var name="SwMajorVersion" type="INTEGER_LABEL">
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Major version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                               Note: Implementation Specific Parameter
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:9dd0879c-f26b-4ea9-bf0e-013bfa0f4685"/>
                                   <a:da name="DEFAULT" value="4"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=4"/>
                                       <a:tst expr="&lt;=4"/>
                                   </a:da>
                               </v:var>

                               <v:var name="SwMinorVersion" type="INTEGER_LABEL">
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                               Note: Implementation Specific Parameter
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:18ede1df-ceac-4080-a4c8-1eb4cf3cd281"/>
                                   <a:da name="DEFAULT" value="0"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=0"/>
                                       <a:tst expr="&lt;=0"/>
                                   </a:da>
                               </v:var>

                               <v:var name="SwPatchVersion" type="INTEGER_LABEL">
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                               Note: Implementation Specific Parameter
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:f5563407-a9bd-4cae-810d-cf4327c59a70"/>
                                   <a:da name="DEFAULT" value="2"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=2"/>
                                       <a:tst expr="&lt;=2"/>
                                   </a:da>
                               </v:var>

                               <v:var name="VendorApiInfix" type="STRING_LABEL">
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                            In driver modules which can be instantiated several times on a single ECU, BSW00347 requires that the name of APIs is extended by the VendorId and a vendor specific name.
                                              This parameter is used to specify the vendor specific name. In total, the Implementation specific name is generated as follows:
                                              &lt;ModuleName&gt;_&gt;VendorId&gt;_&lt;VendorApiInfix&gt;&lt;Api name from SWS&gt;.
                                              E.g. assuming that the VendorId of the implementor is 123 and the implementer chose a VendorApiInfix of "v11r456" a api name
                                              Can_Write defined in the SWS will translate to Can_123_v11r456Write.
                                              This parameter is mandatory for all modules with upper multiplicity &gt;
                                              1. It shall not be used for modules with upper multiplicity =1.
                                              Note: Implementation Specific Parameter
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:dd6060f6-7040-4479-a64c-802197382a73"/>
                                   <a:da name="DEFAULT" value=""/>
                               </v:var>

                               <v:var name="VendorId" type="INTEGER_LABEL">
                                   <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html>
                                               Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.
                                               Note: Implementation Specific Parameter
                                           </html>]]>
                                       </a:v>
                                   </a:a>
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                       <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                   <a:a name="SCOPE" value="LOCAL"/>
                                   <a:a name="UUID" value="ECUC:ccb6488d-97c2-478c-bcc7-3146548af0ee"/>
                                   <a:da name="DEFAULT" value="43"/>
                                   <a:da name="INVALID" type="Range">
                                       <a:tst expr="&gt;=43"/>
                                       <a:tst expr="&lt;=43"/>
                                   </a:da>
                               </v:var>

                             </v:ctr>

                        </v:ctr>

                    </d:chc>

                    <d:chc name="I2c_EcuParameterDefinition" type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="UUID" value="ECUC:c5d9411f-2fff-545c-8395-901b51b401de"/>
                            <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/TS_T40D11M40I2R0/I2c"/>
                            </d:lst>
                        </d:ctr>
                    </d:chc>
                    <d:chc name="I2c_ModuleDescription" type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                            <d:var name="MODULE_ID" type="INTEGER" >
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:var>
                            <d:ref type="RECOMMENDED_CONFIGURATION" >
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="PRE_CONFIGURED_CONF" >
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="VENDOR_SPECIFIC_MODULE_DEF" value="ASPath:/TS_T40D11M40I2R0/I2c"/>
                        </d:ctr>
                    </d:chc>

                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>
