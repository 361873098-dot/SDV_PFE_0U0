                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:ce222755-6394-4d1b-68e3-290362a2d3ef"/>
                            <a:da name="DEFAULT" value="true"/>
                            <a:da name="INVALID" type="XPath">
                                <a:tst expr="(node:value(.) ='true') and ((node:value(../SerdesMode) = 'PCIE_X2') or (node:value(../SerdesMode) = 'PCIE_SGMII_XPCS_1'))" true = "Xpcs0 is not available for the selected mode. Disable UseXPCS0."/>
                                <a:tst expr="(node:value(.) ='false') and (node:value(../SerdesMode) = 'PCIE_SGMII_XPCS_0')" true = "UseXpcs0 should be enabled."/>
                            </a:da>
                          </v:var>

                          <v:var name="UseXpcs1" type="BOOLEAN">
