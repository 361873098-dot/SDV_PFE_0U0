                              <a:da name="DEFAULT" value="false"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="(node:value(.) = 'true') and (((node:value(../../BAR4Configuration/Bar4Type64Bit) = 'true')) or (node:value(../../BAR4Configuration/Bar4TypePrefetchable) = 'true'))"  
                                         true="An I/O BAR must be a 32-bit BAR and cannot be prefetchable."/>
                              </a:da>
                          </v:var><!-- Bar4TypeIo -->
                          <!-- Bar4TypePrefetchable -->
                          <v:var name="Bar4TypePrefetchable" type="BOOLEAN">
