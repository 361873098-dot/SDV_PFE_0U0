                                                                <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../../../dmaLogicChannel_EnableScatterGather ='true') and (../../dmaLogicChannelConfig_enScatterGatherConfig = 'true') and ((../dmaLogicChannelConfig_enSourceOffset='true') or (../dmaLogicChannelConfig_enDestinationOffset='true'))"/>
                                                                <a:da name="DEFAULT" value="0"/>
