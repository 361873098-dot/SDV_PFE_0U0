                  <SHORT-NAME>EthVersionInfoApi</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Enables / Disables version info API</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
