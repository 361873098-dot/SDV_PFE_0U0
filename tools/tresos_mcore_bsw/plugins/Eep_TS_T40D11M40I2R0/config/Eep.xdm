                                        <![CDATA[EN:<html><p>
                                            Configures the timeout for aborting trasfer
                                        </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:12b37b20-1afe-4c89-8324-551a39542266"/>
                                    <a:a name="EDITABLE" value="true"/>
                                    <a:a name="DEFAULT_RADIX" value="HEX" />
                                    <a:da name="DEFAULT" value="268435456"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=0xFFFFFFFF"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var><!-- AbortTransferTimeout -->

                                <!-- setBusClkTimeout -->
                                <v:var name="setBusClkTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Set bus clock timeout"/>
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:<html><p>
                                            Configures the timeout for bus clock set
                                        </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a6693b28-51f3-4feb-9f0a-b1f5bdcca47b"/>
                                    <a:a name="EDITABLE" value="true"/>
                                    <a:a name="DEFAULT_RADIX" value="HEX" />
                                    <a:da name="DEFAULT" value="268435456"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=0xFFFFFFFF"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var><!-- setBusClkTimeout -->

                                <!-- ResetUsdhcTimeout -->
                                <v:var name="ResetUsdhcTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Reset Usdhc Timeout"/>
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:<html><p>
                                            Reset the uSDHC module
                                        </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a6693b11-51f3-4feb-9f0a-b1f5bdcca47b"/>
                                    <a:a name="EDITABLE" value="true"/>
                                    <a:a name="DEFAULT_RADIX" value="HEX" />
                                    <a:da name="DEFAULT" value="268435456"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=0xFFFFFFFF"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var><!-- ResetUsdhcTimeout -->

                               <!-- transferSyncTimeout -->
                               <v:var name="transferSyncTimeout" type="INTEGER">
                                <a:a name="LABEL" value="Set sync transfer timeout"/>
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:<html><p>
                                        Configures the timeout for sync transfer
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:013294f5-82c9-4410-8627-301187fb0309"/>
                                <a:a name="EDITABLE" value="true"/>
                                <a:a name="DEFAULT_RADIX" value="HEX" />
                                <a:da name="DEFAULT" value="268435456"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=0xFFFFFFFF"/>
                                    <a:tst expr="&gt;=1"/>
                                </a:da>
                                </v:var><!-- transferSyncTimeout -->

                               <!-- transferAsyncTimeout -->
                               <v:var name="transferAsyncTimeout" type="INTEGER">
                                <a:a name="LABEL" value="Set async transfer timeout"/>
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:<html><p>
                                        Configures the timeout for async transfer
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:0048ffce-2643-46a4-b56b-b70cb37d4a84"/>
                                <a:a name="EDITABLE" value="true"/>
