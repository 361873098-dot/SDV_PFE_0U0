<d:ctr type="AUTOSAR" factory="autosar"
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
    <d:lst type="TOP-LEVEL-PACKAGES">
        <d:ctr name="TS_T40D11M10I7R0" type="AR-PACKAGE">
            <a:a name="UUID" value="ECUC:01E56E67-7633-1014-B04D-42166F87FD6B"/>
            <d:lst type="ELEMENTS">
                <d:chc name="Llce_Af" type="AR-ELEMENT" value="MODULE-DEF">
                    <v:ctr type="MODULE-DEF">
                        <a:a name="RELEASE" value="asc:4.4"/>
                        <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                            <ad:ADMIN-DATA>
                                <ad:DOC-REVISIONS>
                                    <ad:DOC-REVISION>
                                        <ad:REVISION-LABEL>4.1.0</ad:REVISION-LABEL>
                                        <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                        <ad:DATE>2010-12-03</ad:DATE>
                                    </ad:DOC-REVISION>
                                </ad:DOC-REVISIONS>
                            </ad:ADMIN-DATA>
                        </a:a>
                        <a:a name="DESC" value="EN: Configuration of Llce module."/>
                        <a:a name="LOWER-MULTIPLICITY" value="1"/>
                        <a:a name="UPPER-MULTIPLICITY" value="1"/>
                        <a:a name="UUID" value="ECUC:01E0593A-7633-1014-B04D-42166F87FD6B"/>

                        <!-- @implements LlceAfGeneral_Object -->
                        <v:ctr name="LlceAfGeneral" type="IDENTIFIABLE">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                            <p>Llce general</p>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:386c52b6-2650-435a-a896-b6f81bccf83a"/>

                            <!-- @implements EnableAdvancedFeatureMode_Object -->
                            <v:var name="EnableAdvancedFeatureMode" type="BOOLEAN">
                                <a:a name="LABEL" value="Enable Advanced Feature Mode"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                <p>When this parameter is enabled, the user can enable the following Advanced Features available in CanAdvancedFeature tab:
                                                "Enable Logging feature on LLCE" and "Received frame authentication feature on LLCE". </p>
                                                <h1>Note:</h1>
                                                <p>The advanced features above won't work if the LLCE firmware build is the standard version. </p>
                                            </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:72a8a638-4009-4669-124a-bb4dae953a77"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <!-- /** @implements CanAdvancedFeature_Object */ -->
                            <v:lst name="CanAdvancedFeature" type="MAP">
                                <a:da name="MIN" value="0"/>
                                <v:ctr name="CanAdvancedFeature" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                CanAdvancedFeature.<br>
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:01E1C863-7633-1014-B04D-42166F87FD6B"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                
                                    <!-- /** @implements LoggingFeatureEnable_Object */ -->
                                    <v:var name="LoggingFeatureEnable" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Enable Logging feature.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Enable Logging feature on LLCE."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:84b6bd47-98f3-48df-940e-ecd1d59570h0"/>
                                        <a:da name="INVALID" type="XPath" expr="node:value(../../../EnableAdvancedFeatureMode)='false' and node:value(.)='true' "
                                              true="This feature is not supported in the standard product version. Please enable EnableAdvancedFeatureMode if you have the premium product version. "/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>
                                    
                                    <!-- /** @implements HostReceiveEnable_Object */ -->
                                    <v:var name="HostReceiveEnable" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Host Receive for advanced features.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Enable Host Receive feature on LLCE."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:84b6bd47-98f3-48df-940e-ecd1857570h0"/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>
									
                                    <!-- /** @implements AuthenticationFrameEnable_Object */ -->
                                    <v:var name="AuthenticationFrameEnable" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Received frame authentication using cryptographic algorithms.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Received frame authentication feature on LLCE."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:84b6bd47-98f3-48df-940e-ecd1835536h0"/>
                                        <a:da name="INVALID" type="XPath" expr="node:value(../../../EnableAdvancedFeatureMode)='false' and node:value(.)='true' "
                                              true="This feature is not supported in the standard product version. Please enable EnableAdvancedFeatureMode if you have the premium product version. "/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>								
                                 									
                                    <v:var name="CustomProcessingEnable" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Custom processing to be implemented by user in FDK.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Custom user-defined processing in LLCE."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:28663CAC-765E-1014-B7B5-A9267A34B162"/>
                                        <a:da name="INVALID" type="XPath" expr="node:value(../../../EnableAdvancedFeatureMode)='false' and node:value(.)='true' "
                                              true="This feature is not supported in the standard product version. Please enable EnableAdvancedFeatureMode if you have the premium product version. "/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    <v:var name="CustomProcessingIndex" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Custom Processing Index used by the Custom processing user-defined functions
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Custom Processing Index"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:84b7bd48-98f3-48df-940e-ecd1950189fc"/>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="EDITABLE" type="XPath" expr="(../CustomProcessingEnable = 'true')"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0"/>
                                        <a:tst expr="&lt;=4294967295"/>
                                    </a:da>
                                </v:var>     								
                                 
                                    <!-- /** @implements Can2CanRoutingEnable_Object */ -->
                                    <v:ctr name="Can2CanRoutingEnable" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Can2CanRouting.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:84b6bd47-98f3-48df-940e-ecd1857570gc"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        
                                        <!-- /** @implements Can2CanRoutingTableRef_Object */ -->
                                        <v:ref name="Can2CanRoutingTableRef" type="REFERENCE">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        Can2CanRoutingTableRef.<br>
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can2Can Routing Table Reference"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="UUID" value="ECUC:ea88b350-ec0c-4ec6-81be-6feb74632679"/>
                                            <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Llce_Af/LlceAfGeneral/Can2CanRoutingTable"/>
                                        </v:ref>
                                    </v:ctr>
                                    
                                    <!-- /** @implements Can2EthRoutingEnable_Object */ -->
                                    <v:ctr name="Can2EthRoutingEnable" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Can2EthRouting.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:b6d801df-ad60-4a20-9e13-c724da5314b7"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        
                                        <!-- /** @implements Can2EthRoutingTableRef_Object */ -->
                                        <v:ref name="Can2EthRoutingTableRef" type="REFERENCE">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        Can2EthRoutingTableRef.<br>
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can2Eth Routing Table Reference"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="UUID" value="ECUC:219039f5-e7d1-4b32-add3-6a87d74e4c29"/>
                                            <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Llce_Af/LlceAfGeneral/Can2EthRoutingTable"/>
                                        </v:ref>
                                    </v:ctr>
                                   
                                    <v:ctr name="Can2OtherRoutingEnable" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Can2OtherRouting.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:39921290-4b1a-11ee-be56-0242ac120002"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        
                                        <v:ref name="Can2OtherRoutingTableRef" type="REFERENCE">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        Can2OtherRoutingTableRef.<br>
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can2Other Routing Table Reference"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="UUID" value="ECUC:6fe8c05a-4b1a-11ee-be56-0242ac120002"/>
                                            <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Llce_Af/LlceAfGeneral/Can2OtherRoutingTable"/>
                                        </v:ref>
                                    </v:ctr>

                                </v:ctr>
                            </v:lst>
                            
                            <!-- /** @implements Can2CanRoutingTable_Object */ -->
                            <v:lst name="Can2CanRoutingTable" type="MAP">
                                <a:da name="MIN" value="0"/>
                                <a:da name="INVALID" type="XPath" expr="( count(./*) + count(../Can2EthRoutingTable/*) + count(../Can2OtherRoutingTable/*)) > 255" true="All routing tables must have 255 or less elements combined"/>
                                <v:ctr name="Can2CanRoutingTable" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Can Internal Routing Table Entry.<br>
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:a0a2d57b-6272-4b2f-9fd9-f92c38ea8c6d"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    
                                    <!-- /** @implements CanFd2Can_Object */ -->
                                    <v:var name="CanFd2Can" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Convert destination to Can.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Convert destination to CAN"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:da name="INVALID" type="XPath" expr="node:value(../Can2CanFd)='true' and node:value(.)='true'" true="Options used in converting frames between CAN and CAN-FD are disjunctive"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:7ed539b0-94b8-42c3-9df9-ae96ce8cd9c0"/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    <!-- /** @implements Can2CanFd_Object */ -->
                                    <v:var name="Can2CanFd" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Convert destination to Can FD where the destination channel allows it. 
                                                    In case of multicast routing towards a mix of destinations CAN and CAN-FD, 
                                                    the firmware will send the frame towards the FD destinations,
                                                    but also towards the non-FD destinations for frames with length up to 8 bytes. <br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Convert destination to CAN FD if possible"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:7ed539b0-94b8-42c3-9df9-ae96ce8cd9c1"/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    <!-- /** @implements CanIdRemapping_Object */ -->
                                    <v:var name="CanIdRemapping" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Can frame id used for remapping during internal routing <br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Id remap value"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:7ed539b0-94b8-42c3-9df9-ae96ce8cd9c2"/>
                                        <a:da name="EDITABLE" value="true"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=4294967295"/>
                                        </a:da>
                                    </v:var>

                                    <!-- /** @implements ForceExtendedID_Object */ -->
                                    <v:var name="ForceExtendedID" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Force using an EXTENDED ID even for short IDs (IDs smaller than 0x7FF) when doing the ID remap.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Force Extended ID"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:7ed539b0-99d8-42c3-9df9-ae93ce8cd9c2"/>
                                        <a:a name="EDITABLE" type="XPath">
                                            <a:tst expr="num:i(../CanIdRemapping) &lt; 2048"/>
                                        </a:a>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    <!-- /** @implements CanDestinationList_Object */ -->
                                    <v:lst name="CanDestinationList" type="MAP">
                                        <a:da name="EDITABLE" value="true" />
                                        <a:da name="VISIBLE" value="true" />
                                        <a:da name="INVALID" type="XPath">
                                                <a:tst expr="count(./*) &lt; 1" true="CanDestinationList is empty"/>
                                        </a:da>
                                        <v:ctr name="CanDestinationList"
                                               type="IDENTIFIABLE">
                                            <a:a name="DESC"
                                                value="EN: This container is only included and valid if TTCAN SWS is used and TTCAN is enabled."/>
                                            <a:a name="UUID"
                                                value="ECUC:e4ab5574-20a9-4d2d-86ad-d7e23b583932"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>

                                            <!-- /** @implements Can2CanControllerRef_Object */ -->
                                            <v:ref name="Can2CanControllerRef" type="REFERENCE">
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:<html><p>
                                                            Reference to CAN Controller.<br>
                                                        </p></html>]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Can Controller Reference"/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="NXP"/>
                                                <a:a name="UUID" value="ECUC:01E9602E-7633-1014-B04D-42166F87FD6B"/>
                                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Can/CanConfigSet/CanController"/>
                                            </v:ref>

                                        </v:ctr>
                                    </v:lst>
                                </v:ctr>
                            </v:lst>

                            <v:var name="CAN2ETHWithExternalRingBuffer" type="BOOLEAN">
                                <a:a name="LABEL" value="CAN2ETH with external ring buffer"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                <p>Activates the LLCE-PFE interface using external rings. Rings are structures for management of communication between LLCE and PFE.
                                                The default memory where rings are defined is LLCE memory, while the external ones are defined in system SRAM.</p>
                                                <h1>Note:</h1>
                                                <p>Add at least one entry into Can2EthRoutingTable or enable Eth2Can to have this feature available. </p>
                                            </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:ba6b539c-13ff-11ee-be56-0242ac120002"/>
                                <a:da name="EDITABLE" value="true"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="(count(../Can2EthRoutingTable/*) > 0) or (../Eth2Can/Eth2CanEnable = 'true')" false="Can2EthRoutingTable list must not be empty or Eth2Can shall be enabled."/>
                                </a:da>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>

                            <!-- /** @implements Can2EthRoutingTable_Object */ -->
                            <v:lst name="Can2EthRoutingTable" type="MAP">
                                <a:da name="MIN" value="0"/>
                                <a:da name="INVALID" type="XPath" expr="( count(./*) + count(../Can2CanRoutingTable/*) + count(../Can2OtherRoutingTable/*) ) > 255" true="All routing tables must have 255 or less elements combined"/>
                                <v:ctr name="Can2EthRoutingTable" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Can Internal Routing Table Entry.<br>
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:e26c2dbd-f58e-44f7-849a-9570b92212f3"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>

                                    <v:var name="EncapsulationType" type="ENUMERATION">
                                        <a:a name="DESC" value="Specifies the type of encapsulation to use."/>
                                        <a:a name="UUID" value="ECUC:b5e7b615-8e3a-484b-9116-b2753b6749da"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:da name="DEFAULT" value="AVTP_NTSCF_BRIEF"/>
                                        <a:da name="RANGE">
                                            <a:v>AVTP_NTSCF_BRIEF</a:v>
                                            <a:v>AVTP_NTSCF_FULL</a:v>
                                            <a:v>AVTP_TSCF_BRIEF</a:v>
                                            <a:v>AVTP_TSCF_FULL</a:v>
                                            <a:v>UDP</a:v>
                                            <a:v>UDP_B</a:v>
                                        </a:da>
                                    </v:var>

                                    <!-- /** @implements EthDestAddress_Object */ -->
                                    <v:var name="EthDestAddress" type="STRING">
                                        <a:a name="DESC"
                                            value="EN: Specifies the unique 48-bit physical address (MAC address) of the destination."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:af1b57ea-5e70-4a83-a3db-3b9d604db305"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:match(., '^[0-9a-fA-F]{2}([:-][0-9a-fA-F]{2}){5}$')" false="Physical address has an invalid value."/>
                                        </a:da>
                                        <a:da name="DEFAULT" value="66:55:44:33:22:11"/>
                                    </v:var>
 
                                    <v:var name="EthSrcAddress" type="STRING">
                                        <a:a name="DESC"
                                            value="EN: Specifies the unique 48-bit physical address (MAC address) to be used as source."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:a7f833a0-61bc-4092-8638-52da0e413210"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:match(., '^[0-9a-fA-F]{2}([:-][0-9a-fA-F]{2}){5}$')" false="Physical address has an invalid value."/>
                                        </a:da>
                                        <a:da name="DEFAULT" value="4C:4C:43:45:41:46"/>
                                    </v:var> 

                                    <v:var name="IpDestAddress" type="STRING">
                                        <a:a name="DESC"
                                            value="EN: Specifies the 4 byte IP address of the destination."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:5e17e6fa-632f-4c1c-9e01-5ed4fd9d48c9"/>
                                        <a:da name="EDITABLE" type="XPath" expr="(../EncapsulationType = 'UDP') or (../EncapsulationType = 'UDP_B')"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:match(., '^[0-9]{0,3}(\.[0-9]{0,3}){3}')" false="Physical address has an invalid value."/>
                                        </a:da>
                                        <a:da name="DEFAULT" value="127.0.0.1"/>
                                    </v:var> 

                                    <v:var name="IpSrcAddress" type="STRING">
                                        <a:a name="DESC"
                                            value="EN: Specifies the 4 byte IP address to be used as source."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:209c9eb6-9fc1-410b-af7e-4341d95c85da"/>
                                        <a:da name="EDITABLE" type="XPath" expr="(../EncapsulationType = 'UDP') or (../EncapsulationType = 'UDP_B')"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:match(., '^[0-9]{0,3}(\.[0-9]{0,3}){3}')" false="Physical address has an invalid value."/>
                                        </a:da>
                                        <a:da name="DEFAULT" value="127.0.0.1"/>
                                    </v:var> 

                                    <v:var name="UdpDestPort" type="INTEGER">
                                        <a:a name="DESC" value="Specifies the destination port (1-65535)."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="UUID" value="ECUC:2c11b648-be6b-490d-b5ac-6b3b5eb4c3db"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:da name="EDITABLE" type="XPath" expr="(../EncapsulationType = 'UDP') or (../EncapsulationType = 'UDP_B')"/>
                                        <a:da name="DEFAULT" value="1500"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=1"/>
                                            <a:tst expr="&lt;=65535"/>
                                        </a:da>
                                    </v:var>

                                    <v:var name="UdpSrcPort" type="INTEGER">
                                        <a:a name="DESC" value="Specifies the source port (1-65535)."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="UUID" value="ECUC:dc745c24-8d23-4b0b-8aa5-44fecc6df6d7"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:da name="EDITABLE" type="XPath" expr="(../EncapsulationType = 'UDP') or (../EncapsulationType = 'UDP_B')"/>
                                        <a:da name="DEFAULT" value="1500"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=1"/>
                                            <a:tst expr="&lt;=65535"/>
                                        </a:da>
                                    </v:var>

                                    <!-- /** @implements Can2EthBufferSize_Object */ -->
                                    <v:var name="Can2EthBufferSize" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Size in bytes of each data buffer used for this destination<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Buffer Size"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:CE129E66-7634-1014-BBE8-26EF6E87FD6B"/>
                                        <a:da name="DEFAULT" value="500"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=2048"/>
                                        </a:da>
                                    </v:var>

                                    <!-- /** @implements Can2EthBufferCount_Object */ -->
                                    <v:var name="Can2EthBufferCount" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Number of data buffers of size Can2EthBufferSize used for this destination <br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Buffer Count"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:CE12E5E9-7634-1014-BBE8-26EF6E87FD6B"/>
                                        <a:da name="DEFAULT" value="1"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=255"/>
                                        </a:da>
                                    </v:var>

                                    <v:lst name="EthPhyIf" type="">
                                        <a:da name="INVALID" type="XPath">
                                                <a:tst expr="count(./*) &lt; 1" true="EthPhyIf list is empty"/>
                                        </a:da>
                                        <!-- /** @implements EthPhyIf_Object */ -->
                                        <v:var name="EthPhyIf" type="ENUMERATION">
                                            <a:a name="DESC" value="Specifies the physical interface."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="ECU"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:af1b57ea-5e70-4a83-a3db-3b9d604db304"/>
                                            <a:da name="DEFAULT" value="PFE_EMAC0"/>
                                            <a:da name="RANGE">
                                                <a:v>PFE_EMAC0</a:v>
                                                <a:v>PFE_EMAC1</a:v>
                                                <a:v>PFE_EMAC2</a:v>
                                                <a:v>PFE_HIF0</a:v>
                                                <a:v>PFE_HIF1</a:v>
                                                <a:v>PFE_HIF2</a:v>
                                                <a:v>PFE_HIF3</a:v>
                                                <a:v>PFE_HIFNOCPY</a:v>
                                                <a:v>PFE_AUX</a:v>
                                            </a:da>
                                        </v:var>
                                    </v:lst>
                                </v:ctr>
                            </v:lst>

                            <v:lst name="Can2OtherRoutingTable" type="MAP">
                                <a:da name="MIN" value="0"/>
                                <a:da name="INVALID" type="XPath" expr="( count(./*) + count(../Can2CanRoutingTable/*) + count(../Can2EthRoutingTable/*) ) > 255" true="All routing tables must have 255 or less elements combined"/>
                                <v:ctr name="Can2OtherRoutingTable" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Can Internal Routing Table Entry.<br>
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:971e9834-4b1a-11ee-be56-0242ac120002"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>

                                    <v:var name="RoutingType" type="ENUMERATION">
                                        <a:a name="DESC" value="Specifies the kind of routing to use."/>
                                        <a:a name="UUID" value="ECUC:b35bc6ac-4b1a-11ee-be56-0242ac120002"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:da name="DEFAULT" value="PCIe"/>
                                        <a:da name="RANGE">
                                            <a:v>PCIe</a:v>
                                            <a:v>HSE</a:v>
                                        </a:da>
                                    </v:var>

                                    <v:var name="PcieRcBuffAddr" type="INTEGER">
                                        <a:a name="DESC" value="Specifies the corresponding address on the RC to place the data."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="UUID" value="ECUC:e434f078-4b1a-11ee-be56-0242ac120002"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:da name="ENABLE" type="XPath" expr="(../RoutingType = 'PCIe')"/>
                                        <a:da name="DEFAULT_RADIX" value="HEX" />
                                        <a:da name="DEFAULT" value="1"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=1"/>
                                            <a:tst expr="&lt;=18446744073709551615"/>
                                        </a:da>
                                    </v:var>

                                    <v:var name="BufferSize" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Size in bytes of each data buffer used for this destination<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Buffer Size"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:0c893e1c-4b1b-11ee-be56-0242ac120002"/>
                                        <a:da name="ENABLE" type="XPath" expr="(../RoutingType = 'PCIe')"/>
                                        <a:da name="DEFAULT" value="500"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=65535"/>
                                        </a:da>
                                    </v:var>

                                    <!-- /** @implements Can2EthBufferCount_Object */ -->
                                    <v:var name="BufferCount" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Number of data buffers of size BufferSize used for this destination <br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Buffer Count"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:2bef4b52-4b1b-11ee-be56-0242ac120002"/>
                                        <a:da name="ENABLE" type="XPath" expr="(../RoutingType = 'PCIe')"/>
                                        <a:da name="DEFAULT" value="1"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=255"/>
                                        </a:da>
                                    </v:var>

                                    <v:var name="PcieController" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Pcie controller selection <br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="PCIe controller to use"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:e92c4454-4b1b-11ee-be56-0242ac120002"/>
                                        <a:da name="ENABLE" type="XPath" expr="(../RoutingType = 'PCIe')"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=1"/>
                                        </a:da>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="(node:exists(as:modconf('Resource')[1]/ResourceGeneral/ResourceSubderivative))
                                                         and
                                                         (text:contains(text:tolower(node:value(as:modconf('Resource')[1]/ResourceGeneral/ResourceSubderivative)), 's32g2'))
                                                         and
                                                         (num:i(.) = '1') " true="On S32G2 only PCIe0 can be used." />
                                        </a:da>
                                    </v:var>
                                    <v:var name="DmaChannel" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    DmaChannel selection <br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="DMA channel of the specified PCIe controller to use"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:08c79598-4b1c-11ee-be56-0242ac120002"/>
                                        <a:da name="ENABLE" type="XPath" expr="(../RoutingType = 'PCIe')"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=4"/>
                                        </a:da>
                                    </v:var>
                                    <v:var name="MsiId" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    MSI to trigger on RC. Must be allocated by RC. <br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="LABEL" value="MSI to trigger on RC. Must be allocated by RC."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:24a93dac-4b1c-11ee-be56-0242ac120002"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=32"/>
                                        </a:da>
                                    </v:var>

                                    <v:var name="CanKeyHandle" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Key handle for MAC generation.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Key handle for MAC generation"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:90bc0444-c665-4eb2-a9ef-f2b61b7c7f4b"/>
                                        <a:da name="ENABLE" type="XPath" expr="(../RoutingType = 'HSE')"/>
                                        <a:da name="DEFAULT_RADIX" value="HEX0" />
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=4294967296"/>
                                        </a:da>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="/AUTOSAR/TOP-LEVEL-PACKAGES/Llce_Af/ELEMENTS/Llce_Af/LlceAfGeneral/EnableAdvancedFeatureMode ='false'"
                                                true="This feature is not supported in the standard product version. Please enable EnableAdvancedFeatureMode if you have the premium product version. "/>
                                        </a:da> 
                                    </v:var> 

                                </v:ctr>
                            </v:lst>
                            <v:ctr name="Eth2Can" type="IDENTIFIABLE">
                                <a:a name="TAB" value="Eth2Can"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                <p>Ethernet to Can (Eth2Can) options</p>
                                            </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:061ea3e6-df17-49cf-b696-aa1849821664"/>

                                <v:var name="Eth2CanEnable" type="BOOLEAN">
                                    <a:a name="LABEL" value="Enable Eth2Can"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>Enable this to use routing from PFE to Can buses</p>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:ba9aca92-74c9-48c1-bc4c-0f218e86f75a"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="INVALID" type="XPath" expr="node:value(.) = 'true' and count(../Eth2CanEnabledFormats/*) = 0" true="Eth2Can enabled, but no formats defined"/>
                                </v:var>

                                <v:var name="Eth2CanBufferCount" type="INTEGER">
                                    <a:a name="LABEL" value="Number of Eth2Can buffers"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>Number of buffers to create in memory for Eth2Can usage. Must be >=72.</p>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="ENABLE" type="XPath" expr="../Eth2CanEnable = 'true'"/>
                                    <a:a name="UUID" value="ECUC:c13b6fc2-11d4-446e-a843-71af3343d5fd"/>
                                    <a:da name="DEFAULT" value="72"/>
                                    <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=72"/>
                                            <a:tst expr="&lt;=255"/>
                                    </a:da>
                                </v:var>
     
                                <v:var name="Eth2CanBufferSize" type="INTEGER">
                                    <a:a name="LABEL" value="Size of each Eth2Can buffer"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>Size of buffers to create in memory for Eth2Can usage.</p>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="ENABLE" type="XPath" expr="../Eth2CanEnable = 'true'"/>
                                    <a:a name="UUID" value="ECUC:5d043bce-c6f6-44f3-9797-253103df30bc"/>
                                    <a:da name="DEFAULT" value="1000"/>
                                    <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=65535"/>
                                    </a:da>
                                </v:var>

                                <v:lst name="Eth2CanEnabledFormats">
                                    <a:da name="ENABLE" type="XPath" expr="../Eth2CanEnable = 'true'"/>
                                    <v:var name="Eth2CanEnabledFormats" type="ENUMERATION">
                                        <a:a name="DESC" value="Specifies a format to enable Eth2Can decapsulation."/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:4875455a-4b1c-11ee-be56-0242ac120002"/>
                                        <a:da name="DEFAULT" value="AVTP_NTSCF_BRIEF"/>
                                        <a:da name="RANGE">
                                            <a:v>AVTP_NTSCF_BRIEF</a:v>
                                            <a:v>AVTP_NTSCF_FULL</a:v>
                                            <a:v>AVTP_TSCF_BRIEF</a:v>
                                            <a:v>AVTP_TSCF_FULL</a:v>
                                            <a:v>UDP</a:v>
                                            <a:v>UDP_B</a:v>
                                        </a:da>
                                    </v:var>
                                </v:lst>
                            </v:ctr>

                        </v:ctr>
                        <!--  @implements CommonPublishedInformation_Object  -->
                        <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html><p>Common container, aggregated by all modules. It contains published information about vendor and versions.</p></html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:01E8ACBE-7633-1014-B04D-42166F87FD6B"/>

                            <v:var name="ArReleaseMajorVersion" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="AUTOSAR Major Version"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Major version number of AUTOSAR specification on which the appropriate implementation is based on.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E4D9C4-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="4"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=4"/>
                                    <a:tst expr="&lt;=4"/>
                                </a:da>
                            </v:var>

                            <v:var name="ArReleaseMinorVersion" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="AUTOSAR Minor Version"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Minor version number of AUTOSAR specification on which the appropriate implementation is based on.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E437E3-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="4"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=4"/>
                                    <a:tst expr="&lt;=4"/>
                                </a:da>
                            </v:var>

                            <v:var name="ArReleaseRevisionVersion" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="AUTOSAR Release Revision Version"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Revision version number of AUTOSAR specification on which the appropriate implementation is based on.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01DF9344-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="0"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=0"/>
                                    <a:tst expr="&lt;=0"/>
                                </a:da>
                            </v:var>

                            <v:var name="ModuleId" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Module Id"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Module ID of this module from Module List.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E307F9-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="99"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=99"/>
                                    <a:tst expr="&lt;=99"/>
                                </a:da>
                            </v:var>

                            <v:var name="SwMajorVersion" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Software Major Version"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Major version number of the vendor specific implementation of the module. The numbering is vendor specific.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E80C61-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="1"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=1"/>
                                    <a:tst expr="&lt;=1"/>
                                </a:da>
                            </v:var>

                            <v:var name="SwMinorVersion" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Software Minor Version"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E28036-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="0"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=0"/>
                                    <a:tst expr="&lt;=0"/>
                                </a:da>
                            </v:var>

                            <v:var name="SwPatchVersion" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Software Patch Version"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E78B2C-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="7"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=7"/>
                                    <a:tst expr="&lt;=7"/>
                                </a:da>
                            </v:var>

                            <v:var name="VendorApiInfix" type="STRING_LABEL">
                                <a:a name="LABEL" value="Vendor Api Infix"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>
                                                In driver modules which can be instantiated several times on a single ECU, BSW00347 requires that the name of APIs is extended by the VendorId and a vendor specific name.
                                                This parameter is used to specify the vendor specific name. In total, the implementation specific name is generated as follows:
                                                &lt;ModuleName&gt;_&gt;VendorId&gt;_&lt;VendorApiInfix&gt;&lt;Api name from SWS&gt;.
                                                E.g.  assuming that the VendorId of the implementor is 123 and the implementer chose a VendorApiInfix of &quot;v11r456&quot; a api name Can_Write defined in the SWS will translate to Can_123_v11r456Write.
                                                This parameter is mandatory for all modules with upper multiplicity &gt; 1. It shall not be used for modules with upper multiplicity =1.
                                            </p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E3873C-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value=""/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:da name="READONLY" value="true"/>
                            </v:var>

                            <v:var name="VendorId" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Vendor Id"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:01E61017-7633-1014-B04D-42166F87FD6B"/>
                                <a:da name="DEFAULT" value="43"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=43"/>
                                    <a:tst expr="&lt;=43"/>
                                </a:da>
                            </v:var>
                        </v:ctr>

                    </v:ctr>
                </d:chc>
                <d:chc name="Llce_Af_EcuParameterDefinition"
                            type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                    <d:ctr type="AR-ELEMENT">
                        <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                        <d:lst name="MODULE_REF">
                            <d:ref type="MODULE_REF" value="ASPath:/TS_T40D11M10I7R0/Llce_Af"/>
                        </d:lst>
                        <a:a name="UUID" value="ECUC:CE11D25E-7634-1014-BBE8-26EF6E87FD6B"/>
                    </d:ctr>
                </d:chc>
                <d:chc name="Llce_Af_ModuleDescription"
                            type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                    <d:ctr type="AR-ELEMENT">
                        <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                        <d:var name="MODULE_ID" type="INTEGER" >
                            <a:a name="EDITABLE" value="false"/>
                            <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                        <d:ref type="RECOMMENDED_CONFIGURATION" >
                            <a:a name="EDITABLE" value="false"/>
                            <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:ref>
                        <d:ref type="PRE_CONFIGURED_CONF" >
                            <a:a name="EDITABLE" value="false"/>
                            <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:ref>
                        <d:ref type="VENDOR_SPECIFIC_MODULE_DEF" value="ASPath:/TS_T40D11M10I7R0/Llce_Af"/>
                    </d:ctr>
                </d:chc>
            </d:lst>
        </d:ctr>
    </d:lst>
</d:ctr>

</datamodel>
