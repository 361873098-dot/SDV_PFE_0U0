                  <SHORT-NAME>EepMCoreLockGatesTimeout</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                        Configures the timeout for lock gates in multicore
                                    </L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>ECU</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
