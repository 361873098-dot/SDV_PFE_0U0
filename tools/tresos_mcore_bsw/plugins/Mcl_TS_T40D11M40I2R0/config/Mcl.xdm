                                                            <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../../dmaLogicChannel_EnableScatterGather ='true') and (../dmaLogicChannelConfig_LastElementLink_ScatterGatherType='false')"/>
