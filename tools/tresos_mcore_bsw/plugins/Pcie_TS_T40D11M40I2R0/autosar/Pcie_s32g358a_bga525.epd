        <ECUC-MODULE-DEF UUID="ECUC:1e8f8b52-ca03-d4f1-21e2-21377133d9d5">
          <SHORT-NAME>Pcie</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Vendor specific: Configuration of the Pcie (PcieDriver) module</L-2>
          </DESC>
