                              <SHORT-NAME>ADC_CH_08_ChanNum0</SHORT-NAME>
                              <ORIGIN>NXP</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>ADC_CH_09_ChanNum1</SHORT-NAME>
