  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Can_43_LLCE_TS_T40D11M10I7R0" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:181f65b6-f772-4dd7-b9a6-1186c4c7eba8"/>
        <d:lst type="ELEMENTS">
        <!-- /** @implements Can_Object */ -->
          <d:chc name="Can" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
                <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                    <ad:ADMIN-DATA>
                        <ad:DOC-REVISIONS>
                            <ad:DOC-REVISION>
                                <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                <ad:DATE>2014-10-31</ad:DATE>
                            </ad:DOC-REVISION>
                        </ad:DOC-REVISIONS>
                    </ad:ADMIN-DATA>
                </a:a>
                <a:a name="DESC" 
                    value="EN: This container holds the configuration of a single CAN Driver."/>
                <a:a name="LOWER-MULTIPLICITY" value="1"/>
                <a:a name="RELEASE" value="asc:4.4"/>
                <a:a name="UPPER-MULTIPLICITY" value="*"/>
                <a:a name="UUID" value="ECUC:53829d84-d68b-4234-86cf-6ca163c4995d"/>
                <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>

                <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                    <a:a name="DESC">
                        <a:v>
                            <![CDATA[EN:<html>
                                Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points.
                            </html>]]>
                        </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="LABEL" value="Post Build Variant Used"/>
                    <a:a name="ORIGIN" value="EB"/>
                    <a:a name="UUID" value="ECUC:40b85d0b-6a49-48a9-96e8-58bbab831aa4"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="READONLY" value="false"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                </v:var>
                <!-- /** @implements ConfigVariant_Object */ -->
                <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="LABEL" value="Config Variant"/>
                    <a:a name="UUID" value="ECUC:40b85d0b-6a49-48a9-96e8-58bbab831aa3"/>
                    <a:da name="DEFAULT" value="VariantPostBuild"/>
                    <a:da name="RANGE">
                        <a:v>VariantPostBuild</a:v>
                        <a:v>VariantPreCompile</a:v>
                    </a:da>
                </v:var>

                <!-- /** @implements CanGeneral_Object */ -->
                <v:ctr name="CanGeneral" type="IDENTIFIABLE">
                    <a:a name="DESC">
                        <a:v>
                            <![CDATA[EN:<html><p>
                                This container holds the parameters related each CAN Driver Unit.<br>
                            </p></html>]]>
                        </a:v>
                    </a:a>
                    <a:a name="UUID" value="ECUC:92dba3ff-0eab-40cb-b10e-8e2ed31f8fe9"/>

                    <!-- /** @implements CanDevErrorDetect_Object */ -->
                    <v:var name="CanDevErrorDetect" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN064_Conf: Switches the Development Error Detection and Notification: ON or OFF.<br>
                                    When this option is OFF code size is reduced, but no error detection is available.<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Development Error Detection"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:fae3ece1-6b70-4308-b6ff-36cbf085320d"/>
                        <a:da name="DEFAULT" value="false"/>
                    </v:var>
                    
                    <!-- @implements CanEnableUserModeSupport_Object -->
                    <v:var name="CanEnableUserModeSupport" type="BOOLEAN">
                        <a:a name="LABEL" value="Can Enable User Mode Support"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:
                                    <html>
                                        <p>When this parameter is enabled, the Can module will adapt to run from User Mode</p>
                                    </html>
                                ]]>
                            </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:72a8a638-4009-4639-124a-bb4dae953a77"/>
                        <a:da name="DEFAULT" value="false"/>
                    </v:var>
                        
                    <v:var name="CanMulticoreSupport" type="BOOLEAN">
                        <a:a name="LABEL" value="Can Multicore Support"/>
                        <a:a name="DESC">
                        <a:v>
                            <![CDATA[EN:
                                <html>
                                    Enable mapping Can LLCE driver to multiple EcuC partitions to make the modules API available in this partition. The Can driver will operate as an independent instance in each of the partitions.
                                </html>
                            ]]>
                        </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:52b51f70-ab07-44eb-ab98-a89d2fe01bdd"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="INVALID" type="XPath">
                                <a:tst expr="(. = 'true') and (num:i(count(../CanEcucPartitionRef/*)) &lt;1)" true="When CanMulticoreSupport is enabled, at least one CanEcucPartitionRef need be configured."/>
                                <a:tst expr="(. = 'false') and (num:i(count(../CanEcucPartitionRef/*)) &gt;0)" true="When CanMulticoreSupport disabled, have no any CanEcucPartitionRef are configured."/>
                        </a:da>
                    </v:var>
                    
                    <!-- /** @implements HostInterface_Object */ -->
                    <v:var name="HostInterface" type="ENUMERATION">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    Specifies the selection for the host interface<br>
                                    <b>Note</b>Implementation Specific parameter. Not AutoSar Required.<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Active Host Interface"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:e4482b90-209f-4bbb-bd65-a7cb8b21a48c"/>
                        <a:da name="DEFAULT" value="LLCE_CAN_HIF0"/>
                        <a:da name="ENABLE" type="XPath" expr="../CanMulticoreSupport = 'false'"/> 
                        <a:da name="RANGE">
                            <a:v>  LLCE_CAN_HIF0  </a:v>
                            <a:v>  LLCE_CAN_HIF1  </a:v>
                        </a:da>
                    </v:var>

                    <!-- /** @implements CanVersionInfoApi_Object */ -->
                    <v:var name="CanVersionInfoApi" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN106_Conf. Switches the Can_GetVersionInfo() API: ON or OFF.<br>
                                    When this option is ON driver supports API for getting Version information for the Driver.<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Provide Version Info API"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:1c149bc9-b9f1-41c4-afa6-d1cf49d3ba8f"/>
                        <a:da name="DEFAULT" value="true"/>
                    </v:var>

                    <!-- /** @implements CanIndex_Object */ -->
                    <v:var name="CanIndex" type="INTEGER">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN320_Conf. Specifies the InstanceId of this module instance.<br>
                                    If only one instance is present it shall have the Id 0.<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Can Driver Index"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:da name="EDITABLE" value="true"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:4e05c426-67f4-4e47-b644-194ce78ec98d"/>
                        <a:da name="DEFAULT" value="0"/>
                        <a:da name="INVALID" type="Range">
                            <a:tst expr="&gt;=0"/>
                            <a:tst expr="&lt;=255"/>
                        </a:da>
                    </v:var>

                    <!-- /** @implements CanMainFunctionBusoffPeriod_Object */ -->
                    <v:var name="CanMainFunctionBusoffPeriod" type="FLOAT">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN355_Conf. This parameter describes the period for cyclic call to Can_MainFunction_Busoff.<br>
                                    Unit is seconds.<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Can Main Function Busoff Period (seconds)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:a15e5331-787c-48bb-a807-0a51c0f52342"/>
                        <a:da name="DEFAULT" value="0.001"/>
                        <a:da name="INVALID" type="Range">
                            <a:tst expr="&gt;=0.001"/>
                            <a:tst expr="&lt;=65.535"/>
                        </a:da>
                    </v:var>

                    <v:var name="CanMainFunctionWakeupPeriod" type="FLOAT">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN357_Conf. This parameter describes the period for cyclic call to Can_MainFunction_Wakeup.<br>
                                    Unit is seconds.<br><br>
                                    This field is editable if CanConfigSet/CanController/CanWakeupSupport is 'true'.
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Can Main Function Wakeup Period (seconds)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:1d4118e8-5581-43c2-addc-1cf8f03a0501"/>
                        <a:da name="EDITABLE" type="XPath">
                            <a:tst expr="(../../CanConfigSet/CanController/*/CanWakeupSupport ='true')"/>
                        </a:da>
                        <a:da name="DEFAULT" value="0.0010"/>
                        <a:da name="INVALID" type="Range">
                            <a:tst expr="&gt;=0.0010"/>
                            <a:tst expr="&lt;=65.535"/>
                        </a:da>
                    </v:var>

                    <!-- /** @implements CanMainFunctionModePeriod_Object */ -->
                    <v:var name="CanMainFunctionModePeriod" type="FLOAT">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN376_Conf. This parameter describes the period for cyclic call to Can_MainFunction_Mode.<br>
                                    Unit in seconds.<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Can Main Function Mode Period (seconds)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:730cb556-be31-4be6-a0d2-bc6059a8f112"/>
                        <a:da name="DEFAULT" value="0.001"/>
                        <a:da name="INVALID" type="Range">
                            <a:tst expr="&gt;=0.001"/>
                            <a:tst expr="&lt;=65.535"/>
                        </a:da>
                    </v:var>
                    
                    <!-- /** @implements CanMultiplexedTransmission_Object */ -->
                    <v:var name="CanMultiplexedTransmission" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    Multiplex transmission means to search for a free MB, that has the same ObjectId with the one transmitted to Can_Write,
                                    if current Hth MB is busy. <br>
                                    Replaced by SWS_Can_00401. There is no difference between configuring multiple transmit 
                                    hardware handlers with the same CanObjectId and configuring a single transmit hardware handler with multiple transmit 
                                    hardware objects. Hence, it is advisable to use the CanHwObjectCount mechanism to allocate more free transmit 
                                    hardware objects within a transmit entity.<br>
                                    <p>Note: Deprecated. Please use CanHwObjectCount functionality. </p>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Can Multiplexed Transmission"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:d9c43cc7-d91f-41b8-8658-05065604cec9"/>
                        <a:da name="DEFAULT" value="true"/>
                    </v:var>                    
                    
                    <v:var name="CanTimeoutMethod" type="ENUMERATION">
                        <a:a name="LABEL" value="Can Timeout Method"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:
                                    <html>
                                        <p>CanTimeoutMethod</p>
                                        <p>Configures the timeout method.</p>
                                        <p>Based on this selection a certain timeout method from OsIf will be used in the driver.</p>
                                        <p>Note: If SystemTimer or CustomTimer are selected make sure the corresponding timer is enabled in OsIf General configuration. </p>
                                        Note: Implementation Specific Parameter. <p/>
                                    </html>
                                ]]>
                            </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:7228a315-4003-4639-af1a-bb3d9f762a7b"/>
                        <a:a name="DEFAULT" value="OSIF_COUNTER_DUMMY"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="node:refs('ASPathDataOfSchema:/AUTOSAR/BaseNXP/OsIfGeneral/OsIfUseCustomTimer') = 'false' and node:fallback(.,'OSIF_COUNTER_DUMMY') = 'OSIF_COUNTER_CUSTOM'" true="Custom Timer is not enabled in OsIf (OsIfGeneral/OsIfUseCustomTimer checkbox)"/>
                            <a:tst expr="node:refs('ASPathDataOfSchema:/AUTOSAR/BaseNXP/OsIfGeneral/OsIfUseSystemTimer') = 'false' and node:fallback(.,'OSIF_COUNTER_DUMMY') = 'OSIF_COUNTER_SYSTEM'" true="System Timer is not enabled in OsIf (OsIfGeneral/OsIfUseSystemTimer checkbox)"/>
                        </a:da>
                        <a:da name="RANGE">
                            <a:v>OSIF_COUNTER_DUMMY</a:v>
                            <a:v>OSIF_COUNTER_SYSTEM</a:v>
                            <a:v>OSIF_COUNTER_CUSTOM</a:v>
                        </a:da>
                    </v:var>

                    <!-- /** @implements CanTimeoutDuration_Object */ -->
                    <v:var name="CanTimeoutDuration" type="FLOAT">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN113_Conf. Specifies the maximum time for blocking function until a timeout is detected. Unit in seconds.<br><br>
                                    This Timeout is used to detect the Hardware Errors/ Production Errors.<br>
                                    This timeout is used to allow hardware to take effect of the Hardware settings.
                                    For OSIF_COUNTER_DUMMY method, CanTimeoutDuration may not reflect exactly in seconds (but in the terms of loops, 1 us : 1 loop).
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Can Timeout Duration (seconds)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:da name="DEFAULT" value="1.0"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:ef633bd3-5ecb-4d8a-a5db-9e04ce58cd11"/>
                        <a:da name="INVALID" type="Range">
                            <a:tst expr="&gt;=0.000001"/>
                            <a:tst expr="&lt;=65.535"/>
                        </a:da>
                    </v:var>
                
                    <!-- /** @implements CanLPduReceiveCalloutFunction_Object */ -->
                    <v:var name="CanLPduReceiveCalloutFunction" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                CAN434_Conf:This parameter defines the existence and the name of a callout function that is called after a successful reception of a received CAN Rx L-PDU. If this parameter is omitted no callout shall take place.
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bdfe5480-3705-4c45-aea3-6775b0d7d806"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="EDITABLE" value="true"/>
                    </v:var>

                    <v:var name="LPDUCalloutExtension" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[<html><p>
                                    Allows LLCE callout Extension to accept 2 bytes unsigned integer values.
                                    </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="L-PDU Callout Extension to uint16"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:4234dea7-db09-44af-a2f6-d325a9a549d8"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:da name="DEFAULT" value="false"/>
                    </v:var>  

                    <!-- /** @implements RxTimestampNotification_Object */ -->
                    <v:var name="RxTimestampNotification" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                Vendor specific: Timestamp of received frames are reported through this callout function, if any controller has timestamp option enabled.
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="LABEL" value="Rx Timestamp Notification Function"/>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bdfe5480-3705-4c45-aea3-6775b0d71806"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="EDITABLE" value="true"/>
                    </v:var>

                        <!-- /** @implements TxTimestampNotification_Object */ -->
                    <v:var name="TxTimestampNotification" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                Vendor specific: Timestamp of frames confirmations are reported through this callout function, if any controller has timestamp option enabled.
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="LABEL" value="Tx Timestamp Notification Function"/>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bdfe5480-3785-4c45-aea3-677530d71806"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="EDITABLE" value="true"/>
                    </v:var>

                    <!-- /** @implements CanEcucPartitionRef_Object */ -->
                    <v:lst name="CanEcucPartitionRef" type="">
                        <a:da name="MAX" value="2"/>
                        <v:ref name="CanEcucPartitionRef" type="REFERENCE">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html>
                                        ECUC_Can_00491. Maps the CAN driver to zero or multiple ECUC partitions to make the
                                        modules API available in this partition. The CAN driver will operate as an
                                        independent instance in each of the partitions.
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Can Ecuc Partition Ref"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" value="ECUC:b051dd0a-d2c6-4feb-b096-75f6bfac2fc9"/>
                            <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                        </v:ref>
                    </v:lst>

                    <!-- /** @implements CanCounterRef_Object */ -->
                    <v:ref name="CanOsCounterRef" type="REFERENCE">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN431_Conf. This parameter contains a reference to the counter, which is used by the CAN driver.
                                            <h1>Note:</h1> This node is unused, the using of OsCounter is done by selecting CanTimeoutMethod to OSIF_COUNTER_SYSTEM.
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Can Os Counter ref"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="OPTIONAL" value="false"/>
                        <a:a name="UUID" value="ECUC:9afcd54f-4c05-442a-b507-a07c4a44776c"/>
                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCounter"/>
                        <a:a name="READONLY" value="true"/>
                    </v:ref>

                    <v:ref name="CanSupportTTCANRef" type="REFERENCE">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    CAN430_Conf. Reference to CAN Hardware Object which shall be polled with the configured CanMainFunctionWritePeriod. <br>
                                                This reference shall only be configurable if more than one period is configured via CanMainFunctionWritePeriod.
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="CanSupportTTCANRef"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:44d6c263-9e9c-4446-a344-13905205e75d"/>
                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/CanIf/CanIfPrivateCfg"/>
                        <a:da name="EDITABLE" value="false"/>      
                    </v:ref>
                     
                    <!-- /** @implements CanSetBaudrateApi_Object */ -->
                    <v:var name="CanSetBaudrateApi" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[<html><p>
                                    If the parameter is set to true the Can_SetBaudrate Api shall be supported.<br/>
                                    </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="CanSetBaudrateApi"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bea19940-d399-4198-ac2a-ba7bd671188c"/>
                        <a:da name="DEFAULT" value="false"/>
                    </v:var>               

                    <!-- /** @implements CanApiEnableMbAbort_Object */ -->
                    <v:var name="CanApiEnableMbAbort" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:
                                <html>
                                    <p>
                                        Enables an additional API which request to abort the lowest priority pending transmission belonging to a channel <br/>
                                        Based on this value a define will be generated with STD_ON or STD_OFF value: CAN_43_LLCE_API_ENABLE_ABORT_MB.<br/>
                                    </p>
                                </html>
                                ]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="CanApiEnableMbAbort"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:9b35b214-4597-42bb-8db6-bdf3551ba29f"/>
                        <a:da name="DEFAULT" value="false"/>
                    </v:var>

                    <!-- /** @implements CanAbortOnlyOneMB_Object */ -->
                    <v:var name="CanAbortOnlyOneMB" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[
                                <html>
                                    <p>
                                        When this parameter is true only one MB will be aborted by Can_AbortMb()<br/>
                                        When this parameter is false all the associated message buffers will be aborted for a specific HTH <br/>
                                    </p>
                                </html>
                                ]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="CanAbortOnlyOneMB"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bea19938-d399-4198-ac2a-ba7bd671158c"/>
                        <a:da name="EDITABLE" type="XPath">
                            <a:tst expr="(../CanApiEnableMbAbort = 'true')"/>
                        </a:da>
                        <a:da name="DEFAULT" value="true"/>
                    </v:var>        

                    <v:var name="CanLlceEnableHeadlessMode" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[<html><p>
                                    Set if LLCE Headless mode will be used in any variant
                                    </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Enable Headless Mode "/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:4ed3d311-7b33-409d-bd5b-e3b349f48a15"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:da name="DEFAULT" value="false"/>
                    </v:var> 

                    <v:var name="CanLlceHeadlessModeUsed" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[<html><p>
                                    Set if LLCE is pre-loaded with a headless configuration for this variant
                                    </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Headless Mode Used"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:4ed3d311-7b33-409d-bd5b-e3b796f48a15"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:da name="DEFAULT" value="false"/>
                    </v:var>     

                    <v:var name="CanCustomRxFunction" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                            Defines the existence and the name of a callback function that is called after a successful reception of a CAN frame received through a custom filter.

                                            Leave disabled to stop callbacks in driver.
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:2851589D-765E-1014-89B1-B58ADEED15CC"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="EDITABLE" value="true"/>
                    </v:var>

                    <v:var name="CanWriteCustomCallback" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                            Defines the existence and the name of a callback function that is called for each frame pushed to LLCE firmware.
                                            It provides the HoH, swPduHandle and Message Buffer Index of the transmitted frame. When the callback is triggered,
                                            the message is already written into the buffer based on the Index value.
                                            Leave disabled to stop the callback in driver.
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:2851589D-765E-1014-89B1-C58ADEED15CC"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="EDITABLE" value="true"/>
                    </v:var>

                    <v:var name="CanTxConfirmationCustomCallback" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                            Defines the existence and the name of a custom callback function that is called for each Tx Confirmation received from LLCE firmware.
                                            It provides the HoH and swPduHandle.
                                            Leave disabled to stop the callback in driver.
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:2851589D-765E-1014-89B1-B58ADFED15CE"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="EDITABLE" value="true"/>
                    </v:var>

                    <v:var name="CanAuxFilterEnable" type="BOOLEAN">
                        <a:a name="DESC" value="This checkbox enables the CanAuxFilter."/>
                        <a:a name="VISIBLE" type="XPath" expr="text:contains(text:tolower(node:value(as:modconf('Resource')[1]/ResourceGeneral/ResourceSubderivative)), 's32g3')"/>
                        <a:a name="LABEL" value="CanAuxFilterEnable"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:df1c9137-0a7c-464e-920e-6581f9e5c9d0"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                    </v:var>

                    <v:var name="CanAuxFilterCallback" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                    Defines the existence and the name of a custom callback function that is called for RxLut2 result processing.
                                    Leave disabled to stop the callback in driver.
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:cacb22aa-e423-4222-868c-d6044f81d0d2"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="EDITABLE" value="true"/>
                    </v:var>

                    <v:var name="BusOffNotification" type="FUNCTION-NAME">
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:
                                <html><p>
                                Vendor specific: When the driver is configured in bus-off recovery (automatic or manual), 
                                the LLCE_ERROR_BUSOFF notification triggered by LLCE firmware will call this function, providing the u8CanIfCtrlId.
                                In case of Manual Bus Off Recovery, the user may get the controller out of bus-off confinement state
                                using the API Can_43_LLCE_ManualBusOffRecovery(uint8 u8Controller).
                                </p></html>
                                ]]>
                            </a:v>
                        </a:a>   
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="LABEL" value="Bus-Off Custom Notification"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bdfe5480-3705-4c35-aef3-6553b0d7d85f"/>
                        <a:da name="DEFAULT" value="NULL_PTR"/>
                        <a:da name="WARNING" type="XPath">
                            <a:tst expr="((../../CanConfigSet/CanController/*/ManualBusOffRecovery = 'true') or (../../CanConfigSet/CanController/*/AutomaticBusOffRecovery = 'true')) and (node:value(.) = 'NULL_PTR')" 
                            true="Bus-Off recovery mode requires a custom callout (to be defined/implemented by the user) which will be called by the driver when the Bus-Off event is triggered."/>
                        </a:da>
                        <a:da name="INVALID" type="XPath">                                                    
                            <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                        </a:da>
                        <a:da name="ENABLE" type="XPath" expr="(../../CanConfigSet/CanController/*/ManualBusOffRecovery = 'true') or (../../CanConfigSet/CanController/*/AutomaticBusOffRecovery = 'true')"/> 
                    </v:var>
                    
                    <!-- /** @implements CanMainFunctionRWPeriods_Object */ -->
                    <v:lst name="CanMainFunctionRWPeriods" type="MAP">
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(../../../CanConfigSet/CanHardwareObject/*/CanObjectType = 'RECEIVE') and (../../../CanConfigSet/CanController/*/CanRxProcessing = 'POLLING') and 
                                         (num:i(count(./*)) = 0)" 
                                    true="There is at least one controller that has Rx processing in polling."/>
                            <a:tst expr="(../../../CanConfigSet/CanHardwareObject/*/CanObjectType = 'TRANSMIT') and (../../../CanConfigSet/CanController/*/CanTxProcessing = 'POLLING') and  
                                         (num:i(count(./*)) = 0)" 
                                    true="There is at least one controller that has Tx processing in polling."/> 
                            <a:tst expr="(num:i(count(./*)) > 6)" 
                                    true="Current architecture supports maximum 6 polling classes."/>   
                        </a:da> 
                
                        <v:ctr name="CanMainFunctionRWPeriods" type="IDENTIFIABLE">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                        ECUC_Can_00437. This container contains the parameter for configuring the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item.<br>
                                        </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:05934e7e-6ba9-445a-9523-bbf57e55f7da"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            </a:a>                            
                            <!-- /** @implements CanMainFunctionPeriod_Object */ -->   
                            <v:var name="CanMainFunctionPeriod" type="FLOAT">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            ECUC_Can_00484. This parameter describes the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item. Unit is seconds.<br>
                                            Different poll-cycles will be configurable if more than one CanMainFunctionPeriod is configured. <br>
                                            In this case multiple Can_MainFunction_Read() or Can_MainFunction_Write() will be provided by the CAN Driver module.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:f37a95aa-c879-4bd3-bbc8-f65d3960e3a2"/>
                                <a:da name="DEFAULT" value="0.001"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=0.001"/>
                                    <a:tst expr="&lt;=65.535"/>
                                </a:da>
                            </v:var>
                            <v:var name="AckInterface" type="INTEGER">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            This parameter specifies the number of order of ACK interface for the current polling class. <br>
                                            First 16 interfaces are reserved for interrupt rx processing. <br>
                                            In case of multihost usecase, the user should take care to not assign same interfaces on different hosts.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:f37a95aa-c879-4bd3-bbc8-f65d3960e4a4"/>
                                <a:da name="DEFAULT" type="XPath" expr="num:i(node:fallback(node:current()/../@index, num:i(1)) + 16)"/>
                                <a:da name="RANGE" type="XPath">
                                    <a:tst expr="text:uniq(node:fallback(../../*/AckInterface, text:split('1 2 3')), node:fallback(.,1) )" false="Duplicated value, AckInterface must be unique across all polling classes."/>                                                 
                                </a:da>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=16"/>
                                    <a:tst expr="&lt;=21"/>
                                </a:da>
                            </v:var>
                            <v:var name="RxInterface" type="INTEGER">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            This parameter specifies the number of order of Rx interface for the current polling class. <br>
                                            First 16 interfaces are reserved for interrupt ack processing. <br>
                                            In case of multihost usecase, the user should take care to not assign same interfaces on different hosts.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:f37a95aa-c879-4bd3-bbc8-f65d3960e4b5"/>
                                <a:da name="DEFAULT" type="XPath" expr="num:i(node:fallback(node:current()/../@index, num:i(1)) + 16)"/>
                                <a:da name="RANGE" type="XPath">
                                    <a:tst expr="text:uniq(node:fallback(../../*/RxInterface, text:split('1 2 3')), node:fallback(.,1) )" false="Duplicated value, RxInterface must be unique across all polling classes."/>                                                 
                                </a:da>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=16"/>
                                    <a:tst expr="&lt;=21"/>
                                </a:da>
                            </v:var>
                        </v:ctr>
                    </v:lst>

                    <v:var name="CanPublicIcomSupport" type="BOOLEAN">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    Selects support of Pretended Network features in Can driver. Fixed to false (Pretended Networking not supported)<br>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LABEL" value="Pretended Networking Activation"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:06986fce-c0d5-402d-b7bd-1ffbb5f2d3e8"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:a name="VISIBLE" value="false"/>
                        <a:da name="EDITABLE" value="false"/>
                    </v:var>  
    
                    <v:ctr name="CanIcomGeneral" type="IDENTIFIABLE">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    This container contains the general configuration parameters of the ICOM Configuration<br>
                                   <b>PRETENDED NETWORKING IS NOT SUPPORTED ON THIS PLATFORM. This container is disabled</b>
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="UUID" value="ECUC:2b6f2e90-e380-4a78-bfc5-6cd6631cf1d6"/>
                        <a:da name="EDITABLE" value="false"/>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="VISIBLE" value="false">
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        
                        <v:var name="CanIcomLevel" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                        Defines the level of Pretended Networking.This parameter is reserved for future implementations (Pretended Networking level 2).<br>
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="OPTIONAL" value="true"/>
                            <a:a name="LABEL" value="Level of Pretended Networking"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:eb0670b6-e850-47ce-9d0b-1723d30be663"/>
                            <a:da name="DEFAULT" value="CAN_ICOM_LEVEL_ONE"/>
                            <a:da name="RANGE">
                                <a:v>CAN_ICOM_LEVEL_ONE</a:v>
                                <a:v>CAN_ICOM_LEVEL_TWO</a:v>
                            </a:da>
                            <a:da name="INVALID" type="XPath">
                              <a:tst expr="node:value(.)='CAN_ICOM_LEVEL_ONE'" false = "Current driver does not support CAN_ICOM_LEVEL_TWO" />
                            </a:da>
                            <a:da name="EDITABLE" type="XPath" expr="node:value(../../../CanGeneral/CanPublicIcomSupport) = 'true'"/>
                        </v:var>       
                            
                        <v:var name="CanIcomVariant" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                        Defines the variant, which is supported by this CanController<br>
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Variant of Pretended Networking"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:eb0670b6-e858-47ce-9d0b-1723d30be663"/>
                            <a:da name="DEFAULT" value="CAN_ICOM_VARIANT_NONE"/>
                            <a:da name="RANGE">
                                <a:v>CAN_ICOM_VARIANT_HW</a:v>
                                <a:v>CAN_ICOM_VARIANT_NONE</a:v>
                                <a:v>CAN_ICOM_VARIANT_SW</a:v>
                            </a:da>
                            <a:da name="EDITABLE" type="XPath" expr="node:value(../../../CanGeneral/CanPublicIcomSupport) = 'true'"/>
                            <a:da name="INVALID" type="XPath">
                              <a:tst expr="node:value(.)='CAN_ICOM_VARIANT_HW'" true = "Current driver does not support HW mode" />
                            </a:da>
                        </v:var> 
                    </v:ctr>    
                </v:ctr>
                
                <!-- /** @implements CanConfigSet_Object */ -->
                <v:ctr name="CanConfigSet" type="IDENTIFIABLE">
                    <a:a name="DESC">
                        <a:v>
                            <![CDATA[EN:<html><p>
                                CAN343_Conf. This is the multiple configuration set container for CAN Driver.<br>
                            </p></html>]]>
                        </a:v>
                    </a:a>
                    <a:a name="UUID" value="ECUC:8f338c5b-bc57-4a6a-b94d-e7cfacee8f7d"/>

                     <!-- /** @implements CanErrorReporting_Object */ -->
                    <v:ctr name="CanErrorReporting" type="IDENTIFIABLE">
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    This container includes the possible errors that CAN_43_LLCE plugin can issue.
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="UUID" value="ECUC:7ce530a5-c167-4b47-bf15-e7c9ea7b565b"/>

                        <v:var name="CAN_PROTOCOL_ERR" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                    <h1>This is recommended to be enabled only for debugging purposes, since it may generate very frequent notifications.</h1>
                                    This category includes the following errors:
                                    BIT0ERR This bit indicates when an inconsistency occurs between the transmitted and the received bit in a CAN frame
                                    BIT1ERR: This bit indicates when an inconsistency occurs between the transmitted and the received bit in a CAN frame
                                    ACKERR This bit indicates that an Acknowledge Error has been detected by the transmitter node, that is, a dominant bit has not been detected during the ACK SLOT.
                                    CRCERR:This bit indicates that a CRC Error has been detected by the receiver node in a CAN frame, that is, the calculated CRC is different from the received.                 
                                    STFERR: This bit indicates that a Stuffing Error has been detected by the receiver node in a CAN frame.
                                    FRMERR: This bit indicates that a Form Error has been detected by the receiver node in a CAN frame,that is, a fixed-form bit field contains at least one illegal bit
                                    OTHER_BCAN_ERR: 
                                    ERROVR(Error Overrun bit)- This bit indicates that an error condition occurred when any error bit is already set.
                                    DPCRCERR(Data phase Cyclic Redundancy Check Error)- This bit indicates that a CRC Error has been detected by the receiver node in the data phase
                                    of a CAN FD frame, that is, the calculated CRC is different from the received.
                                    DPFRMERR(Data phase form error) - This bit indicates that a Form Error has been detected by the receiver node in the data phase
                                    of a CAN FD frame, that is, a fixed-form bit field contains at least one illegal bit.
                                    DPSTFERR(Data phase stuff error) - This bit indicates that a Stuffing Error has been detected by the receiver node in the data
                                    phase of a CAN FD frame
                                    DPBIT0ERR(Data phase bit0 error) - This bit indicates when an inconsistency occurs between the transmitted and the received bit
                                    in the data phase of a CAN FD frame.
                                    DPBIT1ERR(Data phase bit1 error) - This bit indicates when an inconsistency occurs between the transmitted and the received bit
                                    in the data phase of a CAN FD frame
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="CAN PROTOCOL ERR"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" value="ECUC:f37a95aa-c879-4bd3-bbc8-f81d3960e3a2"/>
                            <a:da name="DEFAULT" value="IGNORE"/>
                            <a:da name="RANGE">
                                <a:v> IGNORE </a:v>
                                <a:v> INTERRUPT </a:v>
                                <a:v> POLLING </a:v>
                            </a:da>
                        </v:var>

                        <v:var name="CAN_PROTOCOL_WRN" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                     This category includes the following warnings:
                                      - Passive error state. PASSERR is set when BCAN enters Passive state.
                                      - Tx error warnings. TXWRN is set when the Tx error counter ECR[TEC] reached 96.
                                      - Rx error warnings. RXWRN is set when the Rx error counter ECR[REC] reached 96.
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="CAN PROTOCOL WRN"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" value="ECUC:9ec07372-0d46-41c3-85ea-5cb30345c4ff"/>
                            <a:da name="DEFAULT" value="INTERRUPT"/>
                            <a:da name="RANGE">
                                <a:v> IGNORE </a:v>
                                <a:v> INTERRUPT </a:v>
                                <a:v> POLLING </a:v>
                            </a:da>
                        </v:var>

                        <v:var name="DATALOST_ERR" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                     DATALOST event as described by Autosar standard.
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="DATA LOST ERR"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" value="ECUC:9ec07372-0d46-41c3-85ea-5cb30345c4bf"/>
                            <a:da name="DEFAULT" value="INTERRUPT"/>
                            <a:da name="RANGE">
                                <a:v> IGNORE </a:v>
                                <a:v> INTERRUPT </a:v>
                                <a:v> POLLING </a:v>
                            </a:da>
                        </v:var>

                        <v:var name="CONFIGURATION_ERR" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                    Configuration errors, like resources overflow, bad commands flow, bad command parameters, invalid indexes or any other errors caused by bad usage or a malicious host.
                                    Default set is 'IGNORE', because the same error codes are sent to host through shared memory area of each command.
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="CONFIGURATION ERR"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" value="ECUC:4dc48bf7-4f5a-42bb-a4fd-53196a756498"/>
                            <a:da name="DEFAULT" value="IGNORE"/>
                            <a:da name="RANGE">
                                <a:v> IGNORE </a:v>
                                <a:v> INTERRUPT </a:v>
                                <a:v> POLLING </a:v>
                            </a:da>
                        </v:var>

                        <v:var name="INTERNAL_ERR" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                    Internal errors, like timeouts, empty/full fifos or other software errors.
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="INTERNAL ERR"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" value="ECUC:8c3256f3-d912-477a-b444-9487b06d0c97"/>
                            <a:da name="DEFAULT" value="INTERRUPT"/>
                            <a:da name="RANGE">
                                <a:v> IGNORE </a:v>
                                <a:v> INTERRUPT </a:v>
                                <a:v> POLLING </a:v>
                            </a:da>
                        </v:var>

                        <!-- /** @implements CanErrorNotif_Object */ -->
                        <v:var name="CanErrorNotif" type="FUNCTION-NAME">
                            <a:a name="DESC">
                                <a:v><![CDATA[EN:
                                    <html><p>
                                    Vendor specific: The errors triggered by LLCE firmware will call this function. 
                                    </p></html>
                                    ]]>
                                </a:v>
                            </a:a>   
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="LABEL" value="Can Error Notification"/>
                            <a:a name="OPTIONAL" value="true"/>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:bdfe5480-3705-4c45-aea3-6515b0d7d806"/>
                            <a:da name="DEFAULT" value="NULL_PTR"/>
                            <a:da name="INVALID" type="XPath">                                                    
                                <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" 
                                    false="Invalid name of the call out function. Must be valid C function name or NULL_PTR."/>                    
                            </a:da>
                            <a:da name="EDITABLE" value="true"/>
                        </v:var>

                        <v:var name="CanMainFunctionErrorEn" type="BOOLEAN">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html>
                                        Enables/Disables  MainFunction_ErrorNotification API for reporting the errors configured in POLLING.
                                        <h1>Note</h1>Implementation Specific parameter. Not AutoSar Required.
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Can MainFunctionError Enable"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:45d2272d-76d5-4d4d-b114-5b81de297f2c"/>
                            <a:da name="DEFAULT" value="false"/>
                            <a:da name="INVALID" type="XPath">                                                    
                                <a:tst expr="not(node:exists(../CanErrorNotif) and (normalize-space(../CanErrorNotif) != 'NULL_PTR')) and (node:value(.) = 'true')" 
                                    true="Callout function should be defined when MainFunction_ErrorNotification is set to enabled"/>                    
                            </a:da>
                        </v:var>

                    </v:ctr>

                    <v:lst name="CanController" type="MAP">
                        <a:da name="MIN" value="1"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="num:i(count(node:current()/*)) &gt; 16" 
                                        true="Maximum CAN Controllers available for the selected derivative was exceeded."/>
                        </a:da>

                        <!-- /** @implements CanController_Object */ -->
                        <v:ctr name="CanController" type="IDENTIFIABLE">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                        CAN354_Conf. This container contains the configuration parameters of the CAN controller(s).<br>
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:2b6f2e90-e380-4a78-bfc4-6ae6631cf1d6"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            </a:a>                        
                            <v:var name="CanHwChannel" type="ENUMERATION">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Specifies which one of the on-chip interfaces is associated with this controller ID.<br>
                                            <b>Note</b>Implementation Specific parameter. Not AutoSar Required.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Hardware Channel"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:e4482b90-209f-4bbb-bd65-a7ca3b21a48c"/>
                                <a:da name="DEFAULT" value="BCAN_0"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="text:uniq(../../*/CanHwChannel, .)" false="Duplicate physical CAN channel"/>
                                </a:da>
                                <a:da name="RANGE">
                                    <a:v> BCAN_0  </a:v>
                                    <a:v> BCAN_1  </a:v>
                                    <a:v> BCAN_2  </a:v>
                                    <a:v> BCAN_3  </a:v>
                                    <a:v> BCAN_4  </a:v>
                                    <a:v> BCAN_5  </a:v>
                                    <a:v> BCAN_6  </a:v>
                                    <a:v> BCAN_7  </a:v>
                                    <a:v> BCAN_8  </a:v>
                                    <a:v> BCAN_9  </a:v>
                                    <a:v> BCAN_10 </a:v>
                                    <a:v> BCAN_11 </a:v>
                                    <a:v> BCAN_12 </a:v>
                                    <a:v> BCAN_13 </a:v>
                                    <a:v> BCAN_14 </a:v>
                                    <a:v> BCAN_15 </a:v>
                                </a:da>
                            </v:var>

                            <v:var name="RWDestInterface" type="ENUMERATION">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            FIFO Interface ID used for interrupt processing:
                                            1. to send the frames received by a filter configured for CanHwChannel (LLCE_FIFO_RXOUT_BASE_ADDRESS(x)). <br>
                                            2. to acknowledge the frames sent by CanHwChannel (LLCE_FIFO_TXACK_BASE_ADDRESS(x)). <br>
                                            Default value is 1 to 1 mapped with Can Hardware Channel. <br>
                                            <b>Note</b>Usage of this field may violate AutoSar standard.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="RX/ACK Interface"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:e4482b90-209f-4cbb-bd65-a7ca3b23a46c"/>
                                <a:da name="DEFAULT" value="FIFO_INTERFACE_0"/>
                                <a:da name="RANGE">
                                    <a:v> FIFO_INTERFACE_0  </a:v>
                                    <a:v> FIFO_INTERFACE_1  </a:v>
                                    <a:v> FIFO_INTERFACE_2  </a:v>
                                    <a:v> FIFO_INTERFACE_3  </a:v>
                                    <a:v> FIFO_INTERFACE_4  </a:v>
                                    <a:v> FIFO_INTERFACE_5  </a:v>
                                    <a:v> FIFO_INTERFACE_6  </a:v>
                                    <a:v> FIFO_INTERFACE_7  </a:v>
                                    <a:v> FIFO_INTERFACE_8  </a:v>
                                    <a:v> FIFO_INTERFACE_9  </a:v>
                                    <a:v> FIFO_INTERFACE_10 </a:v>
                                    <a:v> FIFO_INTERFACE_11 </a:v>
                                    <a:v> FIFO_INTERFACE_12 </a:v>
                                    <a:v> FIFO_INTERFACE_13 </a:v>
                                    <a:v> FIFO_INTERFACE_14 </a:v>
                                    <a:v> FIFO_INTERFACE_15 </a:v>
                                </a:da>
                            </v:var>

                            <!-- /** @implements CanControllerActivation_Object */ -->
                            <v:var name="CanControllerActivation" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN315_Conf. Defines if a CAN controller is used in the configuration.<br>
                                            Deactivation of a particular CAN controller is equivalent to a CAN controller not used in the configuration.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Controller Activation"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                               <a:a name="SCOPE" value="LOCAL"/>
                               <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:06986fce-c0d5-402d-b7bd-1ffbb5f2d3e9"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>
                            
                            <v:var name="CanControllerBaseAddress" type="INTEGER">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN382_Conf. Specifies the CAN controller base address. <br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Controller Base Address"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:7e05d78c-5cc5-497b-9e7e-3a2d2b8af107"/>
                                <a:da name="DEFAULT" value="0"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=0"/>
                                    <a:tst expr="&lt;=4294967295"/>
                                </a:da>
                                <a:da name="EDITABLE" value="false" />
                            </v:var>
                            
                            <v:var name="CanControllerIcomSupported" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Define if the current controller support Pretended Networking (Icom)

                                            <b>PRETENDED NETWORKING IS NOT SUPPORTED ON THIS PLATFORM. Fixed to false</b>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Controller Icom Supported"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:06986fce-cfd5-402d-b7bd-1ffbb5f2d3e9"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:a name="VISIBLE" value="false"/>
                                <a:da name="EDITABLE" type="XPath">
                                    <a:tst expr="node:value(../../../../CanGeneral/CanPublicIcomSupport)='true'"/>
                                </a:da>
                                <a:da name="INVALID" type="XPath">
                                  <a:tst expr="true or node:value(.) = 'false'" false="This controller does not support Pretended Networking (Icom), please disable this node."/>
                                </a:da>
                            </v:var>
                            
                            <!-- /** @implements CanControllerId_Object */ -->
                            <v:var name="CanControllerId" type="INTEGER">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN316_Conf: This parameter provides the controller ID which is unique in a given CAN Driver.<br>
                                            The value for this parameter starts with 0 and continue without any gaps.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Controller ID"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                                <a:a name="UUID" value="ECUC:18522ce9-9ce2-41d0-a0db-b0a4cf879264"/>
                                <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(1))"/>
                                <a:da name="RANGE" type="XPath">
                                    <a:tst expr="(node:fallback(.,1) &gt;= 0) and (node:fallback(.,1) &lt; num:i(count(node:fallback(node:current()/../../*, 1 ))))" false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the Calc button to calculate correct default value."/>
                                    <a:tst expr="text:uniq(node:fallback(../../*/CanControllerId, text:split('1 2 3')), node:fallback(.,1) )" false="Duplicated value, CanControllerId must be unique across all Can controllers. Use the Calc button to calculate correct default value."/>                                                 
                                </a:da>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&gt;=0"/>
                                    <a:tst expr="&lt;=255"/>
                                </a:da>
                            </v:var>

                            <!-- /** @implements CanRxProcessing_Object */ -->
                            <v:var name="CanRxProcessing" type="ENUMERATION">
                                <a:a name="CALCULATION-FORMULA" value="Mode of event triggering: interrupt or polling."/>
                                <a:a name="CALCULATION-LANGUAGE" value="INFORMAL"/>
                                <a:a name="DERIVED" value="TRUE"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN317_Conf. Enables/Disables API Can_MainFunction_Read() for handling PDU reception events in polling mode.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Rx Processing Type"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:f55d547d-37c7-4393-b930-c3cb7b7678b2"/>
                                <a:da name="DEFAULT" value="POLLING"/>
                                <a:da name="RANGE">
                                    <a:v>INTERRUPT</a:v>
                                    <a:v>POLLING</a:v>
                                    <a:v>MIXED</a:v>
                                </a:da>
                            </v:var>

                            <!-- /** @implements CanTxProcessing_Object */ -->
                            <v:var name="CanTxProcessing" type="ENUMERATION">
                                <a:a name="CALCULATION-FORMULA" value="Mode of event triggering: interrupt or polling."/>
                                <a:a name="CALCULATION-LANGUAGE" value="INFORMAL"/>
                                <a:a name="DERIVED" value="TRUE"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN318_Conf. Enables/Disables API Can_MainFunction_Write() for handling PDU transmission events in polling mode
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Tx Processing Type"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:7d955c0a-ac24-4c77-96c8-145fd72fa124"/>
                                <a:da name="DEFAULT" value="POLLING"/>
                                <a:da name="RANGE">
                                    <a:v>INTERRUPT</a:v>
                                    <a:v>POLLING</a:v>
                                    <a:v>MIXED</a:v>
                                </a:da>
                            </v:var>

                            <!-- /** @implements CanBusoffProcessing_Object */ -->
                            <v:var name="CanBusoffProcessing" type="ENUMERATION">
                                <a:a name="CALCULATION-FORMULA" value="Mode of event triggering: interrupt or polling."/>
                                <a:a name="CALCULATION-LANGUAGE" value="INFORMAL"/>
                                <a:a name="DERIVED" value="TRUE"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN314_Conf. Enables/Disables API Can_MainFunction_BusOff() for handling busoff events in polling mode.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can BusOff Processing Type"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:0db6e1d2-2097-4965-9197-0fb6928ea144"/>
                                <a:da name="DEFAULT" value="POLLING"/>
                                <a:da name="RANGE">
                                    <a:v>INTERRUPT</a:v>
                                    <a:v>POLLING</a:v>
                                </a:da>
                            </v:var>

                            <v:var name="CanWakeupFunctionalityAPI" type="BOOLEAN">
                            <a:a name="DESC" value="EN: Adds / removes the service Can_CheckWakeup() from the code."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                value="ECUC:aacae875-cf85-4e9d-806b-2bebeb817737"/>
                            <a:da name="DEFAULT" value="false"/>
                            </v:var>
                            
                            <v:var name="CanWakeupProcessing" type="ENUMERATION">
                                <a:a name="CALCULATION-FORMULA" value="Mode of event triggering: interrupt or polling."/>
                                <a:a name="CALCULATION-LANGUAGE" value="INFORMAL"/>
                                <a:a name="DERIVED" value="TRUE"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN319_Conf. Enables/Disables API Can_MainFunction_Wakeup() for handling wakeup events in polling mode.<br><br>
                                            <b>Note</b>This option is enabled only if global parameter [CanController/CanWakeupsupport] is 'true'.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Wakeup Processing Type"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:cd2c7e0d-b5a9-4b48-ac4f-b62a2f9fc05a"/>
                                <a:da name="DEFAULT" value="POLLING"/>
                                <a:da name="EDITABLE" type="XPath" expr="../CanWakeupSupport = 'true'"/>
                                <a:da name="RANGE">
                                    <a:v>INTERRUPT</a:v>
                                    <a:v>POLLING</a:v>
                                </a:da>
                            </v:var>

                            <v:var name="CanWakeupSupport" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN330_Conf. CAN driver support for wakeup over CAN Bus.<br>
                                            Every WakeUp process will be ignore if this checkbox is not set to ON.<br>
                                            This parameter enables Internal Wakeup (using controller registers) and External Wakeup (using WKUP module).<br>
                                            This is enabled only if internal Wakeup is supported by the platform.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Wakeup Support"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:8ca7640d-7a8e-4ee5-95d9-55530002ef55"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="EDITABLE" value="false" />
                            </v:var>

                            <v:var name="CanTimeStampEnable" type="ENUMERATION">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p> 
                                            Enables CAN to put timestamp on frames.<br>
                                            <b>Note</b>Implementation specific Parameter. Not AutoSar Required.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can TimeStamp Enable"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:64911420-9960-4cf1-99c3-f27e9587d310"/>
                                <a:da name="DEFAULT" value="DISABLE"/>
                                <a:da name="RANGE">
                                    <a:v>DISABLE</a:v>
                                    <a:v>END_OF_FRAME</a:v>
                                    <a:v>START_OF_FRAME</a:v>
                                    <a:v>CAN_START_OF_FRAME_CANFD_RES</a:v>
                                </a:da>
                            </v:var>

                            <v:var name="CanProtocolException" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Enable Protocol Exception feature in the BCAN controller during initialization.<br>
                                            Enable of this feature will allow that BCAN controller to set <br>
                                            an interrupt status flag whenever a specific protocol error is detected.<br>
                                            <b>Note</b>Implementation specific Parameter. Not AutoSar Required.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Protocol Exception"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:64911420-9960-4cf1-99c3-f27e9587d311"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>

                            <v:var name="CanListenOnlyMode" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                            <p>
                                                Enables the Listen Only Mode (CTRL[LOM] bit).<br>
                                                In this mode, transmission is disabled, all error counters are frozen and the module operates in a CAN Error Passive mode.<br>
                                                <h1>Note</h1>Implementation specific Parameter. Not AutoSar Required.
                                            </p>
                                        </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Listen-Only Mode"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:64911420-9960-4cf1-99c3-f27ed588d371"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>

                            <v:var name="CanLoopBackMode" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                            <p>
                                                CTRL[LPB]: Enables CAN to operate in Loop Back Mode.<br>
                                                The bit stream output of the transmitter is fed back internally to the receiver input.<br>
                                                The Rx CAN input pin is ignored and the Tx CAN output goes to the recessive state (logic "1").<br>
                                                <h1>Note</h1>Implementation specific Parameter. Not AutoSar Required.
                                            </p>
                                        </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can LoopBack Mode"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:64911420-9960-4c41-adc3-f27ed588d471"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>

                            <v:var name="SelfReceptionEnable" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html> 
                                            <p>
                                                CTRL[SRXEN]: Enables CAN to receive frames transmitted by itself.<br>
                                                This bit purpose is for debug, it is recommended keeping it disabled to avoid overload.<br>
                                                <h1>Note</h1>Implementation specific Parameter. Not AutoSar Required.
                                            </p>
                                        </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Self Reception Enable"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:64911420-9960-4c41-adc3-d37ed588d476"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>
                            
                            <!-- /** @implements CanTxFifoMode_Object */ -->
                            <v:var name="CanTxFifoMode" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html> 
                                            <p>
                                                This field defines how the TX messages are processed: in a FIFO manner or based
                                                on the bus arbitration argorithm.
                                            </p>
                                        </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Tx FIFO Mode"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:c24998ef-e920-43ad-b10f-65c7d2d0dde8"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>
                            
                            <!-- /** @implements AutomaticBusOffRecovery_Object */ -->
                            <v:var name="AutomaticBusOffRecovery" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html> 
                                            <p>
                                                This field defines how BCAN recovers from bus-off state. If this field is checked, the module
                                                recovers automatically from bus-off state after 128 occurrences of 11 recessive bits. If the bit
                                                is unchecked, automatic recovery from bus-off is disabled and the module remains in bus-off state
                                                until the BCAN is started by the user (As per AUTOSAR) and 128 occurrences of 11 recessive bits have occurred.
                                            </p>
                                        </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Automatic Bus Off Recovery"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:64911420-9960-4c41-adc3-d37ad588d376"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="(node:value(.) = 'true') and (../ManualBusOffRecovery = 'true')" true="Auto bus off recovery is available only when Manual bus off recovery is disabled"/>
                                </a:da>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>

                            <v:var name="ManualBusOffRecovery" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html> 
                                            <p>
                                                A new API is exposed: Can_43_LLCE_ManualBusOffRecovery(uint8 u8Controller).
                                                Enabling this setting overwrites the Autosar requirement for busoff: it does not set the controller to STOP
                                                and it does not call the CanIf callout. Instead, a user defined callout shall be defined as BusOffNotification.
                                                This field defines how BCAN recovers from bus-off state. If this field is checked, the module
                                                remains in bus-off state until the user manually requets the controller to recover from bus-off state
                                                without flushing the outstanding TX or RX frames. The controller is considered started and LLCE may 
                                                accept and store new transmissions, which will be serviced as soons as the offending condition is removed
                                                and the user calls the exposed API.
                                            </p>
                                        </html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Manual Bus Off Recovery"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:64911420-9960-4c41-adc3-d37ad588d377"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="(node:value(.) = 'true') and (../AutomaticBusOffRecovery = 'true')" true="Manual bus off recovery is available only when Auto bus off recovery is disabled"/>
                                </a:da>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>


                            <!-- /** @implements CanControllerDefaultBaudrate_Object */ -->
                           <v:ref name="CanControllerDefaultBaudrate" type="REFERENCE">
                                <a:a name="DESC">
                                   <a:v>
                                       <![CDATA[EN:<html><p>
                                           CAN435_Conf. Reference to baudrate configuration container configured for the Can Controller.<br>
                                         </p></html>]]>
                                   </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can Controller Default Baudrate"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="UUID" value="ECUC:9171c656-7a2a-4262-833a-a95e19a91f22"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Can/CanConfigSet/CanController/CanControllerBaudrateConfig"/>
                                <a:da name="INVALID" type="XPath" expr="node:refvalid(.)" false="The configured node does not exist or may not be referenced.Please select the default baudrate from CanControllerBaudrateConfig container"/>
                           </v:ref>

                                    <!-- /** @implements CanControllerEcucPartitionRef_Object */ -->
                                    <v:ref name="CanControllerEcucPartitionRef" type="REFERENCE">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    ECUC_Can_00492. Maps the CAN controller to zero or one ECUC partitions. The ECUC
                                                    partition referenced is a subset of the ECUC partitions where the CAN
                                                    driver is mapped to.
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Controller Ecuc Partition Ref"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="UUID" value="ECUC:b051dd0a-d2c6-4feb-b096-75f6bfac2fd0"/>
                                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:exists(.) and node:containsValue(../../../../CanGeneral/CanEcucPartitionRef/*, .)" false="The ECUC partitions referenced by
                                                    CanControllerEcucPartitionRef shall be a subset of the ECUC partitions referenced by CanEcucPartitionRef"/>
                                        </a:da>
                                    </v:ref>
                            <!-- /** @implements CanCpuClockRef_Object */ -->
                            <v:ref name="CanCpuClockRef" type="REFERENCE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN313_Conf. Reference to the CPU clock configuration, which is set in the MCU driver configuration.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="LABEL" value="Can CPU Reference Clock"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="UUID" value="ECUC:b051dd0a-d2c6-4feb-b096-75f6bfac2fc6"/>
                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint"/>
                                <a:da name="INVALID" type="XPath"> 
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/> 
                                </a:da>

                            </v:ref>

                            <v:ref name="CanWakeupSourceRef" type="REFERENCE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            CAN359_Conf. This parameter contains a reference to the Wakeup Source for this controller as defined in the ECU State Manager.<br>
                                            Type: reference to EcuM_WakeupSourceType<br>
                                            EcuM plugin need to be added and then give the reference to it.<br>
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                      
                                <a:da name="EDITABLE" type="XPath">
                                    <a:tst expr="../CanWakeupSupport = 'true'"/>
                                </a:da>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:da name="ENABLE" value="false"/>
                                <a:a name="UUID" value="ECUC:6911183d-488d-4301-a720-4f9bdae57496"/>                    
                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuM/EcuMConfiguration/EcuMCommonConfiguration/EcuMWakeupSource"/>
                            </v:ref>

                            <!-- /** @implements CanControllerBaudrateConfig_Object */ -->
                            <v:lst name="CanControllerBaudrateConfig" type="MAP">
                                <a:da name="MIN" value="1"/>
                                <v:ctr name="CanControllerBaudrateConfig" type="IDENTIFIABLE">
                                    <a:a name="DESC" value="EN: CAN351. This container contains the configuration (parameters) of the CAN Filter Mask(s)."/>
                                    <a:a name="UUID" value="ECUC:bccf9928-1567-49a4-b767-a40100af5bcf"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>

                                    <v:var name="CanAdvancedSetting" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                    <p>
                                                        If TRUE initiates the derivation of the CAN bit timing values from the CanControllerBaudRate parameter.<br> 
                                                        When this option is True the CanControllerPropSeg, CanControllerSeg1, CanControllerSeg2, CanControllerSyncJumpWidth are disabled because are background calculated.<br>
                                                    </p>
                                                </html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Automatic Time Segments Calculation"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:62203346-f039-4f35-8309-0bdba6a0a555"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    <v:var name="CanBusLength" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Specifies the CAN Bus length in meters.<br>
                                                    This parameter is used for PROPSEG parameter calculation when "CanAdvancedSetting" control is set to true.<br>
                                                    <h1>Note</h1>Implementation specific Parameter.
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Bus Length (meters)"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:2e9c3e9c-ff1a-4810-a2b4-92e8220d322b"/>
                                        <a:da name="DEFAULT" value="40"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=1"/>
                                            <a:tst expr="&lt;=5000"/>
                                        </a:da>
                                        <a:da name="ENABLE" type="XPath" expr="../CanAdvancedSetting = 'true'"/>
                                    </v:var>

                                    <v:var name="CanPropDelayTranceiver" type="FLOAT">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Propagation delay of Transceiver used in nanoseconds.
                                                    <h1>Note</h1>Implementation specific Parameter.<br>
                                                    The calculation for the CAN bit timing is implemented in the code template.<br>
                                                    The Formulas used in the code template for calculation are as follows.<br>
                                                    Physical delay of bus = Bus length * Bus propagation delay.<br>
                                                    tPROP_SEG = 2(Physical delay of bus +CanPropDelayTranceiver ).<br>
                                                    PROP_SEG = ROUND_UP (tPROP_SEG/Bus propagation delay).<br>
                                                    Based on these calculations implemented in the Code template the consistency check is maintained for CanPropDelayTranceiver parameter.<br>
                                                    The PROP_SEG parameter need to be a integral value and not fractional value.
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Propagation Delay Transceiver (ns)"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:8495da78-1d7c-463f-a081-9af6153bced6"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=5000"/>
                                        </a:da>
                                        <a:da name="DEFAULT" value="150"/>
                                        <a:da name="ENABLE" type="XPath" expr="../CanAdvancedSetting = 'true'"/>
                                    </v:var>
                                    
                                    <v:var name="CanControllerCheckCanStandard" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    <b>Note</b>
                                                    <p>EN: If enabled, Can Plugin checks that CanControllerPropSeg, CanControllerSeg1, CanControllerSeg2 and CanControllerSyncJumpWidth settings
                                                    match the CAN Standard Compliant Bit Time Segment Settings.
                                                    </p>
                                                    <p>See the following table for details:</p>
                                                        <table>
                                                            <tr>
                                                            <th>CanControllerPropSeg + CanControllerSeg1</th>
                                                            <th>CanControllerSeg2</th>
                                                            <th>CanControllerSyncJumpWidth</th>
                                                            </tr>
                                                            <tr> <td>[5 .. 10]</td> <td>2</td> <td>[1 .. 2]</td> </tr>
                                                            <tr> <td>[4 .. 11]</td> <td>3</td> <td>[1 .. 3]</td> </tr>
                                                            <tr> <td>[5 .. 12]</td> <td>4</td> <td>[1 .. 4]</td> </tr>
                                                            <tr> <td>[6 .. 13]</td> <td>5</td> <td>[1 .. 4]</td> </tr>
                                                            <tr> <td>[7 .. 14]</td> <td>6</td> <td>[1 .. 4]</td> </tr>
                                                            <tr> <td>[8 .. 15]</td> <td>7</td> <td>[1 .. 4]</td> </tr>
                                                            <tr> <td>[9 .. 16]</td> <td>8</td> <td>[1 .. 4]</td> </tr>
                                                        </table>
                                                    <p><b>Note</b>Implementation Specific parameter. Not AutoSar Required.</p>
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Time Segments Checking"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:64e64fg7-6427-4cb0-a3f4-b6c1af05ba2a"/>
                                        <a:da name="DEFAULT" value="true"/>
                                        <a:da name="READONLY" type="XPath" expr="../CanAdvancedSetting = 'true'"/>
                                    </v:var>                                   

                                    
                                    <v:var name="CanControllerPrescaller" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Specifies the prescaller for the controller .<br>
                                                    The calculation of the resulting CanControllerTimeQuanta value depending on module clocking and prescaller shall be done offline.<br>
                                                    Prescaler = FreqCanClk / FreqTq; FreqTq = 1 / CanControllerTimeQuanta .<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Controller Prescaller"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:a72da830-6439-46e6-81c8-7c3fd6a65c10"/>
                                        <a:da name="RANGE" type="XPath">
                                                <a:tst expr="((. &gt;=1) and (. &lt;=1023))" false = "Value is out of range [1, 1023] configurable in BCAN"/>
                                        </a:da>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=1"/>
                                            <a:tst expr="&lt;=1023"/>
                                        </a:da>
                                        <a:da name="DEFAULT" value="16"/>
                           
                                    </v:var>
                                 <!-- /** @implements CanControllerBaudRateConfigID_Object */ -->
                                    <v:var name="CanControllerBaudRateConfigID" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Uniquely identifies a specific baud rate configuration. This ID is used by 
                                                    SetBaudrate API<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Controller BaudRate Config ID "/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>                                            
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:a72da830-6439-46e6-81c8-6c4fd6a85c00"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=65535"/>
                                        </a:da>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:uniq(../../*/CanControllerBaudRateConfigID, .)" false="Duplicate config ID"/>
                                        </a:da>
                                         <a:da name="EDITABLE" type="XPath">
                                             <a:tst expr="(node:exists(../../../../../../CanGeneral/CanSetBaudrateApi)) and (../../../../../../CanGeneral/CanSetBaudrateApi = 'true')"/>
                                        </a:da>
                                    </v:var>
 

                                    <!-- /** @implements CanControllerBaudRate_Object */ -->
                                    <v:var name="CanControllerBaudRate" type="FLOAT">
                                        <a:a name="LABEL" value="Can Controller BaudRate (Kbps)"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    CAN005_Conf. Specifies the buadrate of the controller in kbps.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:cde9b6db-6c79-4cca-a995-fee4c779ea9b"/>
                                        <a:da name="DEFAULT" type="XPath" expr="1 div((num:i( node:fallback(../CanControllerPropSeg, 5)) + num:i( node:fallback(../CanControllerSeg1, 5)) + 
                                                                                       num:i( node:fallback(../CanControllerSyncSeg, 1)) + num:i( node:fallback(../CanControllerSeg2, 6))) *
                                                                                      (num:i( node:fallback(../CanControllerPrescaller, 16)) div 
	                                                                                   num:i(node:fallback('->node:ref(../../../CanCpuClockRef)/McuClockReferencePointFrequency', 40000000))) * 1000)"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:uniq(node:fallback(../../*/CanControllerBaudRate, text:split('0')), node:fallback(.,1))" false="Duplicate CAN BaudRate configured. Please select the different CanControllerBaudRate in the CanControllerBaudrateConfig container of the same controller"/>
                                        </a:da>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=1000"/>
                                        </a:da>
                                        <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(node:value(.) &gt;=1001)"
                                                true="Maximum communication transfer rate is up to 1000 kbps for CAN due to protocol limits"/>
                                        </a:da>
                                        <a:da name="EDITABLE" value="true"/>
                                    </v:var>

                                    <v:var name="CanControllerSyncSeg" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    The Synchronization Segment or SYNC_SEG time interval is used to synchronize all the nodes across the network.<br>
                                                    The SYNC_SEG time interval has a fixed period of one Time Quantum (TQ).<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Synchronization Segment"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:b2255b82-c990-4a04-915a-f9bba0a5d781"/>
                                        <a:da name="DEFAULT" value="1"/>  
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=1"/>
                                            </a:da>
                                        <a:da name="READONLY" value="true" />                                            
                                    </v:var>
                                    
                                    <!-- /** @implements CanControllerPropSeg_Object */ -->
                                    <v:var name="CanControllerPropSeg" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    CAN073_Conf. It is used to compensate the physical delay within the CAN network (CTRL[PROPSEG] - 0..7).<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Propagation Segment"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:b4433b82-c990-4a04-915a-f9cca0a5c891"/>
                                        <a:da name="DEFAULT" value="5"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=255"/>
                                        </a:da>
                                        <a:da name="READONLY" type="XPath" expr="../CanAdvancedSetting = 'true'"/>
                                    </v:var>

                                    <!-- /** @implements CanControllerSeg1_Object */ -->
                                    <v:var name="CanControllerSeg1" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    CAN074_Conf. Specifies the Phase Segment 1 in time quantas.<br>
                                                    PHASE_BUF_SEG1 = (PSEG1 + 1) * Tq .<br>
                                                    The PHASE_BUF_SEG1 valid values are 2-256 Tq.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Phase Segment 1"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:3cef4e6f-8203-40c8-97f7-1d9f7ac94e73"/>
                                        <a:da name="DEFAULT" value="5"/>
                                        <a:da name="RANGE" type="XPath">
                                                <a:tst expr="((. + num:i(node:current()/../CanControllerPropSeg)) &gt;=2)" 
                                                false = "In nominal bit time, Time Segment 1 (Phase_Seg1 + PropSeg) shall be greater than or equal to 2."/>
                                        </a:da>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=2"/>
                                            <a:tst expr="&lt;=255"/>
                                        </a:da>
                                        <a:da name="READONLY" type="XPath" expr="../CanAdvancedSetting = 'true'"/>
                                    </v:var>

                                    <!-- /** @implements CanControllerSeg2_Object */ -->
                                    <v:var name="CanControllerSeg2" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    The PHASE_BUF_SEG2 valid values are 2-128 Tq.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Phase Segment 2"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:8fc49e8b-beed-4fe1-9fe5-8e5218967d0b"/>
                                        <a:da name="DEFAULT" value="6"/>
                                        <a:da name="RANGE" type="XPath">
                                                <a:tst expr="(. &gt;=(num:i(node:current()/../CanControllerSyncJumpWidth)) and . &gt;=2)" 
                                                false = "In nominal bit time, Phase_Seg2 shall be greater than or equal to the maximum of these two items: SJW and the information processing time,which value is 2 time quanta in BCAN."/>
                                                <a:tst expr="((. + num:i(node:current()/../CanControllerSeg1) + num:i(node:current()/../CanControllerPropSeg) + num:i(node:current()/../CanControllerSyncSeg)) &gt;=8)" 
                                                false = "The data phase bit time (defined by the sum of Phase Seg1 + Propagation Seg + Sync Seg + Phase Seg2) must not be smaller than 8 time quanta."/>
                                        </a:da>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=2"/>
                                            <a:tst expr="&lt;=128"/>
                                        </a:da>
                                        <a:da name="READONLY" type="XPath" expr="../CanAdvancedSetting = 'true'"/>
                                    </v:var>

                                    <!-- /** @implements CanControllerSyncJumpWidth_Object */ -->
                                    <v:var name="CanControllerSyncJumpWidth" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    <b>Note</b>Implementation specific Parameter. Not AutoSar required.<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Can Resynch Jump Width"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:1762af43-3493-4392-a39a-aaff019a96a5"/>
                                        <a:da name="DEFAULT" value="1"/>
                                        <a:da name="RANGE" type="XPath">
                                                <a:tst expr="(. &lt;=(num:i(node:current()/../CanControllerSeg1)) and . &lt;=(num:i(node:current()/../CanControllerSeg2)))" 
                                                false = "In nominal bit time and in data bit time, SJW shall be less than or equal to the minimum of these two items: Phase_Seg1 and Phase_Seg2."/>
                                        </a:da>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=127"/>
                                        </a:da>
                                        <a:da name="READONLY" type="XPath" expr="../CanAdvancedSetting = 'true'"/>
                                    </v:var>

                                    <!-- /** @implements CanControllerFdBaudRateConfig_Object */ -->
                                    <v:ctr name="CanControllerFdBaudrateConfig" type="IDENTIFIABLE">
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:a name="UUID" 
                                               value="ECUC:a9ffd090-0ca8-40b5-bea6-d822478c69c3"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    <br>This optional container contains bit timing related configuration parameters of the CAN controller(s) for payload and CRC of a CAN FD frame. If this container exists the controller supports CAN FD frames.
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>

                                        <v:var name="CanAdvancedSettingFd" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        If TRUE initiates the derivation of the CAN bit timing values from the CanControllerBaudRate parameter.<br> 
                                                        When this option is True the CanControllerPropSeg, CanControllerSeg1, CanControllerSeg2, CanControllerSyncJumpWidth are disabled because are background calculated.<br>
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can Automatic Time Segments Calculation"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:62203346-f039-4f35-8309-0bdba6a0a5f5"/>
                                            <a:a name="OPTIONAL" value="true"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                        <v:var name="CanBusLengthFd" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        Specifies the CAN Bus length in meters.<br>
                                                        This parameter is used for PROPSEG parameter calculation when "CanAdvancedSettingFd" control is set to true.<br>
                                                        <h1>Note</h1>Implementation specific Parameter.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can Bus Length (meters)"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:12350894-9b32-46c4-ab04-02a8d5e51b3f"/>
                                            <a:da name="DEFAULT" value="40"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=5000"/>
                                            </a:da>
                                            <a:da name="ENABLE" type="XPath">
                                                <a:tst expr="../CanAdvancedSettingFd = 'true'"/>
                                            </a:da>
                                        </v:var>
                                    
                                        <v:var name="CanControllerFDPrescaller" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        Specifies the prescaller for the controller in FD mode .<br>
                                                        The calculation of the resulting CanControllerTimeQuanta value depending on module clocking and prescaller shall be done offline.<br>
                                                        Prescaler = FreqCanClk / FreqTq; FreqTq = 1 / CanControllerTimeQuanta .<br>
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can Controller Prescaller FD"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:a72da830-6439-46e6-81c9-6c4fd6a65c01"/>
                                            <a:da name="RANGE" type="XPath">
                                                <a:tst expr="((. &gt;=1) and (. &lt;=63))" false = "Value is out of range [1, 63] configurable in BCAN"/>
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=63"/>
                                            </a:da>
                                            <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../../CanControllerPrescaller, num:i(16))"/>
                                            <a:da name="WARNING" type="XPath">
                                                <a:tst expr="(node:value(.) = node:value(../../CanControllerPrescaller))" 
                                                false="To minimize errors when processing CAN FD frames with data phase (CAN bit BRS equal to one), use the same value for NPRESDIV (Can Controller Prescaller) and DPRESDIV (Can Controller Prescaller FD) fields of the NCBT and DCBT registers, respectively."/>
                                            </a:da>
                                            <a:da name="EDITABLE" value="true"/> 
                                        </v:var>

                                        <!-- /** @implements CanControllerFdBaudRate_Object */ -->
                                        <v:var name="CanControllerFdBaudRate" type="FLOAT">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        ECUC_Can_00481.Specifies the data segment baud rate of the controller in kbps.
                                                        CAN FD maximum speed is 8Mbps.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can FD Controller BaudRate"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>    
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:1762df43-3493-4392-a39a-aaff002a96a5"/>
                                            <a:da name="DEFAULT" type="XPath" expr="1 div((num:i( node:fallback(../CanControllerPropSeg, 1)) + num:i( node:fallback(../CanControllerSeg1, 1)) + 
                                                                                           num:i( node:fallback(../CanControllerFdSyncSeg, 1)) + num:i( node:fallback(../CanControllerSeg2, 2))) *
                                                                                          (num:i( node:fallback(../CanControllerFDPrescaller, 1)) div 
                                                                                           num:i(node:fallback('->node:ref(../../../../CanCpuClockRef)/McuClockReferencePointFrequency', 40000000))) * 1000)"/>
                                             <a:da name="RANGE" type="XPath">
                                                <a:tst expr="text:uniq(node:fallback(../../*/CanControllerFdBaudRate, text:split('0')), node:fallback(.,1))" false="Duplicate CANFD BaudRate configured. Please select the different CanControllerFdBaudRate in the CanControllerFdBaudrateConfig container of the same controller"/>
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=16000"/>
                                            </a:da>
                                            <a:da name="INVALID" type="XPath">
                                            <a:tst expr="(node:value(.) &gt;=8001)"
                                                    true="Maximum communication transfer rate is up to 8000 kbps for CAN FD due to protocol limits"/>
                                            </a:da>
                                            <a:da name="EDITABLE" value="true"/>
                                        </v:var>
                                        
                                        <v:var name="CanControllerFdSyncSeg" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        The Synchronization Segment or SYNC_SEG time interval is used to synchronize all the nodes across the network.<br>
                                                        The SYNC_SEG time interval has a fixed period of one Time Quantum (TQ).<br>
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can FD Synchronization Segment"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:b6655b82-c880-4a04-915a-f9dda0a5d891"/>
                                            <a:da name="DEFAULT" value="1"/>  
                                            <a:da name="READONLY" value="true" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=1"/>
                                            </a:da>
                                        </v:var>
                                        
                                        <!-- /** @implements CanControllerFdPropSeg_Object */ -->
                                        <v:var name="CanControllerPropSeg" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        ECUC_Can_00476.Specifies propagation delay in time quantas.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can FD Propagation Segment"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:1762ad43-3493-4392-a40a-aaff002a96a5"/>
                                            <a:da name="DEFAULT" value="1"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=255"/>
                                            </a:da>
                                            <a:da name="EDITABLE" value="true"/>
                                            <a:da name="READONLY" type="XPath" expr="../CanAdvancedSettingFd = 'true'"/>
                                        </v:var>
                                    
                                        <!-- /** @implements CanControllerFdSeg1_Object */ -->
                                        <v:var name="CanControllerSeg1" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        ECUC_Can_00477.Specifies phase segment 1 in time quantas.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can FD Phase Segment 1"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:1762af43-3493-4392-a45a-aaff002a96a6"/>
                                            <a:da name="DEFAULT" value="1"/>
                                            <a:da name="RANGE" type="XPath">
                                                <a:tst expr="not(node:exists(CanControllerFdBaudrateConfig)) or ( ( (. + num:i(node:current()/../CanControllerPropSeg)) &gt;=2) and ( (. + num:i(node:current()/../CanControllerPropSeg)) &lt;=32) )" 
                                                false = "In data bit time, Time Segment 1 (Phase_Seg1 + PropSeg) shall be in range [2, 32]."/>
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=255"/>
                                            </a:da>
                                            <a:da name="EDITABLE" value="true"/>
                                            <a:da name="READONLY" type="XPath" expr="../CanAdvancedSettingFd = 'true'"/>
                                        </v:var>
                                    
                                    
                                        <!-- /** @implements CanControllerFdSeg2_Object */ -->
                                        <v:var name="CanControllerSeg2" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        ECUC_Can_00478.Specifies phase segment 2 in time quantas.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can FD Phase Segment 2"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:1762af43-3493-4392-a40a-aaff002d96a7"/>
                                            <a:da name="DEFAULT" value="6"/>
                                            <a:da name="RANGE" type="XPath">
                                                <a:tst expr="not(node:exists(CanControllerFdBaudrateConfig)) or ((. &gt;=2) and (. &lt;=16))" 
                                                false = "Value is out of range [2, 16]. The Time Segment 2 cannot be smaller than the Information Processing Time (IPT), which value is 2 time quanta in BCAN."/>
                                                <a:tst expr="not(node:exists(CanControllerFdBaudrateConfig)) or ((. + num:i(node:current()/../CanControllerSeg1) + num:i(node:current()/../CanControllerPropSeg) + num:i(node:current()/../CanControllerFdSyncSeg)) &gt;=5)" 
                                                false = "The data phase bit time (defined by the sum of Phase Seg1 + Propagation Seg + Sync Seg + Phase Seg2) must not be smaller than 5 time quanta."/>
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=255"/>
                                            </a:da>
                                            <a:da name="EDITABLE" value="true"/>
                                            <a:da name="READONLY" type="XPath" expr="../CanAdvancedSettingFd = 'true'"/>
                                        </v:var>
                                        
                                        <!-- /** @implements CanFdControllerSyncJumpWidth_Object */ -->
                                        <v:var name="CanControllerSyncJumpWidth" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        ECUC_Can_00479.Specifies the synchronization jump width for the controller in time quantas.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Can FD Resynch Jump Width"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:1762af46-3493-4392-a40a-aaff002a96a7"/>
                                            <a:da name="DEFAULT" value="1"/>
                                            <a:da name="RANGE" type="XPath">
                                                <a:tst expr="not(node:exists(CanControllerFdBaudrateConfig)) or (. &lt;=(num:i(node:current()/../CanControllerSeg1)) and . &lt;=(num:i(node:current()/../CanControllerSeg2)))" 
                                                false = "In nominal bit time and in data bit time, SJW shall be less than or equal to the minimum of these two items: Phase_Seg1 and Phase_Seg2."/>
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=15"/>
                                            </a:da>
                                            <a:da name="EDITABLE" value="true"/>
                                            <a:da name="READONLY" type="XPath" expr="../CanAdvancedSettingFd = 'true'"/>
                                        </v:var>
                                    
                                        <!-- /** @implements CanControllerSspOffset_Object */ -->
                                        <v:var name="CanControllerSspOffset" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        ECUC_Can_00494. Specifies the Transmitter Delay Compensation Offset in minimum time quanta 
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Transmitter Delay Compensation Offset"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="OPTIONAL" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:1762af43-3493-4392-a40a-aaff002b96a7"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=255"/>
                                            </a:da>
                                        </v:var>
                                    
                                        <!-- /** @implements CanFdControllerTxBitRateSwitch_Object */ -->
                                        <v:var name="CanControllerTxBitRateSwitch" type="BOOLEAN">
                                            <a:a name="DESC" value="EN: Specifies if the bit rate switching shall be used for transmissions."/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:da name="DEFAULT" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>                                     
                                            <a:a name="UUID" 
                                                value="ECUC:bd92a9db-bf9c-475f-8316-74db792f9a5b"/>
                                            <a:da name="EDITABLE" value="true"/>
                                        </v:var>                                      

                                        <a:da name="VISIBLE" value="true"/>
                                        <a:da name="EDITABLE" value="true"/>
                                    </v:ctr>                               
                                </v:ctr>
                            </v:lst>
                            
                            <v:ctr name="CanTTController" type="IDENTIFIABLE">
                                <a:da name="EDITABLE" value="false"/>
                                <a:a name="DESC" 
                                     value="TTCan IS NOT SUPPORTED ON THIS PLATFORM. This container is disabled."/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="UUID" 
                                     value="ECUC:a9ffd090-0ca8-40b5-bea6-d810478c69c3"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                     <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                     <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                </a:a>     
                                <v:var name="CanTTControllerApplWatchdogLimit" 
                                       type="INTEGER">
                                    <a:a name="DESC" 
                                        value="EN: Defines the maximum time period (unit is 256 times NTU) after which the application has to serve the watchdog."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" 
                                        value="ECUC:9fb2caac-3bf6-439c-a048-218212cc42f7"/>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>
                                <v:var name="CanTTControllerCycleCountMax" 
                                       type="INTEGER">
                                    <a:a name="DESC" 
                                       value="EN: Defines the value for cycle_count_max."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                       type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" 
                                       value="ECUC:2575bebc-bf3a-4f13-82aa-495e4bb8a04b"/>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=63"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>
                                <v:var name="CanTTControllerExpectedTxTrigger" 
                                       type="INTEGER">
                                    <a:a name="DESC" 
                                        value="EN: Number of expected_tx_trigger."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                       type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" 
                                       value="ECUC:8856c441-4cec-4573-9cfd-30f250cc432a"/>
                                       <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>
                                <v:var name="CanTTControllerExternalClockSynchronisation" type="BOOLEAN">
                                    <a:a name="DESC" 
                                        value="EN: Enables/disables the external clock synchronization."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                       type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
