                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100253"/>
                                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../dmaLogicChannel_EnableTransferConfig ='true') and ((../dmaLogicChannelConfig_enSourceOffset='true') or (../dmaLogicChannelConfig_enDestinationOffset='true'))"/>
                                                    <a:da name="DEFAULT" value="0"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=-1048575"/>
                                                        <a:tst expr="&lt;=1048575"/>
                                                    </a:da>
                                                </v:var>
                                                <v:var name="dmaLogicChannelConfig_enMinorLoopLinkCh" type="BOOLEAN">
