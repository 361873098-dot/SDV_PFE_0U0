                      <SHORT-NAME>EthCtrlMacLayerSubType</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                    Defines the MAC layer subtype of ethernet controller.
                                    This option is only available on master driver and for EMAC interfaces.
                                    </L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
