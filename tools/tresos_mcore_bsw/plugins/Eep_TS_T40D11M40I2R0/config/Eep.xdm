====================================================================================================
====================================================================================================
====================================================================================================
-->


<d:ctr type="AUTOSAR" factory="autosar"
    xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
    xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
    xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
    <d:lst type="TOP-LEVEL-PACKAGES">
        <d:ctr name="TS_T40D11M40I2R0" type="AR-PACKAGE">
            <a:a name="UUID" value="ECUC:13b01487-a247-46d3-a33d-b0a0314620b6"/>
            <d:lst type="ELEMENTS">

                <d:chc name="Eep" type="AR-ELEMENT" value="MODULE-DEF">
                    <v:ctr type="MODULE-DEF">
                        <a:a name="RELEASE" value="asc:4.4"/>
                        <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                            <ad:ADMIN-DATA>
                                <ad:DOC-REVISIONS>
                                    <ad:DOC-REVISION>
                                        <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                        <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                        <ad:DATE>2014-10-31</ad:DATE>
                                    </ad:DOC-REVISION>
                                </ad:DOC-REVISIONS>
                            </ad:ADMIN-DATA>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html><p>
                                    Configuration of the Eep (internal or external eeprom driver) module.
                                </p></html>]]>
                            </a:v>
                        </a:a>
                        <a:a name="LOWER-MULTIPLICITY" value="1"/>
                        <a:a name="UPPER-MULTIPLICITY" value="*"/>
                        <a:a name="UUID" value="ECUC:e52b316c-bd52-4069-84a5-a01f8cbbeb1c"/>
                        <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                            <a:a name="DESC"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="LABEL" value="Post Build Variant Used"/>
                            <a:a name="ORIGIN" value="EB"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:da name="DEFAULT" value="false"/>
                            <a:da name="READONLY" value="FALSE"/>
                            <a:da name="TOOLTIP"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                        </v:var>
                        <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                            <a:a name="LABEL" value="Config Variant"/>
                            <a:a name="UUID" value="ECUC:1e828024-b141-43f8-9df9-a1c7e529fe45"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html>
                                        <p>VariantPostBuild: Mix of precompile and postbuild time configuration parameters.<br>
                                        If Config Variant = VariantPostBuild, the files Eep_Cfg.h and Eep_PBcfg.c should be used.<br>
                                        If Config Variant = VariantPreCompile, the files Eep_Cfg.h and Eep_Cfg.c should be used.
                                        </p>
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:da name="DEFAULT" value="VariantPostBuild"/>
                            <a:da name="RANGE">
                                <a:v>VariantPostBuild</a:v>
                                <a:v>VariantPreCompile</a:v>
                            </a:da>
                        </v:var>
                        <!-- @implements EepInitConfiguration_Object -->
                        <v:ctr name="EepInitConfiguration" type="IDENTIFIABLE">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                      Container for runtime configuration parameters of the eeprom driver.<br>
                                      Implementation Type: Eep_ConfigType.
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:7c955003-8f1a-45da-b0bc-a2c4cf578656"/>
                            <!-- @implements EepSize_Object -->
                            <v:var name="EepSize" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Size"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                           This parameter is the used size of EEPROM device in bytes.
                                           Not applied due to depending on the SD/eMMC size
                                            </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:97dc10f9-4ebe-408c-b0f1-dc643ab04f54"/>
                                <a:da name="DEFAULT" value="1024"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                                <a:da name="READONLY" value="true"/>
                            </v:var>
                            <!-- @implements EepBaseAddress_Object -->
                            <v:var name="EepBaseAddress" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Base Address"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            The eeprom memory start address (see also EEP118). <br>
                                            EEP169: This parameter defines the lower boundary for read / write / erase and compare jobs.<br>Note:<br>Not needed / supported by the driver.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                               <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:365b10b3-4ded-42ee-b8ec-ca6abc20a083"/>
                                <a:da name="DEFAULT" value="0"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                                <a:da name="READONLY" value="true"/>
                            </v:var>

                            <v:var name="EepJobCallCycle" type="FLOAT">
                                <a:a name="LABEL" value="Eep Call Cycle"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Cycle time of calls of the eeprom driver main function.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:4449efe4-5d5d-41d0-accb-a5b9ad4bae49"/>
                                <a:da name="DEFAULT" value="0.01"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=1.0"/>
                                    <a:tst expr="&gt;=0.0"/>
                                </a:da>
                            </v:var>

                            <!-- @implements EepDefaultMode_Object -->
                            <v:var name="EepDefaultMode" type="ENUMERATION">
                                <a:a name="LABEL" value="Eep Default Mode"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            This parameter is the default EEP device mode after initialization.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:b28133f6-757f-42be-8bae-a64cf6e9a3d0"/>
                                <a:da name="DEFAULT" value="MEMIF_MODE_SLOW"/>
                                <a:da name="RANGE">
                                    <a:v>MEMIF_MODE_FAST</a:v>
                                    <a:v>MEMIF_MODE_SLOW</a:v>
                                </a:da>
                            </v:var>

                            <!-- @implements EepJobEndNotification_Object -->
                            <v:var name="EepJobEndNotification" type="FUNCTION-NAME">
                                <a:a name="LABEL" value="Eep Job End Notification"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Mapped to the job end notification routine provided by some upper layer module, typically the Fee module.<br>
                                            Note: Disable the end notification to have it set as NULL_PTR
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:bf476e30-7c7b-406c-9ed5-a80380c1f713"/>
                                <a:da name="EDITABLE" value="true"/>
                                <a:da name="DEFAULT" value="Ea_JobEndNotification"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                           false="Invalid name of the the job end notification routine. Must be valid C function name."/>
                                    <a:tst expr="(not(normalize-space(.) = 'NULL_PTR') and not(normalize-space(.) = 'NULL'))"
                                           false="Invalid name of the the job end notification routine. Must not be NULL_PTR or NULL."/>
                                </a:da>
                            </v:var>
                             <!-- @implements EepJobErrorNotification_Object -->
                            <v:var name="EepJobErrorNotification" type="FUNCTION-NAME">
                                <a:a name="LABEL" value="Eep Job Error Notification"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Mapped to the job error notification routine provided by some upper layer module, typically the Fee module.<br>
                                            Note: Disable the error notification to have it set as NULL_PTR
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:be60ad33-3805-4eb7-a561-a9f24a204f0b"/>
                                <a:da name="EDITABLE" value="true"/>
                                <a:da name="DEFAULT" value="Ea_JobErrorNotification"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                           false="Invalid name of the the job error notification routine. Must be valid C function name."/>
                                    <a:tst expr="(not(normalize-space(.) = 'NULL_PTR') and not(normalize-space(.) = 'NULL'))"
                                           false="Invalid name of the the job error notification routine. Must not be NULL_PTR or NULL."/>
                                </a:da>
                            </v:var>

                            <!-- @implements EepFastReadBlockSize_Object -->
                            <v:var name="EepFastReadBlockSize" type="INTEGER">
                                <a:a name="LABEL" value="Eep Max Read Fast Mode"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            The maximum number of bytes to read or compare in one cycle of the eeprom driver&apos;s job processing function in fast mode.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:5274eaa4-75ac-416f-99fd-b2a4e5f38483"/>
                                <a:da name="DEFAULT" value="4096"/>
                                <a:da name="RANGE" type="XPath">
                                    <!-- Must be greater than zero -->
                                   <a:tst expr="node:fallback( ., 4096 ) > 0"
                                    false="Must be greater than zero"/>
                                    <!-- DMA1 must align with 4096 byte -->
                                   <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA1'
                                    and node:fallback( ., 4096 ) mod 4096 != 0"
                                    true="Must be greater than integer multiple of 4096 bytes(alignment with data transfer of 4KB aligned data in system memory)"/>
                                     <!-- DMA2 must align with 4 byte -->
                                    <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA2'
                                    and node:fallback( ., 4 ) mod 4 != 0"
                                    true="Must be greater than integer multiple of 4 bytes(alignment with data transfer of 4 bytes aligned data in system memory)"/>
                                </a:da>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>

                            <!-- @implements EepNormalReadBlockSize_Object -->
                            <v:var name="EepNormalReadBlockSize" type="INTEGER">
                                <a:a name="LABEL" value="Eep Max Read Normal Mode"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            The maximum number of bytes to read or compare in one cycle of the eeprom driver&apos;s job processing function in normal mode.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:a8740fe8-79f9-46f5-9877-b399a1027705"/>
                                <a:da name="DEFAULT" value="4096"/>
                                <a:da name="RANGE" type="XPath">
                                    <!-- Must be greater than zero -->
                                   <a:tst expr="node:fallback( ., 4096 ) > 0"
                                    false="Must be greater than zero"/>
                                    <!-- DMA1 must align with 4096 byte -->
                                   <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA1'
                                    and node:fallback( ., 4096 ) mod 4096 != 0"
                                    true="Must be greater than integer multiple of 4096 bytes(alignment with data transfer of 4KB aligned data in system memory)"/>
                                     <!-- DMA2 must align with 4 byte -->
                                    <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA2'
                                    and node:fallback( ., 4 ) mod 4 != 0"
                                    true="Must be greater than integer multiple of 4 bytes(alignment with data transfer of 4 bytes aligned data in system memory)"/>
                                </a:da>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>

                            <!-- @implements EepFastWriteBlockSize_Object -->
                            <v:var name="EepFastWriteBlockSize" type="INTEGER">
                                <a:a name="LABEL" value="Eep Max Write Fast Mode"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            The maximum number of bytes to write in one cycle of the eeprom driver&apos;s job processing function in fast mode.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:846b9fb1-a788-4392-a2f9-b44bde7c6bad"/>
                                <a:da name="DEFAULT" value="4096"/>
                                <a:da name="RANGE" type="XPath">
                                    <!-- Must be greater than zero -->
                                   <a:tst expr="node:fallback( ., 4096 ) > 0"
                                    false="Must be greater than zero"/>
                                    <!-- DMA1 must align with 4096 byte -->
                                   <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA1'
                                    and node:fallback( ., 4096 ) mod 4096 != 0"
                                    true="Must be greater than integer multiple of 4096 bytes(alignment with data transfer of 4KB aligned data in system memory)"/>
                                     <!-- DMA2 must align with 4 byte -->
                                    <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA2'
                                    and node:fallback( ., 4 ) mod 4 != 0"
                                    true="Must be greater than integer multiple of 4 bytes(alignment with data transfer of 4 bytes aligned data in system memory)"/>
                                </a:da>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>

                            <!-- @implements EepNormalWriteBlockSize_Object -->
                            <v:var name="EepNormalWriteBlockSize" type="INTEGER">
                                <a:a name="LABEL" value="Eep Max Write Normal Mode"/>
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:<html><p>
                                          The maximum number of bytes to write in one cycle of the eeprom driver&apos;s job processing function in normal mode.
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:627edf03-4c45-4a3c-8960-b518707306ae"/>
                                <a:da name="DEFAULT" value="4096"/>
                                <a:da name="RANGE" type="XPath">
                                    <!-- Must be greater than zero -->
                                   <a:tst expr="node:fallback( ., 4096 ) > 0"
                                    false="Must be greater than zero"/>
                                    <!-- DMA1 must align with 4096 byte -->
                                   <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA1'
                                    and node:fallback( ., 4096 ) mod 4096 != 0"
                                    true="Must be greater than integer multiple of 4096 bytes(alignment with data transfer of 4KB aligned data in system memory)"/>
                                     <!-- DMA2 must align with 4 byte -->
                                    <a:tst expr="node:fallback(./../../EepUsdhcControllerCfg/*/dmaMode,'USDHC_DMA_MODE_NO_DMA')='USDHC_DMA_MODE_ADMA2'
                                    and node:fallback( ., 4 ) mod 4 != 0"
                                    true="Must be greater than integer multiple of 4 bytes(alignment with data transfer of 4 bytes aligned data in system memory)"/>
                                </a:da>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>

                            <!-- @implements EepDemEventParameterRefs_Object -->
                            <v:ctr name="EepDemEventParameterRefs" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Eep Dem Event Parameter References"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            <br>Container for the references to DemEventParameter elements which shall be invoked using the Dem_ReportErrorStatus API in case the corresponding error occurs.</br>
                                            The EventId is taken from the referenced DemEventParameter&apos;s DemEventId value. The standardized errors are provided in the container and can be extended by vendor specific error references.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="UUID" value="ECUC:c18974ae-c38e-4f28-93ef-b613c9f1b08b"/>
                                <a:da name="EDITABLE" value="true"/>

                                <!-- @implements EEP_E_COMPARE_FAILED_Object -->
                                <v:ref name="EEP_E_COMPARE_FAILED" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Reference to the DemEventParameter which shall be issued when the error &quot;Eeprom compare failed (HW)&quot; has occurred.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                    <a:a name="UUID" value="ECUC:3fe8fac1-3991-4e1e-a9d4-b7694226e0bb"/>
                                    <a:da name="EDITABLE" value="true"/>
                                    <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                    </a:da>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                </v:ref>

                                <!-- @implements EEP_E_ERASE_FAILED_Object -->
                                <v:ref name="EEP_E_ERASE_FAILED" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Reference to the DemEventParameter which shall be issued when the error &quot;Eeprom erase failed (HW)&quot; has occurred.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                    <a:a name="UUID" value="ECUC:fd3aebd8-a88d-4c15-ab2e-b849eb26a1e1"/>
                                    <a:da name="EDITABLE" value="true"/>
                                    <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                    </a:da>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                </v:ref>

                                <!-- @implements EEP_E_READ_FAILED_Object -->
                                <v:ref name="EEP_E_READ_FAILED" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Reference to the DemEventParameter which shall be issued when the error &quot;Eeprom read failed (HW)&quot; has occurred.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                    <a:a name="UUID" value="ECUC:15a5dd65-838f-4357-827b-b9fa6631e865"/>
                                    <a:da name="EDITABLE" value="true"/>
                                    <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                    </a:da>
                                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                </v:ref>

                                <!-- @implements EEP_E_WRITE_FAILED_Object -->
                                <v:ref name="EEP_E_WRITE_FAILED" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Reference to the DemEventParameter which shall be issued when the error &quot;Eeprom write failed (HW)&quot; has occurred.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                    <a:a name="UUID" value="ECUC:2485feed-9f7f-44de-9e46-c0eba037e8ae"/>
                                    <a:da name="EDITABLE" value="true"/>
                                    <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                    </a:da>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                </v:ref>
                                </v:ctr>

                            <!-- EepExternalDriver -->
                            <v:ctr name="EepExternalDriver" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Eep External Driver"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            This container is present for external Eeprom drivers only. Internal Eeprom drivers do not use the parameter listed in this container, hence its multiplicity is 0 for internal drivers.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:a name="UUID" value="ECUC:8508fe60-8e3a-4798-a289-c15cb72069c7"/>
                                <a:da name="READONLY" value="true"/>
                                <v:lst name="EepSpiReference">
                                    <a:da name="MIN" value="1"/>
                                    <a:a name="VISIBLE" value="false"/>
                                    <v:ref name="EepSpiReference" type="REFERENCE">
                                        <a:a name="LABEL" value="Eep Spi Reference"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Reference to SPI sequence (required for external Eeprom drivers).
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:da name="EDITABLE" type="XPath">
                                            <a:tst expr="node:exists(nonode)"/>
                                        </a:da>
                                        <a:a name="UUID" value="ECUC:bda02515-58f5-426d-8037-c288b1bef246"/>
                                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Spi/SpiDriver/SpiSequence"/>
                                    </v:ref>
                                </v:lst>
                            </v:ctr><!-- EepExternalDriver -->
                        </v:ctr>

                        <v:lst name="EepUsdhcControllerCfg" type="MAP">
                            <a:a name="LABEL" value="EepUsdhcControllerCfg"/>
                            <a:da name="MIN" value="1"/>
                            <a:da name="INVALID" type="XPath">
                                    <a:tst expr="(num:i(count(./*)) &gt; num:i(count(ecu:list(&apos;Eep.External.HwUnit.List&apos;))))"
                                          true=" EepUsdhcControllerCfg have max number of External Hw Unit."/>
                            </a:da>

                            <v:ctr name="EepUsdhcControllerCfg" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Eep Controller Configuration"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Configuration for low layer ip
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="REQUIRES-INDEX" value="true"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:1b665dd9-0c88-4879-a009-d42616172e69"/>

                                <!-- cardDetectDat3 -->
                                <v:var name="cardDetectDat3" type="BOOLEAN">
                                    <a:a name="LABEL" value="Use DAT3 pin as a card detection pin" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Set this field to true if user want to use DAT3 pin as a card detection pin
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:efc12700-0636-47d6-9c1f-5d3d30bd6ec1"/>
                                    <a:da name="DEFAULT" value="false" />
                                </v:var><!-- cardDetectDat3 -->

                                <!-- EepEnableAutoCMD12 -->
                                <v:var name="EepEnableAutoCMD12" type="BOOLEAN">
                                    <a:a name="LABEL" value="Eep Enable Auto CMD12" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Enable auto CMD12. If this field is false, user have to send a "CMD12" command to card after
                                                each time send/receive data to stop the data transfer. If this field is true, uSDHC will send
                                                "CMD12" command automatically after data transfer is end.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:efc12700-0636-41d9-9c1f-5d3d30bd6ec1"/>
                                    <a:da name="DEFAULT" value="true" />
                                    <a:a name="EDITABLE" value="false"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(../dmaMode ='USDHC_DMA_MODE_ADMA1') and (node:value(.) = 'false')"
                                            true="AutoCMD12 shall be enabled in AMDA1 mode"/>
                                    </a:da>
                                </v:var><!-- EepEnableAutoCMD12 -->

                                <!-- EepSynchronizeCache -->
                                <v:var name="EepSynchronizeCache" type="BOOLEAN">
                                    <a:a name="LABEL" value="Eep Synchronize Cache" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor specific:
                                                Synchronize the memory by cleaning the cache before tranfering.<p/>
                                                The EEP driver needs to maintain the memory coherency by means of three methods:<p/>
                                                    1. Disable data cache, or<p/>
                                                    2. Configure the eep region upon which the driver operates, as non-cacheable, or<p/>
                                                    3. Enable the EepSynchronizeCache feature.<p/>
                                                Depending on the application configuration, one option may be more beneficial than other.<p/>

                                                Enabled:    The EEP driver will call Mcl cache API functions in order to clean the cache
                                                            before transferring , in order
                                                            to ensure that the cache and the modified memory are in sync.<p/>
                                                            If enabled, the driver will attempt to clean only the modified lines from the cache.
                                                            If the size of the region to be clean is greater than half of the cache size, then
                                                            the entire cache is clean.<p/>
                                                            <b>Note</b>: If enabled, the MclEnableCache parameter has to be enabled and the MCL plugin included as a dependency.<p/>
                                                Disabled:   The upper layers have to ensure that the buffers in write/read/compare funcitons upon which the driver operates is not cached.
                                                            This can be obtained by either disabling the data cache or by configuring the memory region as non-cacheable.

                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:efc12711-0636-47d6-9c1f-5d3d30bd6ec1"/>
                                    <a:da name="DEFAULT" value="false" />
                                </v:var><!-- EepSynchronizeCache -->

                                <!-- EepUsdhcIpDevErrorDetect -->
                                <v:var name="EepUsdhcIpDevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Eep Ip Dev Error Detect" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Pre-processor switch to enable and disable development error detection for IP layer.<br>
                                            true: Development error detection enabled for Ip layer.<br>
                                            false: Development error detection disabled for Ip layer.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:efc12700-0613-41d9-9c1f-5d3d30bd6ec1"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(../../../EepGeneral/EepDevErrorDetect = 'true') and (node:value(.) = 'false')"
                                            true="EepUsdhcIpDevErrorDetect should follow EepDevErrorDetect if this node is enabled "/>
                                    </a:da>
                                    <a:da name="DEFAULT" value="true" />
                                </v:var><!-- EepUsdhcIpDevErrorDetect -->

                                <!-- endianMode -->
                                <v:var name="endianMode" type="ENUMERATION">
                                    <a:a name="LABEL" value="Endian mode" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Endian mode
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:5eb37c4b-5718-45c9-8f77-d048a7ec5990"/>
                                    <a:da name="DEFAULT" value="USDHC_ENDIAN_MODE_LITTLE"/>
                                    <a:da name="RANGE">
                                        <a:v>USDHC_ENDIAN_MODE_BIG</a:v>
                                        <a:v>USDHC_ENDIAN_MODE_HALF_WORD_BIG</a:v>
                                        <a:v>USDHC_ENDIAN_MODE_LITTLE</a:v>
                                    </a:da>
                                </v:var><!-- endianMode -->

                                <!-- EnableADMA1Mode -->
                                <v:var name="EnableADMA1Mode" type="BOOLEAN">
                                    <a:a name="LABEL" value="Enable ADMA1 mode" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Enable ADMA1 mode. This mode support data transfer of 4KB aligned data in system memory.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:efc12700-0636-47d6-9c23-5d3d30bd6ec1"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var><!-- EnableADMA1Mode -->

                                <!-- dmaMode -->
                                <v:var name="dmaMode" type="ENUMERATION">
                                    <a:a name="LABEL" value="Dma Mode" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Dma Mode
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:87f9c00f-17c1-45f3-9f10-3652af086aa7"/>
                                    <a:da name="DEFAULT" value="USDHC_DMA_MODE_NO_DMA"/>
                                    <a:da name="RANGE">
                                        <a:v>USDHC_DMA_MODE_NO_DMA</a:v>
                                        <a:v>USDHC_DMA_MODE_ADMA1</a:v>
                                        <a:v>USDHC_DMA_MODE_ADMA2</a:v>
                                    </a:da>
                                   <a:da name="INVALID" type="XPath" >
                                       <a:tst expr="((../EnableADMA1Mode='false') and (node:value(.) = 'USDHC_DMA_MODE_ADMA1'))"
                                           true="Node EnableADMA1Mode must be enabled in order to allow legacy ADMA1 mode"/>
                                   </a:da>
                                </v:var><!-- dmaMode -->

                                <!-- admaTable -->
                                <v:var name="admaTable" type="STRING">
                                    <a:a name="LABEL" value="ADMA table" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                ADMA table for transferring with ADMA1 and ADMA2 mode.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:da name="EDITABLE" type="XPath">
                                        <a:tst expr="(../dmaMode !='USDHC_DMA_MODE_NO_DMA')"/>
                                    </a:da>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="DEFAULT" value="usdhc1_admaTable0"/>
                                    <a:a name="UUID" value="ECUC:a2dc7234-378d-4398-a4a4-0676f675ba33"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                            false="Configuration name must be a valid C identifier!"/>
                                        <a:tst expr="text:uniq(../../*/admaTable, .)" false="Duplicate table name"/>
                                    </a:da>
                                </v:var><!-- admaTable -->

                                <!-- admaTableSize -->
                                <v:var name="admaTableSize" type="INTEGER">
                                    <a:a name="LABEL" value="Size of ADMA table (bytes)"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>The size of ADMA table in bytes.
                                            <br>For ADMA1, driver needs two tables(8 bytes) per a transfer: one for configure the start address(be 4KB align) and the next table for configure length data;
                                            Following the setup, driver can transfer maximum 61440 bytes(0xF000 -> align with 4096) of data at the same time.</br>
                                            For ADMA2, each ADMA table preempt 8 bytes and able to transfer maximum 65532 bytes(0xFFFC -> align with 4) of data at the same time; for configuration, the start address is 32-bit boundary.
                                            If you need to transfer more data at the same time, you have to use more ADMA table size. Size of ADMA table in range: [8...65535]</p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:da name="EDITABLE" type="XPath">
                                        <a:tst expr="(../dmaMode !='USDHC_DMA_MODE_NO_DMA')"/>
                                    </a:da>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:2633d477-2e78-4b9c-857b-c8b450518bd0"/>
                                    <a:da name="DEFAULT" value="8"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=65535"/>
                                        <a:tst expr="&gt;=8"/>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath" expr="((../dmaMode='USDHC_DMA_MODE_ADMA1') and (. mod 4 = 0)) or ((../dmaMode='USDHC_DMA_MODE_ADMA2') and (. mod 8 = 0)) or (../dmaMode='USDHC_DMA_MODE_NO_DMA')"
                                        false="TableSize is recommended to be divisible by 4 with ADMA1 and divisible by 8 with ADMA2"/>
                                </v:var><!-- admaTableSize -->

                                <!-- WriteWatermarkLevel -->
                                <v:var name="WriteWatermarkLevel" type="INTEGER">
                                    <a:a name="LABEL" value="Write Watermark Level (words)"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>The size of Write Watermark Level in word.
                                            <br>For internal DMA it's recommeded to use integer multiple of 16.</br>
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:d10b95cb-7d83-40e2-bb90-c3e765fe0c56"/>
                                    <a:da name="DEFAULT" value="128"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=128"/>
                                        <a:tst expr="&gt;0"/>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath" expr="text:contains(node:value(../dmaMode), 'USDHC_DMA_MODE_ADMA') and (node:value(.) mod 16 != 0)"
                                        true="Write Watermark Level should be an integer multiple of 16 in DMA mode"/>
                                </v:var>

                                <!-- ReadWatermarkLevel -->
                                <v:var name="ReadWatermarkLevel" type="INTEGER">
                                    <a:a name="LABEL" value="Read Watermark Level (words)"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>The size of Read Watermark Level in word.
                                            <br>For internal DMA it's recommeded to use 16.</br>
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:8815b988-6c54-4863-bf1b-0cc37dde15e2"/>
                                    <a:da name="DEFAULT" value="16"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=128"/>
                                        <a:tst expr="&gt;0"/>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath" expr="text:contains(node:value(../dmaMode), 'USDHC_DMA_MODE_ADMA') and (node:value(.) != 16)"
                                        true="Read Watermark Level should be 16 in DMA mode"/>
                                </v:var>

                                <v:var name="EepTimeoutMethod" type="ENUMERATION">
                                    <a:a name="LABEL" value="Eep Timeout Method"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html><p>
                                                    Vendor specific: Counter type used in timeout detection for EEP service request.<br>
                                                    Based on selected counter type the timeout value will be interpreted as follows:<br>
                                                    OSIF_COUNTER_DUMMY  - Counts the number of iterations of the waiting loop. The actual timeout depends on many factors: operation type, compiler optimizations, interrupts or other tasks in the system, etc.<br>
                                                    OSIF_COUNTER_SYSTEM - Microseconds.<br>
                                                    OSIF_COUNTER_CUSTOM - Defined by user implementation of timing services<br>
                                                </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:2b1fef6b-ff21-1fa8-b2db-f2c369b82c69"/>
                                    <a:da name="DEFAULT" value="OSIF_COUNTER_DUMMY"/>
                                    <a:da name="RANGE">
                                        <a:v>OSIF_COUNTER_SYSTEM</a:v>
                                        <a:v>OSIF_COUNTER_CUSTOM </a:v>
                                        <a:v>OSIF_COUNTER_DUMMY</a:v>
                                    </a:da>
                                </v:var>

                                <!-- cardActiveTimeout -->
                                <v:var name="cardActiveTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Card active timeout"/>
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:<html><p>
                                            Configures the timeout for card active
                                        </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:80b37b93-1afe-4c89-8324-551a39542266"/>
                                    <a:a name="EDITABLE" value="true"/>
                                    <a:a name="DEFAULT_RADIX" value="HEX" />
                                    <a:da name="DEFAULT" value="268435456"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=0xFFFFFFFF"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var><!-- cardActiveTimeout -->

                                <!-- SwitchVoltageTimeout -->
                                <v:var name="SwitchVoltageTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Switch Voltage Timeout"/>
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:<html><p>
                                            Configures the timeout for switch votage
                                        </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:80b37b20-1afe-4c89-8324-551a39542266"/>
                                    <a:a name="EDITABLE" value="true"/>
                                    <a:a name="DEFAULT_RADIX" value="HEX" />
                                    <a:da name="DEFAULT" value="268435456"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=0xFFFFFFFF"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var><!-- SwitchVoltageTimeout -->

                                 <!-- GetPresetStatusTimeout -->
                                <v:var name="GetPresentStatusTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Get Present Status Timeout"/>
                                    <a:a name="DESC">
