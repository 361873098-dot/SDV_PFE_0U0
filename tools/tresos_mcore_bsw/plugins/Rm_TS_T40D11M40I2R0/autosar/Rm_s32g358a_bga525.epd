                          <SHORT-NAME>XrdcMasterMode</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">Specifies the secure attribute. This field only has meaning if the core is non-core master type</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
