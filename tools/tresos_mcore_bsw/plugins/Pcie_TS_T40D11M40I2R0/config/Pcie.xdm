                        </v:ctr>

                        <v:lst name="PcieEcucPartitionRef" type="">
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="not(num:i(count(./*) > 0)) and (../../PcieGeneral/PcieMulticoreSupport = 'true')
                                           or (num:i(count(./*) > 0)) and (../../PcieGeneral/PcieMulticoreSupport = 'false')"
                              true="Invalid identifier. This list must contain at least one item for generation the configuration structure if PcieMulticoreSupport is enabled,
                                                        and empty if PcieMulticoreSupport disabled."/>
                          </a:da>
                            <v:ref name="PcieEcucPartitionRef" type="REFERENCE">
                              <a:a name="DESC">
                               <a:v>
                                  <![CDATA[EN:
                                      <html><p>
                                          Vendor specific: Maps the Pcie driver to zero or multiple ECUC partitions to make the
                                          modules API available in this partition. The Pcie driver will operate as
                                          an independent instance in each of the partitions.<p/>
                                          Note: Implementation Specific Parameter.<p/>
                                      </p></html>
                                  ]]>
                               </a:v>
                              </a:a>
                              <a:a name="LABEL" value="PcieEcucPartitionRef" />
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:ea6ee896-5acf-47b9-8b3c-b8f2094f6cf3"/>
                              <a:a name="INVALID" type="XPath">
                                <a:tst expr="node:empty(.)"
                                       true="Field is empty (Suggestion: Select an EcucPartition reference)."/>
                                <a:tst expr="not(node:refvalid(.))"
                                       true="Invalid EcucPartition reference (Suggestion: Select an EcucPartition reference)."/>
                                <a:tst expr="text:uniq(node:fallback(../*,''),node:fallback( ., '' ))"
                                       false ="The partition must be unique in PcieEcucPartitionRef list."/>
                                <a:tst expr="node:containsValue(as:modconf('Pcie')/PcieGlobalConfig/PcieChannel/*/PcieChannelEcucPartitionRef, node:value(.))"
                                       false ="The partition referred in PcieEcucPartitionRef is not used by any PcieChannelEcucPartitionRef."/>
                                <a:tst expr="node:containsValue(as:modconf('Os')[1]/OsApplication/*/OsAppEcucPartitionRef, node:value(.))"
                                       false="The partition referred isn't used by any Os/OsApplication/*/OsAppEcucPartitionRef"/>
                              </a:a>
                              <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                            </v:ref>
                        </v:lst>

                        <!-- @implements PcieChannel_Object -->
                        <v:lst name="PcieChannel" type="MAP">
                          <a:da name="MIN" value="1"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="num:i(count(node:current()/*)) &gt; ecu:get(&apos;Pcie.PcieGlobalConfig.PcieChannel&apos;)"
                                     true="Maximum available Pcie HW channels was exceeded."/>
                          </a:da>
						  
						<v:ctr name="PcieChannel" type="IDENTIFIABLE">
                          <a:a name="DESC">
                              <a:v>
                                  <![CDATA[EN:
                                      <html><p>
                                      Vendor specific: This container contains the configuration (parameters) of the Pcie Controller(s).
                                      <h1>Note:</h1>"User should use unique names for naming the Pcie channels across different PcieGlobalConfig Sets."
                                      <p/></html>
                                  ]]>
                              </a:v>
                          </a:a>
                          <a:a name="UUID" value="ECUC:9f1219fb-5482-4e6b-bf29-8231b3a8da21"/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>

                          <v:var name="PcieChannelId" type="INTEGER">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                        Vendor specific: Identifies the Pcie channel. <p/>
                                        Note: Implementation Specific Parameter. <p/>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Pcie Channel ID" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                            <a:a name="UUID"
                                 value="ECUC:aac952ef-7cb7-4b11-acc4-b6c4ca835e7a"/>
                            <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                            <a:da name="INVALID" type="Range">
                                <a:tst expr="&gt;=0"/>
                                <a:tst expr="&lt;(ecu:get(&apos;Pcie.PcieGlobalConfig.PcieChannel&apos;))"/>
                            </a:da>
                            <a:da name="INVALID" type="XPath">
                                <a:tst expr="(. &gt;= 0) and (.&lt; num:i(count(node:current()/../../*)))"
                                       false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the 'Calculate Value' button to calculate correct default value."/>
                                <a:tst expr="text:uniq(../../*/PcieChannelId, .)"
                                       false="Duplicated value: PcieChannelId must be unique across all Pcie channels. Use the 'Calculate Value' button to calculate correct default value."/>
                                <a:tst expr="(node:fallback( ., 0) &gt;= ecu:get(&apos;Pcie.PcieGlobalConfig.PcieChannel&apos;))"
                                        true="Exceeded the maximum Pcie channels supported by this particular derivative. Please refer to the reference manual for additional information."/>
                                <a:tst expr="num:i(node:fallback(.,0)) = num:i(../@index)"
                                       false="Invalid value: The ID should correspond to the position of the element within the configuration list."/>
                            </a:da>
                          </v:var>

                          <v:var name="PcieHwChannel" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                        Vendor specific: Selects the physical Pcie Channel. <p/>
                                        Note: Implementation Specific Parameter. <p/>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Pcie Hardware Channel" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID"
                                 value="ECUC:38388b20-3219-731a-ab13-8afb524661cd"/>
                            <a:da name="DEFAULT" type="XPath" expr="(ecu:list(&apos;Pcie.PcieGlobalConfig.PcieChannel.PcieHwChannel&apos;))[position()-1=node:fallback( node:current()/../@index, '0')]">
                            </a:da>
                             <a:da name="INVALID" type="XPath">
                              <a:tst expr="text:uniq(node:fallback(../../*/PcieHwChannel, 0 ), node:fallback( ., 1 ))"
                                     false="Duplicate physical Pcie channel: PcieHwChannel must be unique across all Pcie channels. Use the 'Calculate Value' button to calculate correct default value."/>
                            </a:da>
                            <a:da name="RANGE" type="XPath"
                                  expr="ecu:list(&apos;Pcie.PcieGlobalConfig.PcieChannel.PcieHwChannel&apos;)"/>
                          </v:var>

                          <!-- PcieClass -->
                          <v:var name="PcieClass" type="INTEGER">
                              <a:a name="LABEL" value="PCIE class" />
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: PCIE class to configure in the Class Code register of the PCIe header.<br />
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:efc12704-0646-47d6-9c14-5d3d30bd6ed7"/>
                              <a:da name="DEFAULT" value="192937984"/>
                              <a:a name="DEFAULT_RADIX" value="HEX" />
                              <a:a name="INVALID" type="Range">
                                  <a:tst expr="&gt;=0x00000000"/>
                                  <a:tst expr="&lt;=0xFFFFFFFF"/>
                              </a:a>
                          </v:var><!-- PcieClass -->
                      
                          <!-- MsiCount -->
                          <v:var name="MsiCount" type="INTEGER">
                              <a:a name="LABEL" value="MSI count" />
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Number of MSIs supported by the driver.<br />
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:efc12704-0654-4ee6-9c14-5d3d30bd6e40"/>
                              <a:da name="DEFAULT" value="0"/>
                              <a:a name="DEFAULT_RADIX" value="HEX" />
                              <a:a name="INVALID" type="Range">
                                  <a:tst expr="&gt;=0"/>
                                  <a:tst expr="&lt;=32"/>
                              </a:a>
                          </v:var><!-- MsiCount -->
                         
                          <!-- MsixEnabled -->
                          <v:var name="MsixEnabled" type="BOOLEAN">
                              <a:a name="LABEL" value="Enable MSI-X" />
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Enable MSI-X interrupts.<br />
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:3b8d483a-a31f-4457-8ef1-952d802db962"/>
                              <a:da name="DEFAULT" value="false"/>
                          </v:var><!-- MsixEnabled -->

                          <!-- DmaReadDoneHandler -->
                          <v:var name="DmaReadDoneHandler" type="FUNCTION-NAME">
                              <a:a name="LABEL" value="Handler for DMA read done"/>
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Handler for DMA trasfer done event.<br>
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:b5e76e30-7c7b-406c-9665-850380c1f573"/>
                              <a:da name="EDITABLE" value="true"/>
                              <a:a name="OPTIONAL" value="true"/>
                              <a:da name="DEFAULT" value="NULL_PTR"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                         false="Invalid DMA read done handler name, must be valid C function name."/>
                                  <a:tst expr="(not(normalize-space(.) = 'NULL_PTR') and not(normalize-space(.) = 'NULL'))"
                                         false="Invalid DMA read done handler name, must not be NULL_PTR or NULL."/>
                              </a:da>
                          </v:var><!-- DmaReadDoneHandler -->

                          <!-- DmaReadErrorHandler -->
                          <v:var name="DmaReadErrorHandler" type="FUNCTION-NAME">
                              <a:a name="LABEL" value="Handler for DMA read error"/>
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Handler for DMA trasfer error event.<br>
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:b5e76e30-7c7b-406b-9664-850380c1f572"/>
                              <a:da name="EDITABLE" value="true"/>
                              <a:a name="OPTIONAL" value="true"/>
                              <a:da name="DEFAULT" value="NULL_PTR"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                         false="Invalid DMA read error handler name, must be valid C function name."/>
                                  <a:tst expr="(not(normalize-space(.) = 'NULL_PTR') and not(normalize-space(.) = 'NULL'))"
                                         false="Invalid DMA read error handler name, must not be NULL_PTR or NULL."/>
                              </a:da>
                          </v:var><!-- DmaReadErrorHandler -->

                          <!-- DmaWriteDoneHandler -->
                          <v:var name="DmaWriteDoneHandler" type="FUNCTION-NAME">
                              <a:a name="LABEL" value="Handler for DMA write done"/>
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Handler for DMA trasfer done event.<br>
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:b5e76e30-7c7b-406c-9665-850380c1f590"/>
                              <a:da name="EDITABLE" value="true"/>
                              <a:a name="OPTIONAL" value="true"/>
                              <a:da name="DEFAULT" value="NULL_PTR"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                         false="Invalid DMA write done handler name, must be valid C function name."/>
                                  <a:tst expr="(not(normalize-space(.) = 'NULL_PTR') and not(normalize-space(.) = 'NULL'))"
                                         false="Invalid DMA write done handler name, must not be NULL_PTR or NULL."/>
                              </a:da>
                          </v:var><!-- DmaWriteDoneHandler -->

                          <!-- DmaWriteErrorHandler -->
                          <v:var name="DmaWriteErrorHandler" type="FUNCTION-NAME">
                              <a:a name="LABEL" value="Handler for DMA write error"/>
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Handler for DMA trasfer error event.<br>
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:b5e76e30-7c7b-406b-9664-850380c1f509"/>
                              <a:da name="EDITABLE" value="true"/>
                              <a:a name="OPTIONAL" value="true"/>
                              <a:da name="DEFAULT" value="NULL_PTR"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                         false="Invalid DMA write error handler name, must be valid C function name."/>
                                  <a:tst expr="(not(normalize-space(.) = 'NULL_PTR') and not(normalize-space(.) = 'NULL'))"
                                         false="Invalid DMA write error handler name, must not be NULL_PTR or NULL."/>
                              </a:da>
                          </v:var><!-- DmaWriteErrorHandler -->

                          <v:ref name="PcieChannelEcucPartitionRef" type="REFERENCE">
                            <a:a name="DESC">
                             <a:v>
                                <![CDATA[EN:
                                    <html><p>
                                        Vendor specific: Maps one single Pcie channel to zero or one ECUC partitions.
                                        The ECUC partition referenced is a subset of the ECUC partitions
                                        where the Pcie driver is mapped to.<p/>
                                        Note: Implementation Specific Parameter.<p/>
                                    </p></html>
                                ]]>
                             </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Pcie Channel Partition Reference" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="OPTIONAL" value="true"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:f8d45b00-2f1d-48db-a0ef-f5bcd347c55b"/>
                            <a:a name="INVALID" type="XPath">
                              <a:tst expr="node:empty(.)"
                                     true="Invalid EcucPartition reference."/>
                              <a:tst expr="not(node:refvalid(.))"
                                     true="Invalid EcucPartition reference."/>
                              <a:tst expr="node:containsValue(../../../PcieEcucPartitionRef/*, node:value(.))"
                                     false="The ECUC partition referenced by PcieChannelEcucPartitionRef shall be a subset of of the ECUC partitions referenced by PcieEcucPartitionRef."/>
                            </a:a>
                            <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                          </v:ref>

                        <v:ctr name="BAR0Configuration" type="IDENTIFIABLE">
                          <a:a name="DESC">
                              <a:v>
                                  <![CDATA[EN:
                                      <html><p>
                                      Vendor specific: This container contains the configuration Of the BAR 0 register.
                                      </p></html>
                                  ]]>
                              </a:v>
                          </a:a>
                          <a:a name="UUID" value="ECUC:9f1101fb-1298-4e6b-bf29-8231b4a8b027"/>

                          <!-- Bar0Type64Bit -->
                          <v:var name="Bar0Type64Bit" type="BOOLEAN">
                              <a:a name="LABEL" value="64-bit BAR" />
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Specifies that BAR0 size is 64-bit. This will automatically disable BAR1.<br />
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:3b8d483f-a31f-4457-8ef1-952d802db131"/>
                              <a:da name="DEFAULT" value="false"/>
                          </v:var><!-- Bar0Type64Bit -->
                          <!-- Bar0TypeIo -->
                          <v:var name="Bar0TypeIo" type="BOOLEAN">
                              <a:a name="LABEL" value="I/O BAR" />
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Specifies that BAR0 is an I/O BAR.<br />
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:3b8d483f-a31f-4457-8ef1-952d802db132"/>
                              <a:da name="DEFAULT" value="false"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="(node:value(.) = 'true') and (((node:value(../../BAR0Configuration/Bar0Type64Bit) = 'true')) or (node:value(../../BAR0Configuration/Bar0TypePrefetchable) = 'true'))"  
                                         true="An I/O BAR must be a 32-bit BAR and cannot be prefetchable."/>
                              </a:da>
                          </v:var><!-- Bar0TypeIo -->
                          <!-- Bar0TypePrefetchable -->
                          <v:var name="Bar0TypePrefetchable" type="BOOLEAN">
                              <a:a name="LABEL" value="Prefetchable memory" />
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Specifies that BAR0 is a prefetchable memory region.<br />
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:3b8d483f-a31f-4457-8ef1-952d802db133"/>
                              <a:da name="DEFAULT" value="false"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="((node:value(.) = 'true') and (node:value(../../BAR0Configuration/Bar0Type64Bit) = 'false'))"  
                                         true="Prefetchable memory must be assigned to a 64-bit memory BAR."/>
                              </a:da>
                          </v:var><!-- Bar0TypePrefetchable -->
                              <!-- Bar0Size  -->
                              <v:var name="Bar0Size" type="INTEGER">
                                  <a:a name="LABEL" value="BAR 0 Size" />
                                  <a:a name="DESC">
                                      <a:v>
                                          <![CDATA[EN:<html><p>
                                              Vendor specific: Size of address space requested through BAR0. Set to 0 to disable BAR.<br />
                                          </p></html>]]>
                                      </a:v>
                                  </a:a>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="ORIGIN" value="NXP"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                  <a:a name="UUID" value="ECUC:efc34704-0654-4ee6-9c14-5d3d094d6e40"/>
                                  <a:da name="DEFAULT" value="0"/>
                                  <a:a name="DEFAULT_RADIX" value="HEX" />
                                  <a:a name="INVALID" type="Range">
                                      <a:tst expr="&lt;=0xFFFFFFFF"/>
                                      <a:tst expr="&gt;=0"/>
                                  </a:a>
                                  <a:da name="INVALID" type="XPath">
                                      <a:tst expr="((node:value(.) = '0') or (node:value(../../BAR0Configuration/Bar0TypeIo) = 'true')) or (num:i(.)&gt;=ecu:get('Pcie.PcieGlobalConfig.PcieMemBarSize'))"  
                                             false="Mem bar size too low."/>
                                      <a:tst expr="((node:value(.) = '0') or (node:value(../../BAR0Configuration/Bar0TypeIo) = 'false')) or (num:i(.)&gt;=ecu:get('Pcie.PcieGlobalConfig.PcieIoBarSize'))"  
                                             false="IO bar size too low"/>
                                      <a:tst expr="( bit:and((.), (.) - 1) ) = 0" false="BAR size must be power of 2."/>
                                  </a:da>
                              </v:var><!-- Bar0Size -->
                              <!-- Bar0StartAddr  -->
                              <v:var name="Bar0StartAddr" type="INTEGER">
                                  <a:a name="LABEL" value="BAR 0 Start Address" />
                                  <a:a name="DESC">
                                      <a:v>
                                          <![CDATA[EN:<html><p>
                                              Vendor specific: Start adress where address space requested through BAR0 will be mapped. <br />
                                              Note: Only one of "BAR 0 Start Address" and "BAR 0 Start Symbol" may be filled
                                          </p></html>]]>
                                      </a:v>
                                  </a:a>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="EDITABLE" type="XPath" expr="node:value(../Bar0StartSymbol) = ''"/>
                                  <a:a name="ORIGIN" value="NXP"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                  <a:a name="UUID" value="ECUC:efc33404-0654-4ee6-9344-5d3d09006000"/>
                                  <a:da name="DEFAULT" value="0"/>
                                  <a:a name="DEFAULT_RADIX" value="HEX" />
                                  <a:a name="INVALID" type="Range">
                                      <a:tst expr="&gt;=0"/>
                                      <a:tst expr="&lt;=0xFFFFFFFF"/>
                                  </a:a>
                                  <a:da name="INVALID" type="XPath">
                                      <a:tst expr="(../../BAR0Configuration/Bar0Size = 0) or (( bit:and((.), (../../BAR0Configuration/Bar0Size) - 1) ) = 0)" false="Address must be aligned to size."/>
                                  </a:da>
                              </v:var><!-- Bar0StartAddr -->
                              <v:var name="Bar0StartSymbol" type="FUNCTION-NAME">
                                  <a:a name="LABEL" value="BAR 0 Start Symbol"/>
                                  <a:a name="DESC">
                                      <a:v>
                                          <![CDATA[EN:<html><p>
                                              Vendor specific: C Symbol referencing the Start adress where address space requested through BAR0 will be mapped. <br />
                                              Note: Only one of "BAR 0 Start Address" and "BAR 0 Start Symbol" may be filled
                                          </p></html>]]>
                                      </a:v>
                                  </a:a>
                                  <a:a name="EDITABLE" type="XPath" expr="node:value(../Bar0StartAddr) = '0'"/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="ORIGIN" value="NXP"/>
                                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                  <a:a name="UUID" value="ECUC:3201242f-0a7a-45c8-afed-46c8b8841987"/>
                                  <a:da name="DEFAULT" value=""/>
                                  <a:da name="INVALID" type="XPath">
                                      <a:tst expr="(text:match(normalize-space(.),'^([_a-zA-Z]+[_0-9a-zA-Z]*)?$'))"
                                         false="Invalid identifier. The field must specify a valid C function identifier (i.e. an arbitrarily long sequence of digits, underscores, lowercase and uppercase Latin letters, that must begin with a non-digit character)"/>
                                  </a:da>
                              </v:var><!-- Bar0StartSymbol -->
                        </v:ctr>

                        <v:ctr name="BAR1Configuration" type="IDENTIFIABLE">
                          <a:a name="DESC">
                              <a:v>
                                  <![CDATA[EN:
                                      <html><p>
                                      Vendor specific: This container contains the configuration Of the BAR 1 register.
                                      </p></html>
                                  ]]>
                              </a:v>
                          </a:a>
                          <a:a name="UUID" value="ECUC:9f1101fb-1298-4e6b-bf29-8231b4a8b042"/>
