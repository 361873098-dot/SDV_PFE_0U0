                                         true="Prefetchable memory must be assigned to a 64-bit memory BAR."/>
                              </a:da>
                          </v:var><!-- Bar4TypePrefetchable -->
                              <!-- Bar4Size  -->
                              <v:var name="Bar4Size" type="INTEGER">
