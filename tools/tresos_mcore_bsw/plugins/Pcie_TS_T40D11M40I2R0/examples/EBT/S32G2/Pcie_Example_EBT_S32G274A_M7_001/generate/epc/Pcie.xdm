                    <a:a name="IMPORTER_INFO" value="@DEF"/>
                  </d:var>
                  <d:var name="PcieVersionInfoApi" type="BOOLEAN" value="true">
                    <a:a name="IMPORTER_INFO" value="@DEF"/>
                  </d:var>
                </d:ctr>
                <d:lst name="PcieEcucPartitionRef"/>
                <d:lst name="PcieChannel" type="MAP">
                  <d:ctr name="PcieChannel_0" type="IDENTIFIABLE">
                    <d:var name="PcieChannelId" type="INTEGER" value="0">
                      <a:a name="IMPORTER_INFO">
                        <a:v>@CALC</a:v>
                        <a:v>@DEF</a:v>
                      </a:a>
                    </d:var>
                    <d:var name="PcieHwChannel" type="ENUMERATION" 
                           value="Pcie_1"/>
                    <d:var name="PcieClass" type="INTEGER" value="192937984">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="MsiCount" type="INTEGER" value="2"/>
                    <d:var name="MsixEnabled" type="BOOLEAN" value="false"/>
                    <d:var name="DmaReadDoneHandler" type="FUNCTION-NAME" 
                           value="dmaReadDoneHandler">
                      <a:a name="ENABLE" value="true"/>
                    </d:var>
                    <d:var name="DmaReadErrorHandler" type="FUNCTION-NAME" 
                           value="dmaReadErrorHandler">
                      <a:a name="ENABLE" value="true"/>
                    </d:var>
                    <d:var name="DmaWriteDoneHandler" type="FUNCTION-NAME" 
                           value="dmaWriteDoneHandler">
                      <a:a name="ENABLE" value="true"/>
                    </d:var>
                    <d:var name="DmaWriteErrorHandler" type="FUNCTION-NAME" 
