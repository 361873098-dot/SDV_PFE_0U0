                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1319"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="PcieSendMsiXApi" type="BOOLEAN">
