*
*  Description:  DIAB linker command file for AUTOSAR OS sample application
*
**************************************************************************************/
MEMORY
{
    IPCFsharedRAM :   org = 0x34100000, len = 0x00200000
    OsInternalRAM :   org = 0x34300000, len = 0x20000    /* 128K should be enough for sample */
}

SECTIONS
{
    /* Code and constant group */
    GROUP : {
        /* Vectors - they shall be aligned by 32 */
        .vector ALIGN(0x20): {}

        /* Startup code of the second core. It shall be 32-bit word aligned */
        .startup ALIGN(4): {}
        .systeminit : {}
        .text.startup : {}
        /* Code and constant area (all code and constant sections shall be placed between osbegincode and osendcode ) */
        /* Note that it shall be aligned by 32 for SC3/4 */
        .osbegincode ALIGN(0x20) : {}

        /*  OS code and constant data */
        .ostext (TEXT) : {*(.ostext)}

        .oshook (TEXT) : {*(.oshook)}
        .osrodata : {}
        .syscall : {}
        .secinfo : {}
        .rodata : {
                *(".rodata.*")
                *(.rodata)
                *(.mcal_const_cfg)
                *(.mcal_const)
                *(.mcal_text)
            }
        /* Constructor and destructor function ptrs */
        .ctors : {}
        .dtors : {}

        .ossrodata : {}
        .sapp_c32 : {}
        .sapp_c16 : {}
        .sapp_cU : {}
        .sapp_c8 : {}
        .text (TEXT) : {}
        .appcode (TEXT) : {}
        .ROM.data : {}
        .osendcode : {}
    } > OsInternalRAM

    /* Data and bss group */
    GROUP : {
        /* OS stacks (it's aligned by 32 for SC3/4) */
        .osstack  ALIGN(0x20) : {}
        .osstack2 ALIGN(0x20) : {}

        OS_NONCACHE_BSS_START = .;
        .osbeginnoncache ALIGN(0x20) : {}
        .osnoncacheablebss  :{}
        /* user may place own noncachebale bss section here */
        .osendnoncache ALIGN(0x20) : {}
        OS_NONCACHE_BSS_END = .;

/* Begin of the RAM area for applications. Do not edit or delete this comment: it is used by the SysGen for Diab */
/* End of the RAM area for applications. Do not edit or delete this comment: it is used by the SysGen for Diab */

/* Begin of the RAM area #1 for applications. Do not edit or delete this comment: it is used by the SysGen for Diab */
/* End of the RAM area #1 for applications. Do not edit or delete this comment: it is used by the SysGen for Diab */

/* Begin of the RAM area #2 for applications. Do not edit or delete this comment: it is used by the SysGen for Diab */
/* End of the RAM area #2 for applications. Do not edit or delete this comment: it is used by the SysGen for Diab */

/* Begin of the RAM area for applications of the second core. Do not edit or delete this comment: it is used by the SysGen for Diab */
/* End of the RAM area for applications of the second core. Do not edit or delete this comment: it is used by the SysGen for Diab */

/* Begin of the RAM area #1 for applications of the second core. Do not edit or delete this comment: it is used by the SysGen for Diab */
/* End of the RAM area #1 for applications of the second core. Do not edit or delete this comment: it is used by the SysGen for Diab */

/* Begin of the RAM area #2 for applications of the second core. Do not edit or delete this comment: it is used by the SysGen for Diab */
/* End of the RAM area #2 for applications of the second core. Do not edit or delete this comment: it is used by the SysGen for Diab */

        /* data sections */
        _data_rom = .;
        _data_ram = .;
        .data : {}
        .osdata : {}
        .ossdata : {}
        .sapp_v32_data ALIGN(0x20) : {}     /* small data sections for all trusted applications */
        .sapp_v16_data ALIGN(0x20) : {}
        .sapp_vU_data ALIGN(0x20) : {}
        .sapp_v8_data ALIGN(0x20) : {}
        _data_end = .;

    /* ------------------------------------ BSS sections ------------------------------------ */
        _bss_start = .;
        .osbss  ALIGN(1K) : {}
        .ossbss : { }

        .bss  ALIGN(0x20) : {}
        .sbss   : {}

        .sapp_v32_bss  ALIGN(0x20) : {}      /* small bss sections for all trusted applications */
        .sapp_v16_bss  ALIGN(0x20) : {}
        .sapp_vU_bss  ALIGN(0x20) : {}
        .sapp_v8_bss  ALIGN(0x20) : {}

        _bss_end = .;

        _Stack_end  = .;
        .stack_main         ALIGN(16) : {}
        . += 0x800;
        _Stack_start = .;
        _Stack2_end  = .;
        .stack2_main        ALIGN(16) : {}
        . += 0x800;
        _Stack2_start = .;
    } > OsInternalRAM
}

OS_MAIN_STACK_MIN  = _Stack_end;
OS_MAIN_STACK_MAX  = _Stack_start;

OS2_MAIN_STACK_MIN = _Stack2_end;
OS2_MAIN_STACK_MAX = _Stack2_start;
