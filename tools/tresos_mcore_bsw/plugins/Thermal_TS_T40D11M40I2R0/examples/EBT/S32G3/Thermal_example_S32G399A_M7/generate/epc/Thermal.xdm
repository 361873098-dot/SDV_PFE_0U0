<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Thermal" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Thermal" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/TS_T40D11M40I2R0/Thermal"/>
              <d:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN" value="true"/>
              <d:ctr name="ThermalGeneral" type="IDENTIFIABLE">
                <d:var name="ThermalDevErrorDetect" type="BOOLEAN" value="true"/>
                <d:var name="TmuIpDevErrorDetect" type="BOOLEAN" value="true"/>
                <d:var name="ThermalEnableUserModeSupport" type="BOOLEAN" 
                       value="false"/>
                <d:var name="TmuTimeoutMethod" type="ENUMERATION" 
                       value="OSIF_COUNTER_DUMMY"/>
                <d:var name="TmuTimeoutVal" type="INTEGER" value="3000">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ThermalLoadDacTrimFromOcotp" type="BOOLEAN" 
                       value="false"/>
              </d:ctr>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild"/>
              <d:ctr name="ThermalConfigSet" type="IDENTIFIABLE">
                <d:lst name="TmuHwUnit" type="MAP">
                  <d:ctr name="TmuHwUnit_0" type="IDENTIFIABLE">
                    <d:lst name="TmuMonitoringSite" type="MAP">
                      <d:ctr name="TmuMonitoringSite_0" type="IDENTIFIABLE">
                        <d:var name="TmuSitePlacement" type="ENUMERATION" 
                               value="LLCE_ANALOG_PARTITION_TEMP_DIODE"/>
                        <d:var name="TmuEnableSite" type="BOOLEAN" value="true">
                          <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                      </d:ctr>
                      <d:ctr name="TmuMonitoringSite_1" type="IDENTIFIABLE">
                        <d:var name="TmuSitePlacement" type="ENUMERATION" 
                               value="DDR_INTERNAL_RAM"/>
                        <d:var name="TmuEnableSite" type="BOOLEAN" value="true">
                          <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                      </d:ctr>
                      <d:ctr name="TmuMonitoringSite_2" type="IDENTIFIABLE">
                        <d:var name="TmuSitePlacement" type="ENUMERATION" 
                               value="A53_CLUSTER_1"/>
                        <d:var name="TmuEnableSite" type="BOOLEAN" value="true">
                          <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                      </d:ctr>
                    </d:lst>
                    <d:var name="ThermalAverageLowPassFilterType" 
                           type="ENUMERATION" 
                           value="TMU_IP_AVERAGE_LOW_PASS_FILTER_1">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalCentralModuleDisable" type="BOOLEAN" 
                           value="false">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalOffsetCancellation" type="BOOLEAN" 
                           value="true">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalDynamicMatchAvg" type="BOOLEAN" 
                           value="true">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalMeasurementInterval" type="ENUMERATION" 
                           value="TMU_IP_TEMP_MONITORING_INTERVAL_CONTINUOUS">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalImmHighNotif" type="FUNCTION-NAME" 
                           value="ImmediateHighTempNotification"/>
                    <d:var name="ThermalAvgHighNotif" type="FUNCTION-NAME" 
                           value="NULL_PTR">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalAvgHighCriticalNotif" 
                           type="FUNCTION-NAME" value="NULL_PTR">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalImmLowNotif" type="FUNCTION-NAME" 
                           value="NULL_PTR">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalAvgLowNotif" type="FUNCTION-NAME" 
                           value="NULL_PTR">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalAvgLowCriticalNotif" 
                           type="FUNCTION-NAME" value="NULL_PTR">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalRisingRateNotif" type="FUNCTION-NAME" 
                           value="NULL_PTR">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="ThermalFallingRateNotif" type="FUNCTION-NAME" 
                           value="NULL_PTR">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:lst name="TmuCalibConfig" type="MAP"/>
                    <d:lst name="TmuThresholdConfig" type="MAP">
                      <d:ctr name="TmuThresholdConfig_0" type="IDENTIFIABLE">
                        <d:var name="ThermalThresholdType" type="ENUMERATION" 
                               value="TMU_IP_THRESHOLD_HIGH_TEMP_IMMEDIATE"/>
                        <d:var name="ThermalThresholdValue" type="INTEGER" 
                               value="293"/>
                        <d:var name="ThermalThrEnable" type="BOOLEAN" 
                               value="true">
                          <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                        <d:var name="ThermalInterruptEnable" type="BOOLEAN" 
                               value="true">
                          <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                      </d:ctr>
                    </d:lst>
                  </d:ctr>
                </d:lst>
              </d:ctr>
              <d:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <d:var name="ArReleaseMajorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleaseMinorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleaseRevisionVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ModuleId" type="INTEGER" value="255">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwMajorVersion" type="INTEGER" value="4"/>
                <d:var name="SwMinorVersion" type="INTEGER" value="0"/>
                <d:var name="SwPatchVersion" type="INTEGER" value="2"/>
                <d:var name="VendorApiInfix" type="STRING" value="">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="VendorId" type="INTEGER" value="43">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
