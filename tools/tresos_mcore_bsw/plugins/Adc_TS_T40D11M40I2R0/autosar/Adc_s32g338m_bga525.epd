                        <ECUC-REFERENCE-DEF UUID="ECUC:39370532-a5e1-4b76-bb7a-609547382d1d">
                          <SHORT-NAME>AdcGroupEcucPartitionRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">Maps an ADC channel group to zero or multiple ECUC partitions to limit the access to this channel group. The ECUC partitions referenced are a subset of the ECUC partitions where the ADC driver is mapped to.</L-2>
                            <L-2 L="FOR-ALL">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
