                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:235fbd08-c7cb-47b0-8a45-7efe857e1780">
                      <SHORT-NAME>EthCtrlMacLayerType</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                    Defines the MAC layer type of the ethernet controller.
                                    This option is only relevant on master driver and for EMAC interfaces, otherwise it is ignored.
                                    </L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
