                                  <DEFAULT-VALUE>100</DEFAULT-VALUE>
                                  <MAX>4194303</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:10ef456f-1118-4b32-9424-8d776654440e">
                                  <SHORT-NAME>EthCtrlConfigShaperMinCredit</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the minimum value (in bits) that can be accumulated in the credit parameter.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>NXP</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
