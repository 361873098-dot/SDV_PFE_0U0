                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </SUB-CONTAINERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8f338c5b-bc57-4a6a-b94d-e7cfacee8f7d">
              <SHORT-NAME>CanConfigSet</SHORT-NAME>
              <DESC>
                <L-2 L="EN">
                                CAN343_Conf. This is the multiple configuration set container for CAN Driver.
                            </L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7ce530a5-c167-4b47-bf15-e7c9ea7b565b">
                  <SHORT-NAME>CanErrorReporting</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                    This container includes the possible errors that CAN_43_LLCE plugin can issue.
                                </L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:f37a95aa-c879-4bd3-bbc8-f81d3960e3a2">
                      <SHORT-NAME>CAN_PROTOCOL_ERR</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                    This is recommended to be enabled only for debugging purposes, since it may generate very frequent notifications.
                                    This category includes the following errors:
                                    BIT0ERR This bit indicates when an inconsistency occurs between the transmitted and the received bit in a CAN frame
                                    BIT1ERR: This bit indicates when an inconsistency occurs between the transmitted and the received bit in a CAN frame
                                    ACKERR This bit indicates that an Acknowledge Error has been detected by the transmitter node, that is, a dominant bit has not been detected during the ACK SLOT.
                                    CRCERR:This bit indicates that a CRC Error has been detected by the receiver node in a CAN frame, that is, the calculated CRC is different from the received.                 
                                    STFERR: This bit indicates that a Stuffing Error has been detected by the receiver node in a CAN frame.
                                    FRMERR: This bit indicates that a Form Error has been detected by the receiver node in a CAN frame,that is, a fixed-form bit field contains at least one illegal bit
                                    OTHER_BCAN_ERR: 
                                    ERROVR(Error Overrun bit)- This bit indicates that an error condition occurred when any error bit is already set.
                                    DPCRCERR(Data phase Cyclic Redundancy Check Error)- This bit indicates that a CRC Error has been detected by the receiver node in the data phase
                                    of a CAN FD frame, that is, the calculated CRC is different from the received.
                                    DPFRMERR(Data phase form error) - This bit indicates that a Form Error has been detected by the receiver node in the data phase
                                    of a CAN FD frame, that is, a fixed-form bit field contains at least one illegal bit.
                                    DPSTFERR(Data phase stuff error) - This bit indicates that a Stuffing Error has been detected by the receiver node in the data
                                    phase of a CAN FD frame
                                    DPBIT0ERR(Data phase bit0 error) - This bit indicates when an inconsistency occurs between the transmitted and the received bit
                                    in the data phase of a CAN FD frame.
                                    DPBIT1ERR(Data phase bit1 error) - This bit indicates when an inconsistency occurs between the transmitted and the received bit
                                    in the data phase of a CAN FD frame
                                    </L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>NXP</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>IGNORE</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>IGNORE</SHORT-NAME>
                          <ORIGIN>NXP</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>INTERRUPT</SHORT-NAME>
                          <ORIGIN>NXP</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>POLLING</SHORT-NAME>
                          <ORIGIN>NXP</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9ec07372-0d46-41c3-85ea-5cb30345c4ff">
                      <SHORT-NAME>CAN_PROTOCOL_WRN</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                     This category includes the following warnings:
                                      - Passive error state. PASSERR is set when BCAN enters Passive state.
                                      - Tx error warnings. TXWRN is set when the Tx error counter ECR[TEC] reached 96.
                                      - Rx error warnings. RXWRN is set when the Rx error counter ECR[REC] reached 96.
                                    </L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>NXP</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DEFAULT-VALUE>INTERRUPT</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>IGNORE</SHORT-NAME>
                          <ORIGIN>NXP</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>INTERRUPT</SHORT-NAME>
                          <ORIGIN>NXP</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>POLLING</SHORT-NAME>
                          <ORIGIN>NXP</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
