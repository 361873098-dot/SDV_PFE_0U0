                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="DEFAULT_RADIX" value="HEX"/>
                                                    <a:a name="UUID" value="ECUC:00a8505c-39fd-499a-9b7f-acf759763331"/>
                                                    <a:da name="DEFAULT" type="XPath" expr="num:i(ecu:list('Rm.Mpu_M7.RegionStartAddress')[num:i( node:fallback( node:current()/../@index, num:i(0))) + 1])"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;i(0xFFFFFFFF)"/>
                                                        <a:tst expr="&gt;=i(0)"/>
                                                    </a:da>
                                                </v:var>

