<?xml version='1.0'?>
<datamodel version="3.0"
    xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
    xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
    xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd"
    xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd">
    <!--
*   @file    Ipcf.xdm
*   @version 4.10.0
*
*   @brief   AUTOSAR Ipcf - Tresos Studio plugin schema file
*   @details This file contains the schema configuration for and Ipcf Tresos Studio plugin.
-->
    <d:ctr factory="autosar" type="AUTOSAR"
        xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
        xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
        xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd">
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="TS_T40D11M410I0R0" type="AR-PACKAGE">
                <d:lst type="ELEMENTS">
                    <d:chc name="Ipcf" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="DESC">
                                <a:v>
                                <![CDATA[EN:<html>
                                    Configuration of IPCF module.
                                </html>]]></a:v>
                            </a:a>
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:LANGUAGE>EN</ad:LANGUAGE>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>1.0.0</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                            <ad:DATE>2023-01-01</ad:DATE>
                                        </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="LOWER-MULTIPLICITY" value="1"/>
                            <a:a name="RELEASE" value="asc:4.4.0"/>
                            <a:a name="UPPER-MULTIPLICITY" value="1"/>
                            <a:a name="UUID" value="ECUC:aa293437-42fc-3434-b6a4-f8c4da165866"/>
                            <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                            <!-- Implementation config variant variable -->
                            <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="LABEL" value="Config Variant"/>
                                <a:a name="UUID" value="ECUC:42656996-f61c-4973-baad-2a72d0463fe2"/>
                                <a:da name="DEFAULT" value="VariantPreCompile"/>
                                <a:da name="RANGE">
                                    <a:v>VariantPreCompile</a:v>
                                </a:da>
                            </v:var>
                            <!-- Ipcf General container -->
                            <v:ctr name="IpcfGeneral" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="IPCF General"/>
                                <a:a name="DESC" value="EN: This container holds the general, pre-compile configuration parameters for the IPCF driver."/>
                                <a:a name="UUID" value="ECUC:100d668b-c1c3-4833-9bd8-2ebcdc32b277"/>
                                <!-- IpcfDevErrorDetect variable -->
                                <v:var name="IpcfDevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Ipcf Development Error Detection"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>IpcfDevErrorDetect</p>
                                                    <p>Switches the Development Error Detection and Notification ON or OFF.</p>
                                                    Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:7228a335-4003-4639-8e1a-bb3d9f762a7b"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="TOOLTIP" value="Enable DET error reporting"/>
                                </v:var>
                                <!-- @implements IpcfDemReportErrorStatus variable -->
                                <v:var name="IpcfDemReportErrorStatus" type="BOOLEAN">
                                      <a:a name="LABEL" value="Ipcf Dem Error Reporting"/>
                                      <a:a name="DESC">
                                      <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                <p>IpcfDemReportErrorStatus</p>
                                                <p>Switches the Diagnostic Error Reporting and Notification ON or OFF.</p>
                                                Note: Implementation Specific Parameter. <p/>
                                            </html>
                                        ]]>
                                     </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                   <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:72a8a638-4009-4639-124a-bb4daf863a8b"/>
                                    <a:da name="TOOLTIP" value="Enable DEM error reporting"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>
                                <!-- @implements IpcfVersionInfoApi variable -->
                                <v:var name="IpcfVersionInfoApi" type="BOOLEAN">
                                    <a:a name="LABEL" value="Provide Ipcf VersionInfo Api"/>
                                    <a:a name="DESC">
                                    <a:v>
                                     <![CDATA[EN:
                                        <html>
                                            <p>IpcfVersionInfoApi</p>
                                            <p>Switches the Ipcf_GetVersionInfo function ON or OFF.</p>
                                            Note: Implementation Specific Parameter. <p/>
                                        </html>
                                     ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:be230747-6176-4d0b-61e3-290362e2d3ef"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="TOOLTIP" value="Enable GetVersionInfo API function call"/>
                                </v:var>
                            </v:ctr>
                            <v:ctr name="IpcfGlobalConfig" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="IPCF Global Config"/>
                                <a:a name="DESC" value="EN: This container holds the global configuration parameters for the IPCF driver."/>
                                <a:a name="UUID" value="ECUC:100d668b-c1c3-4833-9bd8-2ebcdc32b278"/>
                                <!-- IpcfInstances list for the Ipcf instances containers -->
                                <v:lst name="IpcfInstance" type="MAP">
                                    <a:da name="LABEL" value="IPCF Instances"/>
                                    <a:da name="MIN" value="1"/>
                                    <a:da name="MAX" value="32"/>
                                    <!-- Ipcf instance container -->
                                    <v:ctr name="IpcfInstance" type="IDENTIFIABLE">
                                        <a:da name="LABEL" value="Ipcf Instance"/>
                                        <a:a name="DESC">
                                            <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            IPCF instance
                                            </html> ]]></a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:de4567af-34dd-4567-89de-65775795e1b9"/>
                                        <!-- IPCF Instance ID variable -->
                                        <v:var name="IpcInstanceID" type="INTEGER">
                                            <a:da name="LABEL" value="ID"/>
                                            <a:da name="DEFAULT" type="XPath" expr="num:i( node:fallback( node:current()/../@index, num:i(0)))" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=64"/>
                                            </a:da>
                                            <a:da name="RANGE" type="XPath">
                                                <a:tst expr="text:uniq(node:fallback(../../*/IpcInstanceID, text:split('1 2 3')), node:fallback(., 0))" false="Duplicated value, IpcInstanceID must be unique across IPCF Instances. Use the Calculate button to calculate correct default value." />
                                                <a:tst expr="node:fallback(., 0) &lt; count(node:fallback(../../*, 1))" false="Value out of range: must be in range 0 to N-1 (N is number of configured IPCF Instances). Use the Calculate button to calculate correct default value." />
                                            </a:da>
                                            <a:a name="DESC">
                                                <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Inter-Processor Communication Instance ID.
                                                </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
											<a:a name="ORIGIN" value="NXP"/>
                                        </v:var>
                                        <!-- Local SRAM Address variable -->
                                        <v:var name="IpcLocalRamAddress" type="INTEGER">
                                            <a:da name="LABEL" value="Local SRAM Address"/>
                                            <a:da name="DEFAULT" value="874512384"/>
                                            <a:a name="DEFAULT_RADIX" value="HEX"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Inter-Processor Communication Local SRAM Address.
                                                </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
											<a:a name="ORIGIN" value="NXP"/>
                                            <a:da name="TOOLTIP" value="The user should ensure aligned accesses in the shared memory."/>
                                        </v:var>
                                        <!-- Remote SRAM Address variable -->
                                        <v:var name="IpcRemoteRamAddress" type="INTEGER">
                                            <a:da name="LABEL" value="Remote SRAM Address"/>
                                            <a:da name="DEFAULT" value="873463808"/>
                                            <a:a name="DEFAULT_RADIX" value="HEX"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Inter-Processor Communication Remote SRAM Address.
                                                </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
											<a:a name="ORIGIN" value="NXP"/>
                                            <a:da name="TOOLTIP" value="The user should ensure aligned accesses in the shared memory."/>
                                        </v:var>
                                        <!-- Shared memory size variable -->
                                        <v:var name="IpcSharedMemorySize" type="INTEGER">
                                            <a:da name="LABEL" value="Shared SRAM Memory Size"/>
                                            <a:da name="DEFAULT" value="1048576"/>
                                            <a:a name="DEFAULT_RADIX" value="HEX"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Inter-Processor Communication Shared SRAM Memory Size in bytes.
                                                </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:da name="TOOLTIP" value="The user should ensure aligned accesses in the shared memory."/>
                                        </v:var>
                                        <!-- Ipcf Tx IRQ -->
                                        <v:var name="IpcInterCoreTxIrq" type="ENUMERATION">
                                            <a:da name="LABEL" value="Inter Core TX IRQ"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Inter-Processor Communication TX IRQ number.
                                                </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
											<a:a name="ORIGIN" value="NXP"/>
                                            <a:da name="DEFAULT" value="IPC_IRQ_NONE"/>
                                            <a:da name="RANGE">
                                                <a:v>IPC_IRQ_NONE</a:v>
                                                <a:v>INT0_IRQn</a:v>
                                                <a:v>INT1_IRQn</a:v>
                                                <a:v>INT2_IRQn</a:v>
                                                <a:v>INT3_IRQn</a:v>
                                                <a:v>MSCM_INT0_IRQn</a:v>
                                                <a:v>MSCM_INT1_IRQn</a:v>
                                                <a:v>MSCM_INT2_IRQn</a:v>
                                                <a:v>MSCM_INT3_IRQn</a:v>
                                                <a:v>MSCM_INT4_IRQn</a:v>
                                                <a:v>MSCM_INT5_IRQn</a:v>
                                                <a:v>MSCM_INT6_IRQn</a:v>
                                                <a:v>MCSCM_INT7_IRQn</a:v>
                                                <a:v>MCSCM_INT8_IRQn</a:v>
                                                <a:v>MCSCM_INT9_IRQn</a:v>
                                                <a:v>MCSCM_INT10_IRQn</a:v>
                                                <a:v>MCSCM_INT11_IRQn</a:v>
                                            </a:da>
                                        </v:var>
                                        <!-- Ipcf Rx IRQ -->
                                        <v:var name="IpcInterCoreRxIrq" type="ENUMERATION">
                                            <a:da name="LABEL" value="Inter Core RX IRQ"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Inter-Processor Communication RX IRQ number.
                                                </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
											<a:a name="ORIGIN" value="NXP"/>
                                            <a:da name="DEFAULT" value="IPC_IRQ_NONE"/>
                                            <a:da name="RANGE">
                                                <a:v>IPC_IRQ_NONE</a:v>
                                                <a:v>INT0_IRQn</a:v>
                                                <a:v>INT1_IRQn</a:v>
                                                <a:v>INT2_IRQn</a:v>
                                                <a:v>MSCM_INT0_IRQn</a:v>
                                                <a:v>MSCM_INT1_IRQn</a:v>
                                                <a:v>MSCM_INT2_IRQn</a:v>
                                                <a:v>MSCM_INT3_IRQn</a:v>
                                                <a:v>MSCM_INT4_IRQn</a:v>
                                                <a:v>MSCM_INT5_IRQn</a:v>
                                                <a:v>MSCM_INT6_IRQn</a:v>
                                                <a:v>MCSCM_INT7_IRQn</a:v>
                                                <a:v>MCSCM_INT8_IRQn</a:v>
                                                <a:v>MCSCM_INT9_IRQn</a:v>
                                                <a:v>MCSCM_INT10_IRQn</a:v>
                                                <a:v>MCSCM_INT11_IRQn</a:v>
                                            </a:da>
                                        </v:var>
                                        <!-- Local core type variable -->
                                        <v:var name="IpcLocalCore" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            Inter-Processor Communication Local Core.
                                            </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="LABEL" value="Local Core"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="UUID" value="ECUC:42ccb255-1f6b-9d91-1234-977c9fc0cb23"/>
                                            <a:da name="DEFAULT" value="IPC_CORE_M7"/>
                                            <a:da name="RANGE">
                                                <a:v>IPC_CORE_A53</a:v>
                                                <a:v>IPC_CORE_M7</a:v>
                                            </a:da>
                                        </v:var>
                                        <!-- Local core index variable -->
                                        <v:var name="IpcLocalCoreIndex" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            Inter-Processor Communication Local Core Index.
                                            </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="LABEL" value="Local Core Index"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="UUID" value="ECUC:42ccb255-1f6b-9d91-1234-977c9fc0cb23"/>
                                            <a:da name="DEFAULT" value="IPC_CORE_INDEX_0"/>
                                            <a:da name="RANGE">
                                                <a:v>IPC_CORE_INDEX_0</a:v>
                                                <a:v>IPC_CORE_INDEX_1</a:v>
                                                <a:v>IPC_CORE_INDEX_2</a:v>
                                                <a:v>IPC_CORE_INDEX_3</a:v>
                                            </a:da>
                                        </v:var>
                                        <!-- Remote core type variable -->
                                        <v:var name="IpcRemoteCore" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            Inter-Processor Communication Remote Core.
                                            </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="LABEL" value="Remote Core"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="UUID" value="ECUC:42ccb255-1f6b-9d91-1234-977c9fc0cb23"/>
                                            <a:da name="DEFAULT" value="IPC_CORE_A53"/>
                                            <a:da name="RANGE">
                                                <a:v>IPC_CORE_A53</a:v>
                                                <a:v>IPC_CORE_M7</a:v>
                                            </a:da>
                                        </v:var>
                                        <!-- Remote core index variable -->
                                        <v:var name="IpcRemoteCoreIndex" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            Inter-Processor Communication Remote Core Index.
                                            </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="LABEL" value="Remote Core Index"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="UUID" value="ECUC:42ccb255-1f6b-9d91-1234-977c9fc0cb23"/>
                                            <a:da name="DEFAULT" value="IPC_CORE_INDEX_0"/>
                                            <a:da name="RANGE">
                                                <a:v>IPC_CORE_INDEX_0</a:v>
                                                <a:v>IPC_CORE_INDEX_1</a:v>
                                                <a:v>IPC_CORE_INDEX_2</a:v>
                                                <a:v>IPC_CORE_INDEX_3</a:v>
                                            </a:da>
                                        </v:var>
                                        <!-- AutosarOS OsIsr handler -->
                                        <v:ref name="OsIsrHandler" type="REFERENCE">
                                            <a:a name="DESC">
                                            <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            Inter-Processor Communication AutosarOS OsIsr handler.
                                            </html> ]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="LABEL" value="OsIsr handler"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="UUID" value="ECUC:42ccb255-1f6b-9d91-1234-977c9fc0cb24"/>
                                            <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/Os/OsIsr"/>
											<a:da name="EDITABLE" type="XPath" expr="
												node:exists('ASPathDataOfSchema:/AUTOSAR/Os/OsIsr') and
												text:contains(node:value(../IpcInterCoreRxIrq),'IPC_IRQ_NONE') != 'false' "/>
                                        </v:ref>
                                        <!-- Ipcf unmanaged channel configuration list -->
                                        <v:lst name="UnmanagedChannel" type="MAP">
                                            <a:da name="LABEL" value="Unmanaged Channels"/>
                                            <a:da name="MAX" value="8"/>
                                            <!-- Ipcf unmanaged channel configuration container -->
                                            <v:ctr name="UnmanagedChannel" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html>
                                                        Holds configuration for Inter-Processor Communication Shared memory unmanaged channels.
                                                        </html> ]]></a:v>
                                                </a:a>
                                                <!-- Remote core channel type variable -->
                                                <v:var name="RemoteCoreChanneltype" type="STRING">
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Remote Core Channel Type : UNMANAGED or MANAGED.
                                                            </html> ]]></a:v>
                                                    </a:a>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="LABEL" value="Channel Type"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="UUID" value="ECUC:42ccb255-1f6b-9d91-1234-977c9fc0cb23"/>
                                                    <a:da name="DEFAULT" value="UNMANAGED"/>
                                                    <a:da name="EDITABLE" value="false"/>
                                                </v:var>
                                                <!-- Channel size variable -->
                                                <v:var name="ChannelSize" type="INTEGER">
                                                    <a:da name="LABEL" value="Channel Size"/>
                                                    <a:da name="DEFAULT" value="64"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Channel size.
                                                            </html> ]]></a:v>
                                                    </a:a>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
													<a:a name="ORIGIN" value="NXP"/>
                                                    <a:da name="TOOLTIP" value="The user should ensure aligned accesses in the shared memory."/>
                                                </v:var>

                                                <!-- Receive Callback variable -->
                                                <v:var name="ReceiveCallback" type="STRING">
                                                    <a:da name="LABEL" value="Receive Callback"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Receive Callback.
                                                            </html> ]]></a:v>
                                                    </a:a>
                                                    <a:da name="DEFAULT" value="ctrl_chan_rx_cb"/>
                                                    <a:a name="INVALID" type="XPath">
                                                    	<a:tst expr="(node:current() = '')" true="Invalid or empty reference"/>
                                                    </a:a>
                                                </v:var>

                                                <!-- Receive Callback argument variable -->
                                                <v:var name="ReceiveCallbackArgument" type="STRING">
                                                    <a:da name="LABEL" value="Receive Callback Argument"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Receive Callback.
                                                            </html> ]]></a:v>
                                                    </a:a>
                                                    <a:da name="DEFAULT" value="rx_cb_arg"/>
                                                    <a:a name="INVALID" type="XPath">
                                                    	<a:tst expr="(node:current() = '')" true="Invalid or empty reference"/>
                                                    </a:a>
                                                </v:var>
                                            </v:ctr>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="num:i(count(../ManagedChannel/*) + count(./*)) > 8"
                                                    true = "The maximum number of IPCF channels that can be configured is 8."/>
                                            </a:da>
                                        </v:lst>
                                        <!-- Ipcf managed channel configuration list -->
                                        <v:lst name="ManagedChannel" type="MAP">
                                            <a:da name="LABEL" value="Managed Channels"/>
                                            <a:da name="MAX" value="8"/>
                                            <!-- Ipcf channel configuration container -->
                                            <v:ctr name="ManagedChannel" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v>
                                                        <![CDATA[EN:
                                                        <html>
                                                        Holds configuration for Inter-Processor Communication Shared memory managed channels.
                                                        </html> ]]></a:v>
                                                </a:a>
                                                <!-- Remote core channel type variable -->
                                                <v:var name="RemoteCoreChanneltype" type="STRING">
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Remote Core Channel Type : MANAGED.
                                                            </html> ]]></a:v>
                                                    </a:a>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="LABEL" value="Channel Type"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="UUID" value="ECUC:42ccb255-1f6b-9d91-1234-977c9fc0cb23"/>
                                                    <a:da name="DEFAULT" value="MANAGED"/>
                                                    <a:da name="EDITABLE" value="false"/>
                                                </v:var>
                                                <!-- Receive Callback variable -->
                                                <v:var name="ReceiveCallback" type="STRING">
                                                    <a:da name="LABEL" value="Receive Callback"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Receive Callback.
                                                            </html> ]]></a:v>
                                                    </a:a>
                                                    <a:da name="DEFAULT" value="data_chan_rx_cb"/>
                                                    <a:a name="INVALID" type="XPath">
                                                    	<a:tst expr="(node:current() = '')" true="Invalid or empty reference"/>
                                                    </a:a>
                                                </v:var>

                                                <!-- Receive Callback argument variable -->
                                                <v:var name="ReceiveCallbackArgument" type="STRING">
                                                    <a:da name="LABEL" value="Receive Callback Argument"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Receive Callback.
                                                            </html> ]]></a:v>
                                                    </a:a>
                                                    <a:da name="DEFAULT" value="rx_cb_arg"/>
                                                    <a:a name="INVALID" type="XPath">
                                                    	<a:tst expr="(node:current() = '')" true="Invalid or empty reference"/>
                                                    </a:a>
                                                </v:var>
                                                <!-- IPCF buffers configuration list -->
                                                <v:lst name="IpcfBuffer" type="MAP">
                                                    <a:da name="LABEL" value="IPCF Buffers Configuration"/>
                                                    <!-- IPCF buffers container -->
                                                    <v:ctr name="IpcfBuffer" type="IDENTIFIABLE">
                                                        <a:a name="DESC">
                                                            <a:v>
                                                        <![CDATA[EN:
                                                        <html>
                                                        Holds configuration for Inter-Processor Communication buffers.
                                                        </html> ]]></a:v>
                                                        </a:a>
                                                        <!-- Number of buffers used by the channel variable -->
                                                        <v:var name="NumberOfBuffers" type="INTEGER">
                                                            <a:da name="LABEL" value="Number of Buffers"/>
                                                            <a:da name="DEFAULT" value="5"/>
                                                            <a:a name="DESC">
                                                                <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            The number of buffers allocated to the channel.
                                                            </html> ]]></a:v>
                                                            </a:a>
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                            </a:a>
															<a:a name="ORIGIN" value="NXP"/>
                                                            <a:da name="TOOLTIP" value="The user should ensure aligned accesses in the shared memory."/>
                                                        </v:var>
                                                        <!-- Buffer size variable -->
                                                        <v:var name="BufferSize" type="INTEGER">
                                                            <a:da name="LABEL" value="Buffer Size"/>
                                                            <a:da name="DEFAULT" value="16"/>
                                                            <a:a name="DESC">
                                                                <a:v>
                                                            <![CDATA[EN:
                                                            <html>
                                                            Buffer size.
                                                            </html> ]]></a:v>
                                                            </a:a>
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                            </a:a>
															<a:a name="ORIGIN" value="NXP"/>
                                                            <a:da name="TOOLTIP" value="The user should ensure aligned accesses in the shared memory."/>
                                                        </v:var>
                                                    </v:ctr>
                                                </v:lst>
                                            </v:ctr>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="num:i(count(../UnmanagedChannel/*) + count(./*)) > 8"
                                                    true = "The maximum number of IPCF channels that can be configured is 8."/>
                                            </a:da>
                                        </v:lst>
                                    </v:ctr>
                                </v:lst>
                            </v:ctr>
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:
                                      Common container, aggregated by all modules. It contains published information about vendor and versions.
                                    ]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:f7a92bc0-df21-48a8-8bcc-eb9df292f1b2"/>
                                <v:var name="ArReleaseMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                         Major version number of AUTOSAR specification on which the appropriate implementation is based on.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:55930215-d177-41b2-8660-bc960723a9cb"/>
                                    <a:da name="DEFAULT" value="4"/>
                                </v:var>
                                <v:var name="ArReleaseMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                        Minor version number of AUTOSAR specification on which the appropriate implementation is based on.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:d2dc342f-2834-4cc0-bd45-9aebf96876ce"/>
                                    <a:da name="DEFAULT" value="4"/>
                                </v:var>
                                <v:var name="ArReleaseRevisionVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                        Revision version number of AUTOSAR specification on which the appropriate implementation is based on.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:7dd3874a-e6e9-4035-bd38-14299176aa46"/>
                                    <a:da name="DEFAULT" value="0"/>
                                </v:var>
                                <v:var name="ModuleId" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                        Module ID of this module from Module List.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:bd6d918d-03f9-4da3-9131-75c1d6b4cad1"/>
                                    <a:da name="DEFAULT" value="255"/>
                                </v:var>
                                <v:var name="SwMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                        Major version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:e02435a3-0cbf-4209-9908-d147ed439d34"/>
                                    <a:da name="DEFAULT" value="4"/>
                                </v:var>
                                <v:var name="SwMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                        Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:5eefadd2-c509-423a-9ed8-6e587eb683f2"/>
                                    <a:da name="DEFAULT" value="10"/>
                                </v:var>
                                <v:var name="SwPatchVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                        Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:41425ebf-876a-47e0-9569-fad6d5db22c1"/>
                                    <a:da name="DEFAULT" value="0"/>
                                </v:var>
                                <v:var name="VendorApiInfix" type="STRING_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                <![CDATA[EN:
                                In driver modules which can be instantiated several times on a single ECU, BSW00347 requires that the name of APIs is extended by the VendorId and a vendor specific name.
                                This parameter is used to specify the vendor specific name. In total, the implementation specific name is generated as follows:
                                &lt;ModuleName&gt;_&gt;VendorId&gt;_&lt;VendorApiInfix&gt;&lt;Api name from SWS&gt;.
                                E.g.  assuming that the VendorId of the implementor is 123 and the implementer chose a VendorApiInfix of &quot;v11r456&quot; a api name Can_Write defined in the SWS will translate to Can_123_v11r456Write.
                                This parameter is mandatory for all modules with upper multiplicity &gt; 1. It shall not be used for modules with upper multiplicity =1.]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:79eb6936-7081-44cd-bf5f-7adb993f72ba"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:da name="ENABLE" value="false"/>
                                </v:var>
                                <v:var name="VendorId" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                        Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.
                                        ]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" value="PublishedInformation"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:839d446a-ffad-4105-a647-2816e258f21e"/>
                                    <a:da name="DEFAULT" value="43"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=43"/>
                                        <a:tst expr="&lt;=43"/>
                                    </a:da>
                                </v:var>
                            </v:ctr>
                        </v:ctr>
                    </d:chc>
                    <d:chc name="Ipcf_EcuParameterDefinition" type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/TS_T40D11M410I0R0/Ipcf"/>
                            </d:lst>
                            <a:a name="UUID" value="ECUC:b77f4747-c2c0-b0b1-bd39-78c48d906d74"/>
                        </d:ctr>
                    </d:chc>
                    <d:chc name="Ipcf_ModuleDescription" type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                            <d:var name="MODULE_ID" type="INTEGER">
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:var>
                            <d:ref type="RECOMMENDED_CONFIGURATION">
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="PRE_CONFIGURED_CONF">
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="VENDOR_SPECIFIC_MODULE_DEF" value="ASPath:/TS_T40D11M410I0R0/Ipcf"/>
                        </d:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>
