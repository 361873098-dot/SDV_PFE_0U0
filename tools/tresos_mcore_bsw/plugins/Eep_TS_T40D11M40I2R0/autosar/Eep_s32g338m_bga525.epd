                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:efc12700-0636-47d6-9c1f-5d3d30bd6123">
                  <SHORT-NAME>BootHostConfig</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
