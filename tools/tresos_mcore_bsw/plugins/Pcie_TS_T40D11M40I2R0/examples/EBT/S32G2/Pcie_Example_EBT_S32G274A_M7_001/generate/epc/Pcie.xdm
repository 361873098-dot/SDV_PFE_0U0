                  </d:var>
                  <d:var name="PcieDmaReadApi" type="BOOLEAN" value="true">
                    <a:a name="IMPORTER_INFO" value="@DEF"/>
                  </d:var>
                  <d:var name="PcieDmaReadIntEnableApi" type="BOOLEAN" 
                         value="true">
                    <a:a name="IMPORTER_INFO" value="@DEF"/>
                  </d:var>
                  <d:var name="PcieDmaCheckReadStatusApi" type="BOOLEAN" 
