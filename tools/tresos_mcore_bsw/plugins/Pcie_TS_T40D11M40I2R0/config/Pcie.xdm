                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:3b8d483f-a31f-4457-8ef1-952d802db134"/>
                              <a:da name="DEFAULT" value="false"/>
                          </v:var><!-- Bar1TypeIo -->
                              <!-- Bar1Size  -->
                              <v:var name="Bar1Size" type="INTEGER">
                                  <a:a name="LABEL" value="BAR 1 Size" />
                                  <a:a name="DESC">
                                      <a:v>
                                          <![CDATA[EN:<html><p>
                                              Vendor specific: Size of address space requested through BAR1. Fixed size of 0x10000.<br />
                                          </p></html>]]>
                                      </a:v>
                                  </a:a>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="ORIGIN" value="NXP"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                  <a:a name="UUID" value="ECUC:efc34704-0654-4ee6-9c14-5d3d094d6e41"/>
                                  <a:da name="DEFAULT" value="65536" />
                                  <a:da name="READONLY" value="true"/>
                                  <a:a name="DEFAULT_RADIX" value="HEX" />
