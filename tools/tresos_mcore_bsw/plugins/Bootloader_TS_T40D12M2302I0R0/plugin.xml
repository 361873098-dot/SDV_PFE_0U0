             name="Bootloader_TS_T40D12M2302I0R0 Module">

    <module id="Bootloader_TS_T40D12M2302I0R0"
            label="Bootloader"
            mandatory="false"
            allowMultiple="false"
            description="Bootloader BSW module"
            copyright="Copyright 2006-2016 Freescale Semiconductor, Inc. Copyright 2017-2021 NXP"
            swVersionMajor="23"
            swVersionMinor="02"
            swVersionPatch="0"
            swVersionSuffix="RTM"
