                                        <v:var name="ThermalAvgHighCriticalNotif" type="FUNCTION-NAME">
                                            <a:a name="LABEL" value="Average High Temp Critical Notification"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>This function pointer is called whenever the high temperature average critical threshold issues an interrupt.</p></html>]]></a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                 type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:c06c3744-e56b-44e7-87e3-71f393a58183"/>
                                            <a:da name="DEFAULT" value="NULL_PTR"/>
                                        </v:var>

                                        <!-- ThermalImmLowNotif -->
                                        <v:var name="ThermalImmLowNotif" type="FUNCTION-NAME">
                                            <a:a name="LABEL" value="Immediate Low Temp Notification"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>This function pointer is called whenever the low temperature immediate threshold issues an interrupt.</p></html>]]></a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                 type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:b06c3744-e56b-44e7-87e3-71f394a58183"/>
                                            <a:da name="DEFAULT" value="NULL_PTR"/>
                                        </v:var>

                                        <!-- ThermalAvgLowNotif -->
                                        <v:var name="ThermalAvgLowNotif" type="FUNCTION-NAME">
                                            <a:a name="LABEL" value="Average Low Temp Notification"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>This function pointer is called whenever the low temperature average threshold issues an interrupt.</p></html>]]></a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                 type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:c06c3744-e56b-44e7-77e3-71f394a58183"/>
                                            <a:da name="DEFAULT" value="NULL_PTR"/>
                                        </v:var>

                                        <!-- ThermalAvgLowCriticalNotif -->
                                        <v:var name="ThermalAvgLowCriticalNotif" type="FUNCTION-NAME">
                                            <a:a name="LABEL" value="Average Low Temp Critical Notification"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>This function pointer is called whenever the low temperature average critical threshold issues an interrupt.</p></html>]]></a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                 type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:c06c3744-e56b-44e7-87e3-71f194a58183"/>
                                            <a:da name="DEFAULT" value="NULL_PTR"/>
                                        </v:var>

                                        <!-- ThermalRisingRateNotif -->
                                        <v:var name="ThermalRisingRateNotif" type="FUNCTION-NAME">
                                            <a:a name="LABEL" value="Rising Temp Rate Critical Notification"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>This function pointer is called whenever the The rising temperature difference between two measurements issues an interrupt.</p></html>]]></a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                 type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:c06c3744-e56b-34e7-87e3-71f394a58183"/>
                                            <a:da name="DEFAULT" value="NULL_PTR"/>
                                        </v:var>

                                        <!-- ThermalFallingRateNotif -->
                                        <v:var name="ThermalFallingRateNotif" type="FUNCTION-NAME">
                                            <a:a name="LABEL" value="Falling Temp Rate Critical Notification"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>This function pointer is called whenever the falling temperature difference between two measurements issues an interrupt.</p></html>]]></a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                 type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:c06c3744-e56b-44e7-87e3-71f278a58183"/>
                                            <a:da name="DEFAULT" value="NULL_PTR"/>
                                        </v:var>

                                        <v:lst name="TmuCalibConfig" type="MAP">
                                            <a:da name="MIN" value="0"/>
                                            <a:da name="MAX" value="16"/><!-- TODO: take from resources -->
                                            <!-- Calibration_Object -->
                                            <v:ctr name="TmuCalibConfig" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:<html><p>This container allows configuring the calibration configuration points.
                                                        Driver Init function configures the sensor calibration values for the temperature sensor.
                                                        If this list is empty (resulting in pointer to calibration config NULL_PTR), the driver will use the default calibration points specified by peripheral hardware documentation.

                                                        IMPORTANT NOTE: For default calibration values, this array must be empty. Configure this container ONLY if application requires custom calibration points, to override the default calibration points.
                                                        .</p></html>]]></a:v>
                                                </a:a>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                     type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:d9d0ce36-e2f7-48be-8a49-b515ced3ff20"/>

                                                <!-- Sensor Value -->
                                                <v:var name="ThermalSensorValue" type="INTEGER">
                                                    <a:a name="LABEL" value="Sensor Value"/>
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:<html><p>The sensor value</p></html>]]></a:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                         type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:16426534-24ba-4d05-a6f6-30f6179cb9d2"/>
                                                    <a:da name="DEFAULT" value="41"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=0"/>
                                                        <a:tst expr="&lt;=511"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- Temperature Value -->
                                                <v:var name="ThermalTempRange" type="INTEGER">
                                                    <a:a name="LABEL" value="Temperature Value [K]"/>
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:<html><p>The temperature range. The value is expressed in Kelvin unit.</p></html>]]></a:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                         type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:16426534-25ba-4d05-a6f6-30f6169cb9d2"/>
                                                    <a:da name="DEFAULT" type="XPath" expr="num:i(ecu:get(&apos;Thermal.MinTempAvailable&apos;))"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=num:i(ecu:get(&apos;Thermal.MinTempAvailable&apos;))"/>
                                                        <a:tst expr="&lt;=num:i(ecu:get(&apos;Thermal.MaxTempAvailable&apos;))"/>
                                                    </a:da>
                                                </v:var>
                                            </v:ctr> <!-- End Calibration_Object -->
                                        </v:lst>

                                        <v:lst name="TmuThresholdConfig" type="MAP">
                                            <a:da name="MIN" value="1"/>
                                            <a:da name="MAX" value="8"/>
                                            <!-- TmuThresholdConfig_Object -->
                                            <v:ctr name="TmuThresholdConfig" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:<html><p>This array contains the Threshold configuration (parameters).</p></html>]]></a:v>
                                                </a:a>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                     type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:d9d0ce36-e2f7-48be-8a49-b326ced3ff20"/>

                                                <!-- Threshold Type -->
                                                <v:var name="ThermalThresholdType" type="ENUMERATION">
                                                    <a:a name="LABEL" value="Threshold Type"/>
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:<html><p>Type of threshold value</p></html>]]></a:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                         type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:b0b8ac0e-dc1d-4661-b49f-6b03c23dd9ce"/>
                                                    <a:da name="DEFAULT" value="TMU_IP_THRESHOLD_LOW_TEMP_AVERAGE"/>
                                                    <a:da name="RANGE">
                                                        <a:v>TMU_IP_THRESHOLD_HIGH_TEMP_IMMEDIATE</a:v>
                                                        <a:v>TMU_IP_THRESHOLD_HIGH_TEMP_AVERAGE</a:v>
                                                        <a:v>TMU_IP_THRESHOLD_HIGH_TEMP_AVERAGE_CRITICAL</a:v>
                                                        <a:v>TMU_IP_THRESHOLD_LOW_TEMP_IMMEDIATE</a:v>
                                                        <a:v>TMU_IP_THRESHOLD_LOW_TEMP_AVERAGE</a:v>
                                                        <a:v>TMU_IP_THRESHOLD_LOW_TEMP_AVERAGE_CRITICAL</a:v>
                                                        <a:v>TMU_IP_THRESHOLD_RISING_TEMP_RATE_CRITICAL</a:v>
                                                        <a:v>TMU_IP_THRESHOLD_FALLING_TEMP_RATE_CRITICAL</a:v>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst expr="text:uniq(../../*/ThermalThresholdType, .)" false="Duplicate threshold."/>
                                                    </a:da>
                                                </v:var>

                                                <!-- Threshold Value -->
                                                <v:var name="ThermalThresholdValue" type="INTEGER">
                                                    <a:a name="LABEL" value="Temperature Value"/>
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:<html><p>Temperature threshold value. The value is expressed in Kelvin unit</p></html>]]></a:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                         type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:16426534-25ba-4d05-a6f6-30f5189cb9d2"/>
                                                    <a:da name="DEFAULT" type="XPath" expr="num:i(ecu:get(&apos;Thermal.MinTempAvailable&apos;))"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=0"/>
                                                        <a:tst expr="&lt;=ecu:get(&apos;Thermal.MaxTempAvailable&apos;)"/>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst expr="((. &lt; num:i(ecu:get(&apos;Thermal.MinTempAvailable&apos;))) and
                                                                    ((../ThermalThresholdType = 'TMU_IP_THRESHOLD_HIGH_TEMP_IMMEDIATE') or
                                                                    (../ThermalThresholdType = 'TMU_IP_THRESHOLD_HIGH_TEMP_AVERAGE') or
                                                                    (../ThermalThresholdType = 'TMU_IP_THRESHOLD_HIGH_TEMP_AVERAGE_CRITICAL') or
                                                                    (../ThermalThresholdType = 'TMU_IP_THRESHOLD_LOW_TEMP_IMMEDIATE') or
                                                                    (../ThermalThresholdType = 'TMU_IP_THRESHOLD_LOW_TEMP_AVERAGE') or
                                                                    (../ThermalThresholdType = 'TMU_IP_THRESHOLD_LOW_TEMP_AVERAGE_CRITICAL')))"
                                                                true="Threshold value is out of supported range! Temperature threshold must be between platform dependent min - platform dependent max. value"/>

                                                        <a:tst expr="((. &gt; 200) and
                                                                    ((../ThermalThresholdType = 'TMU_IP_THRESHOLD_RISING_TEMP_RATE_CRITICAL') or
                                                                    (../ThermalThresholdType = 'TMU_IP_THRESHOLD_FALLING_TEMP_RATE_CRITICAL')))"
                                                               true="Threshold value is out of supported range! Rate change must a positive number between 0K - 200K"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- Threshold Enable -->
                                                    <v:var name="ThermalThrEnable" type="BOOLEAN">
                                                        <a:a name="LABEL" value="Threshold Enable"/>
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:<html><p>Enable or disable threshold</p></html>]]></a:v>
                                                        </a:a>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                             type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                        </a:a>
                                                        <a:a name="ORIGIN" value="NXP"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="UUID" value="ECUC:55426ced-9121-4adf-a3e5-92c6db909171"/>
                                                        <a:da name="DEFAULT" value="true"/>
                                                    </v:var>

                                                    <!-- Interrupt Enable -->
                                                    <v:var name="ThermalInterruptEnable" type="BOOLEAN">
                                                        <a:a name="LABEL" value="Interrupt Enable"/>
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:<html><p>Interrupt enable configuration</p></html>]]></a:v>
                                                        </a:a>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                             type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                        </a:a>
                                                        <a:a name="ORIGIN" value="NXP"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="UUID" value="ECUC:55426ced-9131-4adf-a3e5-91c6db907171"/>
                                                        <a:da name="DEFAULT" value="true"/>
                                                    </v:var>
                                            </v:ctr><!-- End TmuThresholdConfig_Object -->
                                        </v:lst>
                                    </v:ctr><!-- End TmuHwUnit_Object -->
                                </v:lst>
                            </v:ctr><!-- End ThermalConfigSet_Object -->

                            <!-- @implements CommonPublishedInformation_Object -->
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v><![CDATA[EN:<html><p>Common container, aggregated by all modules. It contains published information about vendor and versions.</p></html>]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:d9d0ce36-e2f7-48be-8a49-b526cbd3ff20"/>

                               <!-- @implements ArReleaseMajorVersion_Object -->
                                <v:var name="ArReleaseMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Major version number of AUTOSAR specification on which the appropriate implementation is based on.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:fda4ea31-11db-4bcc-bcbd-8c3507f8b0f5"/>
                                    <a:da name="DEFAULT" value="4"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=4"/>
                                        <a:tst expr="&lt;=4"/>
                                    </a:da>
                                </v:var>

                                <!-- @implements ArReleaseMinorVersion_Object -->
                                <v:var name="ArReleaseMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Minor version number of AUTOSAR specification on which the appropriate implementation is based on.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:0626f834-0a47-4b1b-b6f3-74c427d9f3ca"/>
                                    <a:da name="DEFAULT" value="4"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=4"/>
                                        <a:tst expr="&lt;=4"/>
                                    </a:da>
                                </v:var>

                                <!-- @implements ArReleaseRevisionVersion_Object -->
                                <v:var name="ArReleaseRevisionVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Revision version number of AUTOSAR specification on which the appropriate implementation is based on.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:fd4a5223-f6f7-4de7-b91f-f561d10c919f"/>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0"/>
                                        <a:tst expr="&lt;=0"/>
                                    </a:da>
                                </v:var>

                                <!-- @implements ModuleId_Object -->
                                <v:var name="ModuleId" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Module ID of this module from Module List.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:dd03f1ea-8869-45ad-8950-f520fbb2d8a9"/>
                                    <a:da name="DEFAULT" value="255"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=255"/>
                                        <a:tst expr="&lt;=255"/>
                                    </a:da>
                                </v:var>

                                <!-- @implements SwMajorVersion_Object -->
                                <v:var name="SwMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Major version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:d573ae14-6adf-4a88-bcf5-b3734c2c209e"/>
                                    <a:da name="DEFAULT" value="4"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=4"/>
                                        <a:tst expr="&lt;=4"/>
                                    </a:da>
                                </v:var>

                                <!-- @implements SwMinorVersion_Object -->
                                <v:var name="SwMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:72273f10-5242-493f-8a12-e8217da60671"/>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0"/>
                                        <a:tst expr="&lt;=0"/>
                                    </a:da>
                                </v:var>

                                <!-- @implements SwPatchVersion_Object -->
                                <v:var name="SwPatchVersion" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:dc7bd1d8-12a5-4f13-aa3e-0159e0e4ac88"/>
                                    <a:da name="DEFAULT" value="2"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=2"/>
                                        <a:tst expr="&lt;=2"/>
                                    </a:da>
                                </v:var>

                                <!-- @implements VendorApiInfix_Object -->
                                <v:var name="VendorApiInfix" type="STRING_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        In driver modules which can be instantiated several times on a single ECU, BSW00347 requires that the name of APIs is extended by the VendorId and a vendor specific name. 
                                        This parameter is used to specify the vendor specific name. In total, the implementation specific name is generated as follows:
                                        &lt;ModuleName&gt;_&gt;VendorId&gt;_&lt;VendorApiInfix&gt;&lt;Api name from SWS&gt;.
                                        E.g.  assuming that the VendorId of the implementor is 123 and the implementer chose a VendorApiInfix of &quot;v11r456&quot; a api name Can_Write defined in the SWS will translate to Can_123_v11r456Write. 
                                        This parameter is mandatory for all modules with upper multiplicity &gt; 1. It shall not be used for modules with upper multiplicity =1.</p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:b9a82eb5-9994-4054-a60e-fdc9ca66babc"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:da name="READONLY" value="true"/>
                                </v:var>

                                <!-- @implements VendorId_Object -->
                                <v:var name="VendorId" type="INTEGER_LABEL">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html><p>
                                        Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.
                                        </p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                         type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:59ee01f9-9acf-46f8-8f19-c044f31cca4f"/>
                                    <a:da name="DEFAULT" value="43"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=43"/>
                                        <a:tst expr="&lt;=43"/>
                                    </a:da>
                                </v:var>
                            </v:ctr><!--End CommonPublishedInformation_Object -->
                        </v:ctr>
                    </d:chc>
                    <d:chc name="Thermal_EcuParameterDefinition"
                           type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                          <a:a name="UUID" value="ECUC:65d8add0-b8a8-43ea-b9da-c40209e11939"/>
                          <a:a name="DEF"
                               value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                          <d:lst name="MODULE_REF">
                            <d:ref type="MODULE_REF" value="ASPath:/TS_T40D11M40I2R0/Thermal"/>
                          </d:lst>
                        </d:ctr>
                    </d:chc>
                    <d:chc name="Thermal_ModuleDescription"
                        type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                          <a:a name="DEF"
                               value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                          <d:var name="MODULE_ID" type="INTEGER" >
                            <a:a name="EDITABLE" value="false"/>
                            <a:a name="IMPORTER_INFO" value="@DEF"/>
                          </d:var>
                          <d:ref type="RECOMMENDED_CONFIGURATION" >
                            <a:a name="EDITABLE" value="false"/>
                            <a:a name="IMPORTER_INFO" value="@DEF"/>
                          </d:ref>
                          <d:ref type="PRE_CONFIGURED_CONF" >
                            <a:a name="EDITABLE" value="false"/>
                            <a:a name="IMPORTER_INFO" value="@DEF"/>
                          </d:ref>
                          <d:ref type="VENDOR_SPECIFIC_MODULE_DEF"
                                 value="ASPath:/TS_T40D11M40I2R0/Thermal"/>
                        </d:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>