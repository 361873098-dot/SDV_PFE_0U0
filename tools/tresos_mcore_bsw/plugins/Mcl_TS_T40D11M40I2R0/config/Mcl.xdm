                                                         <a:tst expr="node:refvalid(.)" false="Invalid XPath or empty reference."/>
                                                    </a:da>
                                                </v:ref>
                                                <v:var name="dmaLogicChannelConfig_MinorLoopSizeType" type="INTEGER">
                                                    <a:a name="LABEL" value="Size"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                                <html> Vendor specific: Set the Dma Channel minor loop transfer size.
                                                                </html>]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100256"/>
                                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../dmaLogicChannel_EnableTransferConfig ='true')"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=0"/>
                                                        <a:tst expr="&lt;=1073741823"/>
                                                    </a:da>
                                                    <a:a name="INVALID" type="XPath">
                                                        <a:tst expr="
                                                        (((node:fallback(., 0)) mod (substring-after(substring-before(node:fallback(../../dmaLogicChannelConfig_TransferDestinationType/dmaTransferConfig_TransferSizeType,0),'_BYTE'),'DMA_IP_TRANSFER_SIZE_')) != 0) or ((node:fallback(., 0)) mod (substring-after(substring-before(node:fallback(../../dmaLogicChannelConfig_TransferSourceType/dmaTransferConfig_TransferSizeType,0),'_BYTE'),'DMA_IP_TRANSFER_SIZE_')) != 0 ))"
                                                        true="Minor Loop Size shall be multiple of Source Transfer Size and Destination Transfer Size."/>
                                                        <a:tst expr="(node:value(../dmaLogicChannelConfig_enSourceOffset)='true' or node:value(../dmaLogicChannelConfig_enDestinationOffset)='true') and node:value(.)&gt;1023" true="When Source or Destination Offset is enabled, the max value of Size (NBYTES) is 1023 (10 Bits)!"/>
                                                    </a:a>
                                                    <a:da name="DEFAULT" value="0"/>
                                                </v:var>
                                            </v:ctr>
