                                <a:v>SERDES_PHY_CLK_EXT</a:v>
                            </a:da>
                          </v:var>

                          <v:var name="SerdesClock" type="ENUMERATION">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                        Selects the Serdes clock, 100MHz or 125 Mhz. <p/>
                                        Note: Implementation Specific Parameter. <p/>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LABEL" value="Serdes clock" />
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:2134e53b-3d60-4114-bcb4-1b273af192fc"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:da name="DEFAULT" value="SERDES_CLK_100MHZ"/>
                            <a:da name="RANGE">
                                <a:v>SERDES_CLK_100MHZ</a:v>
                                <a:v>SERDES_CLK_125MHZ</a:v>
                            </a:da>
                            <a:da name="INVALID" type="XPath">
                                <a:tst expr="(node:value(.) ='SERDES_CLK_125MHZ') and ((node:value(../SerdesMode) = 'PCIE_X2') or (node:value(../SerdesMode) = 'PCIE_SGMII_XPCS_0') or (node:value(../SerdesMode) = 'PCIE_SGMII_XPCS_1'))" true = "Serdes clock should be 100MHz for the mode selected."/>
                            </a:da>
                          </v:var>

                          <v:var name="UseXpcs0" type="BOOLEAN">
                            <a:a name="LABEL" value="Use XPCS0"/>
                            <a:a name="DESC">
                            <a:v>
                             <![CDATA[EN:
                                <html>
                                    <p>XPCS0 switch </p>
                                    <p>Use XPCS0 in case GMAC or PFE0 is used.</p>
                                    Note: Implementation Specific Parameter. <p/>
                                </html>
                             ]]>
                            </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
