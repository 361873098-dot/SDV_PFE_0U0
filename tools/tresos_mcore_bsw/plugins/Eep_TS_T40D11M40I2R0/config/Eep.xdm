                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:17bc6553-7343-4e98-92ee-c6c9eaaf85f4"/>
                                <a:da name="DEFAULT" value="512"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>
                            <!-- @implements EepTotalSize_object -->
                            <v:var name="EepTotalSize" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep total Size"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                           This parameter is the used size of EEPROM device in bytes (K14x is 4096 bytes, K11x is 2048 bytes).
                                            </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:11dc10f9-4ebe-408c-b0f1-dc643ec04f54"/>
                                <a:da name="DEFAULT" value="0"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                                <a:da name="READONLY" value="true"/>
                            </v:var>

                            <v:var name="EepAllowedWriteCycles" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Allowed Write Cycles"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                        Specified maximum number of write cycles under worst case conditions of specific EEPROM hardware.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:2efad025-dc04-4711-94a0-e0e05aca506d"/>
                                <a:da name="DEFAULT" value="100000"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>


                            <v:var name="EepSpecifiedEraseCycles" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Specified Erase Cycles"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                          Number of erase cycles specified for the EEP device (usually given in the device data sheet). FLEXRAM does not allow erase. </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:17bc6553-7343-4e98-9222-c6c9eaaf85f4"/>
                                <a:da name="DEFAULT" value="100000"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>


                            <!-- @implements EepWriteTime_Object -->
                            <v:var name="EepWriteTime" type="FLOAT_LABEL">
                                <a:a name="LABEL" value="Eep Write Time"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                          Maximum time to program one complete eeprom page.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:79158910-10d3-42a8-bc55-e1082f686f85"/>
                                <a:da name="DEFAULT" value="0.0005"/>
                                <a:da name="INVALID" type="Range">
                                     <!-- Max Range should be Inf, but removing Max Range check gives Amdc check error  -->
                                     <a:tst expr="&lt;=0.0005"/>
                                     <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>
                             <!-- @implements EepWriteUnitSize_Object -->
                            <v:var name="EepWriteUnitSize" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Write Unit Size"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                           Size of smallest writeble EEPROM data unit in bytes. </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:17bc6553-8843-4e98-92ee-c6c9eaaf85f4"/>
                                <a:da name="DEFAULT" value="512"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
