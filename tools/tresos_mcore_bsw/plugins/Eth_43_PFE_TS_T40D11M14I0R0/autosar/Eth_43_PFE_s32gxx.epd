                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:d4c8fba7-c87d-d2a3-df73-acd0aa1446f2">
                      <SHORT-NAME>PfeRtCollisionSize</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Vendor specific: Number of L3 routing table entries available in collision space.                            The collision space is used to form linked lists of entries for the same hash. Default                            value is 256. The value shall be either 8, 16, 32, 64, 128, 256, 512, 1024, 2048 or 4096.</L-2>
                      </DESC>
                      <!-- @Calculated /Eth_43_PFE_TS_T40D11M14I0R0/Eth/EthGeneral/EthVendorSpecific/PfeRtCollisionSize: ENABLE(XPath: ../PfeEnableRouting=&apos;true&apos;)-->
