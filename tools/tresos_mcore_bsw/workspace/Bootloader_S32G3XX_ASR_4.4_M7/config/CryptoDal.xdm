<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="CryptoDal" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="CryptoDal" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/TS_T40D12M2302I0R0/CryptoDal"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild">
                <a:a name="IMPORTER_INFO" value="@DEF"/>
              </d:var>
              <d:ctr name="CryptoDalGeneral" type="IDENTIFIABLE">
                <d:var name="EnableDevErrorDetect" type="BOOLEAN" value="false">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="UseCrypto" type="BOOLEAN" value="true"/>
                <d:var name="EnableHashingService" type="BOOLEAN" value="true"/>
                <d:var name="EnableSMRSupport" type="BOOLEAN" value="true"/>
                <d:var name="EnableCMACGeneration" type="BOOLEAN" value="true"/>
                <d:var name="EnableKeyCatalogsFormat" type="BOOLEAN" 
                       value="true"/>
                <d:var name="EnableMemoryPartitioning" type="BOOLEAN" 
                       value="false"/>
              </d:ctr>
              <d:ctr name="CryptoDalBswConfig" type="IDENTIFIABLE">
                <d:lst name="CryptoDescriptors" type="MAP">
                  <d:ctr name="CryptoDescriptors_CMAC" type="IDENTIFIABLE">
                    <d:var name="CryptoEngine" type="ENUMERATION" value="CRYPTO">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="Algorithm" type="ENUMERATION" 
                           value="AES_256_CMAC"/>
                    <d:var name="CryptoKey" type="STRING" 
                           value="0x85, 0xe3, 0xe6, 0x39, 0x1b, 0x13, 0xc2, 0xa3, 0x23, 0x69, 0xb2, 0x36, 0x80, 0x50, 0x4c, 0xbf, 0x1c, 0x12, 0x7b, 0x10, 0xd2, 0x36, 0x7f, 0xf6, 0x8c, 0x0c, 0x35, 0x6b, 0xa8, 0x86, 0x99, 0x0c"/>
                    <d:ref name="CryptoKeyId" type="REFERENCE" 
                           value="ASPath:/Crypto/Crypto/CryptoKeys/AES256CMAC_RAM_KEY"/>
                    <d:ref name="AlternateCryptoKeyId" type="REFERENCE" 
                           value="ASPath:/Crypto/Crypto/CryptoKeys/AES256CMAC_NVM_KEY"/>
                  </d:ctr>
                  <d:ctr name="CryptoDescriptors_ECB" type="IDENTIFIABLE">
                    <d:var name="CryptoEngine" type="ENUMERATION" value="CRYPTO">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="Algorithm" type="ENUMERATION" 
                           value="AES_128_ECB"/>
                    <d:var name="CryptoKey" type="STRING" 
                           value="0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x10"/>
                    <d:ref name="CryptoKeyId" type="REFERENCE" 
                           value="ASPath:/Crypto/Crypto/CryptoKeys/AES128CBCECB_KEY"/>
                    <d:ref name="AlternateCryptoKeyId" type="REFERENCE" >
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:ref>
                  </d:ctr>
                </d:lst>
                <d:lst name="CryptoMemoryProtection" type="MAP">
                  <d:ctr name="CryptoMemoryProtection_0" type="IDENTIFIABLE">
                    <d:var name="TargetMU" type="ENUMERATION" value="HSE_MU0">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EnableMessagingUnit" type="BOOLEAN" 
                           value="true">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="MUMemorySize" type="INTEGER" value="4096"/>
                    <d:ref name="DomainId" type="REFERENCE" 
                           value="ASPath:/Rm/Rm/RmConfigSet/Rm_XRDC_Domain_Assignment_M7"/>
                  </d:ctr>
                  <d:ctr name="CryptoMemoryProtection_1" type="IDENTIFIABLE">
                    <d:var name="TargetMU" type="ENUMERATION" value="HSE_MU1"/>
                    <d:var name="EnableMessagingUnit" type="BOOLEAN" 
                           value="true">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="MUMemorySize" type="INTEGER" value="4096"/>
                    <d:ref name="DomainId" type="REFERENCE" 
                           value="ASPath:/Rm/Rm/RmConfigSet/Rm_XRDC_Domain_Assignment_M7"/>
                  </d:ctr>
                  <d:ctr name="CryptoMemoryProtection_2" type="IDENTIFIABLE">
                    <d:var name="TargetMU" type="ENUMERATION" value="HSE_MU2"/>
                    <d:var name="EnableMessagingUnit" type="BOOLEAN" 
                           value="true">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="MUMemorySize" type="INTEGER" value="4096"/>
                    <d:ref name="DomainId" type="REFERENCE" 
                           value="ASPath:/Rm/Rm/RmConfigSet/Rm_XRDC_Domain_Assignment_A53"/>
                  </d:ctr>
                  <d:ctr name="CryptoMemoryProtection_3" type="IDENTIFIABLE">
                    <d:var name="TargetMU" type="ENUMERATION" value="HSE_MU3"/>
                    <d:var name="EnableMessagingUnit" type="BOOLEAN" 
                           value="true">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="MUMemorySize" type="INTEGER" value="4096"/>
                    <d:ref name="DomainId" type="REFERENCE" 
                           value="ASPath:/Rm/Rm/RmConfigSet/Rm_XRDC_Domain_Assignment_A53"/>
                  </d:ctr>
                </d:lst>
              </d:ctr>
              <d:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <d:var name="ArReleaseMajorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleaseMinorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleaseRevisionVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ModuleId" type="INTEGER" value="100">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwMajorVersion" type="INTEGER" value="23"/>
                <d:var name="SwMinorVersion" type="INTEGER" value="2"/>
                <d:var name="SwPatchVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="VendorApiInfix" type="STRING" value="">
                  <a:a name="ENABLE" value="false"/>
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="VendorId" type="INTEGER" value="43">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
