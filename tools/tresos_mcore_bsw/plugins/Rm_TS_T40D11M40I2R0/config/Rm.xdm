                                    <a:a name="UUID" value="ECUC:7228a335-4003-8881-8e1a-bb3d9f731131"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>
                                
                                <v:var name="Sema42ResetAllGates" type="BOOLEAN">
                                    <a:a name="LABEL" value="Sema42 Reset All Gates when Initialization"/>
