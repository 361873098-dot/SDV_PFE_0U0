                        <a:a name="EDITABLE" value="false"/>
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:ref>
                    <d:ref type="PRE_CONFIGURED_CONF" >
                        <a:a name="EDITABLE" value="false"/>
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:ref>
                    <d:ref type="VENDOR_SPECIFIC_MODULE_DEF" value="ASPath:/TS_T40D11M40I2R0/Pcie"/>
                </d:ctr>
              </d:chc>
            </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

