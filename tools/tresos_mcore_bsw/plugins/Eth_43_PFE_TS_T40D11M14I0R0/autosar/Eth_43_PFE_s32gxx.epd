                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:5b995e80-da60-3c3f-8eac-5069b430f705">
                          <SHORT-NAME>EthPromiscuousEn</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Vendor specific: Enables / Disables Promiscuous Mode. In current version this option is not available for slave drivers (see 'Slave driver' option). Only available for EMAC controllers.</L-2>
                          </DESC>
