                                <a:a name="UUID" value="ECUC:e0ddb665-caad-4131-ae07-a9c9d43a943a"/>
                                <a:da name="DEFAULT" value="255"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=255"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>
                            <!-- @implements EepMinimumAddressType_object -->
                            <v:var name="EepMinimumAddressType" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Minimum Address Type"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                           Minimum expected size of Eep_AddressType. </p></html>]]>
                                    </a:v>
