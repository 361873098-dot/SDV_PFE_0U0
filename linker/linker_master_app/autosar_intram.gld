/*
* GCC Linker Command File:
* 0x20100000	0x2010FFFF	64KB	M7_0 TCM Backdoor
* 0x20180000	0x2018FFFF	64KB	M7_1 TCM Backdoor
* 0x20200000	0x2020FFFF	64KB	M7_2 TCM Backdoor
* 0x24000000	0x33FFFFFF	262144	Standby RAM (32K)
* 0x34000000	0x34800000	8MB	Internal SRAM
*/

ENTRY(Reset_Handler)

MEMORY
{
    int_itcm                            : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* 0KB - Not Supported */
    int_dtcm                            : ORIGIN = 0x20000000, LENGTH = 0x0000E000 /* 56KB  */
    int_dtcm_stack                      : ORIGIN = 0x2000E000, LENGTH = 0x00002000 /* 8KB  */
    int_sram_shareable                  : ORIGIN = 0x22C00000, LENGTH = 0x00004000 /* 16KB  */
    int_sram_bmu_mem                    : ORIGIN = 0x34000000, LENGTH = 0x00080000 /* 512KB */
    int_sram_pfe_rt_poll_linux          : ORIGIN = 0x34080000, LENGTH = 0x00020000 /* 128KB PFE rt poll linux */
    int_sram_slave_no_cacheable         : ORIGIN = 0x340A0000, LENGTH = 0x00060000 /* 384KB */
    int_sram_ipcf_linux                 : ORIGIN = 0x34100000, LENGTH = 0x00100000 /* 1MB IPCF linux */
    int_sram_ipcf_mcal                  : ORIGIN = 0x34200000, LENGTH = 0x00100000 /* 1MB IPCF mcal */
    int_sram_atf                        : ORIGIN = 0x34300000, LENGTH = 0x00090000 /* 576KB ATF */
    int_sram_master_no_cacheable        : ORIGIN = 0x34390000, LENGTH = 0x0006F000 /* 444KB */
    int_sram_slave_shared_log_stat      : ORIGIN = 0x343FF000, LENGTH = 0x00000800 /* 2KB */
    int_sram_master_shared_log_stat     : ORIGIN = 0x343FF800, LENGTH = 0x00000800 /* 2KB */
    int_sram_master                     : ORIGIN = 0x34400000, LENGTH = 0x00200000 /* 2MB */
    int_sram_stack_c0                   : ORIGIN = 0x34600000, LENGTH = 0x00002000 /* 8KB */
    int_sram_stack_c1                   : ORIGIN = 0x34602000, LENGTH = 0x00002000 /* 8KB */
    int_sram_stack_c2                   : ORIGIN = 0x34604000, LENGTH = 0x00002000 /* 8KB */
    int_sram_stack_c3                   : ORIGIN = 0x34606000, LENGTH = 0x00002000 /* 8KB */
    int_sram_end_stack_not_use          : ORIGIN = 0x34608000, LENGTH = 0x00008000 /* 32KB not used */
    int_sram_firmware                   : ORIGIN = 0x34610000, LENGTH = 0x00010000 /* PFE firmware 64KB */
    ram_rsvd2                           : ORIGIN = 0x34800000, LENGTH = 0          /* End of SRAM */

    LLCE_CAN_SHAREDMEMORY   : ORIGIN = 0x43800000 LENGTH = 0x3D000
    LLCE_LIN_SHAREDMEMORY   : ORIGIN = 0x4383D000 LENGTH = 0x3000
    LLCE_BOOT_END           : ORIGIN = 0x43840000 LENGTH = 0x50
}

SECTIONS
{
    .sram :
    {
        . = ALIGN(4);
        KEEP(*(.core_loop))
        . = ALIGN(4);
        *(.startup)
        . = ALIGN(4);
        *(.systeminit)
        . = ALIGN(4);
        *(.text.startup)
        . = ALIGN(4);
        *(.text)
        *(.text*)
        . = ALIGN(4);
        *(.mcal_text)
        . = ALIGN(4);
        KEEP(*(.init))
        . = ALIGN(4);
        KEEP(*(.fini))

        . = ALIGN(4);
        *(.rodata)
        *(.rodata*)
        . = ALIGN(4);
        *(.mcal_const_cfg)
        . = ALIGN(4);
        *(.mcal_const)
        . = ALIGN(4);
        __init_table = .;
        KEEP(*(.init_table))
        . = ALIGN(4);
        __zero_table = .;
        KEEP(*(.zero_table))

        . = ALIGN(4);
        *(.acfls_code_rom)
        . = ALIGN(4);
        *(.aceep_code_rom)
        . = ALIGN(4);
        *(.acmcu_code_rom)
        . = ALIGN(4);
        *(.ramcode)
        . = ALIGN(4);
        *(.data)
        *(.data*)
        . = ALIGN(4);
        *(.mcal_data)
        . = ALIGN(16);
        __sram_bss_start = .;
        *(.bss)
        *(.bss*)
        . = ALIGN(16);
        *(.mcal_bss)
        . = ALIGN(4);
        __sram_bss_end = .;
        . = ALIGN(4);
        _end = .;
        end = .;
        . = . + 0x8000;
        _heapStart = .;
    } > int_sram_master

    .pfe_class_fw_mem :
    {
        . = ALIGN(4);
        *(.pfe_class_fw_mem)
    } > int_sram_firmware

    .non_cacheable :
    {
        . = ALIGN(4096);
        __interrupts_init_start = .;
        KEEP(*(.intc_vector))
        . = ALIGN(4);
        __interrupts_init_end = .;
        /* Make sure that this section is placed within supported memory range 0x40000 to 0xBFFFFFFF */
        . = ALIGN(0x4);
        KEEP(*(.pfe_buf_mem))
        . = ALIGN(0x4);
        KEEP(*(.pfe_bd_mem))
        . = ALIGN(16);
        __non_cacheable_bss_start = .;
        *(.mcal_bss_no_cacheable)
        . = ALIGN(4);
        __non_cacheable_bss_end = .;
        . = ALIGN(4);
        *(.mcal_data_no_cacheable)
        . = ALIGN(4);
        *(.mcal_const_no_cacheable)
        HSE_LOOP_ADDR = .;
        LONG(0x0);
        . = ALIGN(4096);
        KEEP(*(.pfe_ddr_pool))
    } > int_sram_master_no_cacheable

    .bmu_mem (NOLOAD):
    {
        /* The alignment must be at least : PFE_CFG_BMU2_BUF_COUNT * PFE_CFG_BMU2_BUF_SIZE */
        . = ALIGN(0x80000);
        *(.pfe_bmu_mem)
    } > int_sram_bmu_mem

    .llce_boot_end :
    {
        *(.llce_boot_end)
    } > LLCE_BOOT_END

    .can_43_llce_sharedmemory :
    {
        *(.can_43_llce_sharedmemory)
    } > LLCE_CAN_SHAREDMEMORY

    .lin_43_llce_sharedmemory :
    {
        *(.lin_43_llce_sharedmemory)
    } > LLCE_LIN_SHAREDMEMORY

    .shareable_ram :
    {
        . = ALIGN(16);
        __shareable_bss_start = .;
        KEEP(*(.mcal_shared_bss))
        . = ALIGN(4);
        __shareable_bss_end = .;
        . = ALIGN(16);
        KEEP(*(.mcal_shared_data))
    } > int_sram_shareable

    .intc_vector_dtcm (NOLOAD) :
    {
        . = ALIGN(2048);
        __interrupts_ram_start = .;
        . += __interrupts_init_end - __interrupts_init_start;
        . = ALIGN(4);
        __interrupts_ram_end = .;
    } > int_dtcm

    __Stack_dtcm_end         = ORIGIN(int_dtcm_stack);
    __Stack_dtcm_start       = ORIGIN(int_dtcm_stack) + LENGTH(int_dtcm_stack);

    __Stack_end_c0           = ORIGIN(int_sram_stack_c0);
    __Stack_start_c0         = ORIGIN(int_sram_stack_c0) + LENGTH(int_sram_stack_c0);
    __Stack_end_c1           = ORIGIN(int_sram_stack_c1);
    __Stack_start_c1         = ORIGIN(int_sram_stack_c1) + LENGTH(int_sram_stack_c1);
    __Stack_end_c2           = ORIGIN(int_sram_stack_c2);
    __Stack_start_c2         = ORIGIN(int_sram_stack_c2) + LENGTH(int_sram_stack_c2);
    __Stack_end_c3           = 0;
    __Stack_start_c3         = 0;

    __INT_SRAM_START         = ORIGIN(int_sram_master);
    __INT_SRAM_END           = ORIGIN(ram_rsvd2);

    __INT_ITCM_START         = ORIGIN(int_itcm);
    __INT_ITCM_END           = ORIGIN(int_itcm) + LENGTH(int_itcm);

    __INT_DTCM_START         = ORIGIN(int_dtcm);
    __INT_DTCM_END           = ORIGIN(int_dtcm) + LENGTH(int_dtcm) + LENGTH(int_dtcm_stack);

    __RAM_SHAREABLE_START    = ORIGIN(int_sram_shareable);
    __RAM_SHAREABLE_END      = ORIGIN(int_sram_shareable) + LENGTH(int_sram_shareable) - 1;
    __SHARED_LOG_STATISTICS  = ORIGIN(int_sram_master_shared_log_stat);
    __ROM_SHAREABLE_START    = 0;
    __ROM_SHAREABLE_END      = 0;
    __RAM_NO_CACHEABLE_START = ORIGIN(int_sram_master_no_cacheable);
    __RAM_NO_CACHEABLE_END   = ORIGIN(int_sram_master_no_cacheable) + LENGTH(int_sram_master_no_cacheable) - 1;
    __ROM_NO_CACHEABLE_START = 0;
    __ROM_NO_CACHEABLE_END   = 0;
    __RAM_CACHEABLE_START    = ORIGIN(int_sram_master);
    __RAM_CACHEABLE_END      = ORIGIN(int_sram_master) + LENGTH(int_sram_master) - 1;
    __ROM_CACHEABLE_START    = 0;
    __ROM_CACHEABLE_END      = 0;

    __BSS_SRAM_START         = __sram_bss_start;
    __BSS_SRAM_END           = __sram_bss_end;
    __BSS_SRAM_SIZE          = __sram_bss_end - __sram_bss_start;

    __BSS_SRAM_NC_START      = __non_cacheable_bss_start;
    __BSS_SRAM_NC_SIZE       = __non_cacheable_bss_end - __non_cacheable_bss_start;
    __BSS_SRAM_NC_END        = __non_cacheable_bss_end;

    __BSS_SRAM_SH_START       = __shareable_bss_start;
    __BSS_SRAM_SH_SIZE        = __shareable_bss_end - __shareable_bss_start;
    __BSS_SRAM_SH_END         = __shareable_bss_end;

    __RAM_INTERRUPT_START    = __interrupts_ram_start;
    __INIT_INTERRUPT_START   = __interrupts_init_start;
    __INIT_INTERRUPT_END     = __interrupts_init_end;

    __INIT_TABLE             = __init_table;
    __ZERO_TABLE             = __zero_table;

    __RAM_INIT               = 0;
    __ITCM_INIT              = 0;
    __DTCM_INIT              = 1;

    __RAM_DTCM_START         = 0;
    __RAM_DTCM_END           = 0;
    __ROM_DTCM_START         = 0;
    __ROM_DTCM_END           = 0;

   /* Discard boot header in RAM */
   /DISCARD/ : { *(.boot_header) }

   __INDEX_COPY_CORE2       = 3;    /* This symbol is used to initialize data of ITCM/DTCM for secondary cores */
}
