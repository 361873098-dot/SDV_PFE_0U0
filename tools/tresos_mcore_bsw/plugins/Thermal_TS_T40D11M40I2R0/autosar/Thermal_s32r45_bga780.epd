                          <DEFAULT-VALUE>41</DEFAULT-VALUE>
                          <MAX>511</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:16426534-25ba-4d05-a6f6-30f6169cb9d2">
                          <SHORT-NAME>ThermalTempRange</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The temperature range. The value is expressed in Kelvin unit.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
