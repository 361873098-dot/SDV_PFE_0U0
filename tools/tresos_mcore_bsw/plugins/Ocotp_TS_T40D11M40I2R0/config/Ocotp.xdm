    <d:ctr type="AUTOSAR" factory="autosar"
    xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
    xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
    xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="TS_T40D11M40I2R0" type="AR-PACKAGE">
                <a:a name="UUID" value="ECUC:50f2d2f3-5504-4c52-a1e4-9d1b9a95d1d9"/>
                <d:lst type="ELEMENTS">
                    <!-- Ocotp_Object -->
                    <d:chc name="Ocotp" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="RELEASE" value="asc:4.4"/>
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                            <ad:DATE>2014-10-31</ad:DATE>
                                        </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                    Configuration of the Ocotp module.
                                </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="LOWER-MULTIPLICITY" value="1"/>
                            <a:a name="UPPER-MULTIPLICITY" value="*"/>
                            <a:a name="UUID" value="ECUC:6aaf9191-6e86-4577-b6ca-987d515ab0b0"/>
                            <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                                <a:a name="DESC"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="LABEL" value="Post Build Variant Used"/>
                                <a:a name="ORIGIN" value="EB"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="READONLY" value="FALSE"/>
                                <a:da name="TOOLTIP"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                            </v:var>
                            <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                <a:a name="LABEL" value="Config Variant"/>
                                <a:a name="UUID" value="ECUC:bab17be1-957e-4afe-88b7-a4802d1a7bd3"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html>
                                        <p>VariantPostBuild: Mix of precompile and postbuild time configuration parameters.<br>
                                        If Config Variant = VariantPostBuild, the files Ocotp_Cfg.h and Ocotp_PBcfg.c should be used.<br>
                                        If Config Variant = VariantPreCompile, the files Ocotp_Cfg.h and Ocotp_Cfg.c should be used.
                                        </p>
                                    </html>]]>
                                    </a:v>
                                </a:a>
                                <a:da name="DEFAULT" value="VariantPostBuild"/>
                                <a:da name="RANGE">
                                    <a:v>VariantPostBuild</a:v>
                                    <a:v>VariantPreCompile</a:v>
                                </a:da>
                            </v:var>

                            <!-- OcotpGeneral_Object -->
                            <v:ctr name="OcotpGeneral" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Ocotp General"/>
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:<html><p>
                                          Container for general parameters of the ocotp driver. These parameters are always pre-compile.
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:24d0f592-56d1-484b-ad5b-83db3334a424"/>

                                <!-- OcotpDevErrorDetect_Object -->
                                <v:var name="OcotpDevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Ocotp Development Error Detect"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Pre-processor switch to enable and disable development error detection.<br>
                                                true: Development error detection enabled.<br>
                                                false:  Development error detection disabled.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:c618c912-5bde-4ef3-bb6e-aabb2f70a463"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!-- @implements OcotpIpDevErrorDetect_Object -->
                                <v:var name="OcotpIpDevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Ocotp Ip Development Error Detect"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Pre-processor switch to enable and disable development error detection for IP layer.<br>
                                                true: Ocotp error detect for IP layer is enabled.<br>
                                                false: Ocotp error detect for IP layer is disabled.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:0b28a823-646d-4553-8afd-473634eef185"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!-- @implements OcotpEnableUserModeSupport_Object  -->
                                <v:var name="OcotpEnableUserModeSupport" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html>
                                                Ocotp module can run in user mode without any specific measures. The parameter is not used in the Ocotp implementation.
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="LABEL" value="Ocotp Enable User Mode Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:be2fabef-96f0-42c1-b4e4-4ffed12df749"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="READONLY" value="true"/>
                                </v:var>

                                <!-- @implements OcotpEnableMultiCore_Object -->
                                <v:var name="OcotpEnableMultiCore" type="BOOLEAN">
                                    <a:a name="LABEL" value="Ocotp Enable MultiCore Support"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            When this parameter is enabled, the OCOTP module will adapt to run with Multicore.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:d9684915-7380-4d84-adcf-976d2ca42f8f"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!-- @implements OcotpWriteEFuseApi_Object -->
                                <v:var name="OcotpWriteEFuseApi" type="BOOLEAN">
                                    <a:a name="LABEL" value="Ocotp Write EFuse Api"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Ocotp_WriteEFuse function.<br>
                                            true: API supported / function provided.<br>
                                            false: API not supported / function not provided
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a5c07c7e-6a5e-476a-9e74-1edfe8dd9984"/>
                                    <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:value(.) = 'true' and node:value(../OcotpReadEFuseApi) = 'false'"
                                            true="Ocotp Read eFuse Api must be enabled to use this API."/>
                                    </a:da>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

