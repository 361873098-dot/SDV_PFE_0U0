                                    <a:da name="RANGE" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaCrcPolynomial')"/>
                                    <a:da name="DEFAULT" value="ETHERNET_CCITT32_CRC32"/>
                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../MclGeneral/MclDma/MclEnableDma ='true')and (../../../../../../MclGeneral/MclDma/MclEnableCrc ='true') and (../../../dmaLogicChannel_EnableCrcConfig ='true')"/>
                                </v:var>

                                <v:var name="dmaLogicChannel_CrcInitialValue" type="INTEGER">
                                    <a:a name="LABEL" value="Initial Value"/>
                                    <a:a name="DESC">
