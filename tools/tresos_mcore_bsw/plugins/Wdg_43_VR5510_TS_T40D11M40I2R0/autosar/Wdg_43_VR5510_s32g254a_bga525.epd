                          <ORIGIN>NXP</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:db59479c-25e1-4bf7-a81d-d2de0716ea11">
                  <SHORT-NAME>WdgSettingsSlow</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                                
                                                WdgSettingsSlow
                                                Hardware dependent settings for the watchdog driver's slow mode.
                                                </L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <REQUIRES-INDEX>true</REQUIRES-INDEX>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:b2cba33d-eb88-4f2c-bba9-eaa373151944">
                      <SHORT-NAME>WdgWindowPeriod</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        Controls the Watchdog Window Period (FS_WD_WINDOW_DUR[WD_WINDOW]). 
                                                        This new watchdog window period is effective after the next
                                                        watchdog refresh. 
                                                        Note: Implementation Specific Parameter.
                                                              If the WdgWindowPeriodEnable is disabled and WdgDefaultMode is WDGIF_SLOW_MODE mode, this value will not impact,
                                                              And WD_WINDOW will use default value (3ms) after FS_INIT phase is closed.
                                                    </L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
