          <SHORT-NAME>Llce_Af</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Configuration of Llce module.</L-2>
          </DESC>
          <ADMIN-DATA>
            <DOC-REVISIONS>
              <DOC-REVISION>
                <REVISION-LABEL>4.1.0</REVISION-LABEL>
