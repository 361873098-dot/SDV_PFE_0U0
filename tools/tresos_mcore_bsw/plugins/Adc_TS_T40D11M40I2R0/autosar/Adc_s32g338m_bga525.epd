                            <ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                              <DEFAULT-VALUE>NULL_PTR</DEFAULT-VALUE>
                            </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                          </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        </ECUC-FUNCTION-NAME-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5c0419d3-6d2a-404c-9f67-10b041f998f4">
                          <SHORT-NAME>CtuExpectedValuePortB</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Expected number of system clock cycles (the slave bus clock) for an AD conversion to be completed by the ADC connected to Port B.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
