                    <ECUC-REFERENCE-DEF UUID="ECUC:b883dcfa-2f16-443a-9a48-6d23d99c49f9">
                      <SHORT-NAME>EthCtrlEcucPartitionRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Maps the ETH driver to zero or multiple ECUC partitions to make the driver API available in the according partition. The Eth driver will operate as an independent instance in each of the partitions.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
