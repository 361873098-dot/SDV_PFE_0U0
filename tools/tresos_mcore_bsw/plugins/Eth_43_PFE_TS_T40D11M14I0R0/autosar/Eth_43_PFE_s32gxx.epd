                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REFS>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigEgressFifo</DESTINATION-REF>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigScheduler</DESTINATION-REF>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig/EthCtrlConfigEgress/EthCtrlConfigShaper</DESTINATION-REF>
                                  </DESTINATION-REFS>
                                </ECUC-CHOICE-REFERENCE-DEF>
                              </REFERENCES>
                              <SUB-CONTAINERS>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a240e482-f8b4-4ccb-b0d1-85334567fe12">
                                  <SHORT-NAME>EthCtrlConfigSchedulerPredecessorVendorSpecific</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Scheduler Predecessor vendor specific configuration.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0665580f-4039-4aef-875a-407788776644">
                                      <SHORT-NAME>EthCtrlConfigSchedulerBandwidth</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">
                                                            Represents the bandwidth percentage allocated for current scheduler input.
                                                            In SCHED_ALGO_RR and SCHED_ALGO_PQ, this parameter is irrelevant.
                                                            In SCHED_ALGO_WRR, weight for current scheduler input = (EthTxSchedulerBandwidth / 100) * EthTotalPacketsPerCycle.
                                                            In SCHED_ALGO_DWRR, weight for current scheduler input = (EthTxSchedulerBandwidth / 100) * EthTotalQuantumPerCycle.
                                                            This field is editable only when the scheduling algorithm is set to SCHED_ALGO_WRR or SCHED_ALGO_DWRR.
                                                            </L-2>
                                      </DESC>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>NXP</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>10</DEFAULT-VALUE>
                                      <MAX>100</MAX>
                                      <MIN>1</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a240e482-f8b4-4ccb-b0d1-853701546789">
                              <SHORT-NAME>EthCtrlConfigSchedulerVendorSpecific</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Scheduler vendor specific configuration.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
