  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd"
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="TS_T40D11M40I2R0" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:35cab853-b873-496d-98d6-c3226b4d6856"/>
            <d:lst type="ELEMENTS">
              <d:chc name="Pcie" type="AR-ELEMENT" value="MODULE-DEF">
                <v:ctr type="MODULE-DEF">
                    <a:a name="RELEASE" value="asc:4.4"/>
                    <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                        <ad:ADMIN-DATA>
                            <ad:DOC-REVISIONS>
                            <ad:DOC-REVISION>
                            <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                            </ad:DOC-REVISION>
                        </ad:DOC-REVISIONS>
                    </ad:ADMIN-DATA>
                    </a:a>
                    <a:a name="DESC" value="EN: Vendor specific: Configuration of the Pcie (PcieDriver) module"/>
                    <a:a name="LOWER-MULTIPLICITY" value="0"/>
                    <a:a name="POSTBUILDVARIANTSUPPORT" value="false"/>
                    <a:a name="UPPER-MULTIPLICITY" value="1"/>
                    <a:a name="UUID" value="ECUC:1e8f8b52-ca03-d4f1-21e2-21377133d9d5"/>
                    <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                        <a:a name="DESC" value="Vendor specific: Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="LABEL" value="Post Build Variant Used"/>
                        <a:a name="ORIGIN" value="EB"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="READONLY" value="true"/>
                    </v:var>
                    <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                        <a:a name="LABEL" value="Config Variant"/>
                        <a:a name="UUID" value="ECUC:1a6b36f0-ea4c-46d6-86b5-9369aa3a226c"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:
                                    <html><p>
                                        VariantPreCompile: Only precompile time configuration parameters.<br>
                                        The files Pcie_Cfg.h and Pcie_Cfg.c are used.<br>
                                    </p></html>
                                ]]>
                            </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:da name="DEFAULT" value="VariantPreCompile"/>
                        <a:da name="RANGE">
                            <a:v>VariantPreCompile</a:v>
                        </a:da>
                    </v:var>
 
                    <!-- @implements PcieGeneral_Object -->
                    <v:ctr name="PcieGeneral" type="IDENTIFIABLE">
                        <a:a name="DESC" value="EN: Container for common configuration options"/>
                        <a:a name="UUID" value="ECUC:22ae2271-3301-410d-108a-8aebfedf64e6"/>
                        
                        <!-- @implements PcieDevErrorDetect_Object -->
                        <v:var name="PcieDevErrorDetect" type="BOOLEAN">
                            <a:a name="DESC" value="EN: Vendor specific: Switches the development error detection and notification on or off."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:1b0aef6b-fa21-1fa8-a2db-0ac159b72c59"/>
                            <a:da name="DEFAULT" value="false"/>
                        </v:var>

                        <!-- @implements PcieEnableUserModeSupport_Object -->
                        <v:var name="PcieEnableUserModeSupport" type="BOOLEAN">
                            <a:a name="DESC" value="Vendor specific: User Mode not supported."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:1a0aef6b-fa21-1fa8-a2db-0ac159b83c59"/>
                            <a:da name="DEFAULT" value="false"/>
                            <a:da name="READONLY" value="true"/>
                        </v:var>

                        <v:var name="PcieMulticoreSupport" type="BOOLEAN">
                            <a:a name="LABEL" value="Pcie Multicore Support"/>
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html><p>
                                        Vendor specific: This parameter globally enables the possibility to support multicore.<p/>
                                        <p>If PcieMulticoreSupport is disabled, then for all the variants no EcucPartition shall be defined.</p>
                                        Note: Implementation Specific Parameter.<p/>
                                        </p></html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:72a8a638-4239-4639-124a-ee4d35363e77"/>
                            <a:da name="DEFAULT" value="false"/>
                        </v:var>

                    </v:ctr>
                    
                    
                    <v:ctr name="PcieGlobalConfig" type="IDENTIFIABLE">
                      <a:a name="DESC">
                          <a:v>
                              <![CDATA[EN:
                                  <html><p>
                                  Vendor specific: This container contains the global configuration parameter of the Pcie driver. This container is a MultipleConfigurationContainer, i.e. this container and its sub-containers exit once per configuration set.
                                  </p></html>
                              ]]>
                          </a:v>
                      </a:a>
                      <a:a name="UUID" value="ECUC:ea3b8cf8-1ae5-9a29-ad08-1717472cf670"/>

                        <v:ctr name="APIconfiguration" type="IDENTIFIABLE">
                          <a:a name="DESC">
                              <a:v>
                                  <![CDATA[EN:
                                      <html><p>
                                      Vendor specific: This container contains the configuration of the available APIs
                                      </p></html>
                                  ]]>
                              </a:v>
                          </a:a>
                          <a:a name="LABEL" value="API configuration" />
                          <a:a name="UUID" value="ECUC:9f1101fb-1298-4e6b-bf29-82313768b027"/>

                            <v:var name="PcieSetOutboundRegionApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Set Outbound Region API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_SetOutboundRegion function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1312"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="PcieDmaReadApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Dma Read API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_DmaRead function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1313"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="PcieDmaReadIntEnableApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Dma Read Int Enable API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_DmaReadIntEnable function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1314"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>


                            <v:var name="PcieDmaCheckReadStatusApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Dma Check Read Status API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_DmaCheckReadStatus function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1315"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="PcieDmaWriteApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Dma Write API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_DmaWrite function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1316"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="PcieDmaWriteIntEnableApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Dma Write Int Enable API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_DmaWriteIntEnable function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1317"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="PcieDmaCheckWriteStatusApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Dma Check Write Status API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_DmaCheckWriteStatus function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1759c3d1318"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="PcieSendMsiApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Pcie Send Msi API"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Pre-processor switch to enable and disable the Pcie_SendMsi function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
