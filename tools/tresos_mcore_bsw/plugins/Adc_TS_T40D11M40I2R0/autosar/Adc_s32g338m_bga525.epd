                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0cb2283c-677d-434e-80a6-169b5c6e63e4">
                          <SHORT-NAME>AdcAlternateGroupConvTimings</SHORT-NAME>
