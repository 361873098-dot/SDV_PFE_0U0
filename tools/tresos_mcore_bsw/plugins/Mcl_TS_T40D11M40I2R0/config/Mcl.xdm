<d:ctr type="AUTOSAR" factory="autosar"
    xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
    xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
    xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
    <d:lst type="TOP-LEVEL-PACKAGES">
        <d:ctr name="TS_T40D11M40I2R0" type="AR-PACKAGE">
            <a:a name="UUID" value="ECUC:dd777812-2700-4ff0-b0a4-094794fe4dc0"/>
            <d:lst type="ELEMENTS">
                <d:chc name="Mcl" type="AR-ELEMENT" value="MODULE-DEF">
                    <v:ctr type="MODULE-DEF">
                        <a:a name="RELEASE" value="asc:4.4"/>
                        <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                            <ad:ADMIN-DATA>
                                <ad:DOC-REVISIONS>
                                    <ad:DOC-REVISION>
                                        <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                        <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                        <ad:DATE>2014-10-31</ad:DATE>

                                    </ad:DOC-REVISION>
                                </ad:DOC-REVISIONS>
                            </ad:ADMIN-DATA>
                        </a:a>
                        <a:a name="DESC"
                             value="EN: Vendor specific: Configuration of the Mcl (MicroController Library ) module."/>
                        <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                        <a:a name="UUID" value="ECUC:05f52b67-436e-4bca-9e0c-101c39b327f2"/>
                        <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                            <a:a name="DESC"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="LABEL" value="Post Build Variant Used"/>
                            <a:a name="ORIGIN" value="EB"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:da name="DEFAULT" value="true"/>
                            <a:da name="READONLY" value="FALSE"/>
                            <a:da name="TOOLTIP"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                        </v:var>
                        <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                            <a:a name="LABEL" value="Config Variant"/>
                            <a:a name="UUID" value="ECUC:ce4b3b4a-86da-4f2a-88e0-5d2693913dba"/>
                            <a:da name="DEFAULT" value="VariantPostBuild"/>
                            <a:da name="RANGE">
                                <a:v>VariantPostBuild</a:v>
                                <a:v>VariantPreCompile</a:v>
                            </a:da>
                        </v:var>

                        <v:ctr name="MclGeneral" type="IDENTIFIABLE">
                            <a:a name="DESC" value="EN: Vendor specific: Configuration of general Mcl parameters."/>
                            <a:a name="UUID" value="ECUC:6d8547f9-e285-457b-a878-94e5e562476a"/>
                            <a:a name="LABEL" value="Mcl General Configuration"/>

                        
                            <v:var name="MclEnableDevErrorDetect" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN: <html> Vendor specific:
                                        <p>Enable/Disable the Development Error Detection (DET).</p>
                                            <ul>
                                                <li>true: Enabled.</li>
                                                <li>false: Disabled.</li>
                                            </ul>
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>

                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="LABEL" value="Enable Development Error Detect"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:24ae6f85-444c-48e4-a2ca-721d8091edf1"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:a name="EDITABLE" value="true"/>
                            </v:var>

                            <v:var name="Mcl_VersionInfoApi" type="BOOLEAN">
                                <a:a name="DESC" value="EN: Vendor specific: Enables/Disables the get version info API function"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:03685d5a-3977-4d1d-9366-344aed36fb0a"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:a name="EDITABLE" value="true"/>
                            </v:var>

                            <!-- EnableUserModeSupport -->
                            <!-- @implements MclEnableUserModeSupport_Object -->
                            <v:var name="MclEnableUserModeSupport" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html>
                                                When this parameter is enabled, the MCL module will adapt to run from User Mode, with the following measures:<p/>
                                                b) using 'call trusted function' stubs for all internal function calls that access registers requiring supervisor mode.<p/>
                                                for more information, please see chapter 5.7 User Mode Support in IM <p/>
                                                Note: Implementation Specific Parameter.
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="LABEL" value="Mcl Enable User Mode Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:50c68b82-4b68-48e1-bf65-c5c8d20494c3"/>
                                    <a:da name="DEFAULT" value="false"/>
                                                                    <a:a name="EDITABLE" value="true"/>
                                                                                            </v:var>

                                                    <!-- EnableMulticoreSupport -->
                            <v:var name="MclEnableMulticoreSupport" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html>
                                                Enable/Disable Multicore support
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="LABEL" value="Mcl Enable Multicore Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:fdf29f84-dbae-5cd2-abf2-c0941851a05e"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="EDITABLE" type="XPath" expr="num:i(ecu:get('Mcl.MultiCore.Support')) = 1"/>
                            </v:var>

                            <!-- MclEcucPartitionRef -->
                            <v:ref name="MclEcucPartitionRef" type="REFERENCE">
                                <a:a name="LABEL" value="Mcl Initialization Multicore Configuration"/>
                                <a:a name="DESC">
                                <a:v>The partition shall be used to initialize and de-initialize the Mcl Driver.</a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="UUID"
                                    value="ECUC:f2e69199-f11e-4d01-9dcf-dbd71f71929f"/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:da name="INVALID" type="XPath">
                                        <a:tst expr="node:refvalid(.)" false="There are no valid MclEcucPartitionRef's configured"/>
                                </a:da>
                                <a:da name="REF"
                                    value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                <a:a name="EDITABLE" type="XPath">
                                    <a:tst expr="../MclEnableMulticoreSupport ='true' and (num:i(ecu:get('Mcl.MultiCore.Support')) = 1)"/>
                                </a:a>
                            </v:ref>
                        
                            <!-- EnableVirtualAddressMappingSupport -->
                            <!-- @implements MclEnableVirtualAddressMappingSupport_Object -->
                            <v:var name="MclEnableVirtualAddressMappingSupport" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html>
                                                Enable/Disable Virtual Address Mapping support
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="LABEL" value="Mcl Enable Virtual Address Mapping Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:fdf29f84-dbae-5cd2-abf2-c0941652a05e"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="../MclDma/MclEnableDma ='true'"/>
                                    </a:a>
                                    <a:da name="INVALID" type ="XPath">
                                        <a:tst expr="((node:fallback(.,'false') = 'true') and (node:fallback(../MclDma/MclEnableDma,'false') = 'false'))"
                                         true="Virtual Address Mapping Support only is checked when Mcl Dma is supported "/>
                                    </a:da>
                            </v:var>

                            <!-- MclDmaSupport -->
                            <v:ctr name="MclDma" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Mcl Dma"/>
                                <a:a name="DESC">
                                    <a:v>
                                         <![CDATA[EN: <html> Vendor specific:
                                                Container for the Dma related configuration parameters.
                                                </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:b63c1189-c7ee-4588-adcb-149cb9daa238"/>

                                <!-- MclEnableDma -->
                                <v:var name="MclEnableDma" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html> Vendor specific: <p>Enable/Disable DMA support.</p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Enable DMA Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:72d28c1d-311-41a5-ba35-40021a249a75"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!-- MclEnableDmaCrc -->
                                                            <v:var name="MclEnableCrc" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html> Vendor specific: <p>Enable/Disable DMA CRC support.</p></html>]]></a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="LABEL" value="Enable CRC Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:72d28c1d-311-41a6-ba36-40021a249a75"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>
                                                        </v:ctr>

                                                    <!-- MclCacheSupport -->
                            <v:ctr name="MclCache" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Mcl Cache"/>
                                <a:a name="DESC">
                                    <a:v>
                                         <![CDATA[EN: <html> Vendor specific:
                                                Container for the CACHE related configuration parameters.
                                                </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:b63c1079-c7ee-4588-adcb-149cb9daa238"/>

                                <!-- MclEnableCache -->
                                <v:var name="MclEnableCache" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor specific:
                                                Enable/Disable all CACHE support.
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>

                                    </a:a>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="LABEL" value="Enable CACHE Support"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:c7d99d92-8a15-4476-96bf-4132cdae7781"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="EDITABLE" type="XPath" expr="num:i(ecu:get('Mcl.Cache.Support')) = 1"/>
                                </v:var>
                                                            <!-- MclSynchronizeCache -->
                                <!-- <v:var name="MclSynchronizeCache" type="BOOLEAN">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor specific:
                                                Synchronize the Memory and Cache by cleaning the Cache before each DMA transmision and invalidating the Cache
                                                after each DMA data transmission.<p/>
                                                The MCL driver needs to maintain the memory coherency by means of three methods:<p/>
                                                    1. Disable data cache, or<p/>
                                                    2. Place the data buffers in non-cacheable memory sections, or<p/>
                                                    3. Enable the MclSynchronizeCache feature, or<p/>
                                                    4. Use the cache line APIs individually.<p/>
                                                Depending on the application configuration, one option may be more beneficial than others.<p/>
                                                If the respective cache is disabled or the buffers are placed in non-cacheable memories, this parameter should be
                                                disabled.<p/>
                                                Enabled:    The MCL driver will call Mcl cache API functions in order to sync the cache
                                                            and memory before and after each DMA transfer, in order
                                                            to ensure that the cache and the modified memory are in sync.<p/>
                                                            If enabled, the driver will attempt to clean&invalidate the entire cache.
                                                            If, for perfomance reasons, this invalidation is not desired, then the upper
                                                            software layers should disable this parameter and clean/invalidate the DMA
                                                            buffers accordingly, using the provide cache line APIs.<p/>
                                                            If enabled, the affected drivers will be able to run with the buffers cached.<p/>
                                                Disabled:   MCL driver will not call any cache function during a DMA operation.
                                                            If disabled, the MCL driver needs to have its buffers placed in non-cacheable
                                                            memories, the cache has to be disabled or the data buffers have to be flushed
                                                            before a DMA transaction and invalidated/cleared after it finishes.
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="LABEL" value="Enable CACHE Synchronization"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:c7d99d92-8a15-4476-96bf-4133cdae7781"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="EDITABLE" type="XPath" expr="(../MclEnableCache ='true')"/>
                                </v:var> -->
                            </v:ctr> <!-- <v:ctr name="MclCache" type="IDENTIFIABLE"> -->
                        
                            
                            
                            
                                                        <!-- MclFtmCommonSupport -->
                            <v:ctr name="MclFtmCommon" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Mcl FTM Common"/>
                                <a:a name="DESC">
                                    <a:v>
                                         <![CDATA[EN: <html> Vendor specific:
                                                Container for the FTM Common related configuration parameters.
                                                </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:b63c1079-c7ee-4588-adcb-ddddd9ddc238"/>
                                <v:var name="Mcl_FtmCommonTimebase" type="BOOLEAN">
                                    <a:a name="LABEL" value="FTM Common Timebase"/>
                                    <a:a name="DESC">
                                    <a:v><![CDATA[EN:
                                    <html>
                                    Enables/Disables the option to set the a common timebase for multiple FTM modules.

                                    Note:
                                    <h1>Note</h1>This is an Implementation Specific Parameter. Enabling this feature will allow the use of the Mcl_SelectCommonTimebase API</html>
                                    ]]></a:v>
                                        </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:9391111c-5aed-4783-9c47-405888265a6d"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                </v:var>
                            </v:ctr>
                            
                                                    </v:ctr>

                        <v:ctr name="MclConfig" type="IDENTIFIABLE">
                            <a:da name="FRAME" value="NONE"/>
                            <a:a name="DESC">
                                <a:v><![CDATA[EN: <html> Vendor specific: This container is the base for a multiple configuration set
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:b824a41e-5f5e-48b6-9c71-0e63b429c3da"/>

                            <v:lst name="MclVirtualMemorySection" type="MAP">
                                <a:a name="LABEL" value="Mcl Virtual Memory Section"/>
                                <a:da name="MIN" value="0"/>
                                <a:a name="EDITABLE" type="XPath">
                                    <a:tst expr="../../MclGeneral/MclEnableVirtualAddressMappingSupport ='true'"/>
                                </a:a>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="../../MclGeneral/MclEnableVirtualAddressMappingSupport ='true' and (count(node:fallback(./*,1)) = 0)" true="If MclEnableVirtualAddressMappingSupport = true, then at least 1 Virtual memory section must be configured"/>
                                </a:da>

                                <v:ctr name="MclVirtualMemorySection" type="IDENTIFIABLE">
                                    <a:a name="REQUIRES-INDEX" value="true"/>
                                    <a:a name="DESC">
                                    <a:v><![CDATA[EN:
                                        <html> Vendor specific:
                                        Data to configure Virtual address and Physical address.
                                        </html>
                                            ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:b37b96c6-7528-11e8-adc0-fa7ae01bbebc"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <v:var name="MclVirtualAddressStart" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    This parameter represents the Virtual Address Start.
                                                    The address must be aligned to 4 bytes.
                                                    Note: Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="DEFAULT_RADIX" value="HEX"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="LABEL" value="Virtual Address Start"/>
                                        <a:a name="UUID" value="ECUC:b37b9964-7528-11e8-adc0-fa7ae01bbebc"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=4294967295"/>
                                            <a:tst expr="&gt;=0"/>
                                        </a:da>
                                        <a:da name="RANGE" type="XPath">
                                            <a:tst expr="(node:fallback(., 0) mod 4) != 0" true="The Virtual Address Start must be 4 byte alligned."/>
                                        </a:da>
                                    </v:var>

                                    <v:var name="MclVirtualAddressEnd" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    This parameter represents the Virtual Address End.
                                                    The address must be aligned to 4 bytes.
                                                    Note: Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="DEFAULT_RADIX" value="HEX" />
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="LABEL" value="Virtual Address End"/>
                                        <a:a name="UUID" value="ECUC:b37b9aa4-7528-11e8-adc0-fa7ae01bbebc"/>
                                        <a:da name="DEFAULT" value="255"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=4294967295"/>
                                            <a:tst expr="&gt;=0"/>
                                        </a:da>
                                        <a:da name="RANGE" type="XPath">
                                            <a:tst expr="((node:fallback(., 0)+1) mod 4) != 0" true="The Virtual Address end must be the last address of a page eg: a page with 64kb the end address should be like 0xxxxxFFFF in hexa format."/>
                                            <a:tst expr="(node:fallback(., 0) &lt; node:fallback(../MclVirtualAddressStart, 0))" true="The value of VirtualAddressEnd must be greater or equal VirtualAddressStart."/>
                                        </a:da>
                                    </v:var>

                                    <v:var name="MclPhysicalAddressStart" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    This parameter represents the Physical Address Start.
                                                    The address must be aligned to 4 bytes.
                                                    Note: Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="DEFAULT_RADIX" value="HEX" />
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="LABEL" value="Physical Address Start"/>
                                        <a:a name="UUID" value="ECUC:145207b4-784e-11e8-adc0-fa7ae01bbebc"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=4294967295"/>
                                            <a:tst expr="&gt;=0"/>
                                        </a:da>
                                        <a:da name="RANGE" type="XPath">
                                            <a:tst expr="(node:fallback(., 0) mod 4) != 0" true="The Physical Address Start must be 4 byte alligned."/>
                                        </a:da>
                                    </v:var>

                                    <v:var name="MclPhysicalAddressEnd" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    This parameter represents the Physical Address End.
                                                    The address must be aligned to 4 bytes.
                                                    Note: Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="DEFAULT_RADIX" value="HEX" />
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="LABEL" value="Physical Address End"/>
                                        <a:a name="UUID" value="ECUC:14520a3e-784e-11e8-adc0-fa7ae01bbebc"/>
                                        <a:da name="DEFAULT" value="255"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=4294967295"/>
                                            <a:tst expr="&gt;=0"/>
                                        </a:da>
                                        <a:da name="RANGE" type="XPath">
                                            <a:tst expr="((node:fallback(., 0)+1) mod 4) != 0" true="The Physical Address end must be the last address of a page eg: a page with 64kb the end address should be like 0xxxxxFFFF in hexa format."/>
                                            <a:tst expr="(node:fallback(., 0) &lt; node:fallback(../MclPhysicalAddressStart, 0))" true="The value of PhysicalAddressEnd must be greater or equal PhysicalAddressStart."/>
                                            <a:tst expr="( (num:i(number(node:fallback(../MclVirtualAddressEnd, 0))) - num:i(number(node:fallback(../MclVirtualAddressStart, 0))))!= (num:i(number(node:fallback(., 0))) - num:i(number(node:fallback(../MclPhysicalAddressStart, 0)))) )" true="PhysicalAddressEnd - PhysicalAddressStart must be equal VirtualAddressEnd - VirtualAddressStart ."/>
                                        </a:da>
                                    </v:var>
                                </v:ctr>
                            </v:lst>

                        
                                                                                <v:lst name="dmaLogicInstance_ConfigType" type="MAP">
                                <a:a name="LABEL" value="Dma Logic Instance"/>
                                <a:da name="MIN" value="0"/>
                                <a:da name="MAX" type="XPath" expr="num:i(2 + 1)"/>
                                <a:da name="INVALID" type="XPath">
                                   <a:tst expr="(../../MclGeneral/MclDma/MclEnableDma ='true') and (num:i(count(./*)) > num:i(count(ecu:list('Mcl.MclConfigSet.DmaHwInstance.List'))))"
                                   true="Number of the Dma Instances configured is greater than number of the existing Dma hardware Instances on the platform."/>
                                   <a:tst expr="(../../MclGeneral/MclDma/MclEnableDma ='true') and (num:i(count(./*))=0)"
                                   true="When enable DMA, at least one DMA instance must be configured."/>
                                </a:da>
                                <a:a name="EDITABLE" type="XPath" expr="(../../MclGeneral/MclDma/MclEnableDma ='true')"/>

                                <v:ctr name="dmaLogicInstance_ConfigType" type="IDENTIFIABLE">
                                    <a:a name="REQUIRES-INDEX" value="true"/>
                                    <a:da name="FRAME" value="NONE"/>
                                    <a:a name="LAYOUT" value="VERTICAL"/>
                                    <a:a name="DESC" value="EN: Vendor specific: Configuration of a DMA Instance."/>
                                    <a:a name="UUID" value="ECUC:5d10957b-c38a-45ed-b06b-4b7e365f1cc3"/>
                                    <a:a name="LABEL" value="Instance"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="EDITABLE" type="XPath" expr="(../../../MclGeneral/MclDma/MclEnableDma ='true')"/>

                                    <v:var name="dmaLogicInstance_IdName" type="STRING">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                    Logic Instance Name.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Logic Instance Name"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:feb20843-4496-4542-8956-ab9a45086f8b"/>
                                        <a:da name="DEFAULT" type="XPath" expr="concat( 'DMA_LOGIC_INST_' , node:fallback(node:current()/../@index,'0') )"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:uniq(../../*/dmaLogicInstance_IdName, .)" false="Duplicate Logic Instance Name!"/>
                                        </a:da>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                   <v:var name="dmaLogicInstance_hwId" type="ENUMERATION">
                                        <a:a name="LABEL" value="Hardware Instance"/>
                                        <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor specific:
                                            Select the Hardware DMA Instance.
                                            NOTE: This is an Implementation Specific Parameter.
                                            </html>]]>
                                        </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:f7cbd8ea-f1bc-41a1-ad0a-e9f4015cf1e5"/>
                                        <a:da name="DEFAULT" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaHwInstance.List')[position()-1=node:fallback(node:current()/../@index,'0')]"/>
                                        <a:da name="RANGE" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaHwInstance.List')"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:uniq(../../*/dmaLogicInstance_hwId, .)" false="Duplicate Hardware Instance!"/>
                                        </a:da>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicInstance_enDebug" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                    DMA_CR[EDBG].
                                                    Enable Debug.
                                                    0 - The assertion of the system debug control input is ignored.
                                                    1 - The assertion of the system debug control input causes the eDMA to stall the start of a new channel.
                                                           Executing channels are allowed to complete.
                                                           Channel execution will resume when either the system debug control input is negated or the EDBG bit is cleared.
                                                    Note: Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Debug"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:feb20843-4496-4542-8956-ab9a45086f8a"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicInstance_enRoundRobin" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                    DMA_CR[ERCA].
                                                    Enable Round Robin Channel Arbitration.
                                                    0 - Fixed-priority arbitration is used for channel selection within each group.
                                                    1 - Round-Robin arbitration is used for channel selection within each group.
                                                    Note: Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Round Robin Channel Arbitration"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:b7ee1249-087c-42f7-be8b-3233fb220cfc"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicInstance_enHaltAfterError" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                    DMA_CR[HOE] for eDMA2 instances or DMA_CSR[HAE] for eDMA3 instances.
                                                    Halt On/After Error.
                                                    0 - Normal operation.
                                                    1 - Any error will cause the HALT bit to be set.
                                                           Subsequently, all service requests will be ignored until the HALT bit is cleared.
                                                    Note: Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Halt After Error"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:cce36948-aa6d-419c-ae97-a483c133fe6c"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicInstance_enChLinking" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                    DMA_CR[GCLC].
                                                    Global Channel Linking Control.
                                                    0 - Channel linking is disabled for all channels.
                                                    1 - Channel linking is available and controlled by each channel's link settings.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Global Channel linking"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:dd63275d-22f0-4ba3-b64b-f29b8ea667f5"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                                                    <v:var name="dmaLogicInstance_enGlMasterIdReplication" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                    DMA_CSR[GMRC].Available only for eDMA3 instances.
                                                    Global master ID replication control
                                                    0 - Master ID replication is disabled for all channels
                                                    1 - Master ID replication is available and it is controlled by each channel's CHn_SBR[EMI] setting.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Global Master ID Replication"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:c1adfc64-6df4-4378-ad5b-f6b5aa778a6c"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>
                                
                                                                    <v:ref name="dmaLogicInstance_EcucPartitionRef" type="REFERENCE">
                                        <a:a name="LABEL" value="Ecuc Partition Ref"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    Maps a DMA instance to zero or multiple ECUC partitions to limit the access to this mappable element.
                                                    The ECUC partitions referenced are a subset of the ECUC partitions where the MCL driver is mapped to
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="UUID"
                                            value="ECUC:f2e69199-f11e-3d01-9dcf-dbd71f71783f"/>
                                        <a:a name="OPTIONAL" value="true"/>
                                        <a:da name="REF"
                                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                         <a:da name="INVALID" type="XPath">
                                                <a:tst expr="node:refvalid(.) or (../../../../MclGeneral/MclEnableMulticoreSupport ='false') or (num:i(ecu:get('Mcl.MultiCore.Support')) = 0)" false = "dmaLogicInstance_EcucPartitionRef hasn't reference"/>
                                        </a:da>
                                        <a:a name="EDITABLE" type="XPath">
                                            <a:tst expr="(../../../../MclGeneral/MclEnableMulticoreSupport ='true' and (num:i(ecu:get('Mcl.MultiCore.Support')) = 1))"/>
                                        </a:a>
                                    </v:ref>
                                
                                                                    <v:ctr name="dmaLogicInstance_DmaCrc" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="Dma Crc"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                 <![CDATA[EN: <html> Vendor specific:
                                                        Container for the Dma Crc related configuration parameters.
                                                        </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:b63c1189-c7ee-4588-adcb-149cb7daa248"/>

                                                                        <v:var name="dmaLogicInstance_DmaCrcEnSwapBit" type="BOOLEAN">
                                            <a:a name="LABEL" value="Enable Swap Bit"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:
                                                        <html> Vendor specific: Enable Swap Bit
                                                        </html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100102"/>
                                            <a:a name="EDITABLE" type="XPath" expr="(../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../MclGeneral/MclDma/MclEnableCrc ='true')"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>
                                
                                        <v:var name="dmaLogicInstance_DmaCrcEnSwapByte" type="BOOLEAN">
                                            <a:a name="LABEL" value="Enable Swap Byte"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:
                                                        <html> Vendor specific: Enable Swap Byte
                                                        </html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100302"/>
                                            <a:a name="EDITABLE" type="XPath" expr="(../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../MclGeneral/MclDma/MclEnableCrc ='true')"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                        <v:var name="dmaLogicInstance_DmaCrcEnGlobal" type="BOOLEAN">
                                            <a:a name="LABEL" value="Enable Global"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:
                                                        <html> Vendor specific: Enable Global
                                                        </html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100303"/>
                                            <a:a name="EDITABLE" type="XPath" expr="(../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../../MclGeneral/MclDma/MclEnableCrc ='true')"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                    </v:ctr>
                                
                                </v:ctr>
                            </v:lst>


                                                        <v:lst name="dmaLogicChannel_Type" type="MAP">
                                <a:a name="LABEL" value="Dma Logic Channel"/>
                                <a:da name="MIN" value="0"/>
                                <a:da name="MAX" type="XPath" expr="num:i(ecu:get('Mcl.DMA.NumLogicChannel'))"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="../../MclGeneral/MclDma/MclEnableDma ='true' and (num:i(count(*))= 0)"
                                    true ="At least one channel must be configured when Mcl DMA Supported is checked!"/>
                                </a:da>
                                <a:a name="EDITABLE" type="XPath" expr="(../../MclGeneral/MclDma/MclEnableDma ='true')"/>

                                <v:ctr name="dmaLogicChannel_Type" type="IDENTIFIABLE">
                                    <a:a name="REQUIRES-INDEX" value="true"/>
                                    <a:da name="TITLE" value="Logic Channel"/>
                                    <a:a name="LABEL" value="Logic Channel Configuration"/>
                                    <a:da name="FRAME" value="NONE"/>
                                    <a:a name="LAYOUT" value="VERTICAL"/>
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html> Vendor specific:
                                            Logic Channel Configuration.
                                            </html>
                                                ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100e5b"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="EDITABLE" type="XPath" expr="(../../../MclGeneral/MclDma/MclEnableDma ='true')"/>

                                    <v:var name="dmaLogicChannel_LogicName" type="STRING">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                    Logic Channel Name.
                                                </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Logic Channel Name"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:f51a5922-fbe6-44ad-8ca3-43985c5aa110"/>
                                        <a:da name="DEFAULT" type="XPath" expr="concat( 'DMA_LOGIC_CH_' , node:fallback(node:current()/../@index,'0') )"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="text:uniq(../../*/dmaLogicChannel_LogicName, .)" false="Duplicate Logic Channel Name!"/>
                                        </a:da>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicChannel_HwInstId" type="ENUMERATION">
                                        <a:a name="LABEL" value="Hardware Instance"/>
                                        <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor specific:
                                            Select the Hardware DMA Instance.
                                            NOTE: This is an Implementation Specific Parameter.
                                            </html>]]>
                                        </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:0aff248e-f32e-42b6-94be-372ca32a5726"/>
                                        <a:da name="DEFAULT" type="XPath" expr="(ecu:list('Mcl.MclConfigSet.DmaHwInstance.List'))[position()]"/>
                                        <a:da name="RANGE" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaHwInstance.List')"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicChannel_HwChId" type="ENUMERATION">
                                        <a:a name="LABEL" value="Hardware Channel"/>
                                        <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor specific:
                                            Select the physical eDMA Channel.
                                            NOTE: This is an Implementation Specific Parameter.
                                            </html>]]>
                                        </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:0aff248e-f32e-42b6-94be-372ca32a5727"/>
                                        <a:da name="RANGE" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaChannel')"/>
                                        <a:da name="DEFAULT" type="XPath" expr="ecu:list('Mcl.MclConfigSet.DmaChannel')[position()-1=node:fallback(node:current()/../@index,'0')]"/>
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="var:set('HwInsId',../dmaLogicChannel_HwInstId) and text:uniq(../../*[dmaLogicChannel_HwInstId=$HwInsId]/dmaLogicChannel_HwChId, .)" false="Duplicate Hardware Channel!"/>
                                            <a:tst expr="contains(./../dmaLogicChannel_HwInstId,'DMA_IP_HW_INST_0') and not(contains(ecu:list('Mcl.DMA0.Channel.List'),.))" true="This instance does not support this channel!"/>
                                                                                    <a:tst expr="contains(./../dmaLogicChannel_HwInstId,'DMA_IP_HW_INST_1') and not(contains(ecu:list('Mcl.DMA1.Channel.List'),.))" true="This instance does not support this channel!"/>
                                                                                                                                                                                                        </a:da>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicChannel_InterruptCallback" type="FUNCTION-NAME">
                                        <a:a name="LABEL" value="Interrupt Callback"/>
                                        <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor specific:
                                            User callback function to report that the transfer is half or complete depending on configuration.
                                            NOTE: Use NULL_PTR w/o quotes. If the used string is different from NULL_PTR it will be used as the configured function name.
                                            </html>]]>
                                        </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:c5326d00-5f70-49fe-90c4-36a4df202b63"/>
                                        <a:da name="DEFAULT" value="NULL_PTR"/>
                                        <a:da name="INVALID" type="XPath">
                                        <a:tst expr="normalize-space(.) = '&quot;NULL_PTR&quot;' or normalize-space(.) = 'NULL_PTR' or normalize-space(.) = '&quot;NULL&quot;' or normalize-space(.) = 'NULL' or text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')"
                                        false="Invalid name of the Dma Notification. Must be valid C function name, NULL_PTR, &quot;NULL_PTR&quot;, NULL, or &quot;NULL&quot;."/>
                                        </a:da>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicChannel_ErrorInterruptCallback" type="FUNCTION-NAME">
                                       <a:a name="LABEL" value="Error Interrupt Callback"/>
                                       <a:a name="DESC">
                                       <a:v>
                                           <![CDATA[EN:<html> Vendor specific:
                                           User callback function
                                           NOTE: Use NULL_PTR w/o quotes. If the used string is different from NULL_PTR it will be used as the configured function name.
                                           </html>]]>
                                       </a:v>
                                       </a:a>
                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                           <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                           <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                       </a:a>
                                       <a:a name="SCOPE" value="LOCAL"/>
                                       <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                       <a:a name="ORIGIN" value="NXP"/>
                                       <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                       <a:a name="UUID" value="ECUC:c5326d00-5f70-500e-90c4-36a4df402b6f"/>
                                       <a:da name="DEFAULT" value="NULL_PTR"/>
                                       <a:da name="INVALID" type="XPath">
                                       <a:tst expr="normalize-space(.) = '&quot;NULL_PTR&quot;' or normalize-space(.) = 'NULL_PTR' or normalize-space(.) = '&quot;NULL&quot;' or normalize-space(.) = 'NULL' or text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')"
                                       false="Invalid name of the Mcl Notification. Must be valid C function name, NULL_PTR, &quot;NULL_PTR&quot;, NULL, or &quot;NULL&quot;."/>
                                       </a:da>
                                       <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                                                    <v:ref name="dmaLogicChannel_EcucPartitionRef" type="REFERENCE">
                                            <a:a name="LABEL" value="Ecuc Partition Ref"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html>
                                                        Maps a DMA channel to zero or multiple ECUC partitions to limit the access to this mappable element.
                                                        The ECUC partitions referenced are a subset of the ECUC partitions where the MCL driver is mapped to
                                                    </html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SCOPE" value="ECU"/>
                                            <a:a name="UUID"
                                                value="ECUC:f2e69199-f11e-4d01-9dcf-dbd71f71829f"/>
                                            <a:a name="OPTIONAL" value="true"/>
                                            <a:da name="REF"
                                                value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                             <a:da name="INVALID" type="XPath">
                                                    <a:tst expr="node:refvalid(.) or (../../../../MclGeneral/MclEnableMulticoreSupport ='false' or (num:i(ecu:get('Mcl.MultiCore.Support')) = 0))" false = "MclDmaChannelEcucPartitionRef hasn't reference"/>
                                            </a:da>
                                            <a:a name="EDITABLE" type="XPath">
                                                <a:tst expr="(../../../../MclGeneral/MclEnableMulticoreSupport ='true') and (num:i(ecu:get('Mcl.MultiCore.Support')) = 1)"/>
                                            </a:a>
                                    </v:ref>
                                
                                    <v:var name="dmaLogicChannel_EnableGlobalConfig" type="BOOLEAN">
                                        <a:a name="LABEL" value="Enable Global Config"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                    <html>
                                                    Vendor specific: Enable and allocate memory for Global Configuration. Global Configuration can be configured during generation time or during runtime.
                                                    Note: If the check box is enabled, then memory space is allocated for the configuration.
                                                    </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:c6caae0d-be95-4618-b521-02fcc5ca6365"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath">
                                           <a:tst expr="(node:fallback(../../../../MclGeneral/MclDma/MclEnableDma, 'true') = 'true') and (../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                       </a:a>
                                    </v:var>

                                    <v:var name="dmaLogicChannel_EnableTransferConfig" type="BOOLEAN">
                                        <a:a name="LABEL" value="Enable Transfer Config"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                    <html>
                                                    Vendor specific: Enable and allocate memory for Transfer Configuration. Transfer Configuration can be configured during generation time or during runtime.
                                                    Note: If the check box is enabled, then memory space is allocated for the configuration.
                                                    </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:c6caae0d-be95-4618-b521-02fcc5ca6366"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../dmaLogicChannel_EnableScatterGather='false') and (../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                    <v:var name="dmaLogicChannel_EnableScatterGather" type="BOOLEAN">
                                        <a:a name="LABEL" value="Enable Scatter/Gather"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                    <html>
                                                    Vendor specific: Enable and allocate memory for ScatterGather Transfer Mode.
                                                    The ScatterGather Transfer Mode shall allocate memory for each Element, comprised of: Element Linkage and Element Software TCD.
                                                    The Element allocation can be done only in the configurator.
                                                    The Element Configuration can be further enabled for each individual element.
                                                    </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:c6caae0d-be95-4618-b521-02fcc5ca6367"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../dmaLogicChannel_EnableTransferConfig='false') and (../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>
                                    </v:var>

                                                                        <v:var name="dmaLogicChannel_EnableCrcConfig" type="BOOLEAN">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                    <html>
                                                    Vendor specific: Enable and allocate memory for DMA CRC Configuration. DMA CRC Configuration can be configured during generation time or during runtime.
                                                    Note: If the check box is enabled, then memory space is allocated for the configuration.
                                                    </html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Enable CRC Config"/>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:72d28c1d-9312-41a5-ba35-40022a249b76"/>
                                        <a:da name="DEFAULT" value="false"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../MclGeneral/MclDma/MclEnableCrc ='true')"/>
                                    </v:var>
                                    
                                    <v:ctr name="dmaLogicChannel_ConfigType" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:<html> Vendor specific: <p>Logic Channel Configuration.</p></html>]]></a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100000"/>
                                        <a:a name="LABEL" value="Logic Channel Configuration"/>
                                        <a:da name="FRAME" value="NONE"/>
                                        <a:a name="EDITABLE" type="XPath" expr="(../../../../MclGeneral/MclDma/MclEnableDma ='true')"/>

                                                                                <v:ctr name="dmaLogicChannel_GlobalConfigType" type="IDENTIFIABLE">
                                            <a:a name="TAB" value="Global"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:
                                                    <html> Vendor specific:
                                                    Logic Channel Global Configuration.
                                                    </html>
                                                        ]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100100"/>
                                            <a:a name="EDITABLE" type="XPath" expr="(../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../dmaLogicChannel_EnableGlobalConfig ='true')"/>
                                                                                    <!-- *************************************************** -->
                                            <!-- @implements dmaLogicChannelConfig_GlobalControlType -->
                                            <!-- *************************************************** -->
                                            <v:ctr name="dmaLogicChannelConfig_GlobalControlType" type="IDENTIFIABLE">
                                                <a:a name="LAYOUT" value="VERTICAL"/>
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html> Vendor specific:
                                                        TCD Global Control.
                                                        </html>
                                                            ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100101"/>
                                                <a:a name="LABEL" value="Control"/>
                                                <a:a name="EDITABLE" type="XPath" expr="(../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../dmaLogicChannel_EnableGlobalConfig ='true')"/>
                                                                                        <v:var name="dmaGlobalControl_enMasterIdReplication" type="BOOLEAN">
                                                    <a:a name="LABEL" value="Enable Master Id Replication"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                                <html> Vendor specific: Set the Dma Channel to use the same protection level and system bus ID of the master programming the Dma Channel.
                                                                </html>]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:04ac837b-72f5-590b-b9ec-cc43a5100103"/>
                                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../dmaLogicChannel_EnableGlobalConfig ='true')"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                </v:var>
                                                                                                                                <v:var name="dmaGlobalControl_enBufferedWrites" type="BOOLEAN">
                                                    <a:a name="LABEL" value="Enable Buffered Writes"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                                <html> Vendor specific: Set the Dma Channel writes to be bufferable.
                                                                </html>]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100103"/>
                                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../dmaLogicChannel_EnableGlobalConfig ='true')"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                </v:var>
                                                                                    </v:ctr>
                                                                                    <!-- *************************************************** -->
                                            <!-- @implements dmaLogicChannelConfig_GlobalRequestType -->
                                            <!-- *************************************************** -->
                                            <v:ctr name="dmaLogicChannelConfig_GlobalRequestType" type="IDENTIFIABLE">
                                                <a:a name="LAYOUT" value="VERTICAL"/>
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html> Vendor specific:
                                                        TCD Request Control.
                                                        </html>
                                                            ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100111"/>
                                                <a:a name="EDITABLE" type="XPath" expr="(../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../dmaLogicChannel_EnableGlobalConfig ='true')"/>
                                                <a:a name="LABEL" value="Request"/>
                                                                                            <v:var name="dmaGlobalRequest_enDmamuxTrigger" type="BOOLEAN">
                                                    <a:a name="LABEL" value="Enable DMAMUX Trigger"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                                <html> Vendor specific: Enable the Dma Channel Mux Trigger.
                                                                </html>]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="NXP"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="UUID" value="ECUC:04ac837b-72f5-480b-b9ec-cc43a5100112"/>
                                                    <a:a name="EDITABLE" type="XPath" expr="(../../../../../../../MclGeneral/MclDma/MclEnableDma ='true') and (../../../../dmaLogicChannel_EnableGlobalConfig ='true')"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                </v:var>
                                                <v:var name="dmaGlobalRequest_enDmamuxSource" type="BOOLEAN">
                                                    <a:a name="LABEL" value="Enable DMAMUX Source"/>
                                                    <a:a name="DESC">
                                                        <a:v>
                                                            <![CDATA[EN:
                                                                <html> Vendor specific: Enable the Dma Channel Mux Source.
                                                                </html>]]>
                                                        </a:v>
                                                    </a:a>
