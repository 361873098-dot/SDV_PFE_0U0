                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="PcieMulticoreSupport" type="BOOLEAN" value="false">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
              </d:ctr>
              <d:ctr name="PcieGlobalConfig" type="IDENTIFIABLE">
