                                   true="BAR1 must be disabled if BAR0 is 64 bits."/>
                          </a:da>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>

                          <!-- Bar1TypeIo -->
                          <v:var name="Bar1TypeIo" type="BOOLEAN">
                              <a:a name="LABEL" value="I/O BAR" />
                              <a:a name="DESC">
                                  <a:v>
                                      <![CDATA[EN:<html><p>
                                          Vendor specific: Specifies that BAR1 is an I/O BAR.<br />
                                      </p></html>]]>
                                  </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
