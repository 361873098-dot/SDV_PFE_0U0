                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:f69c312b-82f1-4f64-9ced-4044a428a3f4"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_MULTIPLECOLLISION_Object */ -->
                                <v:ref name="ETH_E_MULTIPLECOLLISION" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Multiple Collisions&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:ab67e813-71bf-4f0e-b30f-02396a8bd65c"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_OVERSIZEFRAME_Object */ -->
                                <v:ref name="ETH_E_OVERSIZEFRAME" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Oversized Frame&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:1a94ea42-2ae2-4577-a998-236353bd336c"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_RX_FRAMES_LOST_Object */ -->
                                <v:ref name="ETH_E_RX_FRAMES_LOST" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;receive frames lost&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:3fef50c3-bf7b-42c0-b1f8-d0def43c9333"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_SINGLECOLLISION_Object */ -->
                                <v:ref name="ETH_E_SINGLECOLLISION" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Single Collisions&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:0c6a6282-aafa-41a2-9498-8b85ab2748be"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>

                                <!-- /** @implements ETH_E_UNDERSIZEFRAME_Object */ -->
                                <v:ref name="ETH_E_UNDERSIZEFRAME" type="REFERENCE">
                                  <a:a name="OPTIONAL" value="true"/>
                                  <a:a name="EDITABLE" type="XPath" expr="../../../../../EthGeneral/EthVendorSpecific/EthDisableDemEventDetect='false'"/>
                                  <a:a name="DESC"
                                      value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Undersized Frame&quot; has occured."/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                      type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v class="Link">VariantLinkTime</icc:v>
                                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                  <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                  <a:a name="SCOPE" value="LOCAL"/>
                                  <a:a name="UUID" value="ECUC:096a6955-eb00-4051-8b63-a18bfe564e74"/>
                                  <a:da name="REF"
                                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                  </a:da>
                                </v:ref>
                            </v:ctr>

                            <v:ctr name="EthVendorSpecific" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="EthVendorSpecific"/>
                                <a:a name="DESC">
                                <a:v><![CDATA[EN:<html>
                                    Vendor specific: Vendor specific configuration of the individual controller
                                </html>]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:7ec46ecf-ce32-41c4-ba95-18ed23c868d4"/>
                                <!-- Add vendor specific controller specific options here -->
                                <v:var name="EthCtrlHwPort" type="ENUMERATION">
                                    <a:a name="LABEL" value="EthCtrlPort"/>
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                        Vendor specific: Defines which interface (MAC, AUX or HIF) the ethernet controller shall be attach to.
                                        </html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:235fbd08-c7cb-47f0-8a45-7efe857e1780"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:uniq(node:fallback(../../../*/EthVendorSpecific/EthCtrlHwPort, text:split('1 2 3')), node:fallback(., 0))" false="Duplicated value, some EMAC is used more than once."/>
                                        <a:tst expr="node:current()!=../../../../../EthGeneral/EthVendorSpecific/EthCommonHif" false="EthCtrlHwPort can't be the same as EthCommonHif. Only remote HIF interfaces can be endpoints."/>
                                    </a:da>
                                    <a:da name="RANGE">
                                        <a:v>EMAC0</a:v>
                                        <a:v>EMAC1</a:v>
                                        <a:v>EMAC2</a:v>
                                        <a:v>AUX</a:v>
                                        <a:v>HIF0</a:v>
                                        <a:v>HIF1</a:v>
                                        <a:v>HIF2</a:v>
                                        <a:v>HIF3</a:v>
                                        <a:v>HIF_NOCPY</a:v>
                                    </a:da>
                                    <a:da name="DEFAULT" value="EMAC0"/>
                                </v:var>
                                <!-- /** @implements EthCtrlEthIfIdx_Object */ -->
                                <v:var name="EthCtrlEthIfIdx" type="INTEGER">
                                    <a:a name="LABEL" value="EthCtrlEthIfIdx"/>
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                        Vendor specific: Defines the index of the controller in context of EthIf driver. This manual asignemnt of this value is only temporary workaround before proper solution is implemented.
                                        </html>]]></a:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="UUID" value="ECUC:235fbd08-c7cb-47bf-8a45-7efe857e1780"/>
                                    <a:a name="WIDTH" value="3"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                    <a:da name="DEFAULT" value="0"/>
                                </v:var>
                                <!-- /** @implements EthDuplexMode_Object */ -->
                                <v:var name="EthDuplexMode" type="ENUMERATION">
                                    <a:a name="LABEL" value="EthDuplexMode"/>
                                    <a:a name="DESC" value="EN: Defines the controller's duplex mode. Only available for EMAC controllers."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v mclass="Link">VariantLinkTime</icc:v>
                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:c8c32912-bc2d-4bc9-a3f5-24b39aa9a07c"/>
                                    <a:da name="RANGE">
                                        <a:v>ETH_FULL_DUPLEX</a:v>
                                        <a:v>ETH_HALF_DUPLEX</a:v>
                                    </a:da>
                                    <a:da name="DEFAULT" value="ETH_FULL_DUPLEX"/>
                                    <a:da name="ENABLE" type="XPath" expr="(../../../../../EthGeneral/EthVendorSpecific/EthPfeMultiInstance='false' or ../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='false') and (../EthCtrlHwPort='EMAC0' or ../EthCtrlHwPort='EMAC1' or ../EthCtrlHwPort='EMAC2')"/>
                                </v:var>
                                <!-- /** @implements EthEmacLoopEn_Object */ -->
                                <v:var name="EthEmacLoopEn" type="BOOLEAN">
                                    <a:a name="LABEL" value="Enable Loopback Mode on associated EMAC"/>
                                    <a:a name="DESC"
                                        value="EN: Vendor specific: Enables / Disables Loopback Mode on associated EMAC. This mode is intended for testing. Only available for EMAC controllers."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:3122b0a2-2b9b-af45-6494-00f82d5ad4c1"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="ENABLE" type="XPath" expr="(../../../../../EthGeneral/EthVendorSpecific/EthPfeMultiInstance='false' or ../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='false') and (../EthCtrlHwPort='EMAC0' or ../EthCtrlHwPort='EMAC1' or ../EthCtrlHwPort='EMAC2')"/>
                                </v:var>
                                <!-- /** @implements EthPromiscuousEn_Object */ -->
                                <v:var name="EthPromiscuousEn" type="BOOLEAN">
                                    <a:a name="LABEL" value="Enable Promiscuous Mode"/>
                                    <a:a name="DESC"
                                        value="EN: Vendor specific: Enables / Disables Promiscuous Mode. In current version this option is not available for slave drivers (see 'Slave driver' option). Only available for EMAC controllers."/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:5b995e80-da60-3c3f-8eac-5069b430f705"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="ENABLE" type="XPath" expr="node:empty(../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode)='true' or ../../../../../EthGeneral/EthVendorSpecific/EthPfeSlaveMode='false' and ../EthCtrlHwPort!='AUX' and ../EthCtrlHwPort!='HIF0' and ../EthCtrlHwPort!='HIF1' and ../EthCtrlHwPort!='HIF2' and ../EthCtrlHwPort!='HIF3' and ../EthCtrlHwPort!='HIF_NOCPY'"/>
                                </v:var>
                                <v:var name="AcceptAllTraffic" type="BOOLEAN">
                                    <a:a name="LABEL" value="Accept all traffic"/>
                                    <a:a name="DESC"
                                        value="EN:
                                        This parameter is for the case where the HIF associated to this instance and the EMAC corresponding to this controller are part of a bridge domain.
                                        If enabled, all ingress traffic received on the corresponding EMAC will be received by this controller.
                                        If disabled, only management traffic from the EMAC will be received by this controller. All other traffic will be received on the AUX controller.
                                        It is recommended to disable this parameter when the corresponding EMAC is part of bridge domain.
                                        Not available on HIF0, HIF1, HIF2, HIF3 and HIF_NOCPY interfaces.
                                        "/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v mclass="Link">VariantLinkTime</icc:v>
                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                    <a:a name="UUID" value="ECUC:afaf8244-248a-d0d2-1d3b-bdc222f89878"/>
                                    <a:da name="DEFAULT" value="true"/>
                                    <a:da name="WARNING" type="XPath">
                                        <a:tst expr=". = 'false' and ../../../*/EthVendorSpecific/EthCtrlHwPort != 'AUX'"
                                            true="AUX interface is not configured, disabling option AcceptAllTraffic has no effect."/>
                                    </a:da>

                                    <a:da name="ENABLE" type="XPath" expr="../EthCtrlHwPort!='AUX' and ../EthCtrlHwPort!='HIF0' and ../EthCtrlHwPort!='HIF1' and ../EthCtrlHwPort!='HIF2' and ../EthCtrlHwPort!='HIF3' and ../EthCtrlHwPort!='HIF_NOCPY'"/>
                                </v:var>
                                <!-- /** @implements EthEthTrcvDriverVendorIdAndApiInfix_Object */ -->
                                <v:var name="EthEthTrcvDriverVendorIdAndApiInfix" type="STRING">
                                    <a:a name="LABEL" value="Eth Transciever Driver API Infix"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html>
                                                The vendor id and vendor api infix for the EthTrcv driver, if any. <br />
                                                This is used to include the correct header file and to point to the EthTrcv callbacks. <br />
                                                Example: 43_PHYGROUPB for a 43_PHYGROUPB driver or leave it blank to include EthTrcv.h
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="DEFAULT" value=""/>
                                    <a:a name="UUID" value="ECUC:6e2b21fe-5da2-48cb-a5c6-df33a57a4412"/>
                                </v:var>

                                <!-- /** @implements EthEthSwtDriverVendorIdAndApiInfix_Object */ -->
                                <v:var name="EthEthSwtDriverVendorIdAndApiInfix" type="STRING">
                                    <a:a name="LABEL" value="Eth Switch Driver API Infix"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html>
                                                The vendor id and vendor api infix for the EthSwt driver, if any. <br />
                                                This is used to include the correct header file and to point to the EthSwt APIs. <br />
                                                Example: 43_SJA1110 for a 43_SJA1110 driver or leave it blank to include EthSwt.h
                                            </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="DEFAULT" value=""/>
                                    <a:a name="UUID" value="ECUC:6e2b21fe-5da2-48cb-a5c6-df33a5654323"/>
                                </v:var>
                            </v:ctr>
                        </v:ctr> <!-- EthCtrlConfig -->
                    </v:lst>    <!-- EthCtrlConfig -->
                </v:ctr> <!-- EthConfigSet -->
              <!-- /** @implements EthGeneral_Object */ -->
              <v:ctr name="EthGeneral" type="IDENTIFIABLE">
                <a:a name="LABEL" value="EthGeneral"/>
                <a:a name="DESC"
                     value="EN: General configuration of Ethernet Driver module"/>
                <a:a name="UUID" value="ECUC:4daefb7e-ec92-48be-9e96-03697c9525b9"/>
                <!-- /** @implements EthDevErrorDetect_Object */ -->
                <v:var name="EthDevErrorDetect" type="BOOLEAN">
                  <a:a name="LABEL" value="Development Error Detection"/>
                  <a:a name="DESC"
                       value="EN: Enables / Disables development error detection."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:f34e98dc-9ad5-4f9c-8c19-6d379d5080f8"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:lst name="EthEcucPartitionRef">
                  <a:da name="INVALID" type="XPath">
                      <a:tst expr="count(./*) > 1"
                             true="This list should not refer to more than one ECUC partition. Multicore support of the driver is limited to type I."/>
                  </a:da>
                  <v:ref name="EthEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC">
                      <a:v>EN: Maps the Eth driver to zero or one ECUC partition to make the modules API availabel in this partition.<a:v>
                      The Eth driver will operate as an independent instance in each of the partitions.</a:v>
                      EN: Tags: atp.Status=draft</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="UUID"
                         value="ECUC:f62f70c5-d1e3-48e3-b920-04027cd30c17"/>
                    <a:da name="REF"
                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                    <a:a name="INVALID" type="XPath">
                      <a:tst expr="node:refvalid(.)"
                             false="Invalid or empty reference."/>
                      <a:tst expr="node:containsValue(as:modconf('Os')[1]/OsApplication/*/OsAppEcucPartitionRef, .)"
                             false="The referenced ECUC partition isn't used by any OsApplication (i.e. Os/OsApplication/*/OsAppEcucPartitionRef)"/>
                    </a:a>
                  </v:ref>
                </v:lst>
                 <v:var name="EthGetClassStatisticApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetClassStatisticApi"/>
                  <a:a name="DESC" value="EN: Enables / Disables Eth_43_PFE_GetClassStats API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v mclass="Link">VariantLinkTime</icc:v>
                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:7d4c3198-3c75-4291-9aab-58378145aea0"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="READONLY" value="false"/>
                  <a:da name="ENABLE" type="XPath" expr="node:empty(../EthVendorSpecific/EthPfeSlaveMode)='true' or ../EthVendorSpecific/EthPfeSlaveMode='false'"/>
                 </v:var>
                 <v:var name="EthGetCounterValuesApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetCounterValuesApi"/>
                  <a:a name="DESC" value="EN: Enables / Disables Eth_GetCounterValues API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:f85ef42d-cc66-4b91-95bb-71158f25612e"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="READONLY" value="false"/>
                </v:var>
                <v:var name="EthGetDropCountApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetDropCountApi"/>
                  <a:a name="DESC"
                       value="EN: Obsolete and kept only for backwards compatibility. The Eth_GetDropCount API has been replaced with Eth_GetCounterValues since R4.3.1. Use parameter EthGetCounterValuesApi instead."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:0199f94b-c109-44dc-b857-d12edf0a9c00"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="VISIBLE" value="false"/>
                </v:var>

                <v:var name="EthGetEtherStatsApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetEtherStatsApi"/>
                  <a:a name="DESC"
                       value="EN: Obsolete and kept only for backwards compatibility. The Eth_GetEtherStats API has been replaced with the Eth_GetTxStats and Eth_GetRxStats APIs since R4.3.1."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:84764df4-ac87-43ea-80bc-49b7f66606fa"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="VISIBLE" value="false"/>
                </v:var>
                 <v:var name="EthGetPFEStatisticApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetPFEStatisticApi"/>
                  <a:a name="DESC" value="EN: Enables / Disables Eth_43_PFE_GetPFEStats API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v mclass="Link">VariantLinkTime</icc:v>
                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:f85ef42d-cc66-4b90-95bb-71158f25612e"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="READONLY" value="false"/>
                  <a:da name="ENABLE" type="XPath" expr="node:empty(../EthVendorSpecific/EthPfeSlaveMode)='true' or ../EthVendorSpecific/EthPfeSlaveMode='false'"/>
                 </v:var>
                <v:var name="EthGetRxStatsApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetRxStatsApi"/>
                  <a:a name="DESC" value="EN: Enables / Disables  Eth_GetRxStats API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:5f2ae92e-3db4-455d-8f8b-5453b7a9a7a7"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="READONLY" value="false"/>
                </v:var>
                <!-- @implements EthGetTxErrorCounterValuesApi_Object -->
                <v:var name="EthGetTxErrorCounterValuesApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetTxErrorCounterValuesApi"/>
                  <a:a name="DESC"
                       value="EN: Enables / Disables Eth_GetTxErrorCounterValues API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="ECUC:27ca7f22-b66d-43cc-89ea-d791864e420a"/>
                  <a:a name="WIDTH" value="3"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:a name="EDITABLE" value="true"/>
                </v:var>
                <v:var name="EthGetTxStatsApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGetTxStatsApi"/>
                  <a:a name="DESC"
                       value="EN: Enables / Disables Eth_GetTxStats API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="Link">VariantLinkTime</icc:v>
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:a9995065-c1a3-48cb-be45-037cf94856bb"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:a name="EDITABLE" value="true"/>
                </v:var>
                <!-- @implements EthGlobalTimeSupport_Object -->
                <v:var name="EthGlobalTimeSupport" type="BOOLEAN">
                  <a:a name="LABEL" value="EthGlobalTimeSupport"/>
                  <a:a name="DESC"
                       value="EN: Enables/Disables the GlobalTime APIs used amongst others by Global Time Synchronization over Ethernet."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:cec23ff3-a548-4a26-aead-70890803f88d"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <!-- @implements EthIndex_Object -->
                <v:var name="EthIndex" type="INTEGER">
                  <a:a name="LABEL" value="EthIndex"/>
                  <a:a name="DESC"
                       value="EN: Specifies the InstanceId of this module instance. If only one instance is present it shall have the Id 0."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:a263e5c8-e87a-4370-bd72-dfc3af8957dc"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=255"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                  <a:a name="WIDTH" value="3"/>
                  <a:da name="DEFAULT" value="0"/>
                </v:var>

                <!-- /** @implements EthMainFunctionPeriod_Object */ -->
                <v:var name="EthMainFunctionPeriod" type="FLOAT">
                  <a:a name="DESC" value="EN: Specifies the period of main function Eth_MainFunction in seconds.
                                        This information is required by BSW scheduler and can be used also in the driver.
                                        ASR define Infinity as limitation, but it is abnormal if the period is longer than 65.535 second"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:2f80a958-25fe-4307-b756-78a183ca839d"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=1.0"/>
                    <a:tst expr="&gt;=0.001"/>
                  </a:da>
                  <a:da name="DEFAULT" value="0.1"/>
                </v:var>
                <!-- /** @implements EthMaxCtrlsSupported_Object */ -->
                <v:var name="EthMaxCtrlsSupported" type="INTEGER">
                  <a:a name="LABEL" value="EthMaxCtrlsSupported"/>
                  <a:a name="DESC"
                       value="EN: Limits the total number of supported controllers."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:4134779e-cf9b-4229-966b-fa7ddeb8284b"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=8"/>
                    <a:tst expr="&gt;=1"/>
                  </a:da>
                  <a:da name="DEFAULT" value="3"/>
                </v:var>
                <!-- /** @implements EthVersionInfoApi_Object */ -->
                <v:var name="EthVersionInfoApi" type="BOOLEAN">
                  <a:a name="LABEL" value="EthVersionInfoApi"/>
                  <a:a name="DESC"
                       value="EN: Enables / Disables version info API"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:5148ec5e-0237-4728-83b1-751598346b35"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>

                <v:ctr name="EthCtrlOffloading" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="EthCtrlOffloading"/>
                  <a:a name="DESC"
                       value="EN: Configuration of hardware offloading features."/>
                  <a:a name="UUID" value="ECUC:9232f72d-c730-49c1-9a5f-6f688a2b7a09"/>
                  <a:a name="EDITABLE" value="false"/>
                  <!-- @implements EthCtrlEnableOffloadChecksumICMP_Object -->
                  <v:var name="EthCtrlEnableOffloadChecksumICMP" type="BOOLEAN">
                    <a:a name="LABEL" value="EthCtrlEnableOffloadChecksumICMP"/>
                    <a:a name="DESC"
                         value="EN: Enables / Disables hardware offloading for ICMP checksums.&#13;If disabled, the FW will be configured to enable receive_malformed. This has the side effect of allowing frames with invalid Ethernet CRC to be be received by the driver"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="Link">VariantLinkTime</icc:v>
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:4fb8fbb3-97bd-46a7-83d2-efb9a1cfddc3"/>
                    <a:a name="EDITABLE" value="true"/>
                    <a:da name="DEFAULT" value="true"/>
                  </v:var>
                  <!-- @implements EthCtrlEnableOffloadChecksumIPv4_Object -->
                  <v:var name="EthCtrlEnableOffloadChecksumIPv4" type="BOOLEAN">
                    <a:a name="LABEL" value="EthCtrlEnableOffloadChecksumIPv4"/>
                    <a:a name="DESC"
                         value="EN: Enables / Disables hardware offloading for IPv4 checksums.&#13;If disabled, the FW will be configured to enable receive_malformed. This has the side effect of allowing frames with invalid Ethernet CRC to be be received by the driver"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:7f593bf2-d20e-405a-83cd-0573fab08a06"/>
                    <a:da name="DEFAULT" value="true"/>
                    <a:a name="EDITABLE" value="true"/>
                  </v:var>
                  <!-- @implements EthCtrlEnableOffloadChecksumTCP_Object -->
                  <v:var name="EthCtrlEnableOffloadChecksumTCP" type="BOOLEAN">
                    <a:a name="LABEL" value="EthCtrlEnableOffloadChecksumTCP"/>
                    <a:a name="DESC"
                         value="EN: Enables / Disables hardware offloading for TCP checksums.&#13;If disabled, the FW will be configured to enable receive_malformed. This has the side effect of allowing frames with invalid Ethernet CRC to be be received by the driver"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:def2a09a-690d-4cce-ad17-765d5aa134f1"/>
                    <a:da name="DEFAULT" value="true"/>
                    <a:a name="EDITABLE" value="true"/>
                  </v:var>
                  <!-- @implements EthCtrlEnableOffloadChecksumUDP_Object -->
                  <v:var name="EthCtrlEnableOffloadChecksumUDP" type="BOOLEAN">
                    <a:a name="LABEL" value="EthCtrlEnableOffloadChecksumUDP"/>
                    <a:a name="DESC"
                         value="EN: Enables / Disables hardware offloading for UDP checksums.&#13;If disabled, the FW will be configured to enable receive_malformed. This has the side effect of allowing frames with invalid Ethernet CRC to be be received by the driver"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:46c4df50-8508-40aa-a7f4-6916ab9f2d7d"/>
                    <a:a name="EDITABLE" value="true"/>
                    <a:da name="DEFAULT" value="true"/>
                  </v:var>
                </v:ctr>
                <v:ctr name="EthVendorSpecific" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="EthVendorSpecific"/>
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:<html>
                       Vendor specific: General vendor specific configuration of Ethernet Driver module
                    </html>]]></a:v>
                  </a:a>
                  <a:a name="UUID" value="ECUC:7cb9bdab-2f91-4f16-b76e-0d97fedc0bfa"/>
                  <v:var name="EthDisableDemEventDetect" type="BOOLEAN">
                    <a:a name="DESC">
                        <a:v><![CDATA[<html>
                                Vendor specific: When this option is ON the Diagnostic Event Manager is disabled, no diagnostic error events are reported.<br>
                        </html>]]></a:v>
                    </a:a>
                    <a:a name="LABEL" value="Eth Disable Diagnostic Event Module"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:c874e412-6231-484c-8b53-1466998c9cca"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <!-- /** @implements EthEnableUserModeSupport_Object */ -->
                  <v:var name="EthEnableUserModeSupport" type="BOOLEAN">
                    <a:a name="DESC">
                        <a:v>
                            <![CDATA[EN:<html>
                                When this field is enabled, the Eth_43_PFE module will be run in the User Mode, therefore, the protected registers for the module Eth_43_PFE can still be accessed
                                normally, except the registers can only be configured to the supervisor mode. When it comes to function implementing write to protected registers which don't exist in the
                                Eth_43_PFE, so these can be called using the function named trusted_callparams().
                                Note: Implementation Specific Parameter.
                            </html>]]>
                        </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="LABEL" value="Enable User Mode Support"/>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:f466e20d-5bba-65fa-be74-2bd1bb0f0b89"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="EthEnableClause45API" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: When ON then API to access Ethernet transciever using Clause 45 will be available.<br>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="Enable Clause 45 API"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:a40daac0-f25e-44a6-bbd0-3794527ab851"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="EthSwtManagementSupportApi" type="BOOLEAN">
                    <a:a name="LABEL" value="EthSwtManagementSupportApi"/>
                    <a:a name="DESC"
                        value="EN: Enables / Disables Switch Management APIs."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                        type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:46c4df50-8508-40aa-a7f4-6916cd9e2d7a"/>
                    <a:a name="EDITABLE" value="true"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="EthReleaseTxBufferApi" type="BOOLEAN">
                    <a:a name="LABEL" value="EthReleaseTxBufferApi"/>
                    <a:a name="DESC"
                        value="EN: Enables / Disables Eth_43_PFE_ReleaseTxBuffer API."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"   type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:a7eac452-be92-47fb-8606-223e993f9f52"/>
                    <a:a name="EDITABLE" value="true"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="EthPfeMultiInstance" type="BOOLEAN">
                    <a:a name="DESC"
                         value="EN: Vendor specific: When ON then role of this driver can be selected: master or slave and other driver(s) (Linux/QNX/another MCAL driver) can be used on the same system simultaneously. In current version this option is not available if option 'Use multiple HIF interfaces' is set."/>
                    <a:a name="LABEL" value="Multiple PFE drivers support (master-slave)"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:24e07ded-37fc-0d83-cda7-5aed90958b65"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="EthPfeSlaveMode" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: This option depends on option "Multiple PFE drivers support (master-slave)" being enabled.
                               <ul>
                                 <li>When ON then this driver requires another driver to be simultaneously running on the device. The other driver shall be configured as master.</li>
                                 <li>When OFF then this driver is a master driver that can either run alone or it can support one or more slave drivers running on the same device.</li>
                               </ul>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="Slave driver"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:47ff8502-1f2f-26cb-3e8d-079285100f39"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="ENABLE" type="XPath" expr="../EthPfeMultiInstance='true'"/>
                  </v:var>
                  <v:var name="EthPfeMasterHif" type="ENUMERATION">
                      <a:a name="LABEL" value="Master HIF interface"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Specifies HIF interface used by master PFE driver. This option is valid only if option 'Slave driver' is set."/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" value="ECUC:8f0ad8bf-2269-bcde-1a8d-fb08a57ef06f"/>
                      <a:da name="RANGE">
                          <a:v>HIF0</a:v>
                          <a:v>HIF1</a:v>
                          <a:v>HIF2</a:v>
                          <a:v>HIF3</a:v>
                          <a:v>HIF_NOCPY</a:v>
                      </a:da>
                      <a:da name="DEFAULT" value="HIF0"/>
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="../EthPfeSlaveMode='true' and node:current()=../EthCommonHif" true="'Master HIF interface' and 'Common HIF interface' of slave cannot be the same."/>
                          <a:tst expr="../EthPfeSlaveMode='false' and node:current()!=../EthCommonHif" true="'Master HIF interface' and 'Common HIF interface' of master must be the same."/>
                      </a:da>
                      <a:da name="ENABLE" type="XPath" expr="../EthPfeMultiInstance='true'"/>
                  </v:var>
                  <v:var name="EthCommonHif" type="ENUMERATION">
                      <a:a name="LABEL" value="Common HIF interface"/>
                      <a:a name="DESC">
                          <a:v><![CDATA[EN:<html>
                          Vendor specific: Defines the HIF interface which this driver will use.
                          </html>]]></a:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" value="ECUC:eb233788-0d51-7810-e832-a0f18eba2ddf"/>
                      <a:da name="RANGE">
                          <a:v>HIF0</a:v>
                          <a:v>HIF1</a:v>
                          <a:v>HIF2</a:v>
                          <a:v>HIF3</a:v>
                          <a:v>HIF_NOCPY</a:v>
                      </a:da>
                      <a:da name="DEFAULT" value="HIF0"/>
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="node:current()='HIF_NOCPY' and ../EthPfeSlaveMode='true'" true="HIF NOCPY is not supported in slave mode"/>
                      </a:da>
                  </v:var>
                  <v:var name="EthSlaveHifMasterUpTimeout" type="INTEGER">
                    <a:a name="DESC" value="EN: Timeout value (in milliseconds) used to wait for Master to be started before Slave sends RPC requests.
                                            Special value 'zero milliseconds' (default) will ensure that slave will wait for the master indefinitely."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:2f80a958-25fe-4307-b756-78a183ca839e"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=100000"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:da name="DEFAULT" value="0"/>
                    <a:da name="ENABLE" type="XPath" expr="../EthPfeSlaveMode='true'"/>
                  </v:var>
                  <v:var name="SlaveReadStatCounterOfEmacDirectly" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: This option depends on option "Slave driver" being enabled.
                               <ul>
                                 <li>When ON then slave reads statistic counters directly from EMAC registers.</li>
                                 <li>When OFF then slave reads statistic counters from EMAC registers through RPC</li>
                               </ul>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="SlaveReadStatCounterOfEmacDirectly"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:68608df2-50de-42c5-a24d-6ad99009631d"/>
                    <a:da name="DEFAULT" value="true"/>
                    <a:da name="ENABLE" type="XPath" expr="../EthPfeSlaveMode='true'"/>
                  </v:var>
                  <v:var name="EnERR051211Workaround" type="BOOLEAN">
                    <a:a name="DESC" value="EN: Turn OFF to disable errata ERR051211 workaround. Errata workaround will be automatically disabled if 'multiple PFE drivers' is disabled. In case of multiple PFE drivers running on the SOC, this option must be configured same way in all of them."/>
                    <a:a name="LABEL" value="Enable errata ERR051211 workaround"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:7db4959c-8bfc-ae3c-8249-3c24fe5f5e3e"/>
                    <a:da name="DEFAULT" value="true"/>
                    <a:da name="ENABLE" type="XPath" expr="../EthPfeMultiInstance = 'true'"/>
                  </v:var>

                  <v:var name="EnableBmuInterrupt" type="BOOLEAN">
                    <a:a name="DESC" value="EN: Turn ON to enable BMU Interrupt"/>
                    <a:a name="LABEL" value="Enable BMU Interrupt"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:7db4959c-8bfc-ae3c-8249-3c24fe5f5e3f"/>
                    <a:da name="DEFAULT" value="true"/>
                    <a:da name="ENABLE" type="XPath" expr="node:empty(../EthPfeSlaveMode)='true' or ../EthPfeSlaveMode='false'"/>
                  </v:var>

                  <v:var name="PfeEnableFCI" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: Turn ON to make the FCI API, Routing Table and L2 Bridge available.<br>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="Enable FCI, routing and bridging support"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:d40b3433-4b58-5c5e-b1d4-2f7b0fd25d33"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="PfeEnableRouting" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: Turn ON to enable routing.<br>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="Enable routing"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="Link">VariantLinkTime</icc:v>
                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:6664c037-b76d-4663-8ff4-4e0dfac21a63"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="ENABLE" type="XPath" expr="../PfeEnableFCI='true' and (../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false')"/>
                  </v:var>
                  <v:var name="PfeRtCollisionSize" type="INTEGER">
                      <a:a name="LABEL" value="Routing Table Collision Size"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Number of L3 routing table entries available in collision space.
                           The collision space is used to form linked lists of entries for the same hash. Default
                           value is 256. The value shall be either 8, 16, 32, 64, 128, 256, 512, 1024, 2048 or 4096."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:d4c8fba7-c87d-d2a3-df73-acd0aa1446f2"/>
                      <a:a name="WIDTH" value="4"/>
                      <a:da name="INVALID" type="Range">
                          <a:tst expr="=4096"/>
                          <a:tst expr="=2048"/>
                          <a:tst expr="=1024"/>
                          <a:tst expr="=512"/>
                          <a:tst expr="=256"/>
                          <a:tst expr="=128"/>
                          <a:tst expr="=64"/>
                          <a:tst expr="=32"/>
                          <a:tst expr="=16"/>
                          <a:tst expr="=8"/>
                      </a:da>
                      <a:da name="DEFAULT" value="256"/>
                      <a:da name="ENABLE" type="XPath" expr="../PfeEnableRouting='true'"/>
                  </v:var>
                  <v:var name="PfeRtHashSize" type="INTEGER">
                      <a:a name="LABEL" value="Routing Table Hash Size"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Number of L3 routing table entries available in hash space.
                           This number also represents number of bits of the hash calculated from the IP header of
                           packets which is being used to address the entries within the hash space. Default value
                           is 256. The value shall be either 8, 16, 32, 64, 128, 256, 512, 1024, 2048, or 4096."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:f5fef9b1-38e3-53ad-16e3-f499f1030fa0"/>
                      <a:a name="WIDTH" value="4"/>
                      <a:da name="INVALID" type="Range">
                          <a:tst expr="=4096"/>
                          <a:tst expr="=2048"/>
                          <a:tst expr="=1024"/>
                          <a:tst expr="=512"/>
                          <a:tst expr="=256"/>
                          <a:tst expr="=128"/>
                          <a:tst expr="=64"/>
                          <a:tst expr="=32"/>
                          <a:tst expr="=16"/>
                          <a:tst expr="=8"/>
                      </a:da>
                      <a:da name="DEFAULT" value="256"/>
                      <a:da name="ENABLE" type="XPath" expr="../PfeEnableRouting='true'"/>
                  </v:var>
                  <v:var name="PfeConnStatsSize" type="INTEGER">
                      <a:a name="LABEL" value="Conntrack stats table size"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Number of stats table entries for conntracks. Default
                           value is 20."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:cbd08860-2ac3-4db6-17c1-80cc035edf2e"/>
                      <a:a name="WIDTH" value="4"/>
                      <a:da name="DEFAULT" value="20"/>
                      <a:da name="INVALID" type="Range">
                          <a:tst expr="&gt;=0"/>
                          <a:tst expr="&lt;=4096"/>
                      </a:da>
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr=". &lt;= ../PfeRtHashSize" false="Conntrack stats table size must be &lt;= Routing Table Hash Size"/>
                      </a:da>
                      <a:da name="ENABLE" type="XPath" expr="../PfeEnableRouting='true'"/>
                  </v:var>
                  <v:var name="PfeEnableBridge" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: Turn ON to enable bridge mode.<br>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="Enable bridge"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="Link">VariantLinkTime</icc:v>
                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:40d71dfe-5190-4c8f-99c6-ae89b5afb8ff"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="ENABLE" type="XPath" expr="../PfeEnableFCI='true' and (../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false')"/>
                  </v:var>
                  <v:var name="PfeL2brDomainsMax" type="INTEGER">
                    <a:a name="LABEL" value="PfeL2brDomainsMax"/>
                    <a:a name="DESC"
                         value="EN: Maximum number of L2BR domains."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:0570e891-3ced-4fa2-a428-eefac2a941b9"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=64"/>
                      <a:tst expr="&gt;=2"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="64"/>
                    <a:da name="ENABLE" type="XPath" expr="../PfeEnableBridge='true'"/>
                  </v:var>
                  <v:var name="PfeL2brStaticsEnable" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: This option determines if L2 bridge static entries can be created using FPP_CMD_L2_STATIC_ENT command.
                               <ul>
                                 <li>When ON then allows to create entries up to amount specified in PfeL2brStaticsMax.</li>
                                 <li>When OFF then no entries will be allowed to create.</li>
                               </ul>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="Use L2 bridge static entries"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="Link">VariantLinkTime</icc:v>
                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:47ff8502-1f2f-26cb-3e8d-079285100f3a"/>
                    <a:da name="DEFAULT" value="true"/>
                    <a:da name="ENABLE" type="XPath" expr="../PfeEnableBridge='true'"/>
                  </v:var>
                  <v:var name="PfeL2brStaticsMax" type="INTEGER">
                    <a:a name="LABEL" value="PfeL2brStaticsMax"/>
                    <a:a name="DESC"
                         value="EN: Maximum number of L2 bridge static entries the FCI is allowed to create using FPP_CMD_L2_STATIC_ENT command."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:4bb15d6a-9966-4545-b12b-032a64cc881f"/>
                    <a:da name="INVALID" type="Range">
                      <!-- max: MAC2F_TABLE_HASH_ENTRIES -->
                      <a:tst expr="&lt;=256"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:a name="WIDTH" value="4"/>
                    <a:da name="DEFAULT" value="16"/>
                    <a:da name="ENABLE" type="XPath" expr="../PfeEnableBridge='true' and (../PfeL2brStaticsEnable='true')"/>
                  </v:var>
                  <v:var name="VarEthBmu2BufCnt" type="INTEGER">
                      <a:a name="LABEL" value="VarEthBmu2BufCnt"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Number of 2048 byte buffers that are used for 2 purposes:
                           1) for HIF_NOCPY interface buffers, both Rx and Tx. Even if the NOCPY interface is used in another driver instance, the buffers are still allocated from here, and
                           2) by PFE hardware internally for processing Ethernet packets among all HIF and EMAC interfaces. Higher number of buffers allows to better cover bursts of Ethernet traffic. When the option is too low, packets may be dropped during bursts due to buffer depletion."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:8d6a85fc-4b24-e5c8-fb0a-5f5860f0e30e"/>
                      <a:a name="WIDTH" value="4"/>
                      <a:da name="INVALID" type="Range">
                          <a:tst expr="=1024"/>
                          <a:tst expr="=512"/>
                          <a:tst expr="=256"/>
                          <a:tst expr="=128"/>
                          <a:tst expr="=64"/>
                          <a:tst expr="=32"/>
                      </a:da>
                      <a:da name="DEFAULT" value="512"/>
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(../EthCommonHif = 'HIF_NOCPY') and (num:i(node:current()) &lt; num:i(sum(../../../EthConfigSet/EthCtrlConfig/*/EthCtrlConfigEgress/EthCtrlConfigEgressFifo/*/EthCtrlConfigEgressFifoBufTotal) + sum(../../../EthConfigSet/EthCtrlConfig/*/EthCtrlConfigIngress/EthCtrlConfigIngressFifo/*/EthCtrlConfigIngressFifoBufTotal) + 16)) " true="With HIF_NOCPY, The number of buffers configured by 'VarEthBmu2BufCnt' must be at least 16 more than the sum of all configured TX buffers 'EthCtrlConfigEgressFifoBufTotal' and RX buffers 'EthCtrlConfigIngressFifoBufTotal'."/>
                      </a:da>
                      <a:da name="ENABLE" type="XPath" expr="node:empty(../EthPfeSlaveMode)='true' or ../EthPfeSlaveMode='false'"/>
                  </v:var>
                  <v:var name="MaxNumFwFeaturesSupported" type="INTEGER">
                      <a:a name="LABEL" value="MaxNumFwFeaturesSupported"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: The maximum number of FW features."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:fcba25cb-eb4e-4d19-bcb0-32131d5a2d40"/>
                      <a:a name="WIDTH" value="4"/>
                      <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=255"/>
                          <a:tst expr="&gt;=12"/>
                      </a:da>
                      <a:da name="DEFAULT" value="22"/>
                  </v:var>
                  <v:var name="PfeClassFwLoadFrom" type="ENUMERATION">
                      <a:a name="LABEL" value="Class firmware load from"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Parameter specifies PFE firmware origin."/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" value="ECUC:9c6476ff-4a5d-41db-b060-9d0c88c59a66"/>
                      <a:da name="RANGE">
                          <a:v>PfeClassFwArrayLabel</a:v>
                          <a:v>PfeClassFwMemoryAddress</a:v>
                      </a:da>
                      <a:da name="DEFAULT" value="PfeClassFwArrayLabel"/>
                      <a:da name="ENABLE" type="XPath" expr="../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false'"/>
                  </v:var>
                  <v:var name="PfeClassFwMemoryAddress" type="STRING">
                      <a:a name="LABEL" value="PfeClassFwMemoryAddress 0x"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Parameter specifies hexadecimal PFE firmware storage memory address."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:0bc9b8ee-a4fa-40ec-bf82-1e7231ba919a"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="text:match(., '^[a-fA-F0-9]{8}$')" false="Must be 8 digits in hexadecimal notation !"/>
                      </a:da>
                      <a:a name="WIDTH" value="8"/>
                      <a:da name="DEFAULT" value="341F0000"/>
                      <a:da name="ENABLE" type="XPath" expr="../PfeClassFwLoadFrom='PfeClassFwMemoryAddress' and (../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false')"/>
                  </v:var>
                  <v:var name="PfeClassFwArrayLabel" type="STRING">
                      <a:a name="LABEL" value="PfeClassFwArrayLabel"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: Parameter specifies PFE firmware storage array variable name defined as const uint8 string_entered_into_PfeClassFwArrayLabel_field[];"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:719e322c-88cf-403b-be96-2a277ae94f46"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="text:match(., '^[_a-zA-Z]{1}[_a-zA-Z0-9]*$')" false="Must be C language label !"/>
                      </a:da>
                      <a:da name="DEFAULT" value="pfe_class_fw_binary"/>
                      <a:da name="ENABLE" type="XPath" expr="../PfeClassFwLoadFrom='PfeClassFwArrayLabel' and (../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false')"/>
                  </v:var>
                  <v:var name="FwFeaturesBufferSize" type="INTEGER">
                      <a:a name="LABEL" value="FwFeaturesBufferSize"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: The maximum size of class firmware .features ELF file section in bytes. Used to prepare enough buffer for copy of section."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:8aad4a80-023c-11ef-86d8-0242ac120002"/>
                      <a:a name="WIDTH" value="5"/>
                      <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=9999"/>
                          <a:tst expr="&gt;=0"/>
                      </a:da>
                      <a:da name="DEFAULT" value="3000"/>
                      <a:da name="ENABLE" type="XPath" expr="../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false'"/>
                  </v:var>
                  <v:var name="FwMessagesBufferSize" type="INTEGER">
                      <a:a name="LABEL" value="FwMessagesBufferSize"/>
                      <a:a name="DESC"
                           value="EN: Vendor specific: The maximum size of class firmware .messages ELF file section in bytes. Used to prepare enough buffer for copy of section."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:a187abe0-023e-11ef-86d8-0242ac120002"/>
                      <a:a name="WIDTH" value="5"/>
                      <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=9999"/>
                          <a:tst expr="&gt;=0"/>
                      </a:da>
                      <a:da name="DEFAULT" value="4000"/>
                      <a:da name="ENABLE" type="XPath" expr="../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false'"/>
                  </v:var>
                  <!-- PFE MEMORY SPACE RESERVATION FOR DEDICATED PURPOSE : begin -->
                  <v:var name="PfeFciMaximumFpTableNumber" type="INTEGER">
                    <a:a name="LABEL" value="PfeFciMaximumFpTableNumber"/>
                    <a:a name="DESC"
                         value="EN: Maximum number of flexible parser tables that can be registered through FCI command FPP_CMD_FP_TABLE."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:c2268f84-0b5e-4fbe-a3d9-712ab303aa0c"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=64"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="1"/>
                  </v:var>
                  <v:var name="PfeFciMaximumFpRuleNumber" type="INTEGER">
                    <a:a name="LABEL" value="PfeFciMaximumFpRuleNumber"/>
                    <a:a name="DESC"
                         value="EN: Maximum number of flexible parser rules that can be registered through FCI command FPP_CMD_FP_RULE."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:1a37fc0e-06db-4780-94f3-4b82435d887b"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=256"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:a name="WIDTH" value="4"/>
                    <a:da name="DEFAULT" value="20"/>
                  </v:var>
                  <v:var name="PfeCfgMacDbEntriesMax" type="INTEGER">
                    <a:a name="LABEL" value="PfeCfgMacDbEntriesMax"/>
                    <a:a name="DESC"
                         value="EN: Maximum number of MAC entries per interface."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:9725cafa-a1dc-4f4a-868b-5be8172447d7"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=64"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="8"/>
                  </v:var>
                  <v:var name="PfeLogIfNameLengthMax" type="INTEGER">
                    <a:a name="LABEL" value="PfeLogIfNameLengthMax"/>
                    <a:a name="DESC" value="EN: Maximum length of logical interface name (including \0 termination character)."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:c48e7631-32dd-48eb-8c34-3d57f5c41e6a"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=32"/>
                      <a:tst expr="&gt;=2"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="16"/>
                    <a:da name="ENABLE" type="XPath" expr="../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false'"/>
                  </v:var>
                  <v:var name="PfeMirrorsMax" type="INTEGER">
                    <a:a name="LABEL" value="PfeMirrorsMax"/>
                    <a:a name="DESC"
                         value="EN: Maximum number of mirrors that can be registered through FCI command FPP_CMD_MIRROR."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:3fabe668-cde9-421e-8895-0ef9ccab0841"/>
                    <a:da name="INVALID" type="Range">
                      <!-- (PFE_PHY_IF_ID_MAX + 1) * PFE_CT_MIRRORS_COUNT * 2 -->
                      <a:tst expr="&lt;=40"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="8"/>
                  </v:var>
                  <!-- PFE MEMORY SPACE RESERVATION FOR DEDICATED PURPOSE : end -->
                  <v:var name="PfeChannelBdFlushApi" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v><![CDATA[<html>
                               Vendor specific: Enable API to perform cached RX BD flush on any channel.<br>
                           </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="LABEL" value="Enable PFE Channel BD Flush API"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="Link">VariantLinkTime</icc:v>
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" value="ECUC:9f2394a9-7399-4792-9069-d62428c0e076"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="ENABLE" type="XPath" expr="node:empty(../EthPfeSlaveMode)='true' or ../EthPfeSlaveMode='false'"/>
                  </v:var>
                  <v:var name="PfeChannelBdFlushMaxBdCount" type="INTEGER">
                    <a:a name="LABEL" value="PfeChannelBdFlushMaxBdCount"/>
                    <a:a name="DESC"
                         value="EN: Maximum number of slave cached BDs that can be released in a single API call. Set to 0 to disable the limit."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:83cc6e3f-d55f-4ed4-a50e-addc944bb680"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=256"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="0"/>
                    <a:da name="ENABLE" type="XPath" expr="../PfeChannelBdFlushApi='true'"/>
                  </v:var>
                  <v:var name="PfeChannelBdFlushTimeoutCounter" type="INTEGER">
                    <a:a name="LABEL" value="PfeChannelBdFlushTimeoutCounter"/>
                    <a:a name="DESC"
                         value="EN: Timeout value (in loop tournaround count) used to wait for the packet to be received on the slave HIF when BD flush."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:b7b3f0c9-0e64-40c8-93e7-bb95b9086cc9"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="200"/>
                    <a:da name="ENABLE" type="XPath" expr="../PfeChannelBdFlushApi='true'"/>
                  </v:var>
                  <v:var name="PfeIdexRpcResendTime" type="INTEGER">
                    <a:a name="LABEL" value="PfeIdexRpcResendTime"/>
                    <a:a name="DESC"
                         value="EN: IDEX request timeout in milliseconds between resending IDEX RPC requests."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:797332c6-2c99-4f26-96e5-1a715b6b2898"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=65535"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="100"/>
                    <a:da name="ENABLE" type="XPath" expr="../EthPfeSlaveMode='true'"/>
                  </v:var>
                  <v:var name="PfeIdexRpcResendCount" type="INTEGER">
                    <a:a name="LABEL" value="PfeIdexRpcResendCount"/>
                    <a:a name="DESC"
                         value="EN: IDEX request maximum resend count. 1 means only one RPC request will be sent, without further attempts."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v mclass="Link">VariantLinkTime</icc:v>
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:dd0da645-ed97-4d13-bb36-8af3e7b83d4e"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=65535"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:a name="WIDTH" value="3"/>
                    <a:da name="DEFAULT" value="40"/>
                    <a:da name="ENABLE" type="XPath" expr="../EthPfeSlaveMode='true'"/>
                  </v:var>
                  <v:ctr name="EnableFCIOwnership" type="IDENTIFIABLE">
                    <a:a name="DESC"
                         value="EN: Slave driver on HIFn can be FCI owner"/>
                    <a:a name="UUID" value="ECUC:645daa8b-06f2-4ed5-b6b9-e326a5b828ce"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <v:var name="PfeEnableFCIownershipHIF0" type="BOOLEAN">
                      <a:a name="DESC">
                        <a:v><![CDATA[<html>
                                Vendor specific: Turn ON to allow slave drivers on HIF0 to become FCI owners.<br>
                            </html>]]>
                        </a:v>
                      </a:a>
                      <a:a name="LABEL" value="Slave driver on HIF0 can be FCI owner"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" value="ECUC:d40b3433-4e69-5c5e-b1d4-2f7b0fd37f44"/>
                      <a:da name="DEFAULT" value="true"/>
                      <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode='true') or ../../EthPfeSlaveMode='false') and (../../EthCommonHif!='HIF0')"/>
                    </v:var>
                    <v:var name="PfeEnableFCIownershipHIF1" type="BOOLEAN">
                      <a:a name="DESC">
                        <a:v><![CDATA[<html>
                                Vendor specific: Turn ON to allow slave drivers on HIF1 to become FCI owners.<br>
                            </html>]]>
                        </a:v>
                      </a:a>
                      <a:a name="LABEL" value="Slave driver on HIF1 can be FCI owner"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" value="ECUC:d40b3433-4e69-5c5e-b1d4-2f7b0fd37f45"/>
                      <a:da name="DEFAULT" value="true"/>
                       <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode='true') or ../../EthPfeSlaveMode='false') and (../../EthCommonHif!='HIF1')"/>
                    </v:var>
                    <v:var name="PfeEnableFCIownershipHIF2" type="BOOLEAN">
                      <a:a name="DESC">
                        <a:v><![CDATA[<html>
                                Vendor specific: Turn ON to allow slave drivers on HIF2 to become FCI owners.<br>
                            </html>]]>
                        </a:v>
                      </a:a>
                      <a:a name="LABEL" value="Slave driver on HIF2 can be FCI owner"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" value="ECUC:d40b3433-4e69-5c5e-b1a4-2f7b0fd37f46"/>
                      <a:da name="DEFAULT" value="true"/>
                       <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode='true') or ../../EthPfeSlaveMode='false') and (../../EthCommonHif!='HIF2')"/>
                    </v:var>
                    <v:var name="PfeEnableFCIownershipHIF3" type="BOOLEAN">
                      <a:a name="DESC">
                        <a:v><![CDATA[<html>
                                Vendor specific: Turn ON to allow slave drivers on HIF3 to become FCI owners.<br>
                            </html>]]>
                        </a:v>
                      </a:a>
                      <a:a name="LABEL" value="Slave driver on HIF3 can be FCI owner"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" value="ECUC:d40b3433-4e69-5c5e-b1d4-2f7b0fe37f47"/>
                      <a:da name="DEFAULT" value="true"/>
                       <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode='true') or ../../EthPfeSlaveMode='false') and (../../EthCommonHif!='HIF3')"/>
                    </v:var>
                    <a:da name="ENABLE" type="XPath" expr="(node:empty(../EthPfeMultiInstance='true') and ../EthPfeSlaveMode='false')"/>
                  </v:ctr>
                  <v:ctr name="EthEMAC0Config" type="IDENTIFIABLE">
                    <a:a name="DESC"
                         value="EN: Configuration for EMAC0"/>
                    <a:a name="UUID" value="ECUC:f6fb9af1-e732-4dc4-9855-28720420b2a4"/>
                    <a:da name="ENABLE" value="true"/>
                    <v:var name="EthCtrlEnableMii" type="BOOLEAN">
                        <a:a name="LABEL" value="EthCtrlEnableMii"/>
                        <a:a name="DESC"
                             value="EN: Enables / Disables Media Independent Interface (MII) for transceiver access"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:03a6cb99-8e1d-43b0-aa7e-4b0a4df8bfc0"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="ENABLE" type="XPath" expr="../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC0'"/>
                    </v:var>
                    <v:var name="EthDuplexMode" type="ENUMERATION">
                        <a:a name="LABEL" value="EthDuplexMode"/>
                        <a:a name="DESC" value="EN: Defines the controller's duplex mode."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="UUID" value="ECUC:362c12fb-c71c-48c2-9783-bb03db54fd69"/>
                        <a:da name="RANGE">
                            <a:v>ETH_FULL_DUPLEX</a:v>
                            <a:v>ETH_HALF_DUPLEX</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_FULL_DUPLEX"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC0')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerSpeed" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerSpeed"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            This bit = 0 & Port Select(Eth line speed) = 1 => Speed = 10Mbps.
                            This bit = 0 & Port Select = 0 => Speed = 1Gbps.
                            This bit = 1 & Port Select = 1 => Speed = 100Mbps.
                            This bit = 1 & Port Select = 0 => Speed = 2.5Gbps.
                            This option is only available on master driver and for EMAC interfaces.
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="Link">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="Link">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="UUID" value="ECUC:6aad1231-6332-4c5c-aa8b-614cceec4bec"/>
                        <a:da name="RANGE">
                            <a:v>ETH_MAC_LAYER_SPEED_10M</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_100M</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_1G</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_2500M</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_MAC_LAYER_SPEED_1G"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_SPEED_2500M') and (node:value(../EthCtrlMacLayerSubType) != 'SERIAL')" true = "Link speeds of 2500M is supported SGMII mode."/>
                        </a:da>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC0')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerSubType" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerSubType"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            Defines the MAC layer subtype of ethernet controller.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="Link">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="Link">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:39eaa630-bb99-44a4-b182-020483a148b2"/>
                        <a:da name="RANGE">
                            <a:v>REDUCED</a:v>
                            <a:v>SERIAL</a:v>
                            <a:v>STANDARD</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="REDUCED"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC0')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerType" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerType"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            Defines the MAC layer type of the ethernet controller.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:a6d7746e-87ec-46f1-b6f9-687c8c095f7d"/>
                        <a:da name="RANGE">
                            <a:v>ETH_MAC_LAYER_TYPE_XMII</a:v>
                            <a:v>ETH_MAC_LAYER_TYPE_XGMII</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_MAC_LAYER_TYPE_XGMII"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and ((node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_2500M') or (node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_1G'))"
                              true = "Link speeds of 1Gbps and 2500M are not supported in MII and RMII."/>
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and ((node:value(../EthCtrlMacLayerSubType) = 'SERIAL'))"
                              true = "SMII is not supported by the SoC."/>
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XGMII') and ((node:value(../EthCtrlMacLayerSubType) = 'STANDARD'))"
                              true = "GMII is not supported by the SoC."/>
                        </a:da>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC0')"/>
                    </v:var>
                    <v:var name="IEEE1588ClockAttachedToGMAC" type="BOOLEAN">
                        <a:a name="LABEL" value="IEEE1588ClockAttachedToGMAC"/>
                        <a:a name="DESC"
                             value="Enables external clock for EMAC IEEE1588 timestamping unit. Clock will be attached to GMAC"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:a7bc61f7-c9d3-4a7a-a76d-f6a5eb3e54ee"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="(../../EthEMAC1Config/IEEE1588ClockAttachedToEMAC0='true') and (node:current()='true')" true="EMAC0 cannot use GMAC clock when EMAC1 uses EMAC0 clock."/>
                          <a:tst expr="(../../EthEMAC2Config/IEEE1588ClockAttachedToEMAC0='true') and (node:current()='true')" true="EMAC0 cannot use GMAC clock when EMAC2 uses EMAC0 clock."/>
                        </a:da>
                    </v:var>
                    <v:var name="IEEE1588ClockOutputFrequencyHz" type="INTEGER">
                        <a:a name="LABEL" value="IEEE1588ClockOutputFrequencyHz"/>
                        <a:a name="DESC"
                           value="Internal clock for timestamping unit. Can be used only when IEEE1588ClockAttachedToGMAC is False"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:d4f22c9f-1c76-43c7-8b6b-99ebec0f9099"/>
                        <a:a name="WIDTH" value="8"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=199999999"/>
                          <a:tst expr="&gt;=3906251"/>
                        </a:da>
                        <a:da name="DEFAULT" value="100000000"/>
                        <a:da name="ENABLE" type="XPath" expr="(../IEEE1588ClockAttachedToGMAC='false')"/>
                    </v:var>
                    <v:var name="EnablePpsOutput" type="BOOLEAN">
                        <a:a name="LABEL" value="EnablePpsOutput"/>
                        <a:a name="DESC"
                             value="Enable PPS output signal generation"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:b066a65c-3978-4610-a41f-2f1e2e7ac2b3"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false')"/>
                    </v:var>
                    <v:var name="PpsOutputPeriod" type="INTEGER">
                        <a:a name="LABEL" value="PpsOutputPeriod"/>
                        <a:a name="DESC"
                           value="PPS output period [units of PTP reference clock ticks]."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:d0ce0b48-d6e3-424a-aa07-d538c1c820d9"/>
                        <a:a name="WIDTH" value="8"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=4294967295"/>
                          <a:tst expr="&gt;=2"/>
                        </a:da>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="(num:i(node:current()) mod num:i(../IEEE1588ClockOutputFrequencyHz) = 0) or (num:i(../IEEE1588ClockOutputFrequencyHz) mod num:i(node:current()) = 0)" false="PPS Period must be a multiple or a divider of 1 second interval."/>
                        </a:da>
                        <a:da name="DEFAULT" value="200000000"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../EnablePpsOutput='true')"/>
                    </v:var>
                    <v:var name="PpsOutputPulseWidth" type="INTEGER">
                        <a:a name="LABEL" value="PpsOutputPulseWidth"/>
                        <a:a name="DESC"
                           value="PPS output pulse width [units of PTP reference clock ticks]."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:28987302-901b-4328-b309-d25a138d22b0"/>
                        <a:a name="WIDTH" value="8"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=4294967295"/>
                          <a:tst expr="&gt;=2"/>
                        </a:da>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="num:i(node:current()) &lt; num:i(../PpsOutputPeriod)" false="Pulse length must be smaller than period length."/>
                        </a:da>
                        <a:da name="DEFAULT" value="100000000"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../EnablePpsOutput='true')"/>
                    </v:var>
                    <!-- /** @implements variable queue sizes for emacs */ -->
                    <v:ctr name="EthEMAC0QueueSizes" type="IDENTIFIABLE">
                        <a:da name="FRAME" value="LINE"/>
                        <a:a name="LABEL" value="EthEMAC0TmuQueueSizes"/>
                        <a:a name="LAYOUT" value="HORIZONTAL"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html>
                                    To set the sizes of TMU queues Q0 - Q7, total maximum size is 255 bytes
                                </html>]]>
                            </a:v>
                        </a:a>
                        <v:var name="EMAC0Q0Size" type="INTEGER">
                          <a:a name="LABEL" value="Q0Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 0."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:b4da89f1-8f4e-4e04-8eb4-3f77552915a4"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC0Q1Size" type="INTEGER">
                          <a:a name="LABEL" value="Q1Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 1."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:d78c8667-0cca-4fae-9797-628e7961dd03"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC0Q2Size" type="INTEGER">
                          <a:a name="LABEL" value="Q2Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 2."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:b61c837c-63cb-43a9-98c2-53465ddf3fc5"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC0Q3Size" type="INTEGER">
                          <a:a name="LABEL" value="Q3Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 3."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:c2e6ebcd-db29-443d-8caf-036bb15bab11"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC0Q4Size" type="INTEGER">
                          <a:a name="LABEL" value="Q4Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 4."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:1d81ed17-1150-48d2-9cae-0f37ba6fedd2"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC0Q5Size" type="INTEGER">
                          <a:a name="LABEL" value="Q5Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 5."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:72c3ce4e-8530-47c1-ab4c-64abaee6ae7d"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC0Q6Size" type="INTEGER">
                          <a:a name="LABEL" value="Q6Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 6."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:8ea8da53-f476-4389-afc6-bd71542f6c74"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC0Q7Size" type="INTEGER">
                          <a:a name="LABEL" value="Q7Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 7."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:6d9ba9a2-1d56-440a-bb7b-e15b68fff813"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="((node:value(./EMAC0Q7Size))+(node:value(./EMAC0Q6Size))+(node:value(./EMAC0Q5Size))+(node:value(./EMAC0Q4Size))+(node:value(./EMAC0Q3Size))+(node:value(./EMAC0Q2Size))+(node:value(./EMAC0Q1Size))+(node:value(./EMAC0Q0Size)))&gt;'255'" true = "The summary of TMU queue sizes (queue 0 to queue 7) for EMAC0 cannot be more than 255."/>
                        </a:da>
                        <a:a name="UUID" value="ECUC:b963bfc9-f6a9-4116-98da-2643b45b717a"/>
                    </v:ctr>
                  </v:ctr>
                  <v:ctr name="EthEMAC1Config" type="IDENTIFIABLE">
                    <a:a name="DESC"
                         value="EN: Configuration for EMAC1"/>
                    <a:a name="UUID" value="ECUC:645daa8b-06f2-4ed5-b6b9-e326a5b828fe"/>
                    <a:da name="ENABLE" value="true"/>
                    <v:var name="EthCtrlEnableMii" type="BOOLEAN">
                        <a:a name="LABEL" value="EthCtrlEnableMii"/>
                        <a:a name="DESC"
                             value="EN: Enables / Disables Media Independent Interface (MII) for transceiver access"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:b7e13fde-7999-440b-adc3-1e49e2de8440"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="ENABLE" type="XPath" expr="../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC1'"/>
                    </v:var>
                    <v:var name="EthDuplexMode" type="ENUMERATION">
                        <a:a name="LABEL" value="EthDuplexMode"/>
                        <a:a name="DESC" value="EN: Defines the controller's duplex mode."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="UUID" value="ECUC:841e708b-eab0-45d6-a5bf-bf900074ffcf"/>
                        <a:da name="RANGE">
                            <a:v>ETH_FULL_DUPLEX</a:v>
                            <a:v>ETH_HALF_DUPLEX</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_FULL_DUPLEX"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC1')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerSpeed" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerSpeed"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            This bit = 0 & Port Select(Eth line speed) = 1 => Speed = 10Mbps.
                            This bit = 0 & Port Select = 0 => Speed = 1Gbps.
                            This bit = 1 & Port Select = 1 => Speed = 100Mbps.
                            This bit = 1 & Port Select = 0 => Speed = 2.5Gbps.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="Link">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="Link">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="UUID" value="ECUC:ef617377-d14f-4514-b733-48507f4686ee"/>
                        <a:da name="RANGE">
                            <a:v>ETH_MAC_LAYER_SPEED_10M</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_100M</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_1G</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_2500M</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_MAC_LAYER_SPEED_1G"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_SPEED_2500M') and (node:value(../EthCtrlMacLayerSubType) != 'SERIAL')" true = "Link speeds of 2500M is supported SGMII mode."/>
                        </a:da>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC1')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerSubType" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerSubType"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            Defines the MAC layer subtype of ethernet controller.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="Link">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="Link">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:93327db2-5e4d-4ed7-8ee3-df608f723617"/>
                        <a:da name="RANGE">
                            <a:v>REDUCED</a:v>
                            <a:v>SERIAL</a:v>
                            <a:v>STANDARD</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="REDUCED"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC1')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerType" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerType"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            Defines the MAC layer type of the ethernet controller.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:76cb5acb-9f48-4b69-9c8f-aef1ec1c7d7d"/>
                        <a:da name="RANGE">
                            <a:v>ETH_MAC_LAYER_TYPE_XMII</a:v>
                            <a:v>ETH_MAC_LAYER_TYPE_XGMII</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_MAC_LAYER_TYPE_XGMII"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and ((node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_2500M') or (node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_1G'))"
                              true = "Link speeds of 1Gbps and 2500M are not supported in MII and RMII."/>
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and ((node:value(../EthCtrlMacLayerSubType) = 'SERIAL'))"
                              true = "SMII is not supported by the SoC."/>
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XGMII') and ((node:value(../EthCtrlMacLayerSubType) = 'STANDARD'))"
                              true = "GMII is not supported by the SoC."/>
                        </a:da>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC1')"/>
                    </v:var>
                    <v:var name="IEEE1588ClockAttachedToEMAC0" type="BOOLEAN">
                        <a:a name="LABEL" value="IEEE1588ClockAttachedToEMAC0"/>
                        <a:a name="DESC"
                             value="Enables external clock for EMAC IEEE1588 timestamping unit. Clock will be attached to EMAC0"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:ed762548-29d0-45c1-a831-99d999898f87"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="(../../EthEMAC0Config/IEEE1588ClockAttachedToGMAC='true') and (node:current()='true')" true="EMAC1 cannot use EMAC0 clock when EMAC0 uses GMAC clock."/>
                        </a:da>
                    </v:var>
                    <v:var name="IEEE1588ClockOutputFrequencyHz" type="INTEGER">
                        <a:a name="LABEL" value="IEEE1588ClockOutputFrequencyHz"/>
                        <a:a name="DESC"
                           value="Internal clock for timestamping unit. Can be used only when IEEE1588ClockAttachedToEMAC0 is False"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:2b28860e-71c4-4924-8c69-95075b4a48f1"/>
                        <a:a name="WIDTH" value="8"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=199999999"/>
                          <a:tst expr="&gt;=3906251"/>
                        </a:da>
                        <a:da name="DEFAULT" value="100000000"/>
                        <a:da name="ENABLE" type="XPath" expr="(../IEEE1588ClockAttachedToEMAC0='false')"/>
                    </v:var>
                    <!-- /** @implements variable queue sizes for emacs */ -->
                    <v:ctr name="EthEMAC1QueueSizes" type="IDENTIFIABLE">
                        <a:da name="FRAME" value="LINE"/>
                        <a:a name="LABEL" value="EthEMAC1TmuQueueSizes"/>
                        <a:a name="LAYOUT" value="HORIZONTAL"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html>
                                    To set the sizes of TMU queues Q0 - Q7, total maximum size is 255 bytes
                                </html>]]>
                            </a:v>
                        </a:a>
                        <v:var name="EMAC1Q0Size" type="INTEGER">
                          <a:a name="LABEL" value="Q0Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 0."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:54222768-c36c-4ec8-b5e3-1abf420a016b"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC1Q1Size" type="INTEGER">
                          <a:a name="LABEL" value="Q1Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 1."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:5e6603b3-3cf0-41ec-82e9-f23e131efa2b"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC1Q2Size" type="INTEGER">
                          <a:a name="LABEL" value="Q2Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 2."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:9178f0f7-c9f2-4c9c-a904-af396b002b7f"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC1Q3Size" type="INTEGER">
                          <a:a name="LABEL" value="Q3Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 3."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:67f5b193-455d-4902-869c-94a32d0177f4"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC1Q4Size" type="INTEGER">
                          <a:a name="LABEL" value="Q4Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 4."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:28d9c7a8-f69b-4e1d-937a-fe697581e5e8"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC1Q5Size" type="INTEGER">
                          <a:a name="LABEL" value="Q5Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 5."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:1a1ec1c5-85ce-49e9-824b-cc120a19ce1e"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC1Q6Size" type="INTEGER">
                          <a:a name="LABEL" value="Q6Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 6."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:89abc7ac-1588-4137-a1f0-96260646fb54"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC1Q7Size" type="INTEGER">
                          <a:a name="LABEL" value="Q7Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 7."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:09b32565-129b-4257-92dd-86e2b3f9c1d0"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="((node:value(./EMAC1Q7Size))+(node:value(./EMAC1Q6Size))+(node:value(./EMAC1Q5Size))+(node:value(./EMAC1Q4Size))+(node:value(./EMAC1Q3Size))+(node:value(./EMAC1Q2Size))+(node:value(./EMAC1Q1Size))+(node:value(./EMAC1Q0Size)))&gt;'255'" true = "The summary of TMU queue sizes (queue 0 to queue 7) for EMAC1 cannot be more than 255."/>
                        </a:da>
                        <a:a name="UUID" value="ECUC:64964fde-3f16-45d5-859c-008961780dc8"/>
                    </v:ctr>
                  </v:ctr>
                  <v:ctr name="EthEMAC2Config" type="IDENTIFIABLE">
                    <a:a name="DESC"
                         value="EN: Configuration for EMAC2"/>
                    <a:a name="UUID" value="ECUC:317bc589-1701-4561-8545-9b18371c0ae6"/>
                    <a:da name="ENABLE" value="true"/>
                    <v:var name="EthCtrlEnableMii" type="BOOLEAN">
                        <a:a name="LABEL" value="EthCtrlEnableMii"/>
                        <a:a name="DESC"
                             value="EN: Enables / Disables Media Independent Interface (MII) for transceiver access"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:795357fe-0c55-449a-afd9-d7d0e4e02832"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="ENABLE" type="XPath" expr="../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC2'"/>
                    </v:var>
                    <v:var name="EthDuplexMode" type="ENUMERATION">
                        <a:a name="LABEL" value="EthDuplexMode"/>
                        <a:a name="DESC" value="EN: Defines the controller's duplex mode."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="UUID" value="ECUC:ec4423df-78af-4137-b366-af4ae4223449"/>
                        <a:da name="RANGE">
                            <a:v>ETH_FULL_DUPLEX</a:v>
                            <a:v>ETH_HALF_DUPLEX</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_FULL_DUPLEX"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC2')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerSpeed" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerSpeed"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            This bit = 0 & Port Select(Eth line speed) = 1 => Speed = 10Mbps.
                            This bit = 0 & Port Select = 0 => Speed = 1Gbps.
                            This bit = 1 & Port Select = 1 => Speed = 100Mbps.
                            This bit = 1 & Port Select = 0 => Speed = 2.5Gbps.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="Link">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="Link">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="UUID" value="ECUC:d7808c3e-4629-49e9-8d28-bc062778f313"/>
                        <a:da name="RANGE">
                            <a:v>ETH_MAC_LAYER_SPEED_10M</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_100M</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_1G</a:v>
                            <a:v>ETH_MAC_LAYER_SPEED_2500M</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_MAC_LAYER_SPEED_1G"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_SPEED_2500M') and (node:value(../EthCtrlMacLayerSubType) != 'SERIAL')" true = "Link speeds of 2500M is supported SGMII mode."/>
                        </a:da>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC2')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerSubType" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerSubType"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            Defines the MAC layer subtype of ethernet controller.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="Link">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="Link">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:5c04a3e3-0f50-4275-835a-eac74672cade"/>
                        <a:da name="RANGE">
                            <a:v>REDUCED</a:v>
                            <a:v>SERIAL</a:v>
                            <a:v>STANDARD</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="REDUCED"/>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC2')"/>
                    </v:var>
                    <v:var name="EthCtrlMacLayerType" type="ENUMERATION">
                        <a:a name="LABEL" value="EthCtrlMacLayerType"/>
                        <a:a name="DESC">
                            <a:v><![CDATA[EN:<html>
                            Defines the MAC layer type of the ethernet controller.
                            This option is only available on master driver and for EMAC interfaces
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="Link">VariantLinkTime</icc:v>
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="Link">VariantLinkTime</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" value="ECUC:27cc5d81-3327-4d88-958e-5c15a610dbe7"/>
                        <a:da name="RANGE">
                            <a:v>ETH_MAC_LAYER_TYPE_XMII</a:v>
                            <a:v>ETH_MAC_LAYER_TYPE_XGMII</a:v>
                        </a:da>
                        <a:da name="DEFAULT" value="ETH_MAC_LAYER_TYPE_XGMII"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and ((node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_2500M') or (node:value(../EthCtrlMacLayerSpeed) = 'ETH_MAC_LAYER_SPEED_1G'))"
                              true = "Link speeds of 1Gbps and 2500M are not supported in MII and RMII."/>
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XMII') and ((node:value(../EthCtrlMacLayerSubType) = 'SERIAL'))"
                              true = "SMII is not supported by the SoC."/>
                            <a:tst expr="(node:value(.) ='ETH_MAC_LAYER_TYPE_XGMII') and ((node:value(../EthCtrlMacLayerSubType) = 'STANDARD'))"
                              true = "GMII is not supported by the SoC."/>
                        </a:da>
                        <a:da name="ENABLE" type="XPath" expr="(node:empty(../../EthPfeSlaveMode)='true' or ../../EthPfeSlaveMode='false') and (../../../../EthConfigSet/EthCtrlConfig/*/EthVendorSpecific/EthCtrlHwPort!='EMAC2')"/>
                    </v:var>
                    <v:var name="IEEE1588ClockAttachedToEMAC0" type="BOOLEAN">
                        <a:a name="LABEL" value="IEEE1588ClockAttachedToEMAC0"/>
                        <a:a name="DESC"
                             value="Enables external clock for EMAC IEEE1588 timestamping unit. Clock will be attached to EMAC0"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:6442298a-65bc-4243-b305-84f8a3a92432"/>
                        <a:da name="DEFAULT" value="false"/>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="(../../EthEMAC0Config/IEEE1588ClockAttachedToGMAC='true') and (node:current()='true')" true="EMAC2 cannot use EMAC0 clock when EMAC0 uses GMAC clock."/>
                        </a:da>
                    </v:var>
                    <v:var name="IEEE1588ClockOutputFrequencyHz" type="INTEGER">
                        <a:a name="LABEL" value="IEEE1588ClockOutputFrequencyHz"/>
                        <a:a name="DESC"
                           value="Internal clock for timestamping unit. Can be used only when IEEE1588ClockAttachedToEMAC0 is False"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:7c143d71-d1b4-444c-9fc9-90560aedb7af"/>
                        <a:a name="WIDTH" value="8"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=199999999"/>
                          <a:tst expr="&gt;=3906251"/>
                        </a:da>
                        <a:da name="DEFAULT" value="100000000"/>
                        <a:da name="ENABLE" type="XPath" expr="(../IEEE1588ClockAttachedToEMAC0='false')"/>
                    </v:var>
                    <!-- /** @implements variable queue sizes for emacs */ -->
                    <v:ctr name="EthEMAC2QueueSizes" type="IDENTIFIABLE">
                        <a:da name="FRAME" value="LINE"/>
                        <a:a name="LABEL" value="EthEMAC1TmuQueueSizes"/>
                        <a:a name="LAYOUT" value="HORIZONTAL"/>
                        <a:a name="DESC">
                            <a:v>
                                <![CDATA[EN:<html>
                                    To set the sizes of TMU queues Q0 - Q7, total maximum size is 255 bytes
                                </html>]]>
                            </a:v>
                        </a:a>
                        <v:var name="EMAC2Q0Size" type="INTEGER">
                          <a:a name="LABEL" value="Q0Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 0."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:17ef953e-443c-4009-a7ee-bd8bd659321f"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC2Q1Size" type="INTEGER">
                          <a:a name="LABEL" value="Q1Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 1."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:9cf458c7-0fa2-4dec-84a9-e99b6ea14aad"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC2Q2Size" type="INTEGER">
                          <a:a name="LABEL" value="Q2Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 2."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:32dfae0a-6f65-43e9-81e6-d22f5c4f474f"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC2Q3Size" type="INTEGER">
                          <a:a name="LABEL" value="Q3Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 3."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:29070ac0-c70d-4e99-8813-fa38b47bf069"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC2Q4Size" type="INTEGER">
                          <a:a name="LABEL" value="Q4Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 4."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:f915bb73-b1f3-428e-9f1d-a0ba80a66d87"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC2Q5Size" type="INTEGER">
                          <a:a name="LABEL" value="Q5Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 5."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:b0558e43-cdc7-4db7-ae16-0703aa88e240"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC2Q6Size" type="INTEGER">
                          <a:a name="LABEL" value="Q6Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 6."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:0c0829cf-8509-475a-9578-e6875b1b6dd9"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <v:var name="EMAC2Q7Size" type="INTEGER">
                          <a:a name="LABEL" value="Q7Size"/>
                          <a:a name="DESC"
                            value="Size of TMU queue 7."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:da name="DEFAULT" value="31"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:d9f0dcf3-4542-440e-a8e3-d0aecb3e4119"/>
                          <a:a name="WIDTH" value="3"/>
                        </v:var>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="((node:value(./EMAC2Q7Size))+(node:value(./EMAC2Q6Size))+(node:value(./EMAC2Q5Size))+(node:value(./EMAC2Q4Size))+(node:value(./EMAC2Q3Size))+(node:value(./EMAC2Q2Size))+(node:value(./EMAC2Q1Size))+(node:value(./EMAC2Q0Size)))&gt;'255'" true = "The summary of TMU queue sizes (queue 0 to queue 7) for EMAC2 cannot be more than 255."/>
                        </a:da>
                        <a:a name="UUID" value="ECUC:c60e581b-af6d-4c16-9ebd-17345ecf0a7c"/>
                    </v:ctr>
                  </v:ctr>

                  <!-- /** @implements EthDriverRuntimeErrorsDemEventParameterRefs */ -->
                  <v:ctr name="EthDriverRuntimeErrorsDemEventParameterRefs" type="IDENTIFIABLE">
                    <a:a name="DESC"
                         value="EN: Container for the references to DemEventParameter elements which shall be invoked using the API Dem_ReportErrorStatus in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter&apos;s DemEventId value. The standardized errors are provided in the container and can be extended by vendor specific error references."/>
                    <a:a name="OPTIONAL" value="true"/>
                    <a:a name="EDITABLE" type="XPath" expr="../EthDisableDemEventDetect='false'"/>
                    <a:a name="UUID" value="ECUC:7dd19452-d692-11ec-9d64-0242ac120002"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantLinkTime</icc:v>
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <!-- /** @implements ETH_E_DRIVER_RUNTIME_ERR_IP_READY_Object */ -->
                      <v:ref name="ETH_E_DRIVER_RUNTIME_ERR_IP_READY" type="REFERENCE">
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="EDITABLE" type="XPath" expr="../../EthDisableDemEventDetect='false' and ../../EthPfeSlaveMode='true'"/>
                        <a:a name="DESC"
                             value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Timeout when detect IP-ready&quot; has occured."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PreCompile">VariantLinkTime</icc:v>
                          <icc:v class="PreCompile">VariantPostBuild</icc:v>
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" value="ECUC:7dd19452-d692-11ec-9d64-0242ac120003"/>
                        <a:da name="REF"
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                        <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                        </a:da>
                      </v:ref>
                    <!-- /** @implements ETH_E_DRIVER_RUNTIME_ERR_INTERNAL_Object */ -->
                      <v:ref name="ETH_E_DRIVER_RUNTIME_ERR_INTERNAL" type="REFERENCE">
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="EDITABLE" type="XPath" expr="../../EthDisableDemEventDetect='false'"/>
                        <a:a name="DESC"
                             value="EN: Reference to the DemEventParameter which shall be issued when the common driver runtime errors have occured."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantLinkTime</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="REQUIRES-SYMBOLIC-NAME-VALUE" value="true"/>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" value="ECUC:7dd19452-d692-11ec-9d64-0242ac120004"/>
                        <a:da name="REF"
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                        </a:da>
                      </v:ref>
                  </v:ctr>

                 <!-- /** @implements EthPfeEccDemEventParameterRefs */ -->
                  <v:ctr name="EthPfeEccDemEventParameterRefs" type="IDENTIFIABLE">
                      <a:a name="DESC"
                           value="EN: Container for the references to DemEventParameter elements which shall be invoked using the API Dem_ReportErrorStatus in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter&apos;s DemEventId value. The standardized errors are provided in the container and can be extended by vendor specific error references."/>
                      <a:a name="OPTIONAL" value="true"/>
                      <a:a name="EDITABLE" type="XPath" expr="../EthDisableDemEventDetect='false' and (../EthPfeMultiInstance='false' or ../EthPfeSlaveMode='false')"/>
                      <a:a name="UUID" value="ECUC:7dd09452-d692-11ec-9d64-0242ac121002"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantLinkTime</icc:v>
