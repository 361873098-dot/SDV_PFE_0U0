                              <ORIGIN>NXP</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:c2e0a221-195b-4b8c-84b8-7db4ffddd3c1">
                          <SHORT-NAME>XrdcMasterPriviledgeMode</SHORT-NAME>
