                                                    <a:da name="DEFAULT" type="XPath" expr="num:i( node:fallback( node:current()/../@index, num:i(0)))"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;num:i(ecu:get('Rm.Mpu_M7.MaximumRegionCount'))" false="Value must be lower than ecu:get('Rm.Mpu_M7.MaximumRegionCount')"/>
                                                        <a:tst expr="&gt;=0" false="Value must be higher or equal than ecu:get('Rm.Mpu_M7.MinimumRegionCount')"/>
                                                    </a:da>
                                                </v:var>

                                                <v:var name="StartAddress" type="INTEGER">
