                                                    <a:da name="EDITABLE" type="XPath" expr="num:i(node:fallback(node:current()/../RegionSize, num:i(0))) &gt;= num:i(ecu:get('Rm.Mpu_M7.MinRegionSizeWithSubregion'))"/>
                                                </v:var>

                                                <v:var name="Shareable" type="BOOLEAN">
                                                    <a:a name="LABEL" value="Shareable"/>
