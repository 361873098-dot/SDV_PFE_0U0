                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:47ff8502-1f2f-26cb-3e8d-079285100f39">
                      <SHORT-NAME>EthPfeSlaveMode</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL">
                               Vendor specific: This option depends on option &quot;Multiple PFE drivers support (master-slave)&quot; being enabled.
                               
                                 When ON then this driver requires another driver to be simultaneously running on the device. The other driver shall be configured as master.
                                 When OFF then this driver is a master driver that can either run alone or it can support one or more slave drivers running on the same device.
                               
                           </L-2>
                      </DESC>
                      <!-- @Calculated /Eth_43_PFE_TS_T40D11M14I0R0/Eth/EthGeneral/EthVendorSpecific/EthPfeSlaveMode: ENABLE(XPath: ../EthPfeMultiInstance=&apos;true&apos;)-->
