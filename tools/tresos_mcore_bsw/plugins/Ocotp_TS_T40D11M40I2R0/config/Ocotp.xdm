                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:8054c455-a601-4c41-be6d-578a5cdc1fcc"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!-- @implements OcotpCrcTestApi_Object -->
                                <v:var name="OcotpCrcTestApi" type="BOOLEAN">
                                    <a:a name="LABEL" value="Ocotp Crc Validate Api"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Ocotp_CalculateAndWriteCrcValue and Ocotp_CrcValidate function.<br>
                                            true: API supported / function provided.<br>
                                            false: API not supported / function not provided
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:dbe77d87-17f6-4069-b7bc-31f4248581db"/>
                                    <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:value(.) = 'true' and node:value(../OcotpWriteEFuseApi) = 'false'"
                                            true="Ocotp Write eFuse Api must be enabled to use this API."/>
                                    </a:da>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!-- @implements OcotpGetStatusApi_Object -->
                                <v:var name="OcotpGetStatusApi" type="BOOLEAN">
                                    <a:a name="LABEL" value="Ocotp Get Status Api"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Ocotp_GetStatus function.<br>
                                            true: API supported / function provided.<br>
                                            false: API not supported / function not provided
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:22dc738c-5662-43f6-8ae7-7355056e5243"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!-- OcotpTimeoutMethod_Object -->
                                <v:var name="OcotpTimeoutMethod" type="ENUMERATION">
                                    <a:a name="LABEL" value="Ocotp Timeout Method"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>OcotpTimeoutMethod</p>
                                                    <p>Configures the timeout method.</p>
                                                    <p>Based on this selection a certain timeout method from OsIf will be used in the driver.</p>
                                                    <p>Note: If OSIF_COUNTER_SYSTEM or OSIF_COUNTER_CUSTOM are selected make sure the corresponding timer is enabled in OsIf General configuration. </p>
                                                    Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:8ce7c4f9-799e-43b0-8f0e-c17be0c0485e"/>
                                    <a:a name="DEFAULT" value="OSIF_COUNTER_DUMMY"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="node:refs('ASPathDataOfSchema:/TS_T40D11M40I2R0/BaseNXP/OsIfGeneral/OsIfUseCustomTimer') = 'false' and node:fallback(.,'OSIF_COUNTER_DUMMY') = 'OSIF_COUNTER_CUSTOM'" true="Custom Timer is not enabled in OsIf (OsIfGeneral/OsIfUseCustomTimer checkbox)"/>
                                        <a:tst expr="node:refs('ASPathDataOfSchema:/TS_T40D11M40I2R0/BaseNXP/OsIfGeneral/OsIfUseSystemTimer') = 'false' and node:fallback(.,'OSIF_COUNTER_DUMMY') = 'OSIF_COUNTER_SYSTEM'" true="System Timer is not enabled in OsIf (OsIfGeneral/OsIfUseSystemTimer checkbox)"/>
                                    </a:da>
                                    <a:da name="RANGE">
                                        <a:v>OSIF_COUNTER_DUMMY</a:v>
                                        <a:v>OSIF_COUNTER_SYSTEM</a:v>
                                        <a:v>OSIF_COUNTER_CUSTOM</a:v>
                                    </a:da>
                                </v:var>

                                <!-- OcotpWriteTimeout -->
                                <v:var name="OcotpWriteTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Ocotp Write Timeout" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Timeout value for write eFuse operation.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:539ef40b-e737-4d2d-ba7e-557735dcca87"/>
                                    <a:da name="DEFAULT" value="1"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4294967295"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>

                                <!-- OcotpReadTimeout -->
                                <v:var name="OcotpReadTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Ocotp Read Timeout" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Timeout value for read eFuse operation.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:e24aad5d-896d-40c6-ad4e-d607ab144b6b"/>
                                    <a:da name="DEFAULT" value="1"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4294967295"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>

                                <!-- OcotpSetModeTimeout -->
                                <v:var name="OcotpSetModeTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Ocotp Set Mode Timeout" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Timeout value for set mode operation. See the chip data sheet for the required setup time (between powerdown and fusebox access).
                                            We must respect this constraint. No accesses are possible to FBXC and eFuse during this time.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:eb7d3350-9dc1-4710-ac56-135072fd4930"/>
                                    <a:da name="DEFAULT" value="1"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4294967295"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>
                                <!-- OcotpCrcValidateTimeout -->
                                <v:var name="OcotpCrcValidateTimeout" type="INTEGER">
                                    <a:a name="LABEL" value="Ocotp Crc Validate Timeout" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Timeout value for CRC validate operation.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a9866b68-1304-43b9-9ea8-89d694978c56"/>
                                    <a:da name="DEFAULT" value="1"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4294967295"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>
                            </v:ctr>

                            <v:ctr name="OcotpConfigList" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                      Container for runtime configuration parameters of the Ocotp driver.<br>
                                      Implementation Type: Ocotp_ConfigType.
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:ce69ec23-0d5d-4444-8d9d-122916af5233"/>
                                <!-- OcotpConfig_Object -->
                                <v:lst name="OcotpHwUnit" type="MAP">
                                        <v:ctr name="OcotpHwUnit" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="OcotpHwUnit"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                Ocotp Hardware Unit.
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:bdfefe03-2fba-4652-bdfe-0d53627668fb"/>
                                                <!-- OcotpHardwareIndex -->
                                        <v:var name="OcotpHardwareIndex" type="INTEGER">
                                            <a:a name="LABEL" value="Ocotp Hardware Index" />
                                                <a:a name="DESC">
                                                    <a:v>
                                                      <![CDATA[EN:<html><p>
                                                        Index of current hardware unit.
                                                      </p></html>]]>
                                                    </a:v>
                                                </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:41f2c709-2eee-4204-9d58-6df0a36d7733"/>
                                            <a:da name="DEFAULT" type="XPath">
                                                <a:tst expr="num:i(node:fallback(../@index, 0))"/>
                                            </a:da>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="text:uniq(text:split(node:fallback(../../*/OcotpHardwareIndex, 1)), node:fallback(., 1))" false="This hardware index is already in use."/>
                                                <a:tst expr="count(../../*)&lt;=node:value(.)" true="Wrong hardware index number. Push calculate button to update value."/>
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=255"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                        </v:var>
                                                <!-- OcotpInstance -->
                                        <v:var name="OcotpInstance" type="INTEGER">
                                            <a:a name="LABEL" value="Instance" />
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                    Instance of this word channel
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:7bd41eb9-bfd7-44d2-9833-4ecd38336d77"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="text:uniq(../../*/OcotpInstance,.)"
                                                       false="Duplicate Hardware Unit."
                                                />
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=0"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                            <a:da name="READONLY" value="true"/>
                                        </v:var>

                                        <!-- OcotpSecureModeEnable -->
                                        <v:var name="OcotpSecureModeEnable" type="BOOLEAN">
                                            <a:a name="LABEL" value="Ocotp Secure Mode Enable"/>
                                            <a:a name="DESC">
                                            <a:v>
                                              <![CDATA[EN:
                                                  <html>
                                                  Enable Secure Mode.<br>
                                                  True: Secure mode is enabled.<br>
                                                  Flase: Secure mode is disabled.
                                                  </html>
                                              ]]>
                                            </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:0990b7eb-7abd-4237-8459-d8642170c139"/>
                                            <a:da name="DEFAULT" value="false"/>
                                            <a:da name="READONLY" value="true"/>
                                        </v:var>
                                                <!-- OcotpEcucPartitionRef_Object  -->
                                        <v:ref name="OcotpEcucPartitionRef" type="REFERENCE">
                                            <a:a name="DESC">
                                            <a:v>Maps the OCOTP driver to zero or multiple ECUC partitions to make the driver API available in the according partition.</a:v>
                                            <a:v>Tags: atp.Status=draft</a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="UUID" value="ECUC:c1e4063a-c34c-467e-998b-598dd98457b8"/>
                                            <a:a name="OPTIONAL" value="true"/>
                                            <a:a name="EDITABLE" type="XPath">
                                                <a:tst expr="../../../../OcotpGeneral/OcotpEnableMultiCore ='true'"/>
                                            </a:a>
                                            <a:da name="INVALID" type="XPath">
                                                    <a:tst expr="node:when(../../../../OcotpGeneral/OcotpEnableMultiCore = 'false','true',node:refvalid(.))" false="There are no valid OcotpEcucPartitionRef's configured"/>
                                            </a:da>
                                            <a:da name="REF"
                                                value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                        </v:ref>
                                    </v:ctr>
                                </v:lst>
                            </v:ctr>
                            <v:ctr name="OcotpChannelList" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Ocotp Channel List"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            List of Otp channel.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:e1a3a547-af32-47ef-9d76-58051563353d"/>
                                <!-- OcotpChannel_Object -->
                                <v:lst name="OcotpChannel" type="MAP">
                                    <a:da name="MIN" value="1"/>
                                    <v:ctr name="OcotpChannel" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="Ocotp Channel"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                Ocotp Channel Configuration.
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:dd42546b-3901-4182-a21a-d2384d5c990a"/>
                                                <!-- OcotpChannelNumber -->
                                        <v:var name="OcotpChannelNumber" type="INTEGER">
                                            <a:a name="LABEL" value="Ocotp Channel Number" />
                                                <a:a name="DESC">
                                                    <a:v>
                                                      <![CDATA[EN:<html><p>
                                                        Index of current channel.
                                                      </p></html>]]>
                                                    </a:v>
                                                </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:f0933669-0307-4782-9b0d-5e95cc501be1"/>
                                            <a:da name="DEFAULT" type="XPath">
                                                <a:tst expr="num:i(node:fallback(../@index, 0))"/>
                                            </a:da>
                                            <a:da name="RANGE" type="XPath">
                                                <a:tst expr="text:uniq(text:split(node:fallback(../../*/OcotpChannelNumber, 1)), node:fallback(., 1))" false="This channel number is already in use."/>
                                                <a:tst expr="count(../../*)&lt;=node:value(.)" true="Wrong channel number. Push calculate button to update value."/>
                                            </a:da>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=255"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                        </v:var>
                                                <!-- OcotpHwRef -->
                                        <v:ref name="OcotpHwRef" type="REFERENCE">
                                            <a:a name="LABEL" value="Ocotp HW Reference"/>
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Select Ocotp Hardware Reference
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="ECU"/>
                                            <a:a name="UUID" value="ECUC:ffd04533-5ef7-4438-862c-74a551aee387"/>
                                            <a:da name="REF" value="ASPathDataOfSchema:/TS_T40D11M40I2R0/Ocotp/OcotpConfigList/OcotpHwUnit"/>
                                            <a:a name="INVALID" type="XPath">
                                                <a:tst expr="node:refvalid(.)"
                                                    false="Invalid or empty reference."/>
                                                </a:a>
                                        </v:ref>
                                                <!-- OcotpWord -->
                                        <v:var name="OcotpWord" type="ENUMERATION">
                                            <a:a name="LABEL" value="eFuse Word" />
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                        Ocotp Fuse Word.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:5793b38b-c209-4bec-b671-be87f1dfa34d"/>
                                            <a:da name="DEFAULT" type="XPath" expr="text:split(text:replaceAll(concat(' ',text:join(ecu:list('Ocotp.FuseMap'))),' [0-9a-fA-F]+_',' '))[position()-1 = node:fallback(node:current()/../@index, '0')]"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="not(text:uniq(../../*/OcotpWord,.))" true="This eFuse is already in use."/>
                                            </a:da>
                                            <a:da name="RANGE" type="XPath" expr="text:split(text:replaceAll(concat(' ',text:join(ecu:list(&apos;Ocotp.FuseMap&apos;))),' [0-9a-fA-F]+_',' '))"/>
                                        </v:var>
                                                <!-- OcotpEccProtectionEnabled -->
                                        <v:var name="OcotpEccProtectionEnabled" type="BOOLEAN">
                                            <a:a name="LABEL" value="Ecc Protection Enabled"/>
                                            <a:a name="DESC">
                                            <a:v>
                                              <![CDATA[EN:
                                                  <html>
                                                  Enable Ecc protection for current fuse word.<br>
                                                  TRUE: Ecc protection will be enable for current fuse after writing operation is successful.<br>
                                                  FALSE: Ecc protection is disabled.
                                                  </html>
                                              ]]>
                                            </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:86fedbc2-b824-45f6-a231-a1f2fd8aea2e"/>
                                            <a:da name="DEFAULT" value="false"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="(. = 'true') and (ecu:get('Ocotp.ECCprotection') = 'false')"
                                                       true="ECC protection is not supported in this device."/>
                                            </a:da>
                                        </v:var>
                                                <!-- OcotpReadProtectionEnabled -->
                                        <v:var name="OcotpReadProtectionEnabled" type="BOOLEAN">
                                            <a:a name="LABEL" value="Read Protection Enabled"/>
                                            <a:a name="DESC">
                                            <a:v>
                                              <![CDATA[EN:
                                                  <html>
                                                  Enable Read Protection for current fuse word.<br>
                                                  TRUE: Read Protection will be enable for current fuse after writing operation is successful.<br>
                                                  FALSE: Read Protection is disabled.
                                                  </html>
                                              ]]>
                                            </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:da name="EDITABLE" type="XPath" expr="text:contains(text:split(text:replaceAll(concat(' ',text:join(ecu:list('Ocotp.FuseLock'))),' [0-9a-fA-F]+_[0-9a-fA-F]+_',' ')),node:value(../OcotpWord))"/>
                                            <a:a name="UUID" value="ECUC:cd254f8a-62df-4bc0-9115-115cd82e3493"/>
                                            <a:da name="DEFAULT" value="false"/>
                                            <a:da name="INVALID" type="XPath">
                                            <a:tst expr="not(text:contains(text:split(text:replaceAll(concat(' ',text:join(ecu:list('Ocotp.FuseLock'))),' [0-9a-fA-F]+_[0-9a-fA-F]+_',' ')),node:value(../OcotpWord))) and node:value(.)='true'"
                                                   true="ReadProtection is not applied this fuse word."/>
                                            </a:da>
                                        </v:var>
                                                <!-- OcotpWriteProtectionEnabled -->
                                        <v:var name="OcotpWriteProtectionEnabled" type="BOOLEAN">
                                            <a:a name="LABEL" value="Write Protection Enabled"/>
                                            <a:a name="DESC">
                                            <a:v>
                                              <![CDATA[EN:
                                                  <html>
                                                  Enable Write Protection for current fuse word.<br>
                                                  TRUE: Write Protection will be enable for current fuse after writing operation is successful.<br>
                                                  FALSE: Write Protection is disabled.
                                                  </html>
                                              ]]>
                                            </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:da name="EDITABLE" type="XPath" expr="text:contains(text:split(text:replaceAll(concat(' ',text:join(ecu:list('Ocotp.FuseLock'))),' [0-9a-fA-F]+_[0-9a-fA-F]+_',' ')),node:value(../OcotpWord))"/>
                                            <a:a name="UUID" value="ECUC:65037893-8569-45e6-baa4-cc1dd0d04175"/>
                                            <a:da name="DEFAULT" value="false"/>
                                            <a:da name="INVALID" type="XPath">
                                            <a:tst expr="not(text:contains(text:split(text:replaceAll(concat(' ',text:join(ecu:list('Ocotp.FuseLock'))),' [0-9a-fA-F]+_[0-9a-fA-F]+_',' ')),node:value(../OcotpWord))) and node:value(.)='true'"
                                                   true="Write Protection is not applied this fuse word."/>
                                            </a:da>
                                        </v:var>
                                                <!-- OcotpWriteOperationBlockingEnabled -->
                                        <v:var name="OcotpWriteOperationBlockingEnabled" type="BOOLEAN">
                                            <a:a name="LABEL" value="Write Operation Blocking Enabled"/>
                                            <a:a name="DESC">
                                            <a:v>
                                              <![CDATA[EN:
                                                  <html>
                                                  TRUE: function WriteEFuse is blocking.<br>
                                                  FALSE: function WriteEFuse is NOT blocking.
                                                  </html>
                                              ]]>
                                            </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:38b51b30-743e-41f2-96af-2cac88aa1cd2"/>
                                            <a:da name="DEFAULT" value="true"/>
                                        </v:var>
                                                <!-- @implements OcotpCrcEnable_Object -->
                                        <v:var name="OcotpCrcEnable" type="BOOLEAN">
                                            <a:a name="LABEL" value="Ocotp CRC32 Test Enable"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                    Enable Crc test for current channel.<br>
                                                    true: Crc test feature is enabled for current channel.<br>
                                                    false: Crc test feature is disabled for current channel.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:937e8b1f-b40b-47a4-bc23-a20bf61b8ef3"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../OcotpGeneral/OcotpCrcTestApi)='true'"/>
                                            <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:value(../../../../OcotpGeneral/OcotpCrcTestApi)='false' and node:value(.)='true'"
                                                   true="OcotpCrcTestApi must be enabled."/>
                                            </a:da>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>
                                                <!-- OcotpCRCTestRegionStart -->
                                        <v:var name="OcotpCRCTestRegionStart" type="ENUMERATION">
                                            <a:a name="LABEL" value="CRC Test Region Start" />
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                    Start address of CRC test region
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:9094fed3-ed9a-49d9-aa4e-b238174db99b"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../OcotpCrcEnable)='true'"/>
                                            <a:da name="DEFAULT" type="XPath" expr="text:split(text:replaceAll(concat(' ',text:join(ecu:list('Ocotp.FuseMap'))),' [0-9a-fA-F]+_',' '))[position()-1 = node:fallback(node:current()/../@index, '0')]"/>
                                            <a:da name="RANGE" type="XPath" expr="text:split(text:replaceAll(concat(' ',text:join(ecu:list(&apos;Ocotp.FuseMap&apos;))),' [0-9a-fA-F]+_',' '))"/>
                                        </v:var>
                                                <!-- OcotpCRCTestRegionEnd -->
                                        <v:var name="OcotpCRCTestRegionEnd" type="ENUMERATION">
                                            <a:a name="LABEL" value="CRC Test Region End" />
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                    Start address of CRC test region
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:f7587944-7d2b-4b55-832f-447dedbb4ea6"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../OcotpCrcEnable)='true'"/>
                                            <a:da name="DEFAULT" type="XPath" expr="text:split(text:replaceAll(concat(' ',text:join(ecu:list('Ocotp.FuseMap'))),' [0-9a-fA-F]+_',' '))[position()-2 = node:fallback(node:current()/../@index, '0')]"/>
                                            <a:da name="RANGE" type="XPath" expr="text:split(text:replaceAll(concat(' ',text:join(ecu:list(&apos;Ocotp.FuseMap&apos;))),' [0-9a-fA-F]+_',' '))"/>
                                        </v:var>
                                                <!-- OcotpCRCTestFuseWord -->
                                        <v:var name="OcotpCRCTestFuseWord" type="ENUMERATION">
                                            <a:a name="LABEL" value="CRC Test Efuse Word" />
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                    CRC eFuse Word which will be used to compare.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:d10f4885-d62c-40a0-a4d1-2343713b84c5"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../OcotpCrcEnable)='true'"/>
                                            <a:da name="DEFAULT" type="XPath" expr="text:split(text:replaceAll(text:join(text:grep(ecu:list('Ocotp.FuseMap'), concat('^[0-9a-zA-Z]+_','OCOTP_CRC','.*'))),'[0-9a-fA-F]+_OCOTP_CRC','OCOTP_CRC'))[1]"/>
                                            <a:da name="RANGE" type="XPath" expr="text:split(text:replaceAll(text:join(text:grep(ecu:list('Ocotp.FuseMap'), concat('^[0-9a-zA-Z]+_','OCOTP_CRC','.*'))),'[0-9a-fA-F]+_OCOTP_CRC','OCOTP_CRC'))"/>
                                        </v:var>
                                                <!-- OcotpGPRegisterIndex -->
                                        <v:var name="OcotpGPRegisterIndex" type="INTEGER">
                                            <a:a name="LABEL" value="GP Register Index" />
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                    Index of general purpose register.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="OPTIONAL" value="true"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:3d585eab-7cb3-49a7-9a50-aeab2e469daf"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../OcotpGeneral/OcotpReadApplicationInformationApi)='true' or node:value(../../../../OcotpGeneral/OcotpWriteApplicationInformationApi)='true'"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=1"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                        </v:var>
                                                <!-- OcotpSTRRegisterIndex -->
                                        <v:var name="OcotpSTRRegisterIndex" type="INTEGER">
                                            <a:a name="LABEL" value="STR Register Index" />
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:<html><p>
                                                    Index of sticky registers. To edit this field, enable the node OcotpReadStickyInformationApi or OcotpWriteStickyInformationApi.
                                                    </p></html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="OPTIONAL" value="true"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:3d585eab-7cb3-49a7-9a50-aeab2e469dae"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../OcotpGeneral/OcotpReadStickyInformationApi)='true' or node:value(../../../../OcotpGeneral/OcotpWriteStickyInformationApi)='true'"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=1"/>
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                        </v:var>
                                    </v:ctr>
                                </v:lst>
                            </v:ctr>

                            <!-- @implements CommonPublishedInformation_Object -->
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Common Published Information"/>
                                <!-- @remarks Covers BSW00374, BSW00318 -->
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                        <p>Common container, aggregated by all modules. It contains published information about vendor and versions.</p>
                                        </html>
                                    ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:339efe8a-03b2-4966-a71b-f6ddd2b071d6"/>

                                <v:var name="ArReleaseMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="AUTOSAR Major Version"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Vendor specific: Major version number of AUTOSAR specification on which the appropriate implementation is based on.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:edc352aa-00a5-442c-ae86-a79fbfb9a51a"/>
                                    <a:da name="DEFAULT" value="4"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=4"/>
                                        <a:tst expr="&lt;=4"/>
                                    </a:da>
                                </v:var>

                                <v:var name="ArReleaseMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="AUTOSAR Minor Version"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Vendor specific: Minor version number of AUTOSAR specification on which the appropriate implementation is based on.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:cef33d8f-ff9b-40e7-94b9-929663d0da3b"/>
                                    <a:da name="DEFAULT" value="4"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=4"/>
                                        <a:tst expr="&lt;=4"/>
                                    </a:da>
                                </v:var>

                                <v:var name="ArReleaseRevisionVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="AUTOSAR Patch Version"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Vendor specific: Patch version number of AUTOSAR specification on which the appropriate implementation is based on.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:93efb8f0-3ef9-41d6-ad04-f9d1cb6da0d5"/>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0"/>
                                        <a:tst expr="&lt;=0"/>
                                    </a:da>
                                </v:var>

                                <v:var name="ModuleId" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Numeric Module ID"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Vendor specific: Module ID of this module.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:d3be6995-c4cf-4b99-993d-a8ac6556d6ff"/>
                                    <a:da name="DEFAULT" value="255"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=255"/>
                                        <a:tst expr="&lt;=255"/>
                                    </a:da>
                                </v:var>

                                <v:var name="SwMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Software Major Version"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Major version number of the vendor specific implementation of the module. The numbering is vendor specific.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:f4ce172b-b350-4b43-a6a1-bd27930813e6"/>
                                    <a:da name="DEFAULT" value="4"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=4"/>
                                        <a:tst expr="&lt;=4"/>
                                    </a:da>
                                </v:var>
                                <v:var name="SwMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Software Minor Version"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:1310e215-653c-4e51-9579-45b4585789cb"/>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0"/>
                                        <a:tst expr="&lt;=0"/>
                                    </a:da>
                                </v:var>

                                <v:var name="SwPatchVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Software Patch Version"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:12a3a6ca-c689-4ab0-be0b-a43d24b4f104"/>
                                    <a:da name="DEFAULT" value="2"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=2"/>
                                        <a:tst expr="&lt;=2"/>
                                    </a:da>
                                </v:var>

                                <v:var name="VendorApiInfix" type="STRING_LABEL">
                                    <a:a name="LABEL" value="Vendor Api Infix"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>In driver modules which can be instantiated several times on a single ECU, BSW00347 requires that the name of APIs is extended by the VendorId and a vendor specific name.
                                            This parameter is used to specify the vendor specific name. In total, the implementation specific name is generated as follows:
                                            &lt;ModuleName&gt;_&gt;VendorId&gt;_&lt;VendorApiInfix&gt;&lt;Api name from SWS&gt;.
                                            E.g.  assuming that the VendorId of the implementor is 123 and the implementer chose a VendorApiInfix of &quot;v11r456&quot; a api name Can_Write defined in the SWS will translate to Can_123_v11r456Write.
                                            This parameter is mandatory for all modules with upper multiplicity &gt; 1. It shall not be used for modules with upper multiplicity =1.
                                            </p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v class="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:431d24fb-b943-4a77-90e6-6db0146db38b"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:da name="READONLY" value="true"/>
                                </v:var>

                                <v:var name="VendorId" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Vendor ID"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.</p>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:b16fce99-5b9e-40eb-b16a-46b295a84019"/>
                                    <a:da name="DEFAULT" value="43"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=43"/>
                                        <a:tst expr="&lt;=43"/>
                                    </a:da>
                                </v:var>

                            </v:ctr>

                        </v:ctr>
                    </d:chc>

                    <d:chc name="Ocotp_EcuParameterDefinition"
                       type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF"
                             value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                            <a:a name="UUID" value="ECUC:b86966a3-d071-4b79-b288-7e7763551f30"/>
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/TS_T40D11M40I2R0/Ocotp"/>
                            </d:lst>
                        </d:ctr>
                    </d:chc>

                    <d:chc name="Ocotp_ModuleDescription"
                       type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF"
                             value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                            <d:var name="MODULE_ID" type="INTEGER" >
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:var>
                            <d:ref type="RECOMMENDED_CONFIGURATION" >
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="PRE_CONFIGURED_CONF" >
                                <a:a name="EDITABLE" value="false"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="VENDOR_SPECIFIC_MODULE_DEF"
                               value="ASPath:/TS_T40D11M40I2R0/Ocotp"/>
                        </d:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>

</datamodel>
