                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9f59476f-2f32-478f-9c67-2325e47bd0c8">
                          <SHORT-NAME>CtuCmdListStartAdr</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">First address of the command list associated with the internal trigger - (CLCRx). Available when ADCE is enabled.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
