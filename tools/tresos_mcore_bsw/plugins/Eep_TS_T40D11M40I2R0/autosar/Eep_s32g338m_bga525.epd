                  <DESC>
                    <L-2 L="EN">
                                        
                                            Vendor specific: Switches the Diagnostic Error Reporting and Notification OFF.
                                        </L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
