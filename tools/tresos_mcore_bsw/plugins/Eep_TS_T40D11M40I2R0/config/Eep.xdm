                                <a:da name="DEFAULT" value="268435456"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=0xFFFFFFFF"/>
                                    <a:tst expr="&gt;=1"/>
                                </a:da>
                                </v:var><!-- transferAsyncTimeout -->

                               <!-- getInterfaceTimeout -->
                               <v:var name="getInterfaceTimeout" type="INTEGER">
                                <a:a name="LABEL" value="Get card interface timeout"/>
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:<html><p>
                                        Timeout value to get card interface condition
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:5390999b-5a85-456d-910e-a1266a9fe14a"/>
                                <a:a name="EDITABLE" value="true"/>
                                <a:a name="DEFAULT_RADIX" value="HEX" />
                                <a:da name="DEFAULT" value="268435456"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=0xFFFFFFFF"/>
                                    <a:tst expr="&gt;=1"/>
                                </a:da>
                                </v:var><!-- getInterfaceTimeout -->

                                <!-- Voltage support config -->
                                <v:ctr name="voltageSupport" type="IDENTIFIABLE">
                                    <a:a name="LABEL" value="Operating Voltage Selection" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Voltage levels supported on current board
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:0db19328-96d9-4960-86be-a8c2b21d7638"/>
                                    <!-- 3.3V Support -->
                                    <v:var name="Support33V" type="BOOLEAN">
                                        <a:a name="LABEL" value="3.3V Support" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Current board supports 3.3V voltage
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:9a949ff5-c090-4ccd-aabb-ac258c87a1c4"/>
                                        <a:da name="DEFAULT" value="true" />
                                    </v:var><!-- 3.3V Support -->
                                    <!-- 3.0V Support -->
                                    <v:var name="Support30V" type="BOOLEAN">
                                        <a:a name="LABEL" value="3.0V Support" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Current board supports 3.0V voltage
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:1ff7b715-a475-40e8-9951-b9db6c2fc1f3"/>
                                        <a:da name="DEFAULT" value="true" />
                                    </v:var><!-- 3.0V Support -->
                                    <!-- 1.8V Support -->
                                    <v:var name="Support18V" type="BOOLEAN">
                                        <a:a name="LABEL" value="1.8V Support" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Current board supports 1.8V voltage (HS200 and HS400 mode will be disabled if 1.8V is not available)
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:b302f581-1e08-419d-9e1e-6c9b143a19c5"/>
                                        <a:da name="DEFAULT" value="true" />
                                    </v:var><!-- 1.8V Support -->
                                </v:ctr>

                                <!-- cardInsertCallback -->
                                <v:var name="cardInsertCallback" type="FUNCTION-NAME">
                                    <a:a name="LABEL" value="Card insertion callback" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Card insertion callback.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="DEFAULT" value="NULL_PTR"/>
                                    <a:a name="UUID" value="ECUC:fb1710bc-df0f-48a2-9dbf-6697c4cef93f"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                            false="Configuration name must be a valid C identifier!"/>
                                    </a:da>
                                </v:var><!-- cardInsertCallback -->

                                <!-- cardRemoveCallback -->
                                <v:var name="cardRemoveCallback" type="FUNCTION-NAME">
                                    <a:a name="LABEL" value="Card removal callback" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Card removal callback.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="DEFAULT" value="NULL_PTR"/>
                                    <a:a name="UUID" value="ECUC:0573a112-a5a7-4325-94b3-567b0aea457a"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                            false="Configuration name must be a valid C identifier!"/>
                                    </a:da>
                                </v:var><!-- cardRemoveCallback -->

                                <!-- transferCompleteCallback -->
                                <v:var name="transferCompleteCallback" type="FUNCTION-NAME">
                                    <a:a name="LABEL" value="Transfer complete callback" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Transfer complete callback.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="DEFAULT" value="NULL_PTR"/>
                                    <a:a name="UUID" value="ECUC:422bc6e4-ee86-4e1c-9cc5-0bdede28fab7"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                            false="Configuration name must be a valid C identifier!"/>
                                    </a:da>
                                </v:var><!-- transferCompleteCallback -->

                                <!-- transferErrorCallback -->
                                <v:var name="transferErrorCallback" type="FUNCTION-NAME">
                                    <a:a name="LABEL" value="Transfer error callback" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Transfer error callback.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="DEFAULT" value="NULL_PTR"/>
                                    <a:a name="UUID" value="ECUC:68a3aefb-9b10-4221-ac28-5a28d0d35372"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                            false="Configuration name must be a valid C identifier!"/>
                                    </a:da>
                                </v:var><!-- transferErrorCallback -->

                                <!-- blockGapCallback -->
                                <v:var name="blockGapCallback" type="FUNCTION-NAME">
                                    <a:a name="LABEL" value="Block gap callback" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Block gap callback.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="DEFAULT" value="NULL_PTR"/>
                                    <a:a name="UUID" value="ECUC:f289cf7b-febb-4687-b899-628ab093e6bb"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                            false="Configuration name must be a valid C identifier!"/>
                                    </a:da>
                                </v:var><!-- blockGapCallback -->

                                <!-- cardIntCallback -->
                                <v:var name="cardIntCallback" type="FUNCTION-NAME">
                                    <a:a name="LABEL" value="Card interrupt callback" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Card interrupt callback.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:da name="DEFAULT" value="NULL_PTR"/>
                                    <a:a name="UUID" value="ECUC:40025f6a-eaba-4091-8817-a2b29f3bbe55"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="text:match(normalize-space(.),'^[_a-zA-Z][_0-9a-zA-Z]*$')"
                                            false="Configuration name must be a valid C identifier!"/>
                                    </a:da>
                                </v:var><!-- cardIntCallback -->
                                
                                <!-- bootFlag Config -->
                                <v:ctr name="BootHostConfig" type="IDENTIFIABLE">
                                    <a:a name="LABEL" value="MMC Boot Host Configuration" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Configure flags in mmc boot
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="UUID" value="ECUC:efc12700-0636-47d6-9c1f-5d3d30bd6123"/>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>

                                    <!-- ackFlag -->
                                    <v:var name="ackFlag" type="BOOLEAN">
                                        <a:a name="LABEL" value="Enable ACK For Boot" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Enable the boot ACK
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:d2e18f03-8ad4-41e8-ad76-a779d698eb13"/>
                                        <a:da name="DEFAULT" value="false" />
                                    </v:var><!-- ackFlag -->

                                    <!-- ackTimeout -->
                                    <v:var name="ackTimeout" type="INTEGER">
                                        <a:a name="LABEL" value="Boot ACK timeout value" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                            /*!< Sets the timeout value for the boot ACK.<br>
                                                NOTE:<br>
                                                In register configuration, real timeout is:<br>
                                                | ackTimeout |   S32V234    |   S32G274A   |   S32R45     |<br>
                                                |-----------------|-------------------|----------------------|---------------------|<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp0&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^13 | SDCLK x 2^32 | SDCLK x 2^14 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp1&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^14 | SDCLK x 2^33 | SDCLK x 2^15 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp2&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^15 | SDCLK x 2^18 | SDCLK x 2^16 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp3&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^16 | SDCLK x 2^19 | SDCLK x 2^17 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp4&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^17 | SDCLK x 2^20 | SDCLK x 2^18 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp5&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^18 | SDCLK x 2^21 | SDCLK x 2^19 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp6&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^19 | SDCLK x 2^22 | SDCLK x 2^20 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp7&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^20 | SDCLK x 2^23 | SDCLK x 2^21 |<br>
                                                |.....................|........................|..........................|............................|<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp14&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^27 | SDCLK x 2^30 | SDCLK x 2^28 |<br>
                                                |&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp15&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp| SDCLK x 2^28 | SDCLK x 2^31 | SDCLK x 2^29 |<br>
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:1942bdce-865a-48ff-b28c-696e4933d41a"/>
                                        <a:da name="DEFAULT" type="XPath" expr="(ecu:list(&apos;Eep.UsdhcCfg.ackTimeout&apos;))[position()-1=node:fallback(node:current()/../../@index,'1')]"/>
                                        <a:da name="RANGE" type="XPath"
                                                expr="ecu:list('Eep.UsdhcCfg.ackTimeout')"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=15"/>
                                            <a:tst expr="&gt;=0"/>
                                        </a:da>
                                    </v:var>
                                    <!-- ackTimeout -->

                                    <!-- disChkTimeout -->
                                    <v:var name="disChkTimeout" type="BOOLEAN">
                                        <a:a name="LABEL" value="Disable check timeout" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Disable check timeout
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:23d12493-5013-4dfb-abd9-1e35ef558e57"/>
                                        <a:da name="DEFAULT" value="false" />
                                    </v:var><!-- disChkTimeout -->

                                    <!-- autoBlkGap -->
                                    <v:var name="autoBlkGap" type="BOOLEAN">
                                        <a:a name="LABEL" value="Enable auto stop at the block gap" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Enable auto stop at the block gap
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:d53145da-0c65-4045-90c4-4ec4692eb87a"/>
                                        <a:da name="DEFAULT" value="false" />
                                    </v:var><!-- autoBlkGap -->

                                    <!-- DDR enable -->
                                    <v:var name="ddrEnable" type="BOOLEAN">
                                        <a:a name="LABEL" value="Enable DDR mode" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Enable Double data rate mode
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:5da53468-e180-4344-a010-f9e86756c1e4"/>
                                        <a:da name="DEFAULT" value="false" />
                                    </v:var><!-- ddrEnable -->

                                    <!-- bootMode -->
                                    <v:var name="bootMode" type="ENUMERATION">
                                        <a:a name="LABEL" value="Boot Mode" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Boot Mode
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:72f3772a-de0f-484a-b1b5-dc8284a9a1f6"/>
                                        <a:da name="DEFAULT" value="USDHC_NORMAL_MMC_BOOT"/>
                                        <a:da name="RANGE">
                                            <a:v>USDHC_NORMAL_MMC_BOOT</a:v>
                                            <a:v>USDHC_ALTER_MMC_BOOT</a:v>
                                        </a:da>
                                    </v:var><!-- bootMode -->

                                    <!-- bootBusWidth -->
                                    <v:var name="bootBusWidth" type="ENUMERATION">
                                        <a:a name="LABEL" value="Boot Bus Width" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Boot Bus Width
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:b519d1bf-df21-493e-a97b-4a7bfdab417f"/>
                                        <a:da name="DEFAULT" value="USDHC_DATA_BUS_WIDTH_1BIT"/>
                                        <a:da name="RANGE">
                                            <a:v>USDHC_DATA_BUS_WIDTH_1BIT</a:v>
                                            <a:v>USDHC_DATA_BUS_WIDTH_4BIT</a:v>
                                            <a:v>USDHC_DATA_BUS_WIDTH_8BIT</a:v>
                                        </a:da>
                                    </v:var><!-- bootBusWidth -->

                                    <!-- stopBlockGapCount -->
                                    <v:var name="stopBlockGapCount" type="INTEGER">
                                        <a:a name="LABEL" value="The block count for blockgap in boot process"/>
                                        <a:a name="DESC">
                                            <a:v>
                                            <![CDATA[EN:<html><p>
                                                Configures the block count for blockgap stop in boot process. The value range of this block count is [0 ... 65535]
                                            </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:627edf03-4c45-4a3c-8960-de18707436af"/>
                                        <a:da name="DEFAULT" value="0"/>
                                        <a:a name="EDITABLE" value="true"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=65535"/>
                                            <a:tst expr="&gt;=0"/>
                                        </a:da>
                                    </v:var><!-- stopBlockGapCount -->
                                    <v:var name="bootSdClock" type="INTEGER">
                                        <a:a name="LABEL" value="Sd Clock Frequency for Boot process"/>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                <html>
                                                Vendor specific:
                                                <h1>Sd Clock Frequency </h1><p>
                                                Indicates Clock Frequency (in Hz) will be used to transfer data for Boot process. It must be less than uSDHC source clock. Driver will calculate the maximum frequency which can be used based on this field.
                                                See the "uSDHC Source Clock" value node in the EepSdCfg array for the uSDHC source clock.
                                                </p></html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:bf37baf3-7aef-4ebf-9612-e9e856d84444"/>
                                        <a:da name="DEFAULT" type="XPath" expr="num:i(noderef:value(concat(noderef:ref(node:fallback(./../../../../EepSdCfg/*/SdClockReference, .)), '/McuClockReferencePointFrequency')))"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=4294967295"/>
                                            <a:tst expr="&gt;=0"/>
                                        </a:da>
                                    </v:var>
                                </v:ctr><!-- bootFlag Config -->

                            </v:ctr><!-- EepUsdhcControllerCfg -->
                        </v:lst><!-- EepUsdhcControllerCfg -->

                        <v:lst name="EepSdCfg" type="MAP">
                            <a:a name="LABEL" value="EepSdCfg"/>
                            <a:da name="MIN" value="1"/>
                            <a:da name="INVALID" type="XPath">
                                    <a:tst expr="(num:i(count(./*)) &gt; num:i(count(ecu:list(&apos;Eep.External.HwUnit.List&apos;))))"
                                          true=" EepSdCfg have max number of External Hw Unit."/>
                             </a:da>

                            <!-- EepSdCfg -->
                            <v:ctr name="EepSdCfg" type="IDENTIFIABLE">
                                <a:a name="LABEL" value="Eep SD Configuration"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            This container is present for SD card configuration structure.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="REQUIRES-INDEX" value="true"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:e4ca0dd3-e868-465e-9420-489bf9cab4f3"/>

                                <!-- EepEnableOperationsOnEmmc -->
                                <v:var name="EepEnableOperationsOnEmmc" type="BOOLEAN">
                                    <a:a name="LABEL" value="Eep Enable Emmc Memory" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Enable: Operations(write/read/erase/compare) are on the Emmc memory
                                                Disable: Operations(write/read/erase/compare) are on the SD memory
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:efc12700-0738-11d9-9c1f-5d3d30bd6ec1"/>
                                    <a:da name="DEFAULT" value="false" />
                                </v:var><!-- EepEnableOperationsOnEmmc -->

                                <!-- EepBusWidthMode -->
                                <v:var name="EepBusWidthMode" type="ENUMERATION">
                                    <a:a name="LABEL" value="Eep MMC Buswidth Mode"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                                Select bus width mode for eMMC.
                                                Available modes are 1 bit, 4 bits, 8 bits.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:fa1fcc9b-569f-4752-a81c-87ac330c441f"/>
                                    <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(node:fallback( ../EepEnableOperationsOnEmmc, 0 ) = 'true')"/>
                                    </a:a>
                                    <a:da name="DEFAULT" value="SD_IP_DATABUSWIDTH_4BIT"/>
                                    <a:da name="RANGE">
                                        <a:v>SD_IP_DATABUSWIDTH_1BIT</a:v>
                                        <a:v>SD_IP_DATABUSWIDTH_4BIT</a:v>
                                        <a:v>SD_IP_DATABUSWIDTH_8BIT</a:v>
                                        <a:v>SD_IP_DATABUSWIDTH_4BIT_DDR</a:v>
                                        <a:v>SD_IP_DATABUSWIDTH_8BIT_DDR</a:v>
                                    </a:da>
                                </v:var>

                                <!-- EepCardDriverStrength -->
                                <v:var name="EepCardDriverStrength" type="INTEGER">
                                    <a:a name="LABEL" value="Card Driver Strength"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html><p>
                                            Vendor specific:
                                            Selected the Driver Strength for card pads in HS_TIMING[185].
                                            (only for eMMC in HS200 or HS400 mode)
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:9059a327-de73-44f0-8b44-f9d17a9aa6c5"/>
                                    <a:a name="EDITABLE" type="XPath">
                                        <a:tst expr="(node:fallback( ../EepEnableOperationsOnEmmc, 0) = 'true')"/>
                                    </a:a>
                                    <a:da name="DEFAULT" value="0"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>

                                <!-- EepSdIpDevErrorDetect -->
                                <v:var name="EepSdIpDevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Eep Ip Dev Error Detect" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Pre-processor switch to enable and disable development error detection for IP layer.<br>
                                            true: Development error detection enabled for Ip layer.<br>
                                            false: Development error detection disabled for Ip layer.
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:efc12700-1323-41d9-9c1f-5d3d30bd6ec1"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="(../../../EepGeneral/EepDevErrorDetect = 'true') and (node:value(.) = 'false')"
                                            true="EepSdIpDevErrorDetect should follow EepDevErrorDetect if this node is enabled "/>
                                    </a:da>
                                    <a:da name="DEFAULT" value="true" />
                                </v:var>

                                <v:ref name="usdhcCfgReference" type="REFERENCE">
                                    <a:a name="LABEL" value="Usdhc Configuration Reference"/>
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                        <html>
                                            Reference to Usdhc Configuration
                                        </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:7D303324-6C00-1014-9FB4-934C845A4C16" />
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                    </a:da>
                                    <a:da name="REF" value="ASPathDataOfSchema:/TS_T40D11M40I2R0/Eep/EepUsdhcControllerCfg" />
                                </v:ref>

                                <v:var name="afrequencyTable" type="INTEGER">
                                    <a:a name="LABEL" value="Sd Clock Frequency"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            Vendor specific:
                                            <h1>Sd Clock Frequency </h1><p>
                                            Indicates Clock Frequency (in Hz) will be used to transfer data. It must be less than uSDHC source clock. Driver will calculate the maximum frequency which can be used based on this field.
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:bf37baf3-7aef-4ebf-9612-e9e856d88fd5"/>
                                    <a:da name="DEFAULT" type="XPath" expr="num:i(noderef:value(concat(noderef:ref(node:fallback(../SdClockReference, .)), '/McuClockReferencePointFrequency')))"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4294967295"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>

                                <v:var name="EepSdAutoDiscoverFrequency" type="BOOLEAN">
                                    <a:a name="LABEL" value="Sd Auto Discover Frequency" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html><p>
                                            Automatically calculate the maximum of the bus clock based on the configured frequency.
                                            <br> TRUE : Enable the automatic calculation.</br>
                                            <br> FALSE: Disable the automatic calculation. Bus clock equals to the configured frequency.</br>
                                            </p></html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:474c233f-39eb-4912-9703-ae2958c15372"/>
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>

                                <v:ref name="SdClockReference" type="REFERENCE">
                                    <a:a name="LABEL" value="Sd Clock Reference"/>
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                        <html>
                                            Reference to a container of the type McuClockReferencePoint, to select an input clock.
                                        </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:6b08094d-766e-4e25-94d0-f28c0f94495b" />
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                                    </a:da>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint" />
                                </v:ref>

                                <v:var name="u32McuClock" type="INTEGER">
                                    <a:a name="LABEL" value="uSDHC Source Clock"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            Vendor specific:
                                            <h1>SDHC Source Clock </h1><p>
                                            Indicates source clock for uSDHC in Hz. Derived from MCU configuration.
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:7D6DEC98-6C00-1014-A2E1-E54917179776"/>
                                    <a:da name="DEFAULT" type="XPath">
                                        <a:tst expr="num:i(noderef:value(concat(noderef:ref(node:fallback(../SdClockReference, .)), '/McuClockReferencePointFrequency')))"/>
                                    </a:da>
                                    <a:da name="RANGE" type="XPath">
                                        <a:tst expr="node:fallback(., 48000) = num:i(noderef:value(concat(noderef:ref(node:fallback(../SdClockReference, .)), '/McuClockReferencePointFrequency')))" false="uSDHC Clock Value must be calculated based on the Mcu Reference Point. Please press the button to caculate automatically"/>
                                    </a:da>
                                    <a:da name="INVALID" type="Range">
                                            <a:tst expr="&lt;=4294967295"/>
                                            <a:tst expr="&gt;=0"/>
                                    </a:da>
                                </v:var>

                                <v:var name="SdMaxVoltRetries" type="INTEGER">
                                    <a:a name="LABEL" value="Sd maximum retries for card voltage check"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>
                                                Maximum loop count to check the card operation voltage range
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:4cf0f51f-47d2-4ac7-ad0e-fde30e399baa"/>
                                    <a:da name="DEFAULT" value="100"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4294967295"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var>

                                <v:var name="SdMaxCmd55Retries" type="INTEGER">
                                    <a:a name="LABEL" value="Sd maximum retries to check card operation for CMD55"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>
                                                Maximum loop count to check the SDHC card for cmd55
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:4cf0f51f-47d2-4ac7-ad0e-fde30e399caa"/>
                                    <a:da name="DEFAULT" value="30"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var>

                                <v:var name="SdMaxSendStatusRetries" type="INTEGER">
                                    <a:a name="LABEL" value="Sd maximum retries for CMD13 "/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>
                                                Maximum loop count for Send Status command (CMD13) in Sd_Ip_WaitWriteComplete function
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:5b8a41ac-3424-4dcc-b258-91fbdbb66ffa"/>
                                    <a:da name="DEFAULT" value="65535"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=4294967295"/>
                                        <a:tst expr="&gt;=1"/>
                                    </a:da>
                                </v:var>

                                <v:ctr name="BootCardConfig" type="IDENTIFIABLE">
                                    <a:a name="UUID" value="ECUC:3cf7d9b3-4d7f-42b5-b4b2-1d54a6122cc2"/>
                                    <a:a name="LABEL" value="MMC Boot Card Configuration"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <p>
                                                This container is present for eMMC Boot Configuration structure.
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>

                                    <v:var name="bootPartitionSelect" type="ENUMERATION">
                                        <a:a name="LABEL" value="Boot partition for boot operation"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    <p>Select boot partition for boot operation.</p>
                                                    </html>]]>
                                                </a:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:3a2a6ffd-eac4-4c4d-a86b-a776ade5d250"/>
                                        <a:da name="DEFAULT" value="SD_IP_MMCBOOT_PARTITION_1"/>
                                        <a:da name="RANGE">
                                            <a:v>SD_IP_MMCBOOT_PARTITION_1</a:v>
                                            <a:v>SD_IP_MMCBOOT_PARTITION_2</a:v>
                                            <a:v>SD_IP_MMCBOOT_USER_AREA</a:v>
                                        </a:da>
                                    </v:var>

                                    <v:var name="ackEnable" type="BOOLEAN">
                                        <a:a name="LABEL" value="Enable ACK for boot operation"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p></p>
                                                    Enable ACK for boot operation.<br>
                                                    true: ACK enable.<br>
                                                    false: ACK disabled
                                                    </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:1c498ef3-2edf-4e04-aaae-de8b9b1679d7"/>
                                        <a:da name="DEFAULT" value="false"/>
                                    </v:var>

                                    <v:var name="bootSpeed" type="ENUMERATION">
                                        <a:a name="LABEL" value="Boot speed for boot operation"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html>
                                                    <p>Select boot speed for boot operation.</p>
                                                    </html>]]>
                                                </a:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:6dfde6af-4c5d-48ba-8405-ca88f10e2489"/>
                                        <a:da name="DEFAULT" value="SD_IP_MMCBOOT_SDR_LOW_SPEED"/>
                                        <a:da name="RANGE">
                                            <a:v>SD_IP_MMCBOOT_SDR_LOW_SPEED</a:v>
                                            <a:v>SD_IP_MMCBOOT_SDR_HIGH_SPEED</a:v>
                                            <a:v>SD_IP_MMCBOOT_DDR</a:v>
                                        </a:da>
                                    </v:var>

                                    <!-- bootBusWidth -->
                                    <v:var name="bootBusWidth" type="ENUMERATION">
                                        <a:a name="LABEL" value="Boot Bus Width" />
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html><p>
                                                    Boot Data Bus Width
                                                </p></html>]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="NXP"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:26b6a53c-47f7-4255-96f1-d9a99b856261"/>
                                        <a:da name="DEFAULT" value="SD_IP_MMCBOOT_DBW_1BIT"/>
                                        <a:da name="RANGE">
                                            <a:v>SD_IP_MMCBOOT_DBW_1BIT</a:v>
                                            <a:v>SD_IP_MMCBOOT_DBW_4BIT</a:v>
                                            <a:v>SD_IP_MMCBOOT_DBW_8BIT</a:v>
                                        </a:da>
                                    </v:var><!-- bootBusWidth -->
                                </v:ctr>

                            </v:ctr><!-- EepSdCfg -->
                        </v:lst>

                        <v:ctr name="AutosarExt" type="IDENTIFIABLE">
                            <a:a name="UUID" value="ECUC:dc9186d3-53e5-45f7-bc95-ea75b2db22ed"/>
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                            <p>Vendor specific: This container contains the global Non-Autosar configuration parameters of the Eep driver.
                                               This container is a MultipleConfigurationContainer, i.e. this container and
                                               its sub-containers exist once per configuration set.</p>
                                        </html>
                                    ]]>
                                </a:v>
                            </a:a>

                            <v:var name="EepCancelApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Cancel Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Eep_Cancel function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:438a9f13-adb7-4b21-a879-f2a55a93a6e5"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <!-- @implements EepCompareApi_Object -->
                            <v:var name="EepCompareApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Compare Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Eep_Compare function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d5264691-6337-49d3-ab05-b1a19c3dadbb"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="EepGetJobResultApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Get Job Result Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Eep_GetJobResult function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:7507c0b2-e7ff-462d-9656-a20a9bbfbf92"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>


                            <v:var name="EepGetStatusApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Get Status Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Eep_GetStatus function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:32c33368-6341-405b-9149-3fa2337a87a3"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>


                            <v:var name="EepSetModeApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Set Mode Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Eep_SetMode function.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:69fbcad3-9d49-47cc-aab9-5ea3910b3f83"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>
                            
                            <v:var name="EepSwitchPartitionAccessApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep MMC Switch Partition Access Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Compile switch to enable and disable the Eep_SwitchPartitionAccess function for eMMC.<br>
                                            true: API supported / function provided.<br>
                                            false:  API not supported / function not provided
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:8cec2d52-389e-42a9-9e20-cc9cad36f666"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>
                            <v:var name="EepBlockSizeWriteAsynchBehaviorEn" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Block Size Write Asynch"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Enable asynchronous execution of the write job in the Eep_MainFunction function which doesn't wait (block) for completion of the block size write operation(s).
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:46ed2647-72d1-42be-a2f3-c396c6230b88"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>
                            <v:var name="EepBlockSizeEraseAsynchBehaviorEn" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Block Size Erase Asynch"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Vendor specific: Enable asynchronous execution of the erase job in the Eep_MainFunction function which doesn't wait (block) for completion of the block size erase operation(s).
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:46ed2647-72d1-42be-a2f3-c397c6230b88"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>
                                <!-- @implements EepDisableDemReportErrorStatus_Object -->
                            <v:var name="EepDisableDemReportErrorStatus" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Disable Production Error Reporting"/>
                                <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                            <p>Vendor specific: Switches the Diagnostic Error Reporting and Notification OFF.</p>
                                        </html>
                                    ]]>
                                </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:fbb4800a-1114-4ef4-9a8b-c46beac658cc"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>

                            <!-- @implements EepEnableUserModeSupport_Object -->
                            <v:var name="EepEnableUserModeSupport" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Enable User Mode Support"/>
                                <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                            <p> When this parameter is enabled, the EEP module will adapt to run from User Mode, with the following measures:</p>
                                            <p>configuring REG_PROT for Eep IPs so that the registers under protection can be accessed from user mode by setting UAA bit in REG_PROT_GCR to 1</p>
                                            <p>for more information and availability on this platform, please see chapter User Mode Support in IM</p>
                                        </html>
                                    ]]>
                                </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:fbb4800a-1114-4ef4-9a8b-c56befc654eb"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="READONLY" value="true"/>
                            </v:var>

                            <!-- EepMCoreEnable  -->
                            <v:var name="EepMCoreEnable" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Multi Cores Enable"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html> Vendor specific:
                                            Enable the multicore synchronization feature.<p/>
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:fbb4800a-1113-4ef4-9a6b-396beac658c3"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var> <!-- EepMCoreEnable  -->

                            <!-- EepMCoreSemaphoreLogicChannel -->
                            <v:ref name="EepMCoreSemaphoreLogicChannel" type="REFERENCE">
                                <a:a name="LABEL" value="Eep MultiCores Semaphore Logic Channel"/>
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:<html><p>
                                          The Semaphore Logic Channel of the multicore semaphore used for requesting an access.
                                          The Semaphore Logic Channel should be passed to the SEMA4 gate APIs.
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Rm/RmConfigSet/Sema42_ModuleConfig/Sema42LogicChannelConfiguration"/>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:627edf12-4c45-4a3c-8960-de18707316ae"/>
                                <a:da name="INVALID" type="XPath">
                                    <a:tst expr="((./../EepMCoreEnable = 'false') or node:refvalid(.))" false = "Reference is not valid. Sema42 logic channel needs to be configured"/>
                                </a:da>
                                <a:a name="ENABLE" type="XPath">
                                    <a:tst expr="(node:fallback( ../EepMCoreEnable, 0 ) = 'true')"/>
                                </a:a>
                            </v:ref>

                             <!-- EepMCoreLockGatesTimeout -->
                            <v:var name="EepMCoreLockGatesTimeout" type="INTEGER">
                                <a:a name="LABEL" value="Eep MCore Lock Gates Timeout"/>
                                <a:a name="DESC">
                                    <a:v>
                                    <![CDATA[EN:<html><p>
                                        Configures the timeout for lock gates in multicore
                                    </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:0048ffce-2612-46a4-b56b-b70cb37d4a84"/>
                                <a:a name="EDITABLE" type="XPath">
                                    <a:tst expr="(node:fallback( ../EepMCoreEnable, 0 ) = 'true')"/>
                                </a:a>
                                <a:a name="DEFAULT_RADIX" value="HEX" />
                                <a:da name="DEFAULT" value="0"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=0xFFFFFFFF"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var><!-- EepMCoreLockGatesTimeout -->
                        </v:ctr>

                        <!-- @implements EepGeneral_Object -->
                        <v:ctr name="EepGeneral" type="IDENTIFIABLE">
                            <a:a name="LABEL" value="Eep General"/>
                            <a:a name="DESC">
                                <a:v>
                                <![CDATA[EN:<html><p>
                                      Container for general parameters of the eeprom driver. These parameters are always pre-compile.
                                </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:1116deb5-59de-4df3-b9ec-c6462fef84d6"/>
                            <!-- @implements EepEcucPartitionRef_Object -->
                            <v:ref name="EepEcucPartitionRef" type="REFERENCE">
                                <a:a name="DESC">
                                <a:v>Maps the Eep driver to zero or one ECUC partition to make the driver API available in this partition.</a:v>
                                <a:v>Tags: atp.Status=draft</a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="UUID"
                                    value="ECUC:f2e69199-a22e-4d01-9dcf-dbd71f71927f"/>
                                <a:da name="REF"
                                    value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                <a:a name="OPTIONAL" value="true"/>
                                <a:da name="EDITABLE" value="true"/>
                            </v:ref>
                            <!-- @implements EepDevErrorDetect_Object -->
                            <v:var name="EepDevErrorDetect" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Development Error Detect"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Pre-processor switch to enable and disable development error detection (see EEP077).<br>
                                            true: Development error detection enabled.<br>
                                            false:  Development error detection disabled.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:305e2f7b-2813-46cf-8e3c-c73aaa076ad8"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <!-- @implements EepEnableCheckCfgCrc_Object -->
                            <v:var name="EepEnableCheckCfgCrc" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Enable Check Configuration CRC"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p> Vendor specific:
                                            true: Enable calculates CRC for Eep Configuration<br>
                                            false: Disable calculates CRC for Eep Configuration.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:314d2833-21d4-1235-aa72-e8a8fbcb54b9"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <!-- @implements EepDriverIndex_Object -->
                            <v:var name="EepDriverIndex" type="INTEGER">
                                <a:a name="LABEL" value="Eep Driver Index"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>  Index of the driver, used by FEE. </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="ECU"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                                <a:a name="UUID" value="ECUC:004af7ec-d551-4da2-a488-abcb544355ec"/>
                                <a:da name="DEFAULT" value="0"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=254"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>


                            <v:var name="EepUseInterrupts" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Use Interrupts"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Job processing triggered by hardware interrupt. <br>true: Job processing triggered by interrupt (hardware controlled)<br> false: Job processing not triggered by interrupt (software controlled)
                                            <br>Note:<br>Not supported by hardware.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:a8bd452c-f261-4dcb-90cd-c927f4955df2"/>
                                <a:da name="DEFAULT" value="true"/>
                                <a:da name="READONLY" value="true"/>
                            </v:var>

                            <!-- @implements EepVersionInfoApi_Object -->
                            <v:var name="EepVersionInfoApi" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Version Info Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Pre-processor switch to enable / disable the API to read out the modules version information.<br>
                                            true: Version info API enabled.<br>
                                            false:  Version info API disabled.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:819c12f5-90f9-497b-a40e-d0f797de7dad"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <v:var name="EepWriteCycleReduction" type="BOOLEAN">
                                <a:a name="LABEL" value="Eep Write Cycle Reduction Api"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                        Switches to activate or deactivate write cycle reduction (EEPROM value is read and compared before being overwritten).
                                        true: writecycle reduction enabled. false: Write cycle reduction disabled.
                                        The parameter is currently not used as the support for the write cycle reduction is implemented in hardware.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:819c12f5-90f9-557b-a40e-bef797de7dad"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="READONLY" value="true"/>
                            </v:var>
                        </v:ctr>

                        <!-- @implements EepPublishedInformation_Object -->
                        <v:ctr name="EepPublishedInformation" type="IDENTIFIABLE">
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html><p>
                                        Additional published parameters not covered by CommonPublishedInformation container.
                                        Note that these parameters do not have any configuration class setting, since they are published information.
                                    </p></html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:7dbdd7c4-c36b-48a7-8ea6-a1957130d568"/>
                        <!-- @implements EepEraseUnitSize_Object -->
                            <v:var name="EepEraseUnitSize" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Erase Unit Size"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Size of smallest erasable EEPROM data unit in bytes.FLEXRAM does not allow erase. </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:17bc6553-7343-4e98-92dd-c6c9eaaf85f4"/>
                                <a:da name="DEFAULT" value="512"/>
                                <a:da name="INVALID" type="Range">
                                    <a:tst expr="&lt;=4294967295"/>
                                    <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>


                            <v:var name="EepEraseTime" type="FLOAT_LABEL">
                                <a:a name="LABEL" value="Eep Erase Time"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            Maximum time to erase one complete eeprom data unit.
                                            <br>Note:<br>This value can be found on DS as the maximum erase time occurs after the specified number of program/erase cycles.
                                            FLEXRAM does not allow erase, only DFLASH, PFLASH allow erase.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:507fad56-d381-4b21-9216-d7b1632881e8"/>
                                <a:da name="DEFAULT" value="0.0005"/>
                                <a:da name="INVALID" type="Range">
                                     <!-- Max Range should be Inf, but removing Max Range check gives Amdc check error  -->
                                     <a:tst expr="&lt;=0.0005"/>
                                     <a:tst expr="&gt;=0"/>
                                </a:da>
                            </v:var>

                            <!-- @implements EepEraseValue_object -->
                            <v:var name="EepEraseValue" type="INTEGER_LABEL">
                                <a:a name="LABEL" value="Eep Erased Value"/>
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html><p>
                                            The contents of an erased eeprom memory cell.
                                        </p></html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                <a:a name="SCOPE" value="LOCAL"/>
