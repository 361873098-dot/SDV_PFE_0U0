                          <SHORT-NAME>XrdcMDADFMTLockBit</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">Variable for setting the MDA_DFMT bit lock! XrdcRegisterLock should be true.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>NXP</ORIGIN>
