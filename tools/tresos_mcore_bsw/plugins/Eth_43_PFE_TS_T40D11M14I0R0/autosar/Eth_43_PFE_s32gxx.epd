                    <ECUC-STRING-PARAM-DEF UUID="ECUC:3144e974-3d55-447e-888b-f474cddb6067">
                      <SHORT-NAME>EthCtrlPhyAddress</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the unique 48-bit physical address (MAC address) of the controller in network byte order. Depending on EthCtrlPort option, the address is set to associated EMAC or to AUX interface.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
