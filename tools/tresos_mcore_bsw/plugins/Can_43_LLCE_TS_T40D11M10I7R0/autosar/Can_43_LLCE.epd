                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  </MULTIPLICITY-CONFIG-CLASSES>
                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f679e979-2935-4d59-9c77-fed84b2e2e71">
                      <SHORT-NAME>Dummy_HRH</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL">Marks the HRH as dummy. It acts as a placeholder in order to enable setting a filter without the need of removing another one</L-2>
                      </DESC>
