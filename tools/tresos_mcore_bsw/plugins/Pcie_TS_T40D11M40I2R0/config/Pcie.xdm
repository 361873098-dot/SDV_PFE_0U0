                                      <a:tst expr="&lt;=0x10000"/>
                                      <a:tst expr="&gt;=0"/>
                                  </a:a>
                                  <a:da name="INVALID" type="XPath">
                                    <a:tst expr="(node:value(../../BAR0Configuration/Bar0Type64Bit) = 'false') and not(node:value(.) = '65536')"
                                           true="BAR1 size is fixed."/>
                                    <a:tst expr="(node:value(../../BAR0Configuration/Bar0Type64Bit) = 'true') and not(node:value(.) = '0')"
                                           true="BAR1 must be disabled if BAR0 is 64 bits."/>
                                  </a:da>
                              </v:var><!-- Bar1Size -->
