                                      <a:tst expr="&lt;=0xFFFFFFFF"/>
                                  </a:a>
                                  <a:da name="INVALID" type="XPath">
                                      <a:tst expr="(../../BAR4Configuration/Bar4Size = 0) or (( bit:and((.), (../../BAR4Configuration/Bar4Size) - 1) ) = 0)" false="Address must be aligned to size."/>
                                  </a:da>
                              </v:var><!-- Bar4StartAddr -->
                              <v:var name="Bar4StartSymbol" type="FUNCTION-NAME">
                                  <a:a name="LABEL" value="BAR 4 Start Symbol"/>
                                  <a:a name="DESC">
                                      <a:v>
