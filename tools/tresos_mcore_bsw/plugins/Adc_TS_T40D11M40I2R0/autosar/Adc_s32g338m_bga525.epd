                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:16426534-25ba-4d05-a6f6-30f6179cb101">
                          <SHORT-NAME>AdcSTAW0RSelfTestLowThresholdValue</SHORT-NAME>
