                      <d:var name="Bar4Size" type="INTEGER" value="65536"/>
                      <d:var name="Bar4StartAddr" type="INTEGER" value="0">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="Bar4StartSymbol" type="FUNCTION-NAME" 
